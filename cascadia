#!/usr/bin/env bash
#
# Project Cascadia -- one entry point.
#
#   ./cascadia doctor      check that this machine has what the build needs
#   ./cascadia kernel      fetch the pinned Linux source into build/linux
#   ./cascadia rootfs      build the Alpine armhf rootfs for the initramfs
#   ./cascadia build       dtb + kernel + staging bundle, with the safety checks
#   ./cascadia firmware    patch iBSS/iBEC out of a stock IPSW (needs Legacy iOS Kit)
#   ./cascadia flash       boot the device over USB            (macOS for now)
#   ./cascadia net on|off  share the Mac's internet with it    (macOS for now)
#   ./cascadia nfs on|off  export a root filesystem to it      (macOS for now)
#
# Everything is relative to this file, so the repository works wherever it is
# cloned.  There is no ~/iBSSloader and no ~/Desktop anything.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${IMAGE:-cascadia-build}"
cd "$ROOT"

say()  { printf '==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# stat's flags are the classic portability trap here: BSD wants -f%z and GNU
# wants -c%s, and the wrong one prints an error that looks like a missing file.
filesize() {
    stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null \
        || fail "cannot stat $1"
}

# Having the docker BINARY says nothing about being able to use it: on a fresh
# Arch install the daemon is not started and the user is not in the docker
# group, and every call then fails with "dial unix /var/run/docker.sock: no
# such file or directory" -- which doctor used to report as "ok: docker".
docker_reachable() { have docker && docker info >/dev/null 2>&1; }

require_docker() {
    have docker || fail "docker is not installed or not on PATH"
    docker_reachable && return 0
    {
        echo "error: docker is installed but its daemon is not reachable."
        echo "       (dial unix /var/run/docker.sock -- nothing listening there)"
        echo
        case "$(uname -s)" in
            Linux)
                echo "  Start it and allow your user to talk to it:"
                echo "    sudo systemctl enable --now docker"
                echo "    sudo usermod -aG docker \"$USER\" && newgrp docker"
                echo
                echo "  Rootless docker or podman also work; point IMAGE= and"
                echo "  DOCKER= at them if you use those." ;;
            Darwin)
                echo "  Start Docker Desktop (or colima) and wait for it to settle." ;;
        esac
    } >&2
    exit 1
}

in_docker() {
    require_docker
    docker image inspect "$IMAGE" >/dev/null 2>&1 \
        || { say "building the $IMAGE image (first run only)"; docker build -t "$IMAGE" "$ROOT"; }
    # Run as the calling user on Linux.  Docker Desktop on macOS maps ownership
    # for you; a plain Linux daemon does not, so everything the build writes
    # into the bind mount lands owned by root and the next `rm -rf build` or
    # plain rebuild needs sudo.  Observed on the first clean-clone build: the
    # bundle came out root:root while the loader, copied by the host shell
    # afterwards, came out as the user.
    duser=()
    [ "$(uname -s)" = "Linux" ] && duser=(--user "$(id -u):$(id -g)")
    # ${arr[@]+"${arr[@]}"} and not plain "${arr[@]}": macOS ships bash 3.2,
    # where expanding an EMPTY array under `set -u` is an unbound-variable
    # error.  bash 4.4 and later made it fine, so this only ever breaks on the
    # Mac -- and it broke on the Mac, after passing on Arch.
    docker run --rm ${duser[@]+"${duser[@]}"} ${DOCKER_EXTRA[@]+"${DOCKER_EXTRA[@]}"} \
        -v "$ROOT":/cascadia -w /cascadia "$IMAGE" bash -c "$1"
}

DOCKER_EXTRA=()

cmd_firmware() {
    # No Legacy iOS Kit needed here: the image builds iBoot32Patcher from source
    # and the img3 decrypt/encrypt steps are pure Python, so the whole boot
    # chain is derived from the user's own IPSW and nothing else.  LIK is still
    # wanted for flashing, where --pwn and --kdfu get the device into pwned DFU.
    IPSW_PATH="${IPSW:-$ROOT/ipad25.ipsw}"
    [ -f "$IPSW_PATH" ] || fail "no IPSW at $IPSW_PATH
This port is pinned to iPad2,5 on iOS 8.4.1 (12H321): the auto-go hook patches
an address inside that exact iBEC and the keys are that build's.  Fetch
iPad2,5_8.4.1_12H321_Restore.ipsw and pass IPSW=/path/to/it."

    say "IPSW: $IPSW_PATH"
    DOCKER_EXTRA=(-v "$IPSW_PATH":/ipsw.ipsw:ro)
    in_docker "IPSW=/ipsw.ipsw bash scripts/build-firmware.sh"
    DOCKER_EXTRA=()
}

cmd_doctor() {
    rc=0
    say "host"
    note "uname: $(uname -srm)"
    for t in git python3 rsync; do
        if have "$t"; then note "ok:      $t"; else note "MISSING: $t"; rc=1; fi
    done
    # Reachability, not presence.  doctor exists to fail here rather than in the
    # middle of a build, and reporting the binary was exactly the wrong check.
    if ! have docker; then
        note "MISSING: docker"; rc=1
    elif docker_reachable; then
        note "ok:      docker (daemon reachable)"
    else
        note "BROKEN:  docker is installed but its daemon is not reachable"; rc=1
    fi
    case "$(uname -s)" in
        Darwin) note "ok:      macOS -- flash/net/nfs are implemented for this host" ;;
        Linux)  note "note:    Linux -- build works; flash/net/nfs are still macOS-only" ;;
        *)      note "note:    $(uname -s) -- untested; build may work, the rest will not" ;;
    esac
    say "boot chain (not needed to build a kernel)"
    if [ -f "${IPSW:-$ROOT/ipad25.ipsw}" ]; then note "ok:      IPSW (./cascadia firmware)"
    else note "missing: iPad2,5_8.4.1_12H321_Restore.ipsw for ./cascadia firmware (set IPSW=)"; fi
    LIKD="${LIK:-$HOME/Legacy-iOS-Kit}"
    if [ -d "$LIKD" ]; then note "ok:      Legacy iOS Kit at $LIKD (./cascadia flash)"
    else note "missing: Legacy iOS Kit for ./cascadia flash -- it is what gets the device"
         note "         into pwned DFU, with a Pi Pico or with --kdfu and no extra hardware"
         note "         git clone https://github.com/LukeZGD/Legacy-iOS-Kit.git ~/Legacy-iOS-Kit"; fi

    say "tree"
    for p in build/linux/Makefile build/initramfs-root/init dtb/p105ap.dtb; do
        if [ -e "$p" ]; then note "ok:      $p"
        else note "missing: $p    ($(case $p in build/linux*) echo './cascadia kernel';; build/initramfs*) echo './cascadia rootfs';; *) echo './cascadia build';; esac))"; fi
    done
    [ "$rc" -eq 0 ] || fail "install what is missing above and re-run"
    say "ready"
}

cmd_kernel() { bash "$ROOT/scripts/fetch-kernel.sh"; }

cmd_rootfs() {
    [ -x "$ROOT/scripts/build-alpine-rootfs.sh" ] || fail "scripts/build-alpine-rootfs.sh is missing"
    bash "$ROOT/scripts/build-alpine-rootfs.sh"
}

cmd_build() {
    [ -f "$ROOT/build/linux/Makefile" ] || fail "no kernel source -- run: ./cascadia kernel"
    [ -d "$ROOT/build/initramfs-root" ] || fail "no rootfs -- run: ./cascadia rootfs"
    mkdir -p "$ROOT/build/out" "$ROOT/output"

    say "1/5 device tree"
    # rm first: dtc is not a make target here, so a stale .dtb would just be
    # reused and an edit to the .dts would silently never reach the device.
    rm -f "$ROOT/dtb/p105ap.dtb"; mkdir -p "$ROOT/dtb"
    # Capture rather than pipe: a pipeline hands back the last command's status,
    # so a docker failure here used to surface as the far less useful "dtc
    # produced no dtb" with the real error scrolled past.
    if ! out=$(in_docker "dtc -I dts -O dtb -f dts/p105ap.dts -o dtb/p105ap.dtb" 2>&1); then
        printf '%s\n' "$out" >&2
        fail "dtc failed -- see above"
    fi
    printf '%s\n' "$out" | grep -v '^$' | tail -5 || true
    [ -s "$ROOT/dtb/p105ap.dtb" ] || fail "dtc ran but produced no dtb"
    for s in g_cdc.host_addr g_cdc.dev_addr; do
        LC_ALL=C grep -aFq "$s" "$ROOT/dtb/p105ap.dtb" || fail "$s missing from the dtb bootargs"
    done
    LC_ALL=C grep -aFq initcall_debug "$ROOT/dtb/p105ap.dtb" && fail "dtb has initcall_debug; drop it from bootargs"
    note "ok: fresh dtb, gadget MACs pinned"

    say "2/5 build date stamp"
    # No RTC on this board: without a stamp it boots at the epoch and every TLS
    # handshake fails on notBefore.  Written before the kernel build so it lands
    # inside the embedded initramfs.
    date -u "+%Y-%m-%d %H:%M:%S" > "$ROOT/build/initramfs-root/etc/build-date"
    note "ok: $(cat "$ROOT/build/initramfs-root/etc/build-date") UTC"

    say "3/5 kernel"
    # set -o pipefail INSIDE the container shell: without it a failed build
    # returns the status of whatever the output was piped into, and the stale
    # artifacts from last time get shipped as if they were fresh.
    in_docker "set -o pipefail; bash scripts/build-kernel.sh 2>&1 | tail -25"

    say "4/5 freshness"
    CPIO="$ROOT/build/linux/usr/initramfs_data.cpio"
    [ -f "$CPIO" ] || fail "no $CPIO -- the kernel build did not embed an initramfs"
    STALE=$(find "$ROOT/build/initramfs-root" -type f -newer "$CPIO" -print -quit 2>/dev/null || true)
    [ -z "$STALE" ] || fail "the archive predates ${STALE#$ROOT/build/initramfs-root/} -- the build missed your change"
    note "ok: the initramfs archive is newer than every input"

    say "5/5 bundle"
    cat "$ROOT/build/linux/arch/arm/boot/zImage" "$ROOT/dtb/p105ap.dtb" > "$ROOT/output/zImage-dtb"
    want=$(( $(filesize "$ROOT/build/linux/arch/arm/boot/zImage") + $(filesize "$ROOT/dtb/p105ap.dtb") ))
    got=$(filesize "$ROOT/output/zImage-dtb")
    [ "$want" = "$got" ] || fail "zImage-dtb is $got bytes, expected $want"
    in_docker "bash build-bundle.sh 2>&1 | tail -5"
    cp "$ROOT/output/linux-boot.bin" "$ROOT/output/staging-loader.bin"
    bs=$(filesize "$ROOT/output/staging-bundle.bin")
    [ "$bs" = "$(( got + 32768 ))" ] || fail "staging-bundle.bin is $bs bytes, expected $(( got + 32768 ))"
    note "ok: bundle = 32K loader + this exact zImage-dtb"

    say "done"
    ls -l "$ROOT/output/staging-bundle.bin" "$ROOT/output/staging-loader.bin"
}

host_only_macos() {
    [ "$(uname -s)" = "Darwin" ] || fail "'$1' is implemented for macOS only so far.
The build works everywhere; flashing and the host-side network and NFS helpers
still speak networksetup/pfctl/nfsd.  Porting them is tracked work, not a
limitation of the device."
}

case "${1:-}" in
    doctor) cmd_doctor ;;
    kernel) cmd_kernel ;;
    rootfs) cmd_rootfs ;;
    build)  cmd_build ;;
    firmware) cmd_firmware ;;
    flash)  host_only_macos flash; shift; bash "$ROOT/tools/flash-rearm.sh" "$@" ;;
    net)    host_only_macos net;   shift; bash "$ROOT/tools/mac-share-internet.sh" "$@" ;;
    nfs)    host_only_macos nfs;   shift; bash "$ROOT/tools/mac-nfs-export.sh" "$@" ;;
    *)      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
