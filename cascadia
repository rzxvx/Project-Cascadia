#!/usr/bin/env bash
#
# Project Cascadia -- one entry point.
#
#   ./cascadia doctor      check that this machine has what the build needs
#   ./cascadia kernel      fetch the pinned Linux source into build/linux
#   ./cascadia rootfs      build the Alpine armhf rootfs for the initramfs
#   ./cascadia build       dtb + kernel + staging bundle, with the safety checks
#   ./cascadia firmware    patch iBSS/iBEC out of a stock IPSW
#   ./cascadia flash       boot the device over USB (needs Legacy iOS Kit)
#   ./cascadia link        give this host 10.55.0.1 on the device's link (flash does it)
#   ./cascadia net on|off  share the Mac's internet with it    (macOS for now)
#   ./cascadia nfs on|off  export a root filesystem to it      (macOS for now)
#   ./cascadia image       rebuild the build image if the Dockerfile changed
#
# Everything is relative to this file, so the repository works wherever it is
# cloned.  There is no ~/iBSSloader and no ~/Desktop anything.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${IMAGE:-cascadia-build}"
cd "$ROOT"

say()  { printf '==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# stat's flags are the classic portability trap here: BSD wants -f%z and GNU
# wants -c%s, and the wrong one prints an error that looks like a missing file.
filesize() {
    stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null \
        || fail "cannot stat $1"
}

# Having the docker BINARY says nothing about being able to use it: on a fresh
# Arch install the daemon is not started and the user is not in the docker
# group, and every call then fails with "dial unix /var/run/docker.sock: no
# such file or directory" -- which doctor used to report as "ok: docker".
docker_reachable() { have docker && docker info >/dev/null 2>&1; }

require_docker() {
    have docker || fail "docker is not installed or not on PATH"
    docker_reachable && return 0
    {
        echo "error: docker is installed but its daemon is not reachable."
        echo "       (dial unix /var/run/docker.sock -- nothing listening there)"
        echo
        case "$(uname -s)" in
            Linux)
                echo "  Start it and allow your user to talk to it:"
                echo "    sudo systemctl enable --now docker"
                echo "    sudo usermod -aG docker \"$USER\" && newgrp docker"
                echo
                echo "  Rootless docker or podman also work; point IMAGE= and"
                echo "  DOCKER= at them if you use those." ;;
            Darwin)
                echo "  Start Docker Desktop (or colima) and wait for it to settle." ;;
        esac
    } >&2
    exit 1
}

# The image is rebuilt whenever the Dockerfile changes, not only when it is
# missing.  The first clean install on Arch found the gap: its image predated
# the iBoot32Patcher step, so ./cascadia firmware failed on a tool the
# Dockerfile plainly installs, and the only way out was knowing to `docker rmi`
# it.  The image carries a label with a hash of the Dockerfile it came from.
# Unchanged layers come from docker's cache, so a rebuild for an old image
# that merely lacks the label takes seconds.
dockerfile_hash() {
    python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest()[:16])' \
        "$ROOT/Dockerfile"
}

ensure_image() {
    require_docker
    want=$(dockerfile_hash)
    have=$(docker image inspect -f '{{ index .Config.Labels "cascadia.dockerfile" }}' "$IMAGE" 2>/dev/null || true)
    if [ "$have" = "$want" ]; then return 0; fi
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        say "$IMAGE does not match the current Dockerfile -- rebuilding it"
    else
        say "building the $IMAGE image (first run only)"
    fi
    docker build --label "cascadia.dockerfile=$want" -t "$IMAGE" "$ROOT"
}

in_docker() {
    ensure_image
    # Run as the calling user on Linux.  Docker Desktop on macOS maps ownership
    # for you; a plain Linux daemon does not, so everything the build writes
    # into the bind mount lands owned by root and the next `rm -rf build` or
    # plain rebuild needs sudo.  Observed on the first clean-clone build: the
    # bundle came out root:root while the loader, copied by the host shell
    # afterwards, came out as the user.
    duser=()
    [ "$(uname -s)" = "Linux" ] && duser=(--user "$(id -u):$(id -g)")
    # ${arr[@]+"${arr[@]}"} and not plain "${arr[@]}": macOS ships bash 3.2,
    # where expanding an EMPTY array under `set -u` is an unbound-variable
    # error.  bash 4.4 and later made it fine, so this only ever breaks on the
    # Mac -- and it broke on the Mac, after passing on Arch.
    docker run --rm ${duser[@]+"${duser[@]}"} ${DOCKER_EXTRA[@]+"${DOCKER_EXTRA[@]}"} \
        -v "$ROOT":/cascadia -w /cascadia "$IMAGE" bash -c "$1"
}

DOCKER_EXTRA=()

# The one stock file the boot chain is derived from.  Apple still serves it;
# the URL is Apple's own, nothing here redistributes the firmware.
IPSW_NAME="iPad2,5_8.4.1_12H321_Restore.ipsw"
IPSW_URL="https://secure-appldnld.apple.com/ios8.4.1/031-31249-20150812-75235CC6-3C8F-11E5-848D-BE1A3A53DB92/$IPSW_NAME"

# IPSW= wins, and a wrong IPSW= is an error rather than a quiet fallback.
# Otherwise the repository root is searched under both names: the one Apple
# serves, so `curl -LO` followed by ./cascadia firmware just works, and the
# short one this tree has always used.
find_ipsw() {
    if [ -n "${IPSW:-}" ]; then
        if [ -f "$IPSW" ]; then echo "$IPSW"; return 0; fi
        return 1
    fi
    for c in "$ROOT/$IPSW_NAME" "$ROOT/ipad25.ipsw"; do
        if [ -f "$c" ]; then echo "$c"; return 0; fi
    done
    return 1
}

cmd_firmware() {
    # No Legacy iOS Kit needed here: the image builds iBoot32Patcher from source
    # and the img3 decrypt/encrypt steps are pure Python, so the whole boot
    # chain is derived from the user's own IPSW and nothing else.  LIK is still
    # wanted for flashing, where --pwn and --kdfu get the device into pwned DFU.
    IPSW_PATH=$(find_ipsw) || fail "no IPSW${IPSW:+ at $IPSW}
This port is pinned to iPad2,5 on iOS 8.4.1 (12H321): the auto-go hook patches
an address inside that exact iBEC, and the keys are that build's.  Apple still
serves it -- from the repository root:

    curl -LO '$IPSW_URL'

./cascadia firmware finds it there under that name.  Anywhere else, pass
IPSW=/path/to/it."

    say "IPSW: $IPSW_PATH"
    DOCKER_EXTRA=(-v "$IPSW_PATH":/ipsw.ipsw:ro)
    in_docker "IPSW=/ipsw.ipsw bash scripts/build-firmware.sh"
    DOCKER_EXTRA=()
}

cmd_doctor() {
    rc=0
    say "host"
    note "uname: $(uname -srm)"
    for t in git python3 rsync; do
        if have "$t"; then note "ok:      $t"; else note "MISSING: $t"; rc=1; fi
    done
    # Reachability, not presence.  doctor exists to fail here rather than in the
    # middle of a build, and reporting the binary was exactly the wrong check.
    if ! have docker; then
        note "MISSING: docker"; rc=1
    elif docker_reachable; then
        note "ok:      docker (daemon reachable)"
    else
        note "BROKEN:  docker is installed but its daemon is not reachable"; rc=1
    fi
    case "$(uname -s)" in
        Darwin) note "ok:      macOS -- build, flash and the host-side helpers all run here" ;;
        Linux)  note "note:    Linux -- build, flash and link run here; net and nfs are macOS-only so far" ;;
        *)      note "note:    $(uname -s) -- untested; build may work, the rest will not" ;;
    esac
    say "boot chain (not needed to build a kernel)"
    if p=$(find_ipsw); then note "ok:      IPSW ${p#$ROOT/} (./cascadia firmware)"
    else note "missing: $IPSW_NAME for ./cascadia firmware"
         note "         curl -LO '$IPSW_URL'"; fi
    LIKD="${LIK:-$HOME/Legacy-iOS-Kit}"
    if [ -d "$LIKD" ]; then note "ok:      Legacy iOS Kit at $LIKD (./cascadia flash)"
         if [ "$(uname -s)" = Linux ]; then
             note "         on Linux its first run installs its own dependencies and exits;"
             note "         run it once on its own before flashing:  cd $LIKD && ./restore.sh"
         fi
    else note "missing: Legacy iOS Kit for ./cascadia flash -- it is what gets the device"
         note "         into pwned DFU, with a Pi Pico or with --kdfu and no extra hardware"
         note "         git clone https://github.com/LukeZGD/Legacy-iOS-Kit.git ~/Legacy-iOS-Kit"; fi

    say "tree"
    for p in build/linux/Makefile build/initramfs-root/init dtb/p105ap.dtb; do
        if [ -e "$p" ]; then note "ok:      $p"
        else note "missing: $p    ($(case $p in build/linux*) echo './cascadia kernel';; build/initramfs*) echo './cascadia rootfs';; *) echo './cascadia build';; esac))"; fi
    done
    [ "$rc" -eq 0 ] || fail "install what is missing above and re-run"
    say "ready"
}

cmd_kernel() { bash "$ROOT/scripts/fetch-kernel.sh"; }

cmd_rootfs() {
    [ -x "$ROOT/scripts/build-alpine-rootfs.sh" ] || fail "scripts/build-alpine-rootfs.sh is missing"
    bash "$ROOT/scripts/build-alpine-rootfs.sh"
}

cmd_build() {
    [ -f "$ROOT/build/linux/Makefile" ] || fail "no kernel source -- run: ./cascadia kernel"
    [ -d "$ROOT/build/initramfs-root" ] || fail "no rootfs -- run: ./cascadia rootfs"
    mkdir -p "$ROOT/build/out" "$ROOT/output"

    # KERNEL_SRC= makes build/linux a symlink to a tree somewhere else, which is
    # right for the host -- a kernel checkout is ~2.5 GB and nobody wants two --
    # and useless inside the container, where that absolute path does not exist.
    # Bind the target over the symlink so the path the build expects is a real
    # directory on both sides.  realpath via python3 because BSD readlink has no
    # -f and python3 is already a checked prerequisite.
    if [ -L "$ROOT/build/linux" ]; then
        KTREE=$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$ROOT/build/linux")
        [ -f "$KTREE/Makefile" ] || fail "build/linux points at $KTREE, which is not a kernel tree"
        note "kernel tree: $KTREE (mounted over the symlink)"
        DOCKER_EXTRA=(-v "$KTREE":/cascadia/build/linux)
    fi

    say "1/6 device tree"
    # rm first: dtc is not a make target here, so a stale .dtb would just be
    # reused and an edit to the .dts would silently never reach the device.
    rm -f "$ROOT/dtb/p105ap.dtb"; mkdir -p "$ROOT/dtb"
    # Capture rather than pipe: a pipeline hands back the last command's status,
    # so a docker failure here used to surface as the far less useful "dtc
    # produced no dtb" with the real error scrolled past.
    if ! out=$(in_docker "dtc -I dts -O dtb -f dts/p105ap.dts -o dtb/p105ap.dtb" 2>&1); then
        printf '%s\n' "$out" >&2
        fail "dtc failed -- see above"
    fi
    printf '%s\n' "$out" | grep -v '^$' | tail -5 || true
    [ -s "$ROOT/dtb/p105ap.dtb" ] || fail "dtc ran but produced no dtb"
    for s in g_cdc.host_addr g_cdc.dev_addr; do
        LC_ALL=C grep -aFq "$s" "$ROOT/dtb/p105ap.dtb" || fail "$s missing from the dtb bootargs"
    done
    LC_ALL=C grep -aFq initcall_debug "$ROOT/dtb/p105ap.dtb" && fail "dtb has initcall_debug; drop it from bootargs"
    note "ok: fresh dtb, gadget MACs pinned"

    say "2/6 initramfs extras"
    # initramfs/ is the source of truth for the boot scripts, but only
    # ./cascadia rootfs used to copy it in -- an edit to initramfs/init followed
    # by ./cascadia build shipped the old init.  Overlay it on every build.
    cp -a "$ROOT/initramfs/." "$ROOT/build/initramfs-root/"
    note "ok: boot scripts from initramfs/"
    # No RTC on this board: without a stamp it boots at the epoch and every TLS
    # handshake fails on notBefore.  Written before the kernel build so it lands
    # inside the embedded initramfs.
    date -u "+%Y-%m-%d %H:%M:%S" > "$ROOT/build/initramfs-root/etc/build-date"
    note "ok: build date $(cat "$ROOT/build/initramfs-root/etc/build-date") UTC"
    # /bin/peek is the MMIO tool every lab note in docs/ uses, and this busybox
    # has no devmem applet.  Built here rather than committed: the source is
    # ours, and the cross-compiler is already in the image.
    in_docker "arm-linux-gnueabihf-gcc -static -Os -o build/initramfs-root/bin/peek tools/p105-peek.c"
    [ -s "$ROOT/build/initramfs-root/bin/peek" ] || fail "peek did not build"
    note "ok: /bin/peek ($(filesize "$ROOT/build/initramfs-root/bin/peek") bytes, static ARM)"
    # /sbin/z2-boot brings the digitizer up the way iOS does -- firmware, the
    # N1 calibration sequence, EXECUTE, operating mode -- where hx-touchd stops
    # after the firmware.  docs/research/p105-z2-boot.md.
    in_docker "arm-linux-gnueabihf-gcc -static -Os -o build/initramfs-root/sbin/z2-boot tools/z2-boot.c"
    [ -s "$ROOT/build/initramfs-root/sbin/z2-boot" ] || fail "z2-boot did not build"
    note "ok: /sbin/z2-boot ($(filesize "$ROOT/build/initramfs-root/sbin/z2-boot") bytes, static ARM)"
    # dropbear's host key, made once and kept in build/keep so it outlives a
    # rootfs rebuild.  Without it dropbear -R made a new one at every boot of the
    # RAM root, and every boot met ssh with REMOTE HOST IDENTIFICATION HAS
    # CHANGED.  The fingerprint printed here is the one ssh shows the first time.
    if [ -x "$ROOT/build/initramfs-root/usr/sbin/dropbear" ]; then
        if command -v ssh-keygen >/dev/null 2>&1; then
            HOSTKEY=etc/dropbear/dropbear_ed25519_host_key
            hk=$(python3 "$ROOT/scripts/dropbear-hostkey.py" "$ROOT/build/keep/$HOSTKEY") \
                || fail "could not make the ssh host key"
            note "ok: ssh host key, ${hk%% *} ed25519 ${hk#* }"
        else
            note "note: no ssh-keygen here, so the device makes its host key at boot -- a new one every boot"
        fi
    fi
    # build/keep holds what the repository cannot reproduce -- the touch
    # daemon, the digitizer firmware, the ssh host key made just above -- and
    # only ./cascadia rootfs used to copy it in, so a firmware added later
    # never reached the image.  Every build now.
    if [ -d "$ROOT/build/keep" ]; then
        cp -a "$ROOT/build/keep/." "$ROOT/build/initramfs-root/"
        note "ok: build/keep/ -> image ($(cd "$ROOT/build/keep" && find . -type f | wc -l | tr -d ' ') files)"
    fi
    if [ -x "$ROOT/build/initramfs-root/usr/sbin/dropbear" ]; then
        # The image always lets in the machine that builds it.  add-dropbear.sh
        # bakes a key once, at rootfs time, so a key made after that -- another
        # ssh-keygen, another laptop -- left an image that met every login with
        # a password prompt for a password that does not exist.  This machine's
        # key is added if the image does not carry it yet; nothing is removed.
        # So is every ~/.ssh/cascadia*.pub: keys made for this device alone
        # (cascadia_claude, the passphrase-less one the assistant logs in
        # with).  Stage 1 copies the image's list over the NFS root's at every
        # boot, so a key appended on the device by hand is gone after a reboot.
        AK="$ROOT/build/initramfs-root/root/.ssh/authorized_keys"
        PUB="${PUBKEY:-}"
        if [ -z "$PUB" ]; then
            for c in ~/.ssh/id_ed25519.pub ~/.ssh/id_rsa.pub ~/.ssh/id_ecdsa.pub; do
                if [ -f "$c" ]; then PUB="$c"; break; fi
            done
        fi
        [ -n "$PUB" ] || note "note: no ssh public key on this machine -- the image keeps whatever keys it had"
        for PUB in $PUB ~/.ssh/cascadia*.pub; do
            [ -f "$PUB" ] || continue
            blob=$(awk 'NR == 1 { print $2 }' "$PUB")
            case "$(head -c 12 "$PUB" 2>/dev/null)" in
                ssh-*|ecdsa-*|sk-*) : ;;
                *) blob= ;;
            esac
            if [ -z "$blob" ]; then
                note "note: $PUB is not an OpenSSH public key -- skipped"
            elif [ -f "$AK" ] && grep -qF "$blob" "$AK"; then
                note "ok: ssh lets in $PUB"
            else
                mkdir -p "$(dirname "$AK")"
                chmod 700 "$(dirname "$AK")"
                { [ -s "$AK" ] && echo; cat "$PUB"; } >> "$AK"
                chmod 600 "$AK"
                note "ok: ssh lets in $PUB -- added to the image"
            fi
        done
    fi

    say "3/6 kernel"
    # set -o pipefail INSIDE the container shell: without it a failed build
    # returns the status of whatever the output was piped into, and the stale
    # artifacts from last time get shipped as if they were fresh.
    in_docker "set -o pipefail; bash scripts/build-kernel.sh 2>&1 | tail -25"

    say "4/6 freshness"
    CPIO="$ROOT/build/linux/usr/initramfs_data.cpio"
    [ -f "$CPIO" ] || fail "no $CPIO -- the kernel build did not embed an initramfs"
    STALE=$(find "$ROOT/build/initramfs-root" -type f -newer "$CPIO" -print -quit 2>/dev/null || true)
    [ -z "$STALE" ] || fail "the archive predates ${STALE#$ROOT/build/initramfs-root/} -- the build missed your change"
    note "ok: the initramfs archive is newer than every input"

    say "5/6 initramfs contents"
    # The kernel build embeds whatever it is pointed at without an opinion, so
    # check that what went in is the boot these docs describe.  This is the
    # check that was missing while ./cascadia rootfs still installed a pre-USB
    # /init: the build was green, the kernel was fine, and the device came up
    # on the glass with no console over the cable, no 10.55.0.2 and no ssh.
    # LC_ALL=C because BSD grep in a UTF-8 locale silently skips regions of a
    # binary it cannot decode.
    for s in "P105: stage1 start" p105-stage2 ttyGS0 10.55.0.2; do
        LC_ALL=C grep -aFq "$s" "$CPIO" \
            || fail "the archive has no '$s' -- build/initramfs-root is not what ./cascadia rootfs builds"
    done
    note "ok: stage 1, stage 2, the ACM console and the pinned address are in the archive"
    # Ownership, read out of the archive's own headers.  Every entry must be
    # root's: the first build on a Linux host came out owned by uid 1000
    # throughout, booted fine, and then dropbear refused root's key because
    # /root/.ssh was not root's -- which surfaces as a password prompt for a
    # password that does not exist.  A group other than 0 is only noted.
    owners=$(python3 "$ROOT/scripts/cpio-owners.py" "$CPIO") \
        || fail "could not read owners out of $CPIO"
    bad_uid=$(printf '%s\n' "$owners" | sed -n 1p)
    bad_gid=$(printf '%s\n' "$owners" | sed -n 2p)
    [ "$bad_uid" = "-" ] || fail "files in the archive are not owned by root ($bad_uid).
The kernel config maps the builder's uid to 0 (CONFIG_INITRAMFS_ROOT_UID=-1),
so this is a file in build/initramfs-root owned by some third uid."
    note "ok: every entry is owned by root"
    [ "$bad_gid" = "-" ] || note "note: some entries keep a non-root group ($bad_gid) -- harmless; rootfs and build ran under different groups"

    # Not fatal: a tree without these still boots and still gives both consoles.
    for s in bin/peek usr/sbin/dropbear etc/dropbear/dropbear_ed25519_host_key sbin/mount.nfs; do
        if LC_ALL=C grep -aFq "$s" "$CPIO"; then note "ok:      $s"
        else note "missing: $s  -- ./cascadia rootfs installs it when docker is up"; fi
    done

    say "6/6 bundle"
    cat "$ROOT/build/linux/arch/arm/boot/zImage" "$ROOT/dtb/p105ap.dtb" > "$ROOT/output/zImage-dtb"
    want=$(( $(filesize "$ROOT/build/linux/arch/arm/boot/zImage") + $(filesize "$ROOT/dtb/p105ap.dtb") ))
    got=$(filesize "$ROOT/output/zImage-dtb")
    [ "$want" = "$got" ] || fail "zImage-dtb is $got bytes, expected $want"
    in_docker "bash build-bundle.sh 2>&1 | tail -5"
    cp "$ROOT/output/linux-boot.bin" "$ROOT/output/staging-loader.bin"
    bs=$(filesize "$ROOT/output/staging-bundle.bin")
    [ "$bs" = "$(( got + 32768 ))" ] || fail "staging-bundle.bin is $bs bytes, expected $(( got + 32768 ))"
    note "ok: bundle = 32K loader + this exact zImage-dtb"

    DOCKER_EXTRA=()
    say "done"
    ls -l "$ROOT/output/staging-bundle.bin" "$ROOT/output/staging-loader.bin"
}

host_only_macos() {
    [ "$(uname -s)" = "Darwin" ] || fail "'$1' is implemented for macOS only so far.
The build, ./cascadia flash and ./cascadia link run anywhere; it is these two
that still speak networksetup, pfctl and nfsd.  Porting them is tracked work,
not a limitation of the device."
}

case "${1:-}" in
    doctor) cmd_doctor ;;
    kernel) cmd_kernel ;;
    rootfs) cmd_rootfs ;;
    build)  cmd_build ;;
    firmware) cmd_firmware ;;
    flash)  shift; bash "$ROOT/tools/flash.sh" "$@" ;;
    link)   bash "$ROOT/tools/host-link.sh" ;;
    image)  ensure_image; say "$IMAGE is current" ;;
    net)    host_only_macos net;   shift; bash "$ROOT/tools/mac-share-internet.sh" "$@" ;;
    nfs)    host_only_macos nfs;   shift; bash "$ROOT/tools/mac-nfs-export.sh" "$@" ;;
    *)      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
