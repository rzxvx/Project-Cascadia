+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included in actual A5 driver. Every entry requires adapter segment lock.
+ * No generic core retries, mutable timeout policy, or adapter proxy copy. */
+static struct apple_s5l8940x_i2c *pmu_controller(struct i2c_client *client)
+{
+	struct i2c_adapter *adap;
+
+	if (IS_ERR_OR_NULL(client) || IS_ERR_OR_NULL(client->adapter) ||
+	    client->addr != 0x3c || client->flags)
+		return ERR_PTR(-EINVAL);
+	adap = client->adapter;
+	if (adap->algo != &apple_s5l8940x_i2c_algorithm ||
+	    IS_ERR_OR_NULL(adap->algo_data) || adap->quirks)
+		return ERR_PTR(-EOPNOTSUPP);
+	lockdep_assert_held(&adap->bus_lock);
+	return adap->algo_data;
+}
+
+int apple_s5l8940x_i2c_pmu_reserve(struct i2c_client *client)
+{
+	struct apple_s5l8940x_i2c *i2c = pmu_controller(client);
+
+	if (IS_ERR(i2c))
+		return PTR_ERR(i2c);
+	if (i2c->pmu_owner)
+		return -EBUSY;
+	if (test_bit(I2C_ALF_IS_SUSPENDED, &client->adapter->locked_flags))
+		return -ESHUTDOWN;
+	i2c->pmu_owner = client;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_s5l8940x_i2c_pmu_reserve);
+
+int apple_s5l8940x_i2c_pmu_release(struct i2c_client *client)
+{
+	struct apple_s5l8940x_i2c *i2c = pmu_controller(client);
+
+	if (IS_ERR(i2c))
+		return PTR_ERR(i2c);
+	if (i2c->pmu_owner != client)
+		return -EPERM;
+	i2c->pmu_owner = NULL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_s5l8940x_i2c_pmu_release);
+
+int apple_s5l8940x_i2c_pmu_once(struct i2c_client *client,
+			      struct i2c_msg *msgs, int num, bool atomic)
+{
+	struct apple_s5l8940x_i2c *i2c = pmu_controller(client);
+	struct i2c_adapter *adap;
+	int i, ret;
+
+	if (IS_ERR(i2c))
+		return PTR_ERR(i2c);
+	adap = client->adapter;
+	if (i2c->pmu_owner != client)
+		return -EPERM;
+	if (test_bit(I2C_ALF_IS_SUSPENDED, &adap->locked_flags))
+		return -ESHUTDOWN;
+	if (IS_ERR_OR_NULL(msgs) || (num != 1 && num != 2))
+		return -EINVAL;
+	for (i = 0; i < num; i++) {
+		if (msgs[i].addr != 0x3c || IS_ERR_OR_NULL(msgs[i].buf) ||
+		    !msgs[i].len || msgs[i].len > 257 ||
+		    msgs[i].flags != (i == 1 ? I2C_M_RD : 0))
+			return -EINVAL;
+	}
+	if (num == 2 && (msgs[0].len != 1 || msgs[1].len > 256))
+		return -EINVAL;
+	if (atomic) {
+		if (!irqs_disabled() || system_state <= SYSTEM_RUNNING)
+			return -EOPNOTSUPP;
+		return apple_s5l8940x_i2c_do_xfer(i2c, msgs, num);
+	}
+	if (irqs_disabled() || in_atomic())
+		return -EOPNOTSUPP;
+	mutex_lock(&i2c->mtx);
+	ret = apple_s5l8940x_i2c_do_xfer(i2c, msgs, num);
+	mutex_unlock(&i2c->mtx);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_s5l8940x_i2c_pmu_once);
--- /dev/null
+++ b/drivers/i2c/busses/a5-pmu-raw-filter.inc
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Generic algorithm path under existing adapter-lock contract. */
+static int apple_s5l8940x_i2c_raw_admit(struct apple_s5l8940x_i2c *i2c,
+				     struct i2c_msg *msgs, int num)
+{
+	int i;
+
+	lockdep_assert_held(&i2c->adap.bus_lock);
+	if (!i2c->pmu_owner)
+		return 0;
+	for (i = 0; i < num; i++) {
+		/* Controller shifts into the FIFO command word without masking:
+		 * an unsupported high address can alias the reserved 7-bit PMU. */
+		if (msgs[i].addr > 0x7f || (msgs[i].flags & I2C_M_TEN))
+			return -EINVAL;
+		if (msgs[i].addr == 0x3c)
+			return -EBUSY;
+	}
+	return 0;
+}
--- /dev/null
+++ b/drivers/mfd/p105-owned-adc6.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Private, uninstalled owner: real shared exclusion; physical admission closed. */
+#include <linux/err.h>
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include "p105-owned-adc6.h"
+
+struct p105_owned_adc6 {
+	struct mutex serial;
+	atomic_t stopping;
+	struct d1946_bank0_bus *bus;
+	struct p105_adc6 poll;
+	u64 epoch;
+};
+
+static int owned_valid(void *context, const struct p105_adc6_lease *lease)
+{
+	struct p105_owned_adc6 *o = context;
+
+	if (atomic_read(&o->stopping) || lease->owner_generation != o->epoch)
+		return -ESHUTDOWN;
+	return d1946_bank0_adc_valid(o->bus, o->epoch);
+}
+
+static int owned_hold(void *context, const struct p105_adc6_lease *lease, int error)
+{
+	struct p105_owned_adc6 *o = context;
+
+	(void)lease;
+	(void)error;
+	d1946_bank0_adc_invalidate(o->bus);
+	return 0;
+}
+
+static const struct p105_adc6_ops owned_ops = {
+	.valid = owned_valid,
+	.hold_unknown = owned_hold,
+};
+
+static const struct regmap_bus owned_bus = {
+	.write = d1946_bank0_adc_write,
+	.read = d1946_bank0_adc_read,
+	.max_raw_read = 2,
+	.max_raw_write = 1,
+};
+
+static void owned_regmap_exit(void *context)
+{
+	regmap_exit(context);
+}
+
+struct p105_owned_adc6 *p105_owned_adc6_create(struct device *dev,
+					    struct d1946_bank0_bus *bus)
+{
+	const struct regmap_config cfg = {
+		.reg_bits = 8,
+		.val_bits = 8,
+		.max_register = 0x45,
+		.cache_type = REGCACHE_NONE,
+		.disable_locking = true, /* Parent transaction holds both locks. */
+		.can_sleep = true,
+	};
+	struct p105_owned_adc6 *o;
+	int ret;
+
+	if (IS_ERR_OR_NULL(dev) || IS_ERR_OR_NULL(bus) ||
+	    IS_ERR_OR_NULL(bus->client) || dev != &bus->client->dev)
+		return ERR_PTR(-EINVAL);
+	o = devm_kzalloc(dev, sizeof(*o), GFP_KERNEL);
+	if (!o)
+		return ERR_PTR(-ENOMEM);
+	mutex_init(&o->serial);
+	atomic_set(&o->stopping, 0);
+	o->bus = bus;
+	ret = p105_adc6_init(&o->poll);
+	if (ret)
+		return ERR_PTR(ret);
+	/* NULL device prevents dev_get_regmap(parent, NULL) from seeing the
+	 * lockless private facade; disable_locking also disables its debugfs. */
+	o->poll.pmu = regmap_init(NULL, &owned_bus, bus, &cfg);
+	if (IS_ERR(o->poll.pmu))
+		return ERR_CAST(o->poll.pmu);
+	ret = devm_add_action_or_reset(dev, owned_regmap_exit, o->poll.pmu);
+	if (ret)
+		return ERR_PTR(ret);
+	o->poll.ops = &owned_ops;
+	o->poll.ctx = o;
+	ret = d1946_bank0_adc_claim(bus);
+	if (ret)
+		return ERR_PTR(ret);
+	ret = devm_add_action_or_reset(dev, p105_owned_adc6_close, o);
+	if (ret)
+		return ERR_PTR(ret);
+	/* Software ready, but begin denies EUCLEAN before any PMU access.
+	 * No current API can mint a physical first-quiescence witness. */
+	o->poll.enabled = true;
+	return o;
+}
+
+int p105_owned_adc6_read(struct p105_owned_adc6 *o, struct p105_adc6_sample *out)
+{
+	struct p105_adc6_lease lease;
+	int ret;
+
+	if (IS_ERR_OR_NULL(out))
+		return -EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (IS_ERR_OR_NULL(o))
+		return -EINVAL;
+	mutex_lock(&o->serial);
+	if (atomic_read(&o->stopping)) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	ret = d1946_bank0_adc_begin(o->bus, &o->epoch);
+	if (ret)
+		goto unlock;
+	lease = (struct p105_adc6_lease){
+		.owner_generation = o->epoch,
+		.exclusive_all_adc = true, /* Actual map+adapter locks held. */
+		.quiescence_proven = true, /* Begin checked parent's witness. */
+	};
+	ret = p105_adc6_read(&o->poll, &lease, out);
+	if (!ret)
+		ret = owned_valid(o, &lease);
+	if (ret) {
+		memset(out, 0, sizeof(*out));
+		d1946_bank0_adc_invalidate(o->bus);
+	}
+	d1946_bank0_adc_end(o->bus);
+unlock:
+	mutex_unlock(&o->serial);
+	return ret;
+}
+
+void p105_owned_adc6_close(void *context)
+{
+	struct p105_owned_adc6 *o = context;
+
+	atomic_set(&o->stopping, 1);
+	d1946_bank0_adc_invalidate(o->bus);
+	mutex_lock(&o->serial);
+	mutex_unlock(&o->serial);
+	/* Calling framework must have stopped new users before devres free.
+	 * This drains admitted calls, not escaped handle lifetime. */
+}
