+/* Only initialized opt-in partitions carry this constructor reference. */
+static void put_partition_constructor(struct mtd_info *mtd)
+{
+	if (!mtd->partition_constructor_ref)
+		return;
+	mtd->partition_constructor_ref = false;
+	if (mtd->driver_device_ref) {
+		put_device(&mtd->dev);
+		return;
+	}
+	/* _get_device failed before publication: there is no async driver ref.
+	 * Its final cleanup still owns an ID reservation. */
+	mutex_lock(&mtd_table_mutex);
+	put_device(&mtd->dev);
+	mutex_unlock(&mtd_table_mutex);
+}
+
+static void free_unpublished_partition(struct mtd_info *mtd)
+{
+	if (mtd->partition_constructor_ref)
+		put_partition_constructor(mtd);
+	else
+		free_partition(mtd);
+}
