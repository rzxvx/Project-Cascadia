--- a/drivers/usb/gadget/legacy/cdc2.c
+++ b/drivers/usb/gadget/legacy/cdc2.c
@@ -32,6 +32,20 @@
 USB_GADGET_COMPOSITE_OPTIONS();
 
 USB_ETHERNET_MODULE_PARAMETERS();
+
+/* Explicit declared USB2 configuration demand in mA; not measured power or
+ * charger permission. Default0 preserves the existing self-powered descriptor.
+ * Immutable while bound: increasing bus demand requires re-enumeration. */
+static unsigned int usb2_maxpower;
+module_param(usb2_maxpower, uint, 0444);
+MODULE_PARM_DESC(usb2_maxpower,
+		"Declared USB2 configuration demand: 0, 100 or 500 mA (default 0)");
+
+static int cdc_validate_maxpower(void)
+{
+	return usb2_maxpower == 0 || usb2_maxpower == 100 ||
+	       usb2_maxpower == 500 ? 0 : -EINVAL;
+}
 
 /*-------------------------------------------------------------------------*/
 
@@ -141,6 +155,16 @@
 	struct f_ecm_opts	*ecm_opts;
 	int			status;
 
+	status = cdc_validate_maxpower();
+	if (status)
+		return status;
+	/* This opt-in declaration is USB2 only. SuperSpeed encoding uses8mA
+	 * units; do not silently advertise rounded96/496mA for100/500 requests. */
+	if (usb2_maxpower && gadget->max_speed != USB_SPEED_FULL &&
+	    gadget->max_speed != USB_SPEED_HIGH)
+		return -EOPNOTSUPP;
+	cdc_config_driver.MaxPower = usb2_maxpower;
+
 	if (!can_support_ecm(cdev->gadget)) {
 		dev_err(&gadget->dev, "controller '%s' not usable\n",
 				gadget->name);
@@ -232,7 +256,22 @@
 	.unbind		= cdc_unbind,
 };
 
-module_usb_composite_driver(cdc_driver);
+/* Reject an invalid declaration before composite/UDC registration can bind. */
+static int __init cdc_init(void)
+{
+	int status = cdc_validate_maxpower();
+
+	if (status)
+		return status;
+	return usb_composite_probe(&cdc_driver);
+}
+module_init(cdc_init);
+
+static void __exit cdc_exit(void)
+{
+	usb_composite_unregister(&cdc_driver);
+}
+module_exit(cdc_exit);
 
 MODULE_DESCRIPTION(DRIVER_DESC);
 MODULE_AUTHOR("David Brownell");
