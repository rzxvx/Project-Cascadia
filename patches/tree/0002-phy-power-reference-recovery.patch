Subject: [PATCH] phy and USB: retain failed power references and recover before resume

A failed final PHY power-off leaves a reference owned by its consumer.
Reject new acquisitions until explicit cleanup succeeds, and track USB
roothub init and power references so resume cannot duplicate retained
references. Propagate suspend failures and require pending recovery even
on automatic HCD resume. Report failed teardown without pretending that
provider references were put.

Remove the set-mode unwind's unowned power-off. No provider register
sequence or successful core count operation is changed. Permanent
provider failures remain fail-closed; no forced reset or unconditional
cleanup is attempted.
---
--- a/drivers/phy/phy-core.c
+++ b/drivers/phy/phy-core.c
@@ -331,6 +331,13 @@
 	if (!phy)
 		goto out;
 
+	/* A failed final release leaves the existing reference owned. */
+	mutex_lock(&phy->mutex);
+	ret = phy->power_off_error;
+	mutex_unlock(&phy->mutex);
+	if (ret)
+		goto out;
+
 	if (phy->pwr) {
 		ret = regulator_enable(phy->pwr);
 		if (ret)
@@ -344,6 +351,11 @@
 	ret = 0; /* Override possible ret == -ENOTSUPP */
 
 	mutex_lock(&phy->mutex);
+	/* Recheck after acquiring PM/supply refs: off may have raced us. */
+	if (phy->power_off_error) {
+		ret = phy->power_off_error;
+		goto err_pwr_on;
+	}
 	if (phy->power_count == 0 && phy->ops->power_on) {
 		ret = phy->ops->power_on(phy);
 		if (ret < 0) {
@@ -382,14 +394,24 @@
 		return 0;
 
 	mutex_lock(&phy->mutex);
+	if (phy->power_count <= 0) {
+		mutex_unlock(&phy->mutex);
+		return -EINVAL;
+	}
 	if (phy->power_count == 1 && phy->ops->power_off) {
 		ret =  phy->ops->power_off(phy);
 		if (ret < 0) {
 			dev_err(&phy->dev, "phy poweroff failed --> %d\n", ret);
+			if (!phy->power_off_error)
+				phy->power_off_error = ret;
+			ret = phy->power_off_error;
 			mutex_unlock(&phy->mutex);
 			return ret;
 		}
 	}
+	/* Only a successful release clears the failed-off latch. */
+	if (phy->power_count == 1)
+		phy->power_off_error = 0;
 	--phy->power_count;
 	mutex_unlock(&phy->mutex);
 	phy_pm_runtime_put(phy);
