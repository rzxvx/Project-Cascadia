+	list_for_each_entry(entry, &phy_roothub->list, list)
+		entry->power_acquired = false;
+	list_for_each_entry(entry, &phy_roothub->list, list) {
+		if (entry->init_error) {
+			err = entry->init_error;
+			goto undo;
