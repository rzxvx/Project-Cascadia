+
+/* HCD serializes this wrapper's lifecycle; the generic PHY mutex protects
+ * the shared provider and its latched final-release error across consumers.
+ */
+static int usb_phy_roothub_release(struct usb_phy_roothub *entry)
+{
+	int err;
+
+	if (!entry->powered)
+		return 0;
+	err = phy_power_off(entry->phy);
+	if (err) {
+		if (!entry->power_off_error)
+			entry->power_off_error = err;
+		return entry->power_off_error;
+	}
+	entry->powered = false;
+	entry->power_off_error = 0;
+	return 0;
+}
+
+static int usb_phy_roothub_recover(struct usb_phy_roothub *root)
+{
+	struct usb_phy_roothub *entry;
+	int err;
+
+	list_for_each_entry_reverse(entry, &root->list, list) {
+		if (!entry->power_off_error)
+			continue;
+		err = usb_phy_roothub_release(entry);
+		if (err)
+			return err;
+	}
+	return 0;
+}
+
+bool usb_phy_roothub_needs_resume(struct usb_phy_roothub *root)
+{
+	struct usb_phy_roothub *entry;
+
+	if (!root)
+		return false;
+	list_for_each_entry(entry, &root->list, list)
+		if (!entry->initialized || !entry->powered ||
+		    entry->init_error || entry->power_off_error)
+			return true;
+	return false;
+}
+EXPORT_SYMBOL_GPL(usb_phy_roothub_needs_resume);
