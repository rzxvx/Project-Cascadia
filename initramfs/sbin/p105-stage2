#!/bin/sh
#
# P105AP stage 2: the services, and the shell of last resort.
#
# Split out of /init on 2026-09-17 so that the root filesystem can change
# underneath it.  Stage 1 (/init in the initramfs) does everything that must
# happen before a root is chosen -- mounts, clock, USB, network -- and then
# execs this, either in the RAM rootfs or, after switch_root, on the NFS root.
# Whichever root wins, this file is the one that starts the services, so there
# is exactly one copy of that logic and both paths exercise it.
#
# Runs as PID 1.  It must never return: PID 1 exiting is a kernel panic.

msg() { echo "$*" > /dev/kmsg; }

# The kernel starts PID 1 with HOME=/ and TERM=linux and nothing else -- no
# PATH at all, so ash falls back to its built-in one, which has no
# /usr/local/bin: `desktop` ran over ssh (a login shell, /etc/profile) and was
# "not found" on the glass.  And HOME=/ would have put an XFCE started from the
# glass in /.config.  Everything this starts inherits these.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root USER=root LOGNAME=root SHELL=/bin/sh

IP_DEV="${IP_DEV:-10.55.0.2}"

ROOTTYPE=$(awk '$2=="/"{print $3; exit}' /proc/mounts 2>/dev/null)
msg "P105: stage2 on $ROOTTYPE root"

# Lost when /init was split: the old one-file init set this and the new stage 1
# did not inherit it, so the prompt went back to "(none)".  It lives here rather
# than in stage 1 because it is a property of the system that booted, not of
# choosing which one to boot.
hostname -F /etc/hostname 2>/dev/null || hostname p105 2>/dev/null || true

# ------------------------------------------------------- ACM console (tty) --
# getty, not a bare shell: it takes the tty as its controlling terminal and
# exits on hangup, so there is exactly one reader on /dev/ttyGS0 at a time.
# Two readers is what made the console eat every other keystroke.
#
# And out of RAM.  On an NFS root every binary is paged in from the server, the
# shell included, so when the NFS client wedged -- after a while idle, the Mac's
# nfsd listening and no connection ever coming back -- ssh, this console and the
# shell on the glass all hung with it, and nothing was left to see why from.
# busybox.static in a tmpfs needs nothing from the root: the respawn loop, getty
# and the shell all run from there, its applets first on PATH (anything else
# still reachable by the root's own PATH while the root is well).
RESCUE=/run/rescue
if [ -x /bin/busybox.static ] && mkdir -p "$RESCUE" \
   && mount -t tmpfs -o size=4m,mode=755 rescue "$RESCUE" \
   && cp /bin/busybox.static "$RESCUE/busybox" && mkdir -p "$RESCUE/bin" \
   && "$RESCUE/busybox" --install -s "$RESCUE/bin"; then
    cat > "$RESCUE/acm" <<'ACM'
n=0
while [ $n -lt 500 ]; do
    n=$((n+1))
    [ -e /dev/ttyGS0 ] && getty -n -l sh 115200 ttyGS0 2>/dev/null
    sleep 1
done
echo "P105: ACM respawn limit reached, giving up" > /dev/kmsg
ACM
    PATH="$RESCUE/bin:/usr/sbin:/usr/bin:/sbin:/bin" "$RESCUE/busybox" sh "$RESCUE/acm" &
    msg "P105: ACM console started on ttyGS0, running from RAM ($RESCUE)"
else
    (
        n=0
        while [ $n -lt 500 ]; do
            n=$((n+1))
            [ -e /dev/ttyGS0 ] && /sbin/getty -n -l /bin/sh 115200 ttyGS0 2>/dev/null
            sleep 1
        done
        msg "P105: ACM respawn limit reached, giving up"
    ) &
    msg "P105: ACM console started on ttyGS0 (no busybox.static: it hangs with an NFS root)"
fi

# ----------------------------------------------------------- ssh (dropbear) --
# The ed25519 host key is baked into the image by ./cascadia build and stage 1
# carries it onto an NFS root, so the device has one identity on every boot and
# on both roots.  -R only fills in key types that are missing -- which is all of
# them on an image built where there was no ssh-keygen, and then the key changes
# every boot of the RAM root again.
if [ -x /usr/sbin/dropbear ]; then
    mkdir -p /etc/dropbear
    # -E logs to stderr; /dev/kmsg puts that in dmesg and the UART capture,
    # where every other verdict already is.  It used to go to /dev/null, which
    # cost a whole flash cycle to diagnose a missing devpts.
    /usr/sbin/dropbear -R -E -p "$IP_DEV:22" 2>/dev/kmsg &
    msg "P105: dropbear on $IP_DEV:22"
else
    msg "P105: dropbear not installed (run scripts/add-dropbear.sh)"
fi

# ------------------------------------------------------------------- udev ---
# Nothing in this boot needs udev, but a desktop does: Xorg and Wayland find
# input devices through libinput, and libinput through udev.  Without it XFCE
# came up and ignored the glass; with udevd started by hand touch worked as a
# pointer (teutekeune, 2026-09-25).  So when eudev is on the root (apk add
# eudev) it is started here, before touch, so the touchscreen is announced to
# it as it appears, and everything the kernel already has is replayed.
if command -v udevd >/dev/null 2>&1 && command -v udevadm >/dev/null 2>&1; then
    udevd --daemon 2>/dev/null
    udevadm trigger --action=add 2>/dev/null
    udevadm settle -t 10 2>/dev/null
    msg "P105: udevd started"
fi

# ------------------------------------------------------------ touch (z2) ---
# z2-boot brings the digitizer up the way iOS does, hands it to the kernel and
# holds it: /dev/input/event0 from then on.  It needs the digitizer's firmware,
# which ./cascadia firmware takes out of the IPSW, and a calibration: the
# default one in initramfs/, or this iPad's own from ./cascadia mtcal.
if [ -x /sbin/z2-boot ] && [ -s /lib/firmware/mtcal.bin ] && [ -s /lib/firmware/P105.mtprops ]; then
    setsid /sbin/z2-boot -c /lib/firmware/mtcal.bin >/tmp/z2boot.log 2>&1 </dev/null &
    msg "P105: touch -- z2-boot started (/tmp/z2boot.log)"
else
    msg "P105: touch -- no /lib/firmware/P105.mtprops or mtcal.bin, not started (./cascadia firmware)"
fi

# --------------------------------------------------- on-screen keyboard -----
# fbkeyboard draws a keyboard at the bottom of the framebuffer and types into
# the console through uinput -- the only keyboard there is, since the one USB
# port is the gadget.  Not baked into the image: `apk add fbkeyboard` on the
# device, and it starts from here on the next boot.  The touchscreen is found
# by name, not by event number: fbkeyboard's own uinput device is an event node
# too.
if command -v fbkeyboard >/dev/null 2>&1; then
    ts=
    for n in /sys/class/input/event*; do
        [ "$(cat "$n/device/name" 2>/dev/null)" = "S5L8940X Capacitive TouchScreen" ] \
            && ts=/dev/input/${n##*/} && break
    done
    font=
    for f in /usr/share/fonts/dejavu/DejaVuSans.ttf /usr/share/fonts/*/*.ttf; do
        [ -f "$f" ] && font=$f && break
    done
    if [ -n "$ts" ] && [ -n "$font" ]; then
        setsid fbkeyboard -d "$ts" -f "$font" >/tmp/fbkeyboard.log 2>&1 </dev/null &
        # For `desktop`, which stops it while X owns the framebuffer and
        # starts it again, the same way, when the session ends.
        echo "-d $ts -f $font" > /run/fbkeyboard.args
        msg "P105: fbkeyboard on $ts"
    else
        msg "P105: fbkeyboard installed, but no touchscreen ($ts) or font ($font)"
    fi
fi

# --------------------------------------------------------- glass fallback ---
# Always reached, and independent of USB: if the gadget never comes up this is
# still a real shell on the panel.
msg "P105: stage2 done, shell on tty0"
# PID 1 from here on, and a shell exec'd as PID 1 got two things wrong:
# typing exit on the glass ended PID 1, which is a kernel panic, and it never
# reaped the orphans the kernel hands to PID 1 -- 127 zombies after an hour of
# a desktop (2026-09-25).  So the glass shell is a child, started again
# whenever it ends, and PID 1 waits on it: ash's wait is waitpid(-1), so every
# orphan that exits in the meantime is reaped on the way.  No setsid: busybox's
# forks when its caller leads a process group, and $! would then be a process
# that is already gone -- a new shell every second.
# A login shell, like ssh's: /etc/profile, the prompt, ~/.profile.
cd "$HOME" 2>/dev/null || cd /
while :; do
    /bin/sh -l </dev/tty0 >/dev/tty0 2>&1 &
    wait $!
    sleep 1
done
