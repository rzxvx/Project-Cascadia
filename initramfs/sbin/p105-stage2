#!/bin/sh
#
# P105AP stage 2: the services, and the shell of last resort.
#
# Split out of /init on 2026-09-17 so that the root filesystem can change
# underneath it.  Stage 1 (/init in the initramfs) does everything that must
# happen before a root is chosen -- mounts, clock, USB, network -- and then
# execs this, either in the RAM rootfs or, after switch_root, on the NFS root.
# Whichever root wins, this file is the one that starts the services, so there
# is exactly one copy of that logic and both paths exercise it.
#
# Runs as PID 1.  It must never return: PID 1 exiting is a kernel panic.

msg() { echo "$*" > /dev/kmsg; }

IP_DEV="${IP_DEV:-10.55.0.2}"

ROOTTYPE=$(awk '$2=="/"{print $3; exit}' /proc/mounts 2>/dev/null)
msg "P105: stage2 on $ROOTTYPE root"

# Lost when /init was split: the old one-file init set this and the new stage 1
# did not inherit it, so the prompt went back to "(none)".  It lives here rather
# than in stage 1 because it is a property of the system that booted, not of
# choosing which one to boot.
hostname -F /etc/hostname 2>/dev/null || hostname p105 2>/dev/null || true

# ------------------------------------------------------- ACM console (tty) --
# getty, not a bare shell: it takes the tty as its controlling terminal and
# exits on hangup, so there is exactly one reader on /dev/ttyGS0 at a time.
# Two readers is what made the console eat every other keystroke.
(
    n=0
    while [ $n -lt 500 ]; do
        n=$((n+1))
        [ -e /dev/ttyGS0 ] && /sbin/getty -n -l /bin/sh 115200 ttyGS0 2>/dev/null
        sleep 1
    done
    msg "P105: ACM respawn limit reached, giving up"
) &
msg "P105: ACM console started on ttyGS0"

# ----------------------------------------------------------- ssh (dropbear) --
# The ed25519 host key is baked into the image by ./cascadia build and stage 1
# carries it onto an NFS root, so the device has one identity on every boot and
# on both roots.  -R only fills in key types that are missing -- which is all of
# them on an image built where there was no ssh-keygen, and then the key changes
# every boot of the RAM root again.
if [ -x /usr/sbin/dropbear ]; then
    mkdir -p /etc/dropbear
    # -E logs to stderr; /dev/kmsg puts that in dmesg and the UART capture,
    # where every other verdict already is.  It used to go to /dev/null, which
    # cost a whole flash cycle to diagnose a missing devpts.
    /usr/sbin/dropbear -R -E -p "$IP_DEV:22" 2>/dev/kmsg &
    msg "P105: dropbear on $IP_DEV:22"
else
    msg "P105: dropbear not installed (run scripts/add-dropbear.sh)"
fi

# ------------------------------------------------------------ touch (z2) ---
# z2-boot brings the digitizer up the way iOS does, hands it to the kernel and
# holds it: /dev/input/event0 from then on.  It needs this iPad's calibration
# (syscfg MtCl) -- tools/mtdump saves it from iOS, and
# build/keep/lib/firmware/mtcal.bin puts it in the image.
if [ -x /sbin/z2-boot ] && [ -s /lib/firmware/mtcal.bin ]; then
    setsid /sbin/z2-boot -c /lib/firmware/mtcal.bin >/tmp/z2boot.log 2>&1 </dev/null &
    msg "P105: touch -- z2-boot started (/tmp/z2boot.log)"
else
    msg "P105: touch -- no /lib/firmware/mtcal.bin, not started (tools/mtdump)"
fi

# --------------------------------------------------------- glass fallback ---
# Always reached, and independent of USB: if the gadget never comes up this is
# still a real shell on the panel.
msg "P105: stage2 done, shell on tty0"
exec /bin/sh </dev/tty0 >/dev/tty0 2>&1
