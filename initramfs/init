#!/bin/sh
#
# P105AP (iPad mini 1 / Apple A5) initramfs init.
#
# Trimmed 2026-09-16.  The WDT layout probe, the touch event0 reader and the
# 12-iteration register-dump loop all served their purpose and are gone; the
# findings live in docs/CASCADIA-CHEATSHEET.md.  What is left has one job:
# bring up the g_cdc gadget's two halves -- a CDC ACM console and a CDC ECM
# network link -- and say plainly whether each one came up.

mount -t proc  proc  /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

msg() { echo "$*" > /dev/kmsg; }

# READ THIS BEFORE ADDING A sleep ANYWHERE ABOVE THE USB DANCE.
#
# The system tick IS the dwc2 Start-of-Frame interrupt.  SOFs only arrive while
# the host has the bus up, so for as long as the device is soft-disconnected
# there are no ticks, jiffies are frozen, and sleep()/msleep() NEVER RETURN.
# A "sleep 1" between the disconnect and the reconnect below is an instant,
# silent hang with no console left to debug it from.
#
# settle() is a pure CPU spin and is therefore the only safe delay while the
# link is down.  Use sleep only after the UDC reports "configured".
#
# MEASURED, not guessed: the 2026-09-16 boot log timestamps the disconnect at
# 2.88 s and "configured after 2 polls" at 26.77 s, so 200000 iterations of ash
# arithmetic cost about 12 SECONDS on this 1 GHz A9 -- roughly 60 us each, not
# the "~200 ms" an older comment claimed.  That one number was the entire slow
# USB bring-up.  5000 iterations is about 300 ms, which is all the host needs
# to notice the device went away.
settle() { s_i=0; while [ $s_i -lt 5000 ]; do s_i=$((s_i+1)); done; }

# Shorter spin for the poll loop: ~100 ms, so a normal enumeration costs a few
# hundred milliseconds instead of half a minute, and the 150-poll ceiling still
# bounds a failed one at ~15 s.
blip() { b_i=0; while [ $b_i -lt 1700 ]; do b_i=$((b_i+1)); done; }

msg "P105: init start"

# ---------------------------------------------------------------- verdicts --
# One line each from the three subsystems that have to be alive for anything
# else to work.  If the box is dead, this is the first thing to read.
dmesg 2>/dev/null | grep -E "AIC1-REARM|LATE-SMOKE|SOF-TIMER|CALIB:|apple-wdt" \
    | while read x; do msg "  V: $x"; done

# --------------------------------------------------------------- usb reset --
# iBEC leaves the port in its own state; a clean disconnect/reconnect makes the
# host throw that away and enumerate us fresh as the Linux gadget.
msg "P105: forcing USB re-enumeration"
for u in /sys/class/udc/*/soft_connect; do echo disconnect > "$u" 2>/dev/null; done
settle
for u in /sys/class/udc/*/soft_connect; do echo connect > "$u" 2>/dev/null; done

# Poll for the host to finish configuring us.  Bounded, and spin-based rather
# than sleep-based because the tick only comes back once this succeeds.
n=0
while [ $n -lt 150 ]; do
    n=$((n+1))
    st=""
    for u in /sys/class/udc/*/state; do st=$(cat "$u" 2>/dev/null); done
    [ "$st" = "configured" ] && break
    blip
done
msg "P105: UDC state=$st after $n polls"

for u in /sys/class/udc/*; do
    [ -e "$u" ] || continue
    msg "  UDC: $(basename "$u") state=$(cat "$u/state" 2>/dev/null)" \
        "function=$(cat "$u/function" 2>/dev/null)" \
        "speed=$(cat "$u/current_speed" 2>/dev/null)"
done

# ------------------------------------------------------------------- usb0 ---
# g_cdc gives us both halves of the port: usb0 (CDC ECM) and /dev/ttyGS0 (ACM).
# Static addressing on purpose -- there is no DHCP server in this initramfs and
# this is a point-to-point link, so a fixed /24 is simpler than anything else.
# 10.55.0.0/24 is picked to stay clear of the usual home ranges.
#
#   device : 10.55.0.2
#   host   : 10.55.0.1   <- set this on the Mac, see README
IP_DEV=10.55.0.2
IP_PFX=24

# Loopback comes up DOWN in a bare initramfs -- nothing brings it up for us.
# Anything that talks to 127.0.0.1 (and that is most daemons) fails until it is
# up, and the failure looks like the daemon is broken rather than the interface.
ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null

# "(none)" in the shell prompt and in uname is just an unset hostname.
hostname p105 2>/dev/null

msg "P105: net interfaces: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
if [ -d /sys/class/net/usb0 ]; then
    ip link set usb0 up 2>/dev/null || ifconfig usb0 up 2>/dev/null
    ip addr add "$IP_DEV/$IP_PFX" dev usb0 2>/dev/null \
        || ifconfig usb0 "$IP_DEV" netmask 255.255.255.0 2>/dev/null
    msg "  usb0: addr=$(ip -o -4 addr show usb0 2>/dev/null | awk '{print $4}')" \
        "carrier=$(cat /sys/class/net/usb0/carrier 2>/dev/null)" \
        "oper=$(cat /sys/class/net/usb0/operstate 2>/dev/null)" \
        "mac=$(cat /sys/class/net/usb0/address 2>/dev/null)"
else
    msg "  usb0: MISSING -- g_cdc did not create the ECM netdev."
    msg "  usb0: check CONFIG_USB_CDC_COMPOSITE=y and that G_SERIAL is off."
fi

msg "P105: ACM nodes: $(ls -d /dev/ttyGS* 2>/dev/null | tr '\n' ' ')"
grep -E "^ *(50|51):" /proc/interrupts 2>/dev/null | while read x; do msg "  IRQ: $x"; done

# ------------------------------------------------------- ACM console (tty) --
# getty, not a bare shell: it takes the tty as its controlling terminal and
# exits on hangup, so there is exactly one reader on /dev/ttyGS0 at a time.
# Two readers is what made the console eat every other keystroke.
(
    n=0
    while [ $n -lt 500 ]; do
        n=$((n+1))
        [ -e /dev/ttyGS0 ] && /sbin/getty -n -l /bin/sh 115200 ttyGS0 2>/dev/null
        sleep 1
    done
    msg "P105: ACM respawn limit reached, giving up"
) &
msg "P105: ACM console started on ttyGS0"

# ----------------------------------------------------------- ssh (dropbear) --
# Installed by scripts/add-dropbear.sh, which is a manual step: Alpine armhf
# binaries cannot be executed on an Apple Silicon host (no AArch32 EL0), so the
# .apk is unpacked rather than installed, and there is no way to run apk itself.
# Absent dropbear this whole block is skipped and the nc shell below stands in.
#
# -R generates host keys on demand.  The rootfs is a ramfs, so those keys die
# with the boot and the host key changes every time -- connect with
#   ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@10.55.0.2
# or SSH will refuse on the mismatch.
if [ -x /usr/sbin/dropbear ] && [ -d /sys/class/net/usb0 ]; then
    mkdir -p /etc/dropbear
    /usr/sbin/dropbear -R -E -p "$IP_DEV:22" 2>/dev/null &
    msg "P105: dropbear on $IP_DEV:22"
else
    msg "P105: dropbear not installed (run scripts/add-dropbear.sh)"
fi

# ------------------------------------------------- shell over the ECM link --
# This busybox has no telnetd and no sshd (they are separate Alpine packages),
# so this is the FIFO trick over plain nc.  Cleartext and unauthenticated --
# acceptable only because the link is a point-to-point USB cable with exactly
# one peer.  Replace with dropbear once the initramfs grows it.
if [ -d /sys/class/net/usb0 ]; then
    (
        rm -f /tmp/ncsh; mkfifo /tmp/ncsh 2>/dev/null || exit 0
        while : ; do
            # -i matters: with stdin coming from a pipe rather than a tty, ash
            # decides it is non-interactive and prints no prompt at all, so the
            # client looks hung when it is actually fine.  -i forces the prompt.
            nc -l -p 2323 < /tmp/ncsh 2>/dev/null | /bin/sh -i > /tmp/ncsh 2>&1
            sleep 1
        done
    ) &
    msg "P105: nc shell on $IP_DEV:2323"
fi

# --------------------------------------------------------- glass fallback ---
# Always reached, and independent of USB: if the gadget never comes up this is
# still a real shell on the panel.
msg "P105: init done, dropping to shell on tty0"
exec /bin/sh </dev/tty0 >/dev/tty0 2>&1
