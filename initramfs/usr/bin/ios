#!/bin/sh
# ios -- the iPad's iOS partitions from Linux, read-only.  Dual boot, the
# Linux side of it: iOS stays as it is, Linux looks at its files.
#
#   ios                 where things stand, and what to type next
#   ios mount [Data]    serve iOS's System partition (and Data, if asked) off
#                       the NAND and mount it read-only on /mnt/ios
#   ios umount          unmount and stop serving
#   ios scan            catch up with the NAND after iOS has run (mount does
#                       this too)
#   ios parts           iOS's partitions
#
# /sbin/iosnand does the work (tools/nand/iosnand.c): it reads the NAND,
# follows iOS's FTL to disk0 and its LwVM partitions, and serves them as
# /dev/nbd0, /dev/nbd1.  It never writes to the NAND.  The first run reads
# every page once (upstream PIO ~12-15 minutes) and keeps pages.v2 under
# /var/lib/iosnand (IOSNAND_CACHE overrides). PIO can then rescan changed
# blocks; IOSNAND_BACKEND=mtd reads every page on every start. Cache-file
# validation and network I/O also contribute to startup time.
# Data is encrypted file by file (iOS content protection): it can be served,
# but it does not mount as HFS+.  Installed from the image into /usr/bin on
# every boot (initramfs/init).

MNT=/mnt/ios
RUN=/run/ios
LOG=$RUN/iosnand.log
CACHE=${IOSNAND_CACHE-/var/lib/iosnand/pages.v2}
BACKEND=${IOSNAND_BACKEND-pio}

say() { printf '%s\n' "$*"; }
die() { printf 'ios: %s\n' "$*" >&2; exit 1; }

serving() { /sbin/iosnandctl status "$RUN/pid" >/dev/null 2>&1; }
mounted() { grep -q " $MNT hfsplus " /proc/mounts 2>/dev/null; }

need() {
    [ -x /sbin/iosnand ] || die "no /sbin/iosnand in this image"
    [ -x /sbin/iosnandctl ] || die "no /sbin/iosnandctl in this image"
    [ -e /dev/nbd0 ] || die "no /dev/nbd0: this kernel was built without CONFIG_BLK_DEV_NBD"
    grep -q hfsplus /proc/filesystems || die "this kernel has no HFS+ (CONFIG_HFSPLUS_FS)"
}

scan_notice() {
    case "$BACKEND" in
        mtd)
            say "MTD backend: every start reads the full NAND map (cache: $CACHE)."
            say "(full scan timing is unverified; cached PIO timings do not apply)" ;;
        pio)
            if [ -f "$CACHE" ]; then
                say "PIO backend: validating $CACHE and checking for changed blocks."
            else
                say "PIO backend: no v2 cache at $CACHE; the first scan reads the whole NAND."
                say "(earlier upstream PIO full scan: ~12-15 minutes)"
            fi ;;
        *) say "Invalid IOSNAND_BACKEND: iosnand requires pio or mtd." ;;
    esac
}

status() {
    if mounted; then
        say "iOS System is mounted read-only on $MNT ($(df -h $MNT | awk 'NR==2 { print $3 " used" }'))."
        say "  ls $MNT            look around"
        say "  ios umount         let go of it"
    elif serving; then
        say "iosnand is running (log: $LOG) but nothing is mounted."
        say "  ios umount         stop it"
    else
        say "iOS's partitions are not mounted."
        scan_notice
        say "  ios mount          System, read-only, on $MNT"
        say "  ios parts          what is there"
    fi
}

start() {
    need
    serving && die "already serving (ios umount first)"
    # Do not chmod/trust an old or symlinked runtime directory.
    if ! [ -e "$RUN" ] && ! [ -L "$RUN" ]; then
        mkdir -m 0700 "$RUN" || die "cannot create private $RUN"
    fi
    /sbin/iosnandctl check-directory "$RUN/pid" || die "$RUN must be root-owned mode 0700"
    if [ -e "$RUN/pid" ] || [ -L "$RUN/pid" ]; then
        /sbin/iosnandctl clean "$RUN/pid" || die "PID record is active or untrusted; retained"
    fi
    mkdir -p "$MNT"
    scan_notice
    /sbin/iosnand --pid-record "$RUN/pid" serve System "$@" > "$LOG" 2>&1 &
    # Registration occurs after exec and before NAND opens. This bounded wait
    # covers registration, not the full scan (whose timing is unverified).
    i=0
    while ! serving && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
    serving || { cat "$LOG" >&2; die "iosnand did not register (no numeric-PID fallback)"; }
    # A global/stale positive nbd0 size is not proof this daemon owns it.
    # Ready checks this generation's worker PIDfd and the kernel pid attribute.
    while ! /sbin/iosnandctl ready "$RUN/pid" >/dev/null 2>&1; do
        serving || { cat $LOG >&2; die "iosnand stopped"; }
        sleep 1
    done
    grep -v "blocks read," $LOG
    mount -t hfsplus -o ro /dev/nbd0 $MNT || { stop_serving; die "mount failed (dmesg | tail)"; }
    say "iOS $(sed -n '/ProductVersion/{n;s/.*<string>\(.*\)<\/string>.*/\1/p}' \
        $MNT/System/Library/CoreServices/SystemVersion.plist 2>/dev/null) System on $MNT, read-only."
    [ -b /dev/nbd1 ] && [ "$(cat /sys/block/nbd1/size 2>/dev/null)" -gt 0 ] 2>/dev/null &&
        say "Data is on /dev/nbd1 (encrypted by iOS: raw only)."
    return 0
}

stop_serving() {
    [ -x /sbin/iosnandctl ] || die "no /sbin/iosnandctl in this image"
    if serving; then
        /sbin/iosnandctl stop "$RUN/pid" || die "pidfd stop refused; record retained"
        i=0
        while serving && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
        serving && die "iosnand has not exited; record retained"
    fi
    if [ -e "$RUN/pid" ] || [ -L "$RUN/pid" ]; then
        /sbin/iosnandctl clean "$RUN/pid" || die "PID record is untrusted or not expired; retained"
    fi
}

case "$1" in
    ""|status)  status ;;
    mount)      shift; start "$@" ;;
    umount|unmount)
                mounted && { umount $MNT || die "$MNT is busy"; }
                stop_serving
                say "iOS unmounted." ;;
    scan)       need; serving && die "iosnand is serving; ios umount first"; iosnand scan ;;
    parts)      need; serving && die "iosnand is serving; ios umount first"; iosnand parts ;;
    *)          sed -n '/^#   ios/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
