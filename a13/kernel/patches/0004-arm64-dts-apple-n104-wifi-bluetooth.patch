diff --git a/arch/arm64/boot/dts/apple/t8030-n104.dts b/arch/arm64/boot/dts/apple/t8030-n104.dts
--- a/arch/arm64/boot/dts/apple/t8030-n104.dts
+++ b/arch/arm64/boot/dts/apple/t8030-n104.dts
@@ -212,5 +212,96 @@
 				touchscreen-inverted-y;
 			};
 		};
+	};
+};
+
+/*
+ * Wi-Fi and Bluetooth: one BCM4378 module ("moana") on apcie port 2, as on
+ * the D421 (Hoolock's t8030-d421.dts). The ADT's pci-bridge2 matches port02
+ * in t8030.dtsi (clkreq GPIO 33, PERST GPIO 35). m1n1 fills the antenna SKU
+ * and the calibration when iBoot put them in the ADT; this boot chain does
+ * not, so `a13/cascadia pack` writes them from the phone's own syscfg
+ * (WMac, WSKU, WCAL, BMac) -- see boot/package.sh.
+ */
+/ {
+	aliases {
+		bluetooth0 = &bluetooth0;
+		wifi0 = &wifi0;
+	};
+};
+
+/*
+ * The PCIe block's power, from the ADT: apcie's clock-gates are APCIE,
+ * APCIE_GP, APCIE_ST and PCIE_REF (ids 125, 126, 128, 60), and APCIE's parent
+ * is IMX. t8030.dtsi has APCIE and APCIE_GP only: with a full iBoot the rest
+ * is left on, with this boot chain PCIE_REF is off and the DART's first
+ * register read is an SError.
+ */
+&pmgr {
+	ps_pcie_ref: power-controller@80178 {
+		compatible = "apple,t8030-pmgr-pwrstate",
+			     "apple,t8103-pmgr-pwrstate";
+		reg = <0x80178 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "pcie_ref";
+	};
+
+	ps_imx: power-controller@802d0 {
+		compatible = "apple,t8030-pmgr-pwrstate",
+			     "apple,t8103-pmgr-pwrstate";
+		reg = <0x802d0 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "imx";
+		apple,always-on;	/* the NVMe (iOS's disk) sits behind it too */
+	};
+};
+
+&ps_apcie {
+	power-domains = <&ps_imx>;
+};
+
+&ps_apcie_gp {
+	power-domains = <&ps_apcie>, <&ps_pcie_ref>;
+};
+
+/*
+ * m1n1 brings the controller up -- the PHY, the PMGR fuses and the ADT's
+ * apcie tunables (Cascadia's m1n1 patch 0005, after iOS's AppleT803xPCIe);
+ * pcie-apple then does the port: refclk, PERST, link training.
+ */
+&pcie_dart2 {
+	status = "okay";
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&port02 {
+	bus-range = <1 1>;
+	/*
+	 * The module's power (WL_REG_ON): the ADT's /amfm function-reg_on, SMC
+	 * GPIO key gP11, written as ARG | 1 by pcie-apple (patch 0006) before
+	 * the link comes up. A full iBoot leaves it on; this boot chain does not.
+	 */
+	apple,power-function = <&smc 0x67503131 0x0>;
+
+	wifi0: wifi@0,0 {
+		compatible = "pci14e4,4425";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-mac-address = [00 00 00 00 00 00];
+		apple,antenna-sku = "XX";
+		brcm,board-type = "apple,moana";
 	};
+
+	bluetooth0: bluetooth@0,1 {
+		compatible = "pci14e4,5f69";
+		reg = <0x10100 0x0 0x0 0x0 0x0>;
+		/* To be filled by the loader */
+		local-bd-address = [00 00 00 00 00 00];
+		brcm,board-type = "apple,moana";
+	};
 };
