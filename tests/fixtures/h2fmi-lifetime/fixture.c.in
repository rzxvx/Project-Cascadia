static int h2fmi_read_raw_page(struct h2fmi*f,struct h2fmi_bus*b,u32 row,u8*st){
 (void)f;(void)row;assert(resources_available);hardware_reads++;
 if(block_read){pthread_mutex_lock(&progress_lock);entered_read=true;pthread_cond_broadcast(&progress_cv);while(!allow_read)pthread_cond_wait(&progress_cv,&progress_lock);pthread_mutex_unlock(&progress_lock);}
 memset(b->page,0xa5,H2FMI_PAGE_RAW);*st=0x40;return 0;
}
