/* GEOMETRY */
struct rw_semaphore { pthread_rwlock_t lock; };
static void init_rwsem(struct rw_semaphore *s) { assert(!pthread_rwlock_init(&s->lock,NULL)); }
static void down_read(struct rw_semaphore *s) { assert(!pthread_rwlock_rdlock(&s->lock)); }
static void up_read(struct rw_semaphore *s) { assert(!pthread_rwlock_unlock(&s->lock)); }
static void down_write(struct rw_semaphore *s) { assert(!pthread_rwlock_wrlock(&s->lock)); }
static void up_write(struct rw_semaphore *s) { assert(!pthread_rwlock_unlock(&s->lock)); }
struct mutex { pthread_mutex_t lock; };
static struct mutex mtd_table_mutex;
static _Thread_local bool fake_table_owned, fake_work_draining;
static void fake_drain_work(void);
struct work_struct { void(*fn)(struct work_struct *); bool queued; };
#define INIT_WORK(w,f) ((w)->fn=(f),(w)->queued=false)
static struct work_struct *fake_work_queue[128];
static unsigned fake_work_count;
static pthread_mutex_t fake_work_lock=PTHREAD_MUTEX_INITIALIZER;
static bool schedule_work(struct work_struct *w) {
 pthread_mutex_lock(&fake_work_lock);assert(!w->queued&&fake_work_count<128);
 w->queued=true;fake_work_queue[fake_work_count++]=w;pthread_mutex_unlock(&fake_work_lock);
 if(!fake_table_owned)fake_drain_work();
 return true;
}
static void fake_drain_work(void) {
 if(fake_work_draining)return;
 fake_work_draining=true;
 for(;;){pthread_mutex_lock(&fake_work_lock);
  if(!fake_work_count){pthread_mutex_unlock(&fake_work_lock);break;}
  struct work_struct*w=fake_work_queue[0];memmove(fake_work_queue,fake_work_queue+1,--fake_work_count*sizeof(*fake_work_queue));
  w->queued=false;void(*fn)(struct work_struct*)=w->fn;pthread_mutex_unlock(&fake_work_lock);fn(w);
 }
 fake_work_draining=false;
}

static void mutex_init(struct mutex *m) { assert(!pthread_mutex_init(&m->lock,NULL)); }
static void mutex_lock(struct mutex *m) { assert(!pthread_mutex_lock(&m->lock));if(m==&mtd_table_mutex)fake_table_owned=true; }
static void mutex_unlock(struct mutex *m) { if(m==&mtd_table_mutex)fake_table_owned=false;assert(!pthread_mutex_unlock(&m->lock));if(m==&mtd_table_mutex)fake_drain_work(); }
typedef struct { int locked; } spinlock_t;
static void spin_lock_init(spinlock_t *s) { s->locked=0; }
static void spin_lock(spinlock_t *s) { assert(!s->locked);s->locked=1; }
static void spin_unlock(spinlock_t *s) { assert(s->locked);s->locked=0; }
struct kref { unsigned int count; };
static void kref_init(struct kref *k) { k->count=1; }
static void kref_get(struct kref *k) { assert(k->count); k->count++; }
static void kref_put(struct kref *k,void(*release)(struct kref *)) { assert(k->count);if(!--k->count)release(k); }
struct device_node {int unused;};
struct device {bool registered;unsigned refs;unsigned long devt;void *parent,*data,*class;struct device_node *of_node;const void *type;};
struct platform_device {struct device dev;void *data;};
struct nvmem_device {void *priv;};
struct nvmem_config {
 int id;struct device *dev;const char *name;void *owner;
 bool add_legacy_fixed_of_cells,read_only,root_only,ignore_wp;
 int(*reg_read)(void*,unsigned int,void*,size_t);
 size_t size;int word_size,stride;void *priv;
};
#define NVMEM_DEVID_NONE -1
struct mtd_req_stats {unsigned uncorrectable_errors,corrected_bitflips,max_bitflips;};
struct mtd_oob_ops {size_t len,retlen,ooblen,oobretlen;u32 ooboffs;u8 *datbuf,*oobbuf;struct mtd_req_stats *stats;};
struct mtd_info {
 void *priv,*owner;const char *name;struct device dev;struct mtd_info *parent;
 struct kref refcnt;int index;u8 type;u64 size;u32 erasesize,writesize,writebufsize,oobsize,oobavail,flags,ecc_strength,bitflip_threshold;
 unsigned erasesize_shift,writesize_shift,erasesize_mask,writesize_mask;
 void *pairing,*_write,*_write_oob,*_writev,*_read,*_erase;struct {unsigned failed,corrected;}ecc_stats;struct{void *dfs_dir;}dbg;
 int(*_get_device)(struct mtd_info*);void(*_put_device)(struct mtd_info*);
 int(*_read_oob)(struct mtd_info*,loff_t,struct mtd_oob_ops*);
 int(*_block_isbad)(struct mtd_info*,loff_t);
 bool no_nvmem,retain_device_context,driver_device_ref,partition_constructor_ref;struct device *driver_parent_ref;struct work_struct device_release_work;void(*_reboot)(void);struct {void(*notifier_call)(void);} reboot_notifier;
 struct nvmem_device *nvmem,*otp_user_nvmem,*otp_factory_nvmem;
};
