static void *alloc(size_t n,bool managed) {
 if(++allocation_step==fail_allocation)return NULL;
 void*p=calloc(1,n);assert(p&&allocation_count<100);allocations[allocation_count++]=(struct allocation){p,n,managed,true,true};
 if(n==sizeof(struct h2fmi))last_context=p;
 return p;
}
static struct allocation *record(const void*p) {for(unsigned i=0;i<allocation_count;i++)if(allocations[i].p==p)return &allocations[i];assert(!"unknown allocation");return NULL;}
static void *kzalloc(size_t n,int flags) {(void)flags;return alloc(n,false);}
static void *devm_kzalloc(struct device*d,size_t n,int flags) {(void)d;(void)flags;return alloc(n,true);}
static void *kmalloc(size_t n,int flags) {return kzalloc(n,flags);}
static void kfree(const void*p) {if(!p)return;struct allocation*r=record(p);assert(r->live);r->live=r->logical_live=false;free((void*)p);}
static char *name_alloc(bool managed,const char*fmt,int idx) {char*p=alloc(32,managed);if(p)snprintf(p,32,fmt,idx);return p;}
static char *kasprintf(int flags,const char*fmt,int idx){(void)flags;return name_alloc(false,fmt,idx);}
