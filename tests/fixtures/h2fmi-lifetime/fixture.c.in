/* ACTUAL_FUNCTIONS */
static void cleanup_fixture(void){for(unsigned i=0;i<allocation_count;i++)if(allocations[i].live){free(allocations[i].p);allocations[i].live=false;}}
static void fresh(void){cleanup_fixture();memset(allocations,0,sizeof(allocations));allocation_count=allocation_step=fail_allocation=0;fail_map=fail_registration=fail_unregister=fail_parse=fail_add=-1;hold_failed_device=false;failed_device=NULL;open_die=0;maps=registrations=unregistrations=hardware_reads=nvmem_registrations=core_releases=device_releases=0;open_during_probe=false;resources_available=module_get_ok=true;retained=NULL;last_context=NULL;partition_child=NULL;partition_releases=0;memset(table,0,sizeof(table));memset(regions,0,sizeof(regions));for(int i=0;i<6;i++)*(u32*)regions[i]=5;entered_read=allow_read=remove_done=block_read=false;}
static void devres_cleanup(void){resources_available=false;for(unsigned i=0;i<allocation_count;i++)if(allocations[i].managed)allocations[i].logical_live=false;}
static void partial_current_controls(struct platform_device *dev,unsigned *cases){
#if PARTITIONED_MASTER
 for(int failed=0;failed<4;failed++){
  fresh();open_during_probe=true;open_die=failed;fail_parse=failed;
  assert(h2fmi_probe(dev)==-EPROBE_DEFER);devres_cleanup();assert(retained);
#ifndef HISTORICAL_CONTROL
  assert(record(last_context)->live);assert(retained->_block_isbad(retained,0)==-ENODEV);
#endif
  __put_mtd_device(retained);
#ifndef HISTORICAL_CONTROL
  assert(!record(last_context)->live);
#endif
  (*cases)++;
 }
#else
 (void)dev;(void)cases;
#endif
}
static void deferred_device_controls(struct platform_device *dev,unsigned *cases){
 for(unsigned fd=0;fd<2;fd++){
  fresh();assert(!h2fmi_probe(dev));struct h2fmi*f=dev->data;struct mtd_info*m=&f->mtd[0];
  get_device(&m->dev);if(fd)assert(!__get_mtd_device(m));
  h2fmi_remove(dev);devres_cleanup();
#ifdef HISTORICAL_CONTROL
  assert(!record(f)->logical_live);
  if(fd)__put_mtd_device(m);
  /* Actual original core memset loses the deferred device's release data. */
  assert(!m->dev.refs&&!m->dev.data);
#else
  assert(record(f)->live&&m->dev.data==m&&m->dev.refs);
  assert(m->_block_isbad(m,0)==-ENODEV);
  if(fd)__put_mtd_device(m);
  assert(record(f)->live&&m->dev.refs==1);
  put_device(&m->dev);assert(!record(f)->live);
#endif
  (*cases)++;
 }
}
static void partition_controls(struct platform_device *dev,unsigned *cases){
 fresh();assert(!h2fmi_probe(dev));struct h2fmi*f=dev->data;struct mtd_info*m=&f->mtd[0];
 struct mtd_info *child=kzalloc(sizeof(*child),0);assert(child);child->parent=m;child->name=kasprintf(0,"partition%d",0);child->writesize=m->writesize;child->erasesize=m->erasesize;child->flags=m->flags;child->size=m->size;child->_read_oob=m->_read_oob;
 unsigned nvmem_before=nvmem_registrations;(void)nvmem_before;
 assert(!add_mtd_device(child));
#ifndef HISTORICAL_CONTROL
 put_partition_constructor(child);
#endif
 partition_child=child;
#ifndef HISTORICAL_CONTROL
 assert(nvmem_registrations==nvmem_before); /* master opt-out covers child */
#endif
 assert(!__get_mtd_device(child));get_device(&child->dev);h2fmi_remove(dev);devres_cleanup();
#ifndef HISTORICAL_CONTROL
 assert(record(f)->live);assert(m->_block_isbad(m,0)==-ENODEV);
#endif
 __put_mtd_device(child);
#ifndef HISTORICAL_CONTROL
 assert(record(f)->live&&!partition_releases);
 put_device(&child->dev);assert(partition_releases==1&&!record(f)->live);
#else
 assert(!record(f)->logical_live);put_device(&child->dev);assert(partition_releases==1);
#endif
 (*cases)++;
}
static void failed_publication_controls(struct platform_device *dev,unsigned *cases){
 for(int failed=0;failed<4;failed++)for(unsigned hold=0;hold<2;hold++){
  fresh();fail_add=failed;hold_failed_device=hold;
  assert(h2fmi_probe(dev)==-EIO);devres_cleanup();
#ifndef HISTORICAL_CONTROL
  if(hold){assert(failed_device&&record(last_context)->live);assert(table[failed]==failed_device->data);put_device(failed_device);assert(!record(last_context)->live&&!table[failed]);}
  else assert(!record(last_context)->live);
#else
  if(hold){assert(failed_device&&!record(last_context)->logical_live);assert(!table[failed]);put_device(failed_device);}
#endif
  (*cases)++;
 }
}
static void *read_thread(void*p){struct mtd_info*m=p;u8 out[32768];memset(out,0x55,sizeof(out));struct mtd_oob_ops ops={.len=sizeof(out),.datbuf=out};read_result=m->_read_oob(m,0,&ops);read_progress=ops.retlen;assert(read_result==0||read_result==-ENODEV);assert(out[16384]==0x55);return NULL;}
static void *remove_thread(void*p){h2fmi_remove(p);devres_cleanup();pthread_mutex_lock(&progress_lock);remove_done=true;pthread_cond_broadcast(&progress_cv);pthread_mutex_unlock(&progress_lock);return NULL;}
static int contract_get(struct mtd_info*m){(void)m;assert(!"must reject before callbacks");return 0;}
static void contract_put(struct mtd_info*m){(void)m;assert(!"must reject before callbacks");}
int main(void){
#ifdef MODULE_PROBE_CONTROL
 struct platform_device module_dev={0};fresh();assert(h2fmi_probe(&module_dev)==-EOPNOTSUPP);assert(!allocation_count&&!maps&&!registrations);cleanup_fixture();puts("PASS H2FMI module probe denied before allocation/publication");return 0;
#endif
#ifdef CONTRACT_REJECTION
 fresh();struct mtd_info invalid={.writesize=16384,.retain_device_context=true,._get_device=contract_get,._put_device=contract_put};
#if CORE_BUILTIN
 invalid.owner=(void*)1;
#endif
 assert(add_mtd_device(&invalid)==-EINVAL&&!registrations&&!device_releases);puts("PASS built-in-only opt-in contract rejection before publication");return 0;
#endif
 unsigned cases=0;struct platform_device dev={0};
#ifndef HISTORICAL_CONTROL
 u8 out[8192];struct mtd_oob_ops ops;
#endif
 fresh();assert(!h2fmi_probe(&dev));struct h2fmi*f=dev.data;struct mtd_info*m=&f->mtd[0];assert(!__get_mtd_device(m));
 h2fmi_remove(&dev);devres_cleanup();
#ifdef HISTORICAL_CONTROL
 assert(!record(f)->logical_live);assert(nvmem_registrations==4); /* actual original master open didn't retain devm context */
#else
 assert(record(f)->logical_live&&nvmem_registrations==0);assert(f->removed&&f->refs.count==1+PARTITIONED_MASTER);
 memset(out,0x55,sizeof(out));ops=(struct mtd_oob_ops){.len=sizeof(out),.datbuf=out,.retlen=99,.oobretlen=77};assert(m->_read_oob(m,0,&ops)==-ENODEV&&ops.retlen==0&&ops.oobretlen==0&&!hardware_reads);assert(out[0]==0x55);assert(m->_block_isbad(m,0)==-ENODEV);assert(__get_mtd_device(m)==-ENODEV);
#endif
 __put_mtd_device(m);
#ifndef HISTORICAL_CONTROL
 assert(!record(f)->live);
