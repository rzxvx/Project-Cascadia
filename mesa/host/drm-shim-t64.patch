diff --git a/src/drm-shim/t64.c b/src/drm-shim/t64.c
new file mode 100644
index 0000000..36591bd
--- /dev/null
+++ b/src/drm-shim/t64.c
@@ -0,0 +1,13 @@
+/* mesa/host only: time64 stat layout for the armhf glibc wrappers */
+#define _FILE_OFFSET_BITS 64
+#define _TIME_BITS 64
+#include <string.h>
+#include <sys/stat.h>
+void shim_t64_fake(void *p, dev_t rdev);
+void shim_t64_fake(void *p, dev_t rdev)
+{
+   struct stat *st = p;
+   memset(st, 0, sizeof(*st));
+   st->st_rdev = rdev;
+   st->st_mode = S_IFCHR;
+}
