#!/usr/bin/env bash
# Project Cascadia: A12 / iPhone XR (N841AP), called by ./cascadia a12.
set -euo pipefail

A12="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$A12"

say()  { printf '==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<'EOF'
Project Cascadia: iPhone XR (A12/N841)

  ./cascadia a12 doctor              check host tools and local inputs
  ./cascadia a12 inputs              fetch/patch first-stage inputs (IM4M=...)
  ./cascadia a12 periphery [OS.dmg]  fetch touch; optionally extract radio firmware
  ./cascadia a12 build [TARGET]      all, m1n1, kernel, dtb, initramfs, rootfs
  ./cascadia a12 pack                package the SysCfg-calibrated image (IM4M=...)
  ./cascadia a12 boot                boot Linux with DCSD logging
  ./cascadia a12 boot radios         boot Debian, then load Wi-Fi and Bluetooth
  ./cascadia a12 nfs on|off|status   manage the Debian NFS export

Apple firmware, IM4M, SysCfg, generated payloads and logs stay local.
EOF
}

cmd_doctor() {
    rc=0
    for t in bash git python3 curl ssh sha256sum dtc cpp fdtget fdtput img4 irecovery ipsw; do
        if have "$t"; then note "ok:      $t"; else note "MISSING: $t"; rc=1; fi
    done
    if [ "$(uname -m)" = aarch64 ]; then
        note "ok:      arm64 host (initramfs copies its busybox and dropbear)"
    else
        note "warning: not an arm64 host; build initramfs needs one"
    fi
    if have usbliter8ctl || [ -x "$A12/../a13/usbliter8ctl" ] || \
       [ -x /picotool/spironolactone/Linux/aarch64/usbliter8ctl ]; then
        note "ok:      usbliter8ctl"
    else
        note "MISSING: usbliter8ctl (PATH, devices/a13, or USBLITER8CTL=...)"; rc=1
    fi
    [ -s boot/extracted/iBSS.raw ] && note "ok:      XR iBSS" || note "missing: XR iBSS, run inputs"
    [ -s boot/extracted/DeviceTree.raw ] && note "ok:      XR DeviceTree" || note "missing: XR DeviceTree, run inputs"
    [ -s boot/inputs/syscfg.bin ] && note "ok:      private SysCfg (ignored)" || note "optional: private SysCfg"
    [ -s boot/inputs/brcm/BCM4349B1.apple,n841.hcd ] && note "ok:      radio firmware" || note "optional: radio firmware, run periphery OS.dmg"
    [ -s build/payload/Image.gz ] && note "ok:      kernel" || note "missing: kernel, run build kernel"
    [ -s boot/inputs/m1n1-linux.img4 ] && note "ok:      packed Linux IMG4" || note "missing: packed image, run pack"
    [ "$rc" -eq 0 ] || fail "install the missing host tools and re-run doctor"
}

need_im4m() {
    [ -n "${IM4M:-}" ] && [ -s "$IM4M" ] || \
        fail "set IM4M=/path/to/this-XR/apticket.im4m"
}

cmd_inputs() {
    need_im4m
    bash boot/make-inputs.sh
    python3 boot/prepare-xr-linux-bootset.py --ticket "$IM4M" "$@"
}

cmd_periphery() {
    bash boot/make-touch-firmware.sh
    if [ -n "${1:-}" ]; then
        bash boot/make-radio-firmware.sh "$1"
    else
        note "touch prepared; pass the matching OS .dmg.aea/.dmg to extract Wi-Fi/Bluetooth"
    fi
}

cmd_build() {
    case "${1:-all}" in
        all)
            cmd_build m1n1; cmd_build kernel; cmd_build dtb; cmd_build initramfs ;;
        m1n1)     bash m1n1/build-m1n1.sh ;;
        kernel)   bash linux/prepare-kernel.sh; bash linux/build-kernel.sh ;;
        dtb)      bash dts/build-dtb.sh ;;
        initramfs) bash initramfs/make-initramfs.sh ;;
        rootfs)   bash rootfs/build-debian-rootfs.sh ;;
        *) fail "unknown build target '$1'" ;;
    esac
}

cmd_pack() {
    need_im4m
    python3 boot/prepare-xr-linux-bootset.py --ticket "$IM4M"
    if [ -n "${SYSCFG:-}" ]; then
        XR_SYSCFG="$SYSCFG" XR_IM4M="$IM4M" python3 boot/package-linux.py
    elif [ -s boot/inputs/syscfg.bin ]; then
        XR_SYSCFG="$A12/boot/inputs/syscfg.bin" XR_IM4M="$IM4M" python3 boot/package-linux.py
    else
        note "packing without private SysCfg; radios will lack board calibration/address"
        XR_IM4M="$IM4M" python3 boot/package-linux.py
    fi
}

case "${1:-}" in
    doctor) cmd_doctor ;;
    inputs) shift; cmd_inputs "$@" ;;
    periphery) shift; cmd_periphery "$@" ;;
    build) shift; cmd_build "$@" ;;
    pack) cmd_pack ;;
    boot)
        shift
        case "${1:-}" in
            ''|linux) bash boot/boot-xr-linux.sh ;;
            radios|full) bash boot/boot-and-load-xr.sh ;;
            *) fail "unknown boot mode '$1', use linux or radios" ;;
        esac ;;
    nfs) shift; bash host/linux-nfs-export.sh "$@" ;;
    ''|-h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
