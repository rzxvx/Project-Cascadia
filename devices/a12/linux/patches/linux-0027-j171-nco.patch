+/*
+ * AppleS5L8960XNCO: parent 0, no alternate prescaler, accumulator mode.
+ * J171a 21B91 verification: 0xfffffff008ec43fc writes 0x80001000
+ * for input 0, normal fractional mode. Enable is BIT(12), not BIT(31).
+ * Its fNCO wrapper 0xfffffff008ec4a74 requests the input-0 path first.
+ * This prototype requires the actual input-0 clock as DT parent; no rate
+ * is fabricated here. Alternate-input / prescaler selection is not ported.
+ */
+static const struct applnco_hw j171_nco_hw = {
+	.enable_mask = BIT(12),
+	.control_set = BIT(31),
+	.control_clear = BIT(24) | BIT(29),
+};
+
 static const struct of_device_id applnco_ids[] = {
+	{ .compatible = "cascadia,j171a-nco", .data = &j171_nco_hw },
 	{ .compatible = "apple,t8103-nco" },
 	{ .compatible = "apple,nco" },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, applnco_ids);
+
+static int applnco_probe(struct platform_device *pdev)
+{
+ if (of_device_is_compatible(pdev->dev.of_node, "cascadia,j171a-nco") &&
+     !of_machine_is_compatible("apple,j171a"))
+  return -ENODEV;
+ return applnco_probe_common(pdev);
+}
 
