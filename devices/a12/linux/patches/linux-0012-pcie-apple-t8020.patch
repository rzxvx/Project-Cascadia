 		return -ENOMEM;
@@ -762,6 +770,13 @@ static int apple_pcie_enable_device(struct pci_host_bridge *bridge, struct pci_d
 	if (!port)
 		return 0;
 
+	/*
+	 * No RID/SID table, as behind a DART with a single SID on T8020:
+	 * everything on the port already lands on SID 0.
+	 */
+	if (!port->sid_map_sz)
+		return 0;
+
 	dev_dbg(&pdev->dev, "added to bus %s, index %d\n",
 		pci_name(pdev->bus->self), port->idx);
 
