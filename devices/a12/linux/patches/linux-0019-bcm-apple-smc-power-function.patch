+/* N841's ADT function-power_enable is pKW4(gP09, ARG | enabled), not
+ * macsmc-gpio's CMD_OUTPUT | enabled encoding. */
+static int bcm_apple_smc_set_shutdown(struct bcm_device *dev, bool powered)
+{
+	return apple_smc_write_u32(dev->apple_power_smc, dev->apple_power_key,
+				   dev->apple_power_arg | (powered ? 1 : 0));
+}
+
+static int bcm_apple_smc_get_power(struct bcm_device *dev)
+{
+	struct of_phandle_args args;
+	struct platform_device *pdev;
+	int err;
+
+	if (!dev->dev->of_node ||
+	    !of_property_present(dev->dev->of_node, "apple,power-function"))
+		return 0;
+
+	err = of_parse_phandle_with_fixed_args(dev->dev->of_node,
+					     "apple,power-function", 2, 0, &args);
+	if (err)
+		return err;
+	pdev = of_find_device_by_node(args.np);
+	of_node_put(args.np);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	dev->apple_power_smc = platform_get_drvdata(pdev);
+	put_device(&pdev->dev);
+	if (!dev->apple_power_smc)
+		return -EPROBE_DEFER;
+
+	dev->apple_power_key = args.args[0];
+	dev->apple_power_arg = args.args[1];
+	dev->set_shutdown = bcm_apple_smc_set_shutdown;
+	return 0;
+}
