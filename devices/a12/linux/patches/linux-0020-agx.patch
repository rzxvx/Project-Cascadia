+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_HWDATA_H
+#define AGX_21B91_HWDATA_H
+#include "agx-21b91-layout.h"
+#include "agx_21b91_power.h"
+/* Decode a CORE_ID read only after the native power prerequisites hold.
+ * This helper does not access MMIO or power hardware. SoC revision is not
+ * a substitute for GPU identity. Values correspond to native match tables. */
+enum agx21_g11_variant { AGX21_G11_A0=1, AGX21_G11_B0=3 };
+int agx21_g11_variant(u32 core_id, enum agx21_g11_variant *variant);
+/* Exact first step of 21B91 publisher: save HWA+0x4338 qword, zero
+ * 0x4358 bytes, restore that qword. Not a complete policy builder. */
+int agx21_reset_native_hwa(u8 *hwa,size_t hwa_size);
+/* J171 initial no-override performance-boost fields, after native reset. */
+int agx21_write_j171_perf_boost_defaults(u8 *hwa,size_t hwa_size);
+/* Native 31-entry IO resource table, HWB+0x640, stride 0x20.
+ * This serializes mapping requests; it does not map or touch device memory.
+ * Preserve all unrelated HWData fields: NOT a complete HWData constructor.
+ */
+int agx21_write_native_iomaps(u8 *hwb,size_t size,u32 core_id,
+ u64 sgx_pa,u64 fender_pa,u64 sw_interrupt_pa);
+/* Native 0x845ebac Region C policy mirror. Must be called only after the
+ * corresponding HWDataA range has been fully populated; this is one field
+ * family, not a complete Region C constructor or a publication check. */
+int agx21_copy_region_c_policy(u8 *region_c,size_t region_c_size,
+ const u8 *hardware_a,size_t hardware_a_size);
+/* Native G11 variants' vtable+0x978 resolves to 0x8410d24: clear 0x6e0
+ * bytes at HWA+0x3aa0, then 0x845ebac mirrors HWA+0x3aa4 to C+0xcc. */
+int agx21_prepare_region_c_mirror(u8 *region_c,size_t region_c_size,
+ u8 *hardware_a,size_t hardware_a_size);
+/* Publisher C+0x7d4/+0x7d8 from G11P +0x1d70/+0x1d6c.
+ * Callers supply the actual post-ADT values; J171's absent properties
+ * select the native 100/100 defaults. Not a whole-C constructor. */
+int agx21_write_region_c_keepalive(u8 *region_c,size_t region_c_size,
+ u32 perf_threshold,u32 off_threshold);
+/* Region C timing triple after native firmware-state setup/override selection.
+ * Captured J171 no-override inputs are 0, 40 and 5 respectively. */
+int agx21_write_region_c_timing(u8 *region_c,size_t region_c_size,
+ u32 idle_off_ms,u32 fender_idle_off_ms,u32 early_wake_ms);
+/* Verified no-setter late-publication zeros from 0x8460870 and G11P
+ * configureDevice. Leaves property-dependent C+0x34/+0x5e untouched. */
+int agx21_write_region_c_late_defaults(u8 *region_c,size_t region_c_size);
+/* Initial no-setter C+0x88: 100*(effective G11P perf-state count - 1).
+ * J171 G11P identity decoder leaves DVMR disabled; raw count is effective. */
+int agx21_write_region_c_perf_range(u8 *region_c,size_t region_c_size,
+ u32 perf_states);
+/* G11P model-slow flag feeds HWB+2668, then late C+0x5e.
+ * Captured J171 ADT lacks model-slow, so initial values are both one. */
+int agx21_write_j171_model_slow_policy(u8 *hwb,size_t hwb_size,
+ u8 *region_c,size_t region_c_size,int model_slow);
+/* Initial 21B91 C+0x74/+0x78/+0x7c from setup + three indexed
+ * 0x8442e94 calls; requires strictly increasing native MHz table. */
+int agx21_write_j171_initial_target_policy(u8 *region_c,size_t region_c_size,
+ const struct agx21_power_tables *power);
+/* Native 0x845ebac copies firmware-object +6376..+6431 to C+0x8c.
+ * Source must be the fully initialized, post-override firmware snapshot;
+ * this routine does not infer the first-publish values or permit InitData. */
+int agx21_copy_region_c_idleoff(u8 *region_c,size_t region_c_size,
+ const u8 *firmware,size_t firmware_size);
+/* Sparse first-publication power-request writes from initialized firmware
+ * state. Caller must own a zeroed 0x1e8 reservation, have populated HWA,
+ * and separately prove the J171 zone gate is clear. Not a full graph. */
+int agx21_copy_j171_power_request_policy(u8 *power,size_t power_size,
+ const u8 *firmware,size_t firmware_size,const u8 *hwa,size_t hwa_size);
+/* Minimal no-override J171 differential: publish only three independently
+ * proven first-publisher words, leaving all unproven power fields untouched. */
+int agx21_write_j171_power_request_core(u8 *power,size_t power_size,
+ const u8 *firmware,size_t firmware_size);
+/* Native 0x844f26c dictionary callback: one validated sensor-index update.
+ * group 0/1 selects HWA+4712/+4716 and power+108/+112. A cleared status
+ * removes the mapping; a set status installs the supplied clvr_ce index. */
+int agx21_power_request_sensor_update(u8 *power,size_t power_size,
+ const u8 *hwa,size_t hwa_size,u32 group,u32 sensor_index,
+ u32 clvr_ce_index,int clear_status);
+/* 21B91 kernel 0x84431ec writes these HWB bases and Region C defaults
+ * during initialization. Deliberately do not infer the first two HWB qwords
+ * from the XS driver: their native source is a separate kernel constant. */
+int agx21_write_native_bootstrap_fields(u8 *hwb,size_t hwb_size,
+ u8 *region_c,size_t region_c_size);
+/* Opt-in BadApple-style power-mode experiment for J171 firmware ABI.
+ * These are J171 HWB offsets, not the XS offsets. Not native iOS policy. */
+int agx21_write_badapple_power_mode(u8 *hwb,size_t hwb_size);
+/* ChinookV2 21B91 publication control words. Does not populate the
+ * board-dependent capability vectors or the rest of HWDataB. */
+int agx21_write_native_hwb_controls(u8 *hwb,size_t size,u32 sample_ms);
+/* Native G11 capability provider 0x8469e30 and HWB publisher 0x8460870.
+ * sgx_4018 must be read only after the SGX power domain is active. */
+int agx21_write_native_slot_masks(u8 *hwb,size_t size,u32 sgx_4018);
+/* Native publisher 0x845ebac copies AGXArmFirmware a1+5480..5559 into
+ * HWDataA's tail (non-linear 8-byte ordering). The legacy function/argument
+ * name says "accelerator", but this buffer is FIRMWARE-OBJECT state, not
+ * the separate G11P accelerator at *(a1+496). No value is guessed. */
+int agx21_copy_native_accelerator_policy(u8 *hwa,size_t hwa_size,
+ const u8 *accelerator,size_t accelerator_size);
+/* Publisher's HWA+5264..15007 resource-map clear and three direct
+ * G11P-source stores. Conditional indexed entries are NOT populated. */
+int agx21_begin_native_resource_map(u8 *hwa,size_t hwa_size,
+ const u8 *g11p,size_t g11p_size);
+/* G11P 21B91 third-branch MtrPolynomGFX parser plus indexed HWA
+ * publisher, for an explicit, captured PMGR OSData payload. This does not
+ * derive the live PMGR register values or permit InitData publication. */
+int agx21_write_j171_polynomial_map(u8 *hwa,size_t hwa_size,
+ const u8 *pmgr_data,size_t pmgr_size);
+/* Exact direct table mirrors from the 21B91 InitData publisher. Source is
+ * initialized AGXArmFirmware state; legacy API name is misleading. */
+int agx21_copy_native_accelerator_tables(u8 *hwa,size_t hwa_size,
+ const u8 *accelerator,size_t accelerator_size);
+/* G11P vtable+0x948 produces a 32-byte fast-die0 source record. This J171
+ * specialization uses the exact captured 21B91 ADT values/defaults; the
+ * native accelerator sensor mask is an explicit input, never guessed. */
+int agx21_write_j171_fast_die0(u8 *dst,size_t size,u64 native_sensor_mask);
+/* G11P vtable+0x950: source qword, J171 default sochot temperature, then
+ * 256 zeroed bytes. This is an accelerator source, not HWDataA itself. */
+int agx21_write_j171_sochot_source(u8 *dst,size_t size,u64 native_sensor_mask);
+/* Native setup's +0x950 output in firmware state at +5848; duplicate +6116. */
+int agx21_init_j171_sochot_tables(u8 *accelerator,size_t size,u64 native_sensor_mask);
+/* 21B91 publisher mirrors the 12-byte sochot prefix from initialized
+ * AGXArmFirmware state +5848, then writes HWA+4748=1. Sparse publication:
+ * it neither initializes the source nor constructs the rest of HWDataA. */
+int agx21_copy_native_sochot_prefix(u8 *hwa,size_t hwa_size,
+ const u8 *firmware,size_t firmware_size);
+/* Native firmware-state first table from zero-initialized v157..v172. */
+int agx21_init_j171_fast_die0_table(u8 *accelerator,size_t size);
+/* J171 configureDevice source for G11P vtable+0xac0 (sample period=16). */
+int agx21_write_j171_sample_period(u8 *accelerator,size_t size);
+/* Native publisher +2216..+2364, sparse stores and exact fallbacks.
+ * Caller must supply initialized iPad AGXArmFirmware state; this does not
+ * manufacture the source object or certify complete HWDataA policy. */
+int agx21_copy_native_fast_die0_policy(u8 *hwa,size_t hwa_size,
+ const u8 *accelerator,size_t accelerator_size);
+/* Captured J171 initial no-runtime-override firmware-state source at
+ * +4752..+4867. Live sensor mask, state count and min-duty are inputs. */
+int agx21_init_j171_fast_die0_control(u8 *firmware,size_t size,
+ u64 native_sensor_mask,u32 states,u32 min_duty);
+#endif
diff --git a/drivers/gpu/drm/agx/agx_21b91_init.c b/drivers/gpu/drm/agx/agx_21b91_init.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_init.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "agx_21b91_init.h"
+#include "agx_21b91_hwdata.h"
+
+static int valid_buffer(const struct agx21_init_buffer *b, size_t minimum, int firmware_mapped)
+{
+ unsigned long cpu;
+ if (!b->cpu || b->size < minimum ||
+     (firmware_mapped && (!b->firmware_va || (b->firmware_va & 3) ||
+      b->firmware_va > (~(u64)0) - b->size)))
+  return 0;
+ cpu = (unsigned long)b->cpu;
+ return cpu <= (~0UL) - b->size;
+}
+
+static int bind_init_graph(const struct agx21_init_graph *g, int sparse_test)
+{
+ const struct agx21_init_buffer *buffers[7];
+ static const size_t sizes[7] = { AGX21_INIT_SIZE, AGX21_REGION_B_SIZE,
+  AGX21_REGION_C_SIZE, AGX21_STARTUP_SIZE, AGX21_AUX_SIZE,
+  AGX21_POWER_REQUESTS_SIZE, AGX21_HWDATA_A_SIZE };
+ u8 checked_b[AGX21_REGION_B_SIZE], init[AGX21_INIT_SIZE], mmu[AGX21_MMU_SIZE];
+ unsigned int i, j;
+ if (!g) return -1;
+ buffers[0]=&g->init; buffers[1]=&g->region_b; buffers[2]=&g->region_c;
+ buffers[3]=&g->startup; buffers[4]=&g->auxiliary; buffers[5]=&g->power;
+ buffers[6]=&g->hardware_a;
+ if (!sparse_test && g->hardware_a_policy_ready != 1) return -1;
+ if (!sparse_test && (!g->power_firmware_source || g->power_firmware_source_size<6432 ||
+     (unsigned long)g->power_firmware_source >
+       ~0UL-g->power_firmware_source_size)) return -1;
+ if (!sparse_test && ((unsigned long)g > ~0UL- sizeof(*g) ||
+     ((unsigned long)g->power_firmware_source < (unsigned long)g+sizeof(*g) &&
+      (unsigned long)g < (unsigned long)g->power_firmware_source+
+                          g->power_firmware_source_size))) return -1;
+ for (i=0;i<7;i++) {
+  unsigned long graph_cpu=(unsigned long)g, out_cpu=(unsigned long)buffers[i]->cpu;
+  if (!valid_buffer(buffers[i],sizes[i],i != 0)) return -1;
+  if (graph_cpu > (~0UL)-sizeof(*g) ||
+      (graph_cpu < out_cpu+buffers[i]->size && out_cpu < graph_cpu+sizeof(*g)))
+   return -1;
+  for (j=0;j<i;j++) {
+   unsigned long a=(unsigned long)buffers[i]->cpu, b=(unsigned long)buffers[j]->cpu;
+   u64 av=buffers[i]->firmware_va, bv=buffers[j]->firmware_va;
+   if ((a < b+buffers[j]->size && b < a+buffers[i]->size) ||
+       (i && j && av < bv+buffers[j]->size && bv < av+buffers[i]->size)) return -1;
+  }
+ }
+ for (i=0;!sparse_test && i<7;i++) {
+  unsigned long src=(unsigned long)g->power_firmware_source;
+  unsigned long dst=(unsigned long)buffers[i]->cpu;
+  if (src<dst+buffers[i]->size && dst<src+g->power_firmware_source_size)
+   return -1;
+ }
+ /* Validate the complete binding transaction before changing caller bytes.
+  * checked_b is only scratch: never copy its unspecified bytes to Region B.
+  */
+ if (g->descriptor_table_pa >= (1ULL << 44)-0x4000 ||
+     !g->host_generations_va || !g->catalogues_va ||
+     ((g->host_generations_va | g->catalogues_va) & 3) ||
+     g->host_generations_va == g->catalogues_va ||
+     g->host_generations_va == g->region_b_pointers.firmware_generations_va ||
+     !g->native_boot_buffer_pa || (g->native_boot_buffer_pa & 0x3fff) ||
+     g->native_boot_buffer_pa >= (1ULL << 44) ||
+     agx21_write_region_b_bindings(checked_b,sizeof(checked_b),&g->region_b_pointers) ||
+     agx21_write_mmu_format(mmu,sizeof(mmu)) ||
+     agx21_write_init_fields(init,sizeof(init),g->region_b.firmware_va,
+      g->region_c.firmware_va,mmu,sizeof(mmu),g->descriptor_table_pa,
+      g->descriptor_count,g->startup.firmware_va) ||
+     agx21_write_init_aux_fields(init,sizeof(init),g->auxiliary.firmware_va,
+      g->power.firmware_va)) return -1;
+ for (i=0;i<13;i++) {
+  const struct agx21_input_binding *ch=&g->inputs[i];
+  if (agx21_write_channel(checked_b,AGX21_CHANNEL_SIZE,ch->consumer_va,
+       ch->prefetch_va,ch->producer_va,ch->ring_va)) return -1;
+ }
+ if (agx21_write_outbound_channel(checked_b,0x10,g->event_state_va,g->event_ring_va) ||
+     !g->mapping_state_va || !g->mapping_ring_va ||
+     ((g->mapping_state_va | g->mapping_ring_va) & 3) ||
+     g->mapping_state_va == g->mapping_ring_va) return -1;
+ {
+  const struct agx21_output_binding *outputs[]={&g->logging,&g->trace,&g->statistics};
+  for (i=0;i<3;i++)
+   if (agx21_write_outbound_channel(checked_b,0x10,outputs[i]->state_va,
+        outputs[i]->ring_va)) return -1;
+ }
+ /* Only validated writes below. Preserve native policy, status and unknown
+  * fields. The caller may not concurrently mutate this graph or its buffers.
+  */
+ /* Power policy is copied from the caller's initialized firmware snapshot,
+  * not synthesized from the zeroed DMA reservation. This is on the actual
+  * protocol_open -> bind_init_graph path, still gated by full policy readiness.
+  * Native callback mutations must be applied by the producer beforehand. */
+ if (!sparse_test && (agx21_copy_j171_power_request_policy(g->power.cpu,g->power.size,
+      g->power_firmware_source,g->power_firmware_source_size,
+      g->hardware_a.cpu,g->hardware_a.size) ||
+      agx21_copy_region_c_idleoff(g->region_c.cpu,g->region_c.size,
+      g->power_firmware_source,g->power_firmware_source_size))) return -1;
+ /* These publisher copies share the same post-override firmware object.
+  * Do not substitute the separate G11P accelerator pointer. They are
+  * sparse HWA families; they do not establish full policy readiness. */
+ if (!sparse_test && (agx21_copy_native_accelerator_tables(g->hardware_a.cpu,
+      g->hardware_a.size,g->power_firmware_source,
+      g->power_firmware_source_size) ||
+     agx21_copy_native_sochot_prefix(g->hardware_a.cpu,
+      g->hardware_a.size,g->power_firmware_source,
+      g->power_firmware_source_size) ||
+     agx21_copy_native_accelerator_policy(g->hardware_a.cpu,
+      g->hardware_a.size,g->power_firmware_source,
+      g->power_firmware_source_size))) return -1;
+ if (agx21_prepare_region_c_mirror(g->region_c.cpu,g->region_c.size,
+      g->hardware_a.cpu,g->hardware_a.size)) return -1;
+ agx21_write_init_fields(g->init.cpu,g->init.size,g->region_b.firmware_va,
+  g->region_c.firmware_va,mmu,sizeof(mmu),g->descriptor_table_pa,
+  g->descriptor_count,g->startup.firmware_va);
+ agx21_write_init_aux_fields(g->init.cpu,g->init.size,g->auxiliary.firmware_va,
+  g->power.firmware_va);
+ agx21_write_region_b_bindings(g->region_b.cpu,g->region_b.size,&g->region_b_pointers);
+ agx21_write_context_fields(g->region_c.cpu,g->region_c.size,
+  g->host_generations_va,g->catalogues_va,g->context_masks);
+ agx21_patch_aux_scheduler(g->auxiliary.cpu,g->auxiliary.size);
+ for (i=0;i<13;i++) {
+  const struct agx21_input_binding *ch=&g->inputs[i];
+  agx21_write_channel(g->region_b.cpu+0x18+i*0x20,AGX21_CHANNEL_SIZE,
+   ch->consumer_va,ch->prefetch_va,ch->producer_va,ch->ring_va);
+ }
+ agx21_write_outbound_channel(g->region_b.cpu+0x1b8,0x10,
+  g->event_state_va,g->event_ring_va);
+ {
+  const struct agx21_output_binding *outputs[]={&g->logging,&g->trace,&g->statistics};
+  for (i=0;i<3;i++)
+   agx21_write_outbound_channel(g->region_b.cpu+0x1c8+0x10*i,0x10,
+    outputs[i]->state_va,outputs[i]->ring_va);
+ }
+ for (i=0;i<8;i++) {
+  g->auxiliary.cpu[0x4560+i]=(u8)(g->mapping_state_va>>(8*i));
+  g->auxiliary.cpu[0x4568+i]=(u8)(g->mapping_ring_va>>(8*i));
+ }
+ /* Native publisher 0xfffffff008460870 at 0x8460e0c and 0x8460ef0. */
+ {
+  u64 magic=0x0c07a32e038a0490ULL;
+  for (i=0;i<8;i++) {
+   g->init.cpu[i]=(u8)(magic>>(8*i));
+   g->init.cpu[8+i]=(u8)(g->native_boot_buffer_pa>>(8*i));
+  }
+ }
+ return 0;
+}
+int agx21_bind_init_graph(const struct agx21_init_graph *g)
+{
+ return bind_init_graph(g,0);
+}
+int agx21_bind_sparse_test_graph(const struct agx21_init_graph *g)
+{
+ if (!g || g->hardware_a_policy_ready || g->power_firmware_source) return -1;
+ return bind_init_graph(g,1);
+}
diff --git a/drivers/gpu/drm/agx/agx_21b91_init.h b/drivers/gpu/drm/agx/agx_21b91_init.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_init.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_INIT_H
+#define AGX_21B91_INIT_H
+#include "agx-21b91-layout.h"
+struct agx21_init_buffer {
+ u8 *cpu;
+ size_t size;
+ u64 firmware_va;
+};
+struct agx21_output_binding {
+ u64 state_va, ring_va;
+};
+struct agx21_input_binding {
+ u64 consumer_va, prefetch_va, producer_va, ring_va;
+};
+/* Before firmware publication only. These buffers must already have valid
+ * mappings and native policy population. Binding does NOT certify their
+ * contents, allocate/map memory, or send an Init message.
+ */
+struct agx21_init_graph {
+ /* init is sent by physical address; its firmware_va is unused. */
+ struct agx21_init_buffer init, region_b, region_c, startup, auxiliary, power, hardware_a;
+ /* Set only by a complete native HWDataA producer. The allocator leaves it 0. */
+ u32 hardware_a_policy_ready;
+ struct agx21_region_b_bindings region_b_pointers;
+ u64 host_generations_va, catalogues_va;
+ u32 context_masks[8];
+ u64 descriptor_table_pa;
+ u32 descriptor_count;
+ /* Native init+8, deliberately explicit rather than silently zero-filled. */
+ u64 native_boot_buffer_pa;
+ struct agx21_input_binding inputs[13];
+ u64 event_state_va, event_ring_va;
+ u64 mapping_state_va, mapping_ring_va;
+ struct agx21_output_binding logging, trace, statistics;
+ /* Initialized AGXArmFirmware source snapshot. The graph binder copies its
+  * native first-publisher power fields only after the full policy gate is
+  * explicitly set. The partial live preflight leaves this pointer NULL. */
+ const u8 *power_firmware_source;
+ size_t power_firmware_source_size;
+};
+int agx21_bind_init_graph(const struct agx21_init_graph *graph);
+/* Explicit experiment only: bind structural pointers while retaining sparse,
+ * zero-initialized policy fields. This does not certify native HWData. */
+int agx21_bind_sparse_test_graph(const struct agx21_init_graph *graph);
+#endif
diff --git a/drivers/gpu/drm/agx/agx_21b91_memory.c b/drivers/gpu/drm/agx/agx_21b91_memory.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_memory.c
@@ -0,0 +1,401 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "agx_21b91_memory.h"
+#include "agx_21b91_queue.h"
+#ifdef AGX_ABI_HOST_TEST
+#include <string.h>
+#else
+#include <linux/string.h>
+#endif
+
+static void write_le(u8 *p, u64 value, unsigned int size)
+{
+ unsigned int i;
+ for (i=0;i<size;i++) p[i]=(u8)(value>>(8*i));
+}
+static u64 read_le(const u8 *p, unsigned int size)
+{
+ u64 value=0;
+ unsigned int i;
+ for (i=0;i<size;i++) value|=(u64)p[i]<<(8*i);
+ return value;
+}
+static int physical_ok(u64 pa, u64 size)
+{
+ /* The native G11 GPU walker masks GPU PAs to 40 bits. Its initial physical
+  * InitData mapping is wider, but using the stricter bound avoids truncation.
+  */
+ return pa && !(pa&(AGX21_PAGE-1)) && size && pa<(1ULL<<40) &&
+        size <= (1ULL<<40)-pa;
+}
+static int allocate_at(struct agx21_memory *m, unsigned int id, u32 bytes)
+{
+ u32 start, reserved;
+ if (!m || m->size!=AGX21_ARENA_BYTES || m->published || id>=AGX21_MAX_OBJECTS || !bytes ||
+     bytes>m->size || m->objects[id].size || m->used>m->size) return -1;
+ start=(m->used+AGX21_PAGE-1)&~(AGX21_PAGE-1);
+ reserved=(bytes+AGX21_PAGE-1)&~(AGX21_PAGE-1);
+ if (start>m->size || reserved>m->size-start) return -1;
+ m->objects[id].offset=start;
+ m->objects[id].size=bytes;
+ m->objects[id].reserved=reserved;
+ m->used=start+reserved;
+ return 0;
+}
+u8 *agx21_memory_cpu(struct agx21_memory *m, unsigned int id)
+{
+ if (!m || !m->arena || id>=AGX21_MAX_OBJECTS || !m->objects[id].size) return NULL;
+ return m->arena+m->objects[id].offset;
+}
+u64 agx21_memory_firmware_va(const struct agx21_memory *m, unsigned int id)
+{
+ if (!m || id>=AGX21_MAX_OBJECTS || !m->objects[id].size) return 0;
+ return m->firmware_va+m->objects[id].offset;
+}
+u64 agx21_memory_physical(const struct agx21_memory *m, unsigned int id)
+{
+ if (!m || id>=AGX21_MAX_OBJECTS || !m->objects[id].size) return 0;
+ return m->arena_pa+m->objects[id].offset;
+}
+int agx21_memory_allocate(struct agx21_memory *m, u32 bytes, unsigned int *id)
+{
+ unsigned int next;
+ if (!m || !id || m->published) return -1;
+ next=m->dynamic_next;
+ if (next<AGX21_MEM_DYNAMIC_BASE || next>=AGX21_MAX_OBJECTS ||
+     allocate_at(m,next,bytes)) return -1;
+ m->dynamic_next=next+1;
+ memset(m->arena+m->objects[next].offset,0,m->objects[next].reserved);
+ *id=next;
+ return 0;
+}
+int agx21_memory_reserve_render_staging(struct agx21_memory *m,
+ struct agx21_render_staging *out)
+{
+ static const u32 sizes[6]={0x24c0,0x100,256*8,0x100,0x100,AGX21_PAGE};
+ struct agx21_render_staging staged;
+ unsigned int next,k,ch,field,id;
+ u32 start;
+ if (!m || !out || !m->arena || m->published || m->render_staging_reserved ||
+     m->size!=AGX21_ARENA_BYTES || m->used>m->size ||
+     m->dynamic_next<AGX21_MEM_DYNAMIC_BASE ||
+     m->dynamic_next>AGX21_MAX_OBJECTS-12) return -1;
+ next=m->dynamic_next;
+ start=(m->used+AGX21_PAGE-1)&~(AGX21_PAGE-1);
+ /* Every object consumes exactly one 16 KiB reservation. Preflight the
+  * whole transaction so a short arena/object table cannot half-allocate. */
+ if (start>m->size || 12U>(m->size-start)/AGX21_PAGE) return -1;
+ for (k=0;k<12;k++) if (m->objects[next+k].size) return -1;
+ for (ch=0;ch<2;ch++) {
+  for (field=0;field<5;field++) {
+   if (agx21_memory_allocate(m,sizes[field],&id)) return -1;
+   staged.queue[ch][field]=id;
+  }
+  if (agx21_memory_allocate(m,sizes[5],&id)) return -1;
+  staged.command[ch]=id;
+ }
+ *out=staged;
+ m->render_ids=staged;
+ m->render_staging_reserved=1;
+ return 0;
+}
+int agx21_memory_reserve_render_resources(struct agx21_memory *m,
+ struct agx21_render_resources *out)
+{
+ static const u32 bytes[10]={AGX21_PAGE,AGX21_RENDER_TILEMAP_BYTES,AGX21_RENDER_TPC_BYTES,0x820000,
+  4*AGX21_PAGE,3*AGX21_PAGE,4*AGX21_PAGE,4*AGX21_PAGE,4*AGX21_PAGE,
+  AGX21_PAGE};
+ struct agx21_render_resources staged;
+ unsigned int id,next,k,ids[10];
+ u32 start;
+ if(!m||!out||!m->arena||m->size!=AGX21_ARENA_BYTES||m->published||
+    !m->render_staging_reserved||!m->render_queue_headers_initialized||
+    m->render_resources_reserved||m->used>m->size||
+    m->dynamic_next>AGX21_MAX_OBJECTS-10)return -1;
+ next=m->dynamic_next;
+ start=(m->used+AGX21_PAGE-1)&~(AGX21_PAGE-1);
+ /* Bounded up-to-2048x2160 scene: metadata/tile/TPC, an 8 MiB parameter
+  * allocation with 128 KiB headroom for physical alignment,
+  * independent scene descriptor, 3 preempt pages and three 64 KiB
+  * parameter-manager state buffers, and the 16 KiB firmware-side PM slot
+  * table. No CP object is reused. */
+ if(start>m->size||562U>(m->size-start)/AGX21_PAGE)return -1;
+ for(k=0;k<10;k++)if(m->objects[next+k].size)return -1;
+ for(k=0;k<10;k++){
+  if(agx21_memory_allocate(m,bytes[k],&id))return -1;
+  ids[k]=id;
+ }
+ staged=(struct agx21_render_resources){ids[0],ids[1],ids[2],ids[3],
+  ids[4],ids[5],ids[6],ids[7],ids[8],ids[9]};
+ *out=staged;m->render_resources=staged;m->render_resources_reserved=1;
+ return 0;
+}
+int agx21_render_bind_pm_slots(struct agx21_memory *m)
+{
+ u8 *region_b, *slots;
+ u64 fw_va, gpu_va;
+ unsigned int id;
+ if(!m || !m->render_resources_reserved || !m->render_staging_reserved ||
+    m->published || m->objects[AGX21_MEM_B].size<0x2d8)return -1;
+ id=m->render_resources.pm_slots;
+ if(id>=AGX21_MAX_OBJECTS || m->objects[id].size!=AGX21_PAGE)return -1;
+ region_b=agx21_memory_cpu(m,AGX21_MEM_B);
+ slots=agx21_memory_cpu(m,id);
+ fw_va=agx21_memory_firmware_va(m,id);
+ gpu_va=AGX21_GPU_SHARED_VA+m->objects[id].offset;
+ if(!region_b || !slots || !fw_va || (fw_va & 7) ||
+    read_le(region_b+0x2c8,8) || read_le(region_b+0x2d0,8))return -1;
+ /* Native 21B91 kernel 0x8460a28/0x8460a68 publishes both aliases.
+  * Firmware 0x97a4..0x97a8 loads the GPU alias into SGX+0x14430;
+  * InitBuffer fills the same table through the firmware alias. */
+ write_le(region_b+0x2c8,gpu_va,8);
+ write_le(region_b+0x2d0,fw_va,8);
+ return 0;
+}
+static void graph_buffer(struct agx21_memory *m, struct agx21_init_buffer *b,
+                         unsigned int id)
+{
+ b->cpu=agx21_memory_cpu(m,id);
+ b->size=m->objects[id].size;
+ b->firmware_va=agx21_memory_firmware_va(m,id);
+}
+int agx21_memory_prepare(struct agx21_memory *m, u8 *arena, u64 arena_pa,
+ u8 *init_cpu, u64 init_pa, u8 *table_cpu, u64 table_pa, u8 *boot_cpu, u64 boot_pa)
+{
+ static const u32 bytes[AGX21_MEM_INPUT_STATE_BASE]={
+  AGX21_REGION_B_SIZE,AGX21_REGION_C_SIZE,AGX21_STARTUP_SIZE,AGX21_AUX_SIZE,
+  AGX21_POWER_REQUESTS_SIZE,AGX21_HWDATA_SIZE,AGX21_HWDATA_A_SIZE,
+  AGX21_TA_STATS_SIZE,AGX21_3D_STATS_SIZE,AGX21_COMPUTE_STATS_SIZE,
+  AGX21_FAULT_INFO_SIZE,0x88,4*AGX21_CONTEXTS,4*AGX21_CONTEXTS,
+  8*AGX21_CONTEXTS,0x100,256*AGX21_MEMDESC_SIZE,0x100,
+  /* Native CP control helper 0x848901c probes command+0x920/+0x928
+   * and publishes pointers through +0x938. Reserve one full GPU page;
+   * the older 0x300-byte allocation covered only the firmware base. */
+  256*AGX21_EVENT_RECORD_SIZE,AGX21_PAGE,0x200,0x200,0x100,
+  0x24c0,0x100,256*8,0x100,0x100,AGX21_PAGE,
+  0x51000,0x120,0x15000,0x30,0x7000,0x30,0x4000
+ };
+ u8 *buffers[4]={arena,init_cpu,table_cpu,boot_cpu};
+ u64 physical[4]={arena_pa,init_pa,table_pa,boot_pa};
+ u32 sizes[4]={AGX21_ARENA_BYTES,AGX21_PAGE,AGX21_PAGE,AGX21_PAGE};
+ struct agx21_init_graph *g;
+ unsigned int i,j;
+ if (!m) return -1;
+ for (i=0;i<4;i++) {
+  unsigned long p=(unsigned long)buffers[i], owner=(unsigned long)m;
+  if (!buffers[i] || !physical_ok(physical[i],sizes[i]) ||
+      p>(~0UL)-sizes[i] || owner>(~0UL)-sizeof(*m) ||
+      (owner<p+sizes[i] && p<owner+sizeof(*m))) return -1;
+  for (j=0;j<i;j++) {
+   unsigned long other=(unsigned long)buffers[j];
+   if ((p<other+sizes[j] && other<p+sizes[i]) ||
+       (physical[i]<physical[j]+sizes[j] && physical[j]<physical[i]+sizes[i])) return -1;
+  }
+ }
+ memset(m,0,sizeof(*m));
+ m->arena=arena;m->arena_pa=arena_pa;m->size=AGX21_ARENA_BYTES;
+ m->firmware_va=AGX21_FIRMWARE_SHARED_VA;
+ m->init_cpu=init_cpu;m->init_pa=init_pa;m->table_cpu=table_cpu;
+ m->table_pa=table_pa;m->boot_cpu=boot_cpu;m->boot_pa=boot_pa;
+ for (i=0;i<AGX21_MEM_INPUT_STATE_BASE;i++)
+  if (allocate_at(m,i,bytes[i])) return -1;
+ for (i=0;i<13;i++)
+  if (allocate_at(m,AGX21_MEM_INPUT_STATE_BASE+i,0x100) ||
+      allocate_at(m,AGX21_MEM_INPUT_RING_BASE+i,
+       256*(i==12?AGX21_CONTROL_RECORD_SIZE:AGX21_RUN_RECORD_SIZE))) return -1;
+ for (i=0;i<AGX21_CONTEXTS;i++)
+  if (allocate_at(m,AGX21_MEM_PC_BASE+i,AGX21_PAGE)) return -1;
+ if (allocate_at(m,AGX21_MEM_SHARED_PD,AGX21_PAGE)) return -1;
+ for (i=0;i<6;i++)
+  if (allocate_at(m,AGX21_MEM_SHARED_PT_BASE+i,AGX21_PAGE)) return -1;
+ m->dynamic_next=AGX21_MEM_DYNAMIC_BASE;
+ /* All framing and bounded planning succeeded. Initialize actual owned RAM. */
+ for (i=0;i<4;i++) memset(buffers[i],0,sizes[i]);
+ if (agx21_write_memdesc(table_cpu,AGX21_PAGE,m->firmware_va,arena_pa,
+      AGX21_ARENA_BYTES/AGX21_PAGE,1)) return -1;
+ g=&m->graph;
+ g->init=(struct agx21_init_buffer){init_cpu,AGX21_INIT_SIZE,0};
+ graph_buffer(m,&g->region_b,AGX21_MEM_B);graph_buffer(m,&g->region_c,AGX21_MEM_C);
+ graph_buffer(m,&g->startup,AGX21_MEM_STARTUP);graph_buffer(m,&g->auxiliary,AGX21_MEM_AUX);
+ graph_buffer(m,&g->power,AGX21_MEM_POWER);
+ graph_buffer(m,&g->hardware_a,AGX21_MEM_HWA);
+ g->descriptor_table_pa=table_pa;g->descriptor_count=1;g->native_boot_buffer_pa=boot_pa;
+ g->host_generations_va=agx21_memory_firmware_va(m,AGX21_MEM_HOST_GEN);
+ g->catalogues_va=agx21_memory_firmware_va(m,AGX21_MEM_CATALOGUES);
+ g->context_masks[AGX21_TEST_CONTEXT/32]=1U<<(AGX21_TEST_CONTEXT%32);
+ g->region_b_pointers.hardware_b_va=agx21_memory_firmware_va(m,AGX21_MEM_HWB);
+ g->region_b_pointers.hardware_a_va=agx21_memory_firmware_va(m,AGX21_MEM_HWA);
+ g->region_b_pointers.header_10_va=agx21_memory_firmware_va(m,AGX21_MEM_HEADER10);
+ /* Native allocation table at 0x8445a34..0x8445a48: host CPU+1328,
+  * mapped+1344, 331776 bytes. Publication 0x8454684 binds B+0x1f8. */
+ g->region_b_pointers.header_1f8_va=agx21_memory_firmware_va(m,AGX21_MEM_LOG_PAYLOAD);
+ g->logging=(struct agx21_output_binding){
+  agx21_memory_firmware_va(m,AGX21_MEM_LOG_STATES),
+  agx21_memory_firmware_va(m,AGX21_MEM_LOG_RING)};
+ g->trace=(struct agx21_output_binding){
+  agx21_memory_firmware_va(m,AGX21_MEM_TRACE_STATE),
+  agx21_memory_firmware_va(m,AGX21_MEM_TRACE_RING)};
+ g->statistics=(struct agx21_output_binding){
+  agx21_memory_firmware_va(m,AGX21_MEM_STATS_STATE),
+  agx21_memory_firmware_va(m,AGX21_MEM_STATS_RING)};
+ g->region_b_pointers.ta_stats_va=agx21_memory_firmware_va(m,AGX21_MEM_TA_STATS);
+ g->region_b_pointers.render_stats_va=agx21_memory_firmware_va(m,AGX21_MEM_3D_STATS);
+ g->region_b_pointers.compute_stats_va=agx21_memory_firmware_va(m,AGX21_MEM_CP_STATS);
+ g->region_b_pointers.fault_info_va=agx21_memory_firmware_va(m,AGX21_MEM_FAULT);
+ g->region_b_pointers.firmware_generations_va=agx21_memory_firmware_va(m,AGX21_MEM_FW_GEN);
+ for (i=0;i<13;i++) {
+  u64 state=agx21_memory_firmware_va(m,AGX21_MEM_INPUT_STATE_BASE+i);
+  g->inputs[i]=(struct agx21_input_binding){state,state+4,state+0x20,
+    agx21_memory_firmware_va(m,AGX21_MEM_INPUT_RING_BASE+i)};
+ }
+ g->event_state_va=agx21_memory_firmware_va(m,AGX21_MEM_EVENT_STATE);
+ g->event_ring_va=agx21_memory_firmware_va(m,AGX21_MEM_EVENT_RING);
+ g->mapping_state_va=agx21_memory_firmware_va(m,AGX21_MEM_MAP_STATE);
+ g->mapping_ring_va=agx21_memory_firmware_va(m,AGX21_MEM_MAP_RING);
+ /* Shared GPU window: exact native u32 root / u64 directory / u64 leaf
+  * format. Each page-table allocation is 16 KiB, including unused padding.
+  */
+ for (i=0;i<6;i++) {
+  u8 *pt=agx21_memory_cpu(m,AGX21_MEM_SHARED_PT_BASE+i);
+  for (j=0;j<128;j++) write_le(pt+j*8,arena_pa+(u64)i*0x200000+j*AGX21_PAGE+1,8);
+  write_le(agx21_memory_cpu(m,AGX21_MEM_SHARED_PD)+i*8,
+   agx21_memory_physical(m,AGX21_MEM_SHARED_PT_BASE+i)|3,8);
+ }
+ for (i=0;i<AGX21_CONTEXTS;i++) {
+  write_le(agx21_memory_cpu(m,AGX21_MEM_PC_BASE+i)+(AGX21_GPU_SHARED_VA>>30)*4,
+   ((agx21_memory_physical(m,AGX21_MEM_SHARED_PD)>>12)<<4)|1,4);
+  write_le(agx21_memory_cpu(m,AGX21_MEM_CATALOGUES)+i*8,
+   agx21_memory_physical(m,AGX21_MEM_PC_BASE+i),8);
+ }
+ return agx21_queue_initialize(m);
+}
+/* Translate a page-table physical address only if it names an entire owned,
+ * aligned 16 KiB allocation. Never cast a hardware-provided PA to a CPU VA.
+ */
+static u8 *table_from_pa(struct agx21_memory *m, u64 pa)
+{
+ unsigned int i;
+ for (i=AGX21_MEM_PC_BASE;i<AGX21_MAX_OBJECTS;i++)
+  if (m->objects[i].size==AGX21_PAGE && agx21_memory_physical(m,i)==pa)
+   return agx21_memory_cpu(m,i);
+ return NULL;
+}
+int agx21_memory_enable_context(struct agx21_memory *m, unsigned int ctx)
+{
+ if (!m || !m->arena || m->size!=AGX21_ARENA_BYTES || m->published ||
+     ctx<AGX21_TEST_CONTEXT || ctx>=AGX21_CONTEXTS ||
+     !agx21_memory_cpu(m,AGX21_MEM_PC_BASE+ctx)) return -1;
+ m->graph.context_masks[ctx/32] |= 1U << (ctx%32);
+ return 0;
+}
+int agx21_memory_map_page_ctx(struct agx21_memory *m, unsigned int ctx,
+ u64 va, u64 pa, int write)
+{
+ u32 i0,i1,i2,need=0,start,next;
+ u8 *pc,*pd=NULL,*pt=NULL;
+ u64 root,entry=0,pd_pa=0,pt_pa=0;
+ unsigned int id,k;
+ if (!m || !m->arena || m->size!=AGX21_ARENA_BYTES || m->published ||
+     ctx<AGX21_TEST_CONTEXT || ctx>=AGX21_CONTEXTS ||
+     !(m->graph.context_masks[ctx/32] & (1U << (ctx%32))) ||
+     (write!=0 && write!=1) || (va&(AGX21_PAGE-1)) || (pa&(AGX21_PAGE-1)) ||
+     va>=AGX21_GPU_SHARED_VA || pa<m->arena_pa ||
+     pa>m->arena_pa+m->size-AGX21_PAGE) return -1;
+ i0=(u32)(va>>30);i1=(u32)((va>>21)&511);i2=(u32)((va>>14)&127);
+ pc=agx21_memory_cpu(m,AGX21_MEM_PC_BASE+ctx);
+ root=read_le(pc+i0*4,4);
+ if (root&1) {
+  pd_pa=(root&0xfffffff0ULL)<<8;
+  pd=table_from_pa(m,pd_pa);
+  if (!pd) return -1;
+  entry=read_le(pd+i1*8,8);
+  if (entry&1) {
+   pt_pa=entry&0xfffffffc00ULL;
+   pt=table_from_pa(m,pt_pa);
+   if (!pt || read_le(pt+i2*8,8)) return -1;
+  } else {
+   if (entry) return -1;
+   need=1;
+  }
+ } else {
+  if (root) return -1;
+  need=2;
+ }
+ /* Reserve capacity for the whole operation BEFORE touching page-table
+  * links. A short pool cannot leave a partially installed root/directory.
+  * Caller serializes this private, pre-publication owner.
+  */
+ next=m->dynamic_next;
+ if (m->used>m->size || next<AGX21_MEM_DYNAMIC_BASE || next>AGX21_MAX_OBJECTS ||
+     need>AGX21_MAX_OBJECTS-next) return -1;
+ start=(m->used+AGX21_PAGE-1)&~(AGX21_PAGE-1);
+ if (start>m->size || need>(m->size-start)/AGX21_PAGE) return -1;
+ for (k=0;k<need;k++) if (m->objects[next+k].size) return -1;
+ if (!pd) {
+  if (agx21_memory_allocate(m,AGX21_PAGE,&id)) return -1;
+  pd=agx21_memory_cpu(m,id);pd_pa=agx21_memory_physical(m,id);
+ }
+ if (!pt) {
+  if (agx21_memory_allocate(m,AGX21_PAGE,&id)) return -1;
+  pt=agx21_memory_cpu(m,id);pt_pa=agx21_memory_physical(m,id);
+ }
+ write_le(pt+i2*8,pa|(write?1:3),8);
+ if (!entry) write_le(pd+i1*8,pt_pa|3,8);
+ if (!root) write_le(pc+i0*4,((pd_pa>>12)<<4)|1,4);
+ return 0;
+}
+int agx21_memory_map_page(struct agx21_memory *m, u64 va, u64 pa, int write)
+{
+ return agx21_memory_map_page_ctx(m,AGX21_TEST_CONTEXT,va,pa,write);
+}
+int agx21_memory_replace_owned_page_ctx(struct agx21_memory *m,
+ unsigned int ctx,u64 va,u64 expected_pa,u64 replacement_pa)
+{
+ u8 *pc,*pd,*pt;
+ u64 root,entry,pte;
+ u32 i0,i1,i2;
+ if (!m || !m->arena || m->size!=AGX21_ARENA_BYTES || !m->published ||
+     ctx<AGX21_TEST_CONTEXT || ctx>=AGX21_CONTEXTS ||
+     !(m->graph.context_masks[ctx/32] & (1U << (ctx%32))) ||
+     (va&(AGX21_PAGE-1)) || va>=AGX21_GPU_SHARED_VA ||
+     !physical_ok(expected_pa,AGX21_PAGE) ||
+     !physical_ok(replacement_pa,AGX21_PAGE) ||
+     expected_pa==replacement_pa || expected_pa<m->arena_pa ||
+     replacement_pa<m->arena_pa ||
+     expected_pa>m->arena_pa+m->size-AGX21_PAGE ||
+     replacement_pa>m->arena_pa+m->size-AGX21_PAGE) return -1;
+ i0=(u32)(va>>30);i1=(u32)((va>>21)&511);i2=(u32)((va>>14)&127);
+ pc=agx21_memory_cpu(m,AGX21_MEM_PC_BASE+ctx);
+ if (!pc) return -1;
+ root=read_le(pc+i0*4,4);
+ if (!(root&1)) return -1;
+ pd=table_from_pa(m,(root&0xfffffff0ULL)<<8);
+ if (!pd) return -1;
+ entry=read_le(pd+i1*8,8);
+ if (!(entry&1)) return -1;
+ pt=table_from_pa(m,entry&0xfffffffc00ULL);
+ if (!pt) return -1;
+ pte=read_le(pt+i2*8,8);
+ if (pte!=(expected_pa|1ULL)) return -1;
+ write_le(pt+i2*8,replacement_pa|1ULL,8);
+ return 0;
+}
+int agx21_memory_request_tlb_flush(struct agx21_memory *m,
+ unsigned int ctx,u32 *old_fw_generation,u32 *new_host_generation)
+{
+ u8 *host,*firmware;
+ u32 fw,next;
+ if (!m || !m->arena || m->size!=AGX21_ARENA_BYTES || !m->published ||
+     ctx<AGX21_TEST_CONTEXT || ctx>=AGX21_CONTEXTS ||
+     !(m->graph.context_masks[ctx/32] & (1U << (ctx%32))) ||
+     !old_fw_generation || !new_host_generation) return -1;
+ host=agx21_memory_cpu(m,AGX21_MEM_HOST_GEN);
+ firmware=agx21_memory_cpu(m,AGX21_MEM_FW_GEN);
+ if (!host || !firmware ||
+     m->objects[AGX21_MEM_HOST_GEN].size<(ctx+1)*4 ||
+     m->objects[AGX21_MEM_FW_GEN].size<(ctx+1)*4) return -1;
+ fw=(u32)read_le(firmware+ctx*4,4);
+ next=fw+(1U<<22);
+ write_le(host+ctx*4,next,4);
+ *old_fw_generation=fw;*new_host_generation=next;
+ return 0;
+}
diff --git a/drivers/gpu/drm/agx/agx_21b91_memory.h b/drivers/gpu/drm/agx/agx_21b91_memory.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_memory.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_MEMORY_H
+#define AGX_21B91_MEMORY_H
+#include "agx_21b91_init.h"
+#define AGX21_PAGE 0x4000U
+#define AGX21_RENDER_MAX_WIDTH 2048U
+#define AGX21_RENDER_MAX_HEIGHT 2160U
+#define AGX21_RENDER_TILEMAP_BYTES 0x20000U
+#define AGX21_RENDER_TPC_BYTES 0x30000U
+#define AGX21_ARENA_BYTES 0xc00000U
+#define AGX21_CONTEXTS 64U
+#define AGX21_TEST_CONTEXT 16U
+/* Host-owned VA choices, not captured Apple addresses. Mapping descriptors
+ * establish the firmware view; the GPU uses separate 40-bit page tables.
+ */
+#define AGX21_FIRMWARE_SHARED_VA 0xffffffffc0000000ULL
+#define AGX21_GPU_SHARED_VA 0x8000000000ULL
+#define AGX21_MAX_OBJECTS 192U
+
+enum agx21_memory_id {
+ AGX21_MEM_B, AGX21_MEM_C, AGX21_MEM_STARTUP, AGX21_MEM_AUX,
+ AGX21_MEM_POWER, AGX21_MEM_HWB, AGX21_MEM_HWA, AGX21_MEM_TA_STATS,
+ AGX21_MEM_3D_STATS, AGX21_MEM_CP_STATS, AGX21_MEM_FAULT,
+ AGX21_MEM_HEADER10, AGX21_MEM_HOST_GEN, AGX21_MEM_FW_GEN,
+ AGX21_MEM_CATALOGUES, AGX21_MEM_MAP_STATE, AGX21_MEM_MAP_RING,
+ AGX21_MEM_EVENT_STATE, AGX21_MEM_EVENT_RING, AGX21_MEM_COMMAND,
+ AGX21_MEM_EVENT_CONTROL, AGX21_MEM_MICROSEQUENCE, AGX21_MEM_SCRATCH,
+ AGX21_MEM_QUEUE_INFO, AGX21_MEM_QUEUE_POINTERS, AGX21_MEM_QUEUE_RING,
+ AGX21_MEM_JOB_LIST, AGX21_MEM_QUEUE_CONTEXT, AGX21_MEM_QUEUE_GBUF,
+ AGX21_MEM_LOG_PAYLOAD, AGX21_MEM_LOG_STATES, AGX21_MEM_LOG_RING,
+ AGX21_MEM_TRACE_STATE, AGX21_MEM_TRACE_RING,
+ AGX21_MEM_STATS_STATE, AGX21_MEM_STATS_RING,
+ AGX21_MEM_INPUT_STATE_BASE,
+ AGX21_MEM_INPUT_RING_BASE=AGX21_MEM_INPUT_STATE_BASE+13,
+ AGX21_MEM_PC_BASE=AGX21_MEM_INPUT_RING_BASE+13,
+ AGX21_MEM_SHARED_PD=AGX21_MEM_PC_BASE+AGX21_CONTEXTS,
+ AGX21_MEM_SHARED_PT_BASE,
+ AGX21_MEM_DYNAMIC_BASE=AGX21_MEM_SHARED_PT_BASE+6
+};
+struct agx21_memory_object {
+ u32 offset, size, reserved;
+};
+/* Offline render staging only. These are separate from the proven CP objects;
+ * reserving them does not publish a channel or enable DRM render submission.
+ */
+struct agx21_render_staging {
+ unsigned int queue[2][5]; /* info, pointers, ring, list, context */
+ unsigned int command[2];  /* TA type 0, 3D type 1 */
+};
+/* A deliberately bounded 300x200 first-render candidate. The four objects
+ * remain disjoint from the CP queue and the two render command pages. */
+struct agx21_render_resources {
+ unsigned int metadata, tilemap, tpc, parameter_heap;
+ unsigned int scene, pre, mtile, mlist, vheap, pm_slots;
+};
+struct agx21_memory {
+ u8 *arena, *init_cpu, *table_cpu, *boot_cpu;
+ u64 arena_pa, init_pa, table_pa, boot_pa;
+ u64 firmware_va;
+ u32 size, used, dynamic_next, published;
+ u32 queue_header_initialized, queue_context_initialized;
+ u32 event_control_initialized, event_control_armed;
+ u32 render_staging_reserved;
+ u32 render_queue_headers_initialized;
+ u32 render_policy_candidate_ready;
+ struct agx21_render_staging render_ids;
+ u32 render_resources_reserved;
+ struct agx21_render_resources render_resources;
+ struct agx21_memory_object objects[AGX21_MAX_OBJECTS];
+ struct agx21_init_graph graph;
+};
+/* CPU buffers: arena 12 MiB, init/table/boot each 16 KiB. All must be disjoint.
+ * Addresses are independently checked physical values, NOT arbitrary DMA IOVAs.
+ * Output bytes are not changed on framing/range errors. Initializes the known
+ * layout and empty GPU mappings; does not invent native hardware policy or
+ * populate hardware policy. B+0x1f8 is the native 0x51000-byte log payload
+ * allocation. No firmware message is sent.
+ */
+int agx21_memory_prepare(struct agx21_memory *m, u8 *arena, u64 arena_pa,
+ u8 *init_cpu, u64 init_pa, u8 *table_cpu, u64 table_pa,
+ u8 *boot_cpu, u64 boot_pa);
+u8 *agx21_memory_cpu(struct agx21_memory *m, unsigned int id);
+u64 agx21_memory_firmware_va(const struct agx21_memory *m, unsigned int id);
+u64 agx21_memory_physical(const struct agx21_memory *m, unsigned int id);
+/* Legacy one-job wrapper, pinned to context 16. */
+int agx21_memory_map_page(struct agx21_memory *m, u64 gpu_va, u64 pa, int write);
+/* Pre-publication context planning for the future J171 DRM VM path. Contexts
+ * 16..63 may be enabled explicitly; no live TLB mutation is provided here.
+ * Mapping is restricted to owned RAM and cannot replace an existing PTE.
+ */
+int agx21_memory_enable_context(struct agx21_memory *m, unsigned int ctx);
+int agx21_memory_map_page_ctx(struct agx21_memory *m, unsigned int ctx,
+ u64 gpu_va, u64 pa, int write);
+/* Test-only live remap of an already-present writable PTE. Caller must have
+ * retired the preceding job, serialize access, order PTE before generation,
+ * and retain both owned pages until reboot. No table allocation or free.
+ */
+int agx21_memory_replace_owned_page_ctx(struct agx21_memory *m,
+ unsigned int ctx,u64 gpu_va,u64 expected_pa,u64 replacement_pa);
+/* BadApple-style generation request, relative to the firmware's current
+ * generation. Caller orders PTE writes before this and doorbell after it.
+ */
+int agx21_memory_request_tlb_flush(struct agx21_memory *m,
+ unsigned int ctx,u32 *old_fw_generation,u32 *new_host_generation);
+int agx21_memory_allocate(struct agx21_memory *m, u32 bytes, unsigned int *id);
+int agx21_memory_reserve_render_staging(struct agx21_memory *m,
+ struct agx21_render_staging *out);
+int agx21_memory_reserve_render_resources(struct agx21_memory *m,
+ struct agx21_render_resources *out);
+/* 21B91 firmware init copies RegionB+0x2d0 into its PM slot-table global. */
+int agx21_render_bind_pm_slots(struct agx21_memory *m);
+#endif
diff --git a/drivers/gpu/drm/agx/agx_21b91_power.c b/drivers/gpu/drm/agx/agx_21b91_power.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_power.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/of.h>
+#include <linux/string.h>
+#include <linux/slab.h>
+#include "agx_21b91_power.h"
+
+int agx21_read_power_tables(struct device *dev, struct agx21_power_tables *out)
+{
+ struct device_node *np = dev->of_node;
+ const char *build;
+ u32 *scratch, *core, *sram;
+ u32 n, tables, words, i, t, c;
+ u32 policy[AGX21_POLICY_WORDS] = {0};
+ u64 present = 0;
+ static const char *const policy_names[AGX21_POLICY_WORDS] = {
+  "apple,g11-policy-gpu-device-max-power",
+  "apple,g11-policy-gpu-max-power",
+  "apple,g11-policy-gpu-perf-base-pstate",
+  "apple,g11-policy-gpu-perf-filter-drop-threshold",
+  "apple,g11-policy-gpu-perf-filter-time-constant",
+  "apple,g11-policy-gpu-perf-filter-time-constant2",
+  "apple,g11-policy-gpu-perf-integral-gain",
+  "apple,g11-policy-gpu-perf-integral-gain2",
+  "apple,g11-policy-gpu-perf-integral-min-clamp",
+  "apple,g11-policy-gpu-perf-limiter-filter-time-constant",
+  "apple,g11-policy-gpu-perf-proportional-gain",
+  "apple,g11-policy-gpu-perf-proportional-gain2",
+  "apple,g11-policy-gpu-power-sample-period",
+  "apple,g11-policy-gpu-ppm-filter-time-constant-ms",
+  "apple,g11-policy-gpu-ppm-ki",
+  "apple,g11-policy-gpu-ppm-kp",
+  "apple,g11-policy-gpu-pwr-integral-gain",
+  "apple,g11-policy-gpu-pwr-integral-min-clamp",
+  "apple,g11-policy-gpu-pwr-min-duty-cycle",
+  "apple,g11-policy-gpu-pwr-proportional-gain",
+  "apple,g11-policy-gpu-pwr-sample-period-aic-clks",
+  "apple,g11-policy-gpu-avg-power-filter-tc-ms",
+  "apple,g11-policy-gpu-avg-power-input-filter-tc",
+  "apple,g11-policy-gpu-avg-power-ki",
+  "apple,g11-policy-gpu-avg-power-ki-only",
+  "apple,g11-policy-gpu-avg-power-kp",
+  "apple,g11-policy-gpu-avg-power-min-duty-cycle",
+  "apple,g11-policy-gpu-avg-power-target-filter-tc",
+  "apple,g11-policy-gpu-fast-die0-sensor-mask",
+  "apple,g11-policy-gpu-fender-idle-off-delay-ms",
+  "apple,g11-policy-gpu-perf-boost-ce-step",
+  "apple,g11-policy-gpu-perf-boost-min-util",
+  "apple,g11-policy-gpu-perf-reset-iters",
+  "apple,g11-policy-gpu-power-zone-filter-tc-0",
+  "apple,g11-policy-gpu-power-zone-filter-tc-1",
+  "apple,g11-policy-gpu-power-zone-filter-tc-2",
+  "apple,g11-policy-gpu-power-zone-filter-tc-3",
+  "apple,g11-policy-gpu-power-zone-filter-tc-4",
+  "apple,g11-policy-gpu-power-zone-target-0",
+  "apple,g11-policy-gpu-power-zone-target-1",
+  "apple,g11-policy-gpu-power-zone-target-2",
+  "apple,g11-policy-gpu-power-zone-target-3",
+  "apple,g11-policy-gpu-power-zone-target-4",
+  "apple,g11-policy-gpu-power-zone-target-offset-0",
+  "apple,g11-policy-gpu-power-zone-target-offset-1",
+  "apple,g11-policy-gpu-power-zone-target-offset-2",
+  "apple,g11-policy-gpu-power-zone-target-offset-3",
+  "apple,g11-policy-gpu-power-zone-target-offset-4",
+  "apple,g11-policy-gpu-se-engagement-criteria",
+  "apple,g11-policy-gpu-se-filter-time-constant-1",
+  "apple,g11-policy-gpu-se-inactive-threshold",
+  "apple,g11-policy-gpu-se-ki",
+  "apple,g11-policy-gpu-se-ki-1",
+  "apple,g11-policy-gpu-se-kp",
+  "apple,g11-policy-gpu-se-kp-1",
+  "apple,g11-policy-gpu-se-reset-criteria",
+  "apple,g11-policy-gpu-pwr-filter-time-constant",
+  "apple,g11-policy-gpu-perf-tgt-utilization",
+ };
+ int ret;
+ if (!out || !np || !of_machine_is_compatible("apple,j171a"))
+  return -ENODEV;
+ if (of_property_read_string(np, "apple,g11-firmware-build", &build) || strcmp(build,"21B91"))
+  return -EINVAL;
+ if (of_property_read_u32(np,"apple,g11-state-count",&n) ||
+     of_property_read_u32(np,"apple,g11-table-count",&tables) ||
+     n < 2 || n > 16 || tables < 1 || tables > 8)
+  return -EINVAL;
+ words = n*tables*2;
+ if (of_property_count_u32_elems(np,"apple,g11-core-perf-states") != (int)words ||
+     of_property_count_u32_elems(np,"apple,g11-sram-perf-states") != (int)words)
+  return -EINVAL;
+ scratch = kmalloc_array(words * 2, sizeof(*scratch), GFP_KERNEL);
+ if (!scratch) return -ENOMEM;
+ core = scratch; sram = scratch + words;
+ ret = of_property_read_u32_array(np,"apple,g11-core-perf-states",core,words);
+ if (ret) goto free_scratch;
+ ret = of_property_read_u32_array(np,"apple,g11-sram-perf-states",sram,words);
+ if (ret) goto free_scratch;
+ for (t=0; t<tables; t++) {
+  for (i=0; i<n; i++) {
+   u32 k=2*(t*n+i), hz=core[k];
+   if (hz != sram[k] || hz != core[2*i] || !core[k+1] || !sram[k+1] ||
+       (i == 0 ? hz != 0 : hz <= core[k-2]) || hz % 1000000)
+    { ret = -EINVAL; goto free_scratch; }
+  }
+ }
+ /* Import the same bounded raw-word allowlist handed off by m1n1. */
+ for (i=0;i<AGX21_POLICY_WORDS;i++) {
+  if (!of_find_property(np,policy_names[i],NULL)) continue;
+  if (of_property_count_u32_elems(np,policy_names[i]) != 1) {
+   ret = -EINVAL; goto free_scratch;
+  }
+  ret = of_property_read_u32(np,policy_names[i],&policy[i]);
+  if (ret) goto free_scratch;
+  present |= 1ULL << i;
+ }
+ /* No partial output on errors; unused state rows are always zero. */
+ memset(out,0,sizeof(*out));
+ out->states=n; out->tables=tables;
+ out->policy_present=present;
+ memcpy(out->policy,policy,sizeof(policy));
+ for (i=0; i<n; i++) {
+  out->mhz[i]=core[2*i]/1000000;
+  for (c=0; c<8; c++) {
+   t=c < tables ? c : 0;
+   out->core[8*i+c]=core[2*(t*n+i)+1];
+   out->sram[8*i+c]=sram[2*(t*n+i)+1];
+  }
+ }
+ ret = 0;
+free_scratch:
+ kfree(scratch);
+ return ret;
+}
diff --git a/drivers/gpu/drm/agx/agx_21b91_power.h b/drivers/gpu/drm/agx/agx_21b91_power.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_power.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_POWER_H
+#define AGX_21B91_POWER_H
+#include "agx-21b91-layout.h"
+struct device;
+struct platform_device;
+int agx21_transport_probe(struct platform_device *pdev);
+/* Native raw property words: float coefficients remain IEEE-754 bits.
+ * A clear presence bit is absence, not a request to overwrite native defaults.
+ */
+#define AGX21_POLICY_WORDS 58
+struct agx21_power_tables {
+ u32 states, tables;
+ u64 policy_present;
+ u32 policy[AGX21_POLICY_WORDS];
+ u32 mhz[AGX21_MAX_PSTATES];
+ u32 core[AGX21_MAX_PSTATES * AGX21_VOLTAGE_COLUMNS];
+ u32 sram[AGX21_MAX_PSTATES * AGX21_VOLTAGE_COLUMNS];
+};
+/* Read-only calibration import. Bounded temporary allocation; no firmware startup or rail writes. */
+int agx21_read_power_tables(struct device *dev, struct agx21_power_tables *out);
+#endif
diff --git a/drivers/gpu/drm/agx/agx_21b91_protocol.c b/drivers/gpu/drm/agx/agx_21b91_protocol.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_protocol.c
@@ -0,0 +1,384 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "agx_21b91_protocol.h"
+#ifdef AGX_ABI_HOST_TEST
+#include <string.h>
+#else
+#include <linux/string.h>
+#endif
+#define AGX21_MSG_INIT (0x81ULL<<48)
+#define AGX21_MSG_DOORBELL (0x83ULL<<48)
+static u32 read32(const u8 *p)
+{
+ const volatile u8 *v=p;
+ return (u32)v[0]|((u32)v[1]<<8)|((u32)v[2]<<16)|((u32)v[3]<<24);
+}
+static u64 read64(const u8 *p)
+{
+ return read32(p)|((u64)read32(p+4)<<32);
+}
+static void write32(u8 *p,u32 v)
+{
+ unsigned int i;
+ for (i=0;i<4;i++) p[i]=(u8)(v>>(8*i));
+}
+static void write64(u8 *p,u64 v)
+{
+ write32(p,(u32)v);write32(p+4,(u32)(v>>32));
+}
+static int fail(struct agx21_protocol *p,int error)
+{
+ p->phase=AGX21_PROTOCOL_FAILED;
+ p->error=error;
+ return error;
+}
+int agx21_protocol_open(struct agx21_protocol *p,struct agx21_memory *m,
+ const struct agx21_protocol_io *io)
+{
+ struct agx21_protocol_io saved;
+ unsigned long a=(unsigned long)p;
+ const u8 *buffers[5];size_t sizes[5];unsigned int i;
+ if (!p || !m || !io || !io->send || !io->now_ms || !io->sleep_ms ||
+     !io->crashed || !io->release || !io->acquire || m->published ||
+     m->size!=AGX21_ARENA_BYTES || !m->arena || !m->init_cpu ||
+     a>(~0UL)-sizeof(*p)) return -22;
+ saved=*io;
+ buffers[0]=m->arena;sizes[0]=m->size;
+ buffers[1]=m->init_cpu;sizes[1]=AGX21_PAGE;
+ buffers[2]=m->table_cpu;sizes[2]=AGX21_PAGE;
+ buffers[3]=m->boot_cpu;sizes[3]=AGX21_PAGE;
+ buffers[4]=(const u8 *)m;sizes[4]=sizeof(*m);
+ for (i=0;i<5;i++) {
+  unsigned long b=(unsigned long)buffers[i];
+  if (!b || b>(~0UL)-sizes[i] || (a<b+sizes[i] && b<a+sizeof(*p))) return -22;
+ }
+ if (agx21_bind_init_graph(&m->graph)) return -22;
+ memset(p,0,sizeof(*p));p->memory=m;p->io=saved;
+ return 0;
+}
+static int drain_events(struct agx21_protocol *p)
+{
+ struct agx21_memory *m=p->memory;
+ u8 *state=agx21_memory_cpu(m,AGX21_MEM_EVENT_STATE);
+ u8 *ring=agx21_memory_cpu(m,AGX21_MEM_EVENT_RING);
+ u32 r=read32(state),w=read32(state+0x20),type;
+ u64 bitmap[2];
+ if (r>=256 || w>=256) return fail(p,-5);
+ while (r!=w) {
+  int ret=agx21_decode_event(ring+r*AGX21_EVENT_RECORD_SIZE,
+   AGX21_EVENT_RECORD_SIZE,&type,bitmap);
+  if (ret<0) return fail(p,-5);
+  /* Even a matching notification is not a completion proof. */
+  p->event_records++;r=(r+1)&255;
+ }
+ p->io.release(p->io.cookie);write32(state,r);
+ return 0;
+}
+/* Outbound state is 0x30 bytes per native allocation. Six logging states
+ * share one array; trace/statistics each have one state. Discard records only
+ * after acquire, then publish consumer with release, avoiding log backpressure.
+ */
+static int drain_diagnostics(struct agx21_protocol *p)
+{
+ static const unsigned int ids[]={AGX21_MEM_LOG_STATES,
+  AGX21_MEM_TRACE_STATE,AGX21_MEM_STATS_STATE};
+ unsigned int i,j;
+ for (i=0;i<3;i++) {
+  u8 *state=agx21_memory_cpu(p->memory,ids[i]);
+  for (j=0;j<(i==0?6U:1U);j++) {
+   u8 *one=state+0x30*j;u32 r=read32(one),w=read32(one+0x20);
+   if (r>=256 || w>=256) return fail(p,-74);
+   if (r!=w) { p->io.release(p->io.cookie);write32(one,w); }
+  }
+ }
+ return 0;
+}
+int agx21_protocol_drain_idle(struct agx21_protocol *p)
+{
+ if (!p || !p->memory || !p->io.acquire || !p->io.release)
+  return -22;
+ if (p->phase!=AGX21_PROTOCOL_READY &&
+     p->phase!=AGX21_PROTOCOL_COMPLETE &&
+     p->phase!=AGX21_PROTOCOL_VERIFIED)
+  return 0; /* synchronous submit/wait owns all consumers */
+ if (p->io.crashed(p->io.cookie)) return fail(p,-5);
+ p->io.acquire(p->io.cookie);
+ if (drain_events(p) || drain_diagnostics(p)) return p->error;
+ return 0;
+}
+int agx21_protocol_init(struct agx21_protocol *p,u32 timeout_ms)
+{
+ u64 start;
+ u8 *status;
+ if (!p || !p->memory || !p->io.send || p->phase!=AGX21_PROTOCOL_NEW || !timeout_ms || timeout_ms>30000)
+  return -22;
+ status=agx21_memory_cpu(p->memory,AGX21_MEM_STARTUP);
+ if (p->io.crashed(p->io.cookie) || read32(status+0x14)) return fail(p,-5);
+ p->io.release(p->io.cookie);
+ p->memory->published=1;p->phase=AGX21_PROTOCOL_INIT_SENT;
+ start=p->io.now_ms(p->io.cookie);
+ if (p->io.send(p->io.cookie,0x20,AGX21_MSG_INIT|p->memory->init_pa))
+  return fail(p,-5);
+ for (;;) {
+  u32 ack;
+  if (p->io.crashed(p->io.cookie)) return fail(p,-5);
+  p->io.acquire(p->io.cookie);
+  if (drain_diagnostics(p)) return p->error;
+  ack=read32(status+0x14);
+  if (ack==1) { p->phase=AGX21_PROTOCOL_READY;return 0; }
+  if (ack) return fail(p,-74);
+  if (p->io.now_ms(p->io.cookie)-start>=timeout_ms) return fail(p,-110);
+  p->io.sleep_ms(p->io.cookie,1);
+ }
+}
+int agx21_protocol_submit(struct agx21_protocol *p,u32 expected,u64 trace_token,
+ u64 queue_metadata,u64 completion_primary_va,u64 completion_retire_va)
+{
+ struct agx21_memory *m;
+ u8 *state,*ring,*command,*scratch,*queue,*queue_info,*queue_gbuf,*pointers,*event_control,*microseq;
+ u32 next,w,event_offset,counter_offset;
+ u64 command_va,queue_va;
+ unsigned int command_id,microseq_id,event_id,scratch_id;
+ if (!p || !p->memory || !p->io.send || p->phase!=AGX21_PROTOCOL_READY ||
+     p->jobs>=(p->max_jobs ? p->max_jobs : 2) ||
+     agx21_next_stamp(p->stamp,p->stamp,&next) || expected!=next ||
+     !completion_primary_va || !completion_retire_va ||
+     completion_primary_va==completion_retire_va)
+  return -22;
+ m=p->memory;
+ command_id=p->custom_job?p->command_object:AGX21_MEM_COMMAND;
+ microseq_id=p->custom_job?p->microseq_object:AGX21_MEM_MICROSEQUENCE;
+ event_id=p->custom_job?p->event_object:AGX21_MEM_EVENT_CONTROL;
+ scratch_id=p->custom_job?p->scratch_object:AGX21_MEM_SCRATCH;
+ event_offset=p->custom_job?0:p->jobs*192;
+ counter_offset=p->custom_job?0x20:0x20+p->jobs*4;
+ state=agx21_memory_cpu(m,AGX21_MEM_INPUT_STATE_BASE+2);
+ ring=agx21_memory_cpu(m,AGX21_MEM_INPUT_RING_BASE+2);
+ command=agx21_memory_cpu(m,command_id);
+ microseq=agx21_memory_cpu(m,microseq_id);
+ scratch=agx21_memory_cpu(m,scratch_id);
+ event_control=agx21_memory_cpu(m,event_id);
+ queue=agx21_memory_cpu(m,AGX21_MEM_QUEUE_RING);
+ queue_info=agx21_memory_cpu(m,AGX21_MEM_QUEUE_INFO);
+ queue_gbuf=agx21_memory_cpu(m,AGX21_MEM_QUEUE_GBUF);
+ pointers=agx21_memory_cpu(m,AGX21_MEM_QUEUE_POINTERS);
+ command_va=agx21_memory_firmware_va(m,command_id);
+ queue_va=agx21_memory_firmware_va(m,AGX21_MEM_QUEUE_INFO);
+ if (p->io.crashed(p->io.cookie)) return fail(p,-5);
+ p->io.acquire(p->io.cookie);w=read32(state+0x20);
+ if (!state || !ring || !pointers || !command || !scratch || !queue ||
+     !queue_info || !queue_gbuf || !microseq || !m->queue_header_initialized || !m->queue_context_initialized ||
+     !m->event_control_initialized || !m->event_control_armed || !event_control ||
+     m->objects[event_id].size<event_offset+192 ||
+     read64(event_control+event_offset)!=
+       agx21_memory_firmware_va(m,scratch_id)+counter_offset ||
+     read64(event_control+event_offset+168)!=~0ULL ||
+     read32(pointers+0x50)!=256 || read32(queue_info+0x30)!=0 ||
+     /* Firmware advances ptrs[0] as it retires each command. BadApple's
+      * repeated queue pushes do not require this word to remain zero. */
+     read32(pointers)!=p->jobs || read32(pointers+0x40)!=p->jobs ||
+     w!=p->jobs || read32(state)!=p->jobs || read32(state+4)>w ||
+     read32(queue_info+0x20)!=p->jobs || read32(queue_info+0x28)!=p->jobs ||
+     read32(pointers+0x30)!=p->jobs ||
+     ((w+1)&255)==read32(state) || read32(command)!=3 ||
+     (p->context && (p->context<AGX21_TEST_CONTEXT ||
+       p->context>=AGX21_CONTEXTS ||
+       !(m->graph.context_masks[p->context/32] & (1U<<(p->context%32))))) ||
+     read32(command+0x10)!=(p->context ? p->context : AGX21_TEST_CONTEXT) ||
+     read64(command+0x1f0)!=agx21_memory_firmware_va(m,microseq_id) ||
+     (read64(command+0x1f8)!=320 && read64(command+0x1f8)!=384) ||
+     read64(command+0x1f8)>m->objects[microseq_id].size ||
+     (read32(microseq)&63)!=(read64(command+0x1f8)==384 ? 31U : 41U) ||
+     read64(command+0x14)!=agx21_memory_firmware_va(m,event_id)+event_offset ||
+     read64(command+0x278)!=completion_primary_va ||
+     read64(command+0x280)!=completion_retire_va ||
+     completion_primary_va!=agx21_memory_firmware_va(m,scratch_id)+0x14 ||
+     completion_retire_va!=agx21_memory_firmware_va(m,scratch_id)+0x10 ||
+     read64(command+0x70)==0 || read64(command+0x78)==0 ||
+     read64(microseq+264)!=completion_retire_va ||
+     read32(microseq+272)!=expected ||
+     read32(command+0x288)!=expected ||
+     /* Native 0x842c4a4 copies a qword from a2's virtual getter at +216
+      * into +0x288; firmware 0x1ac44 uses its low word for tracing.
+      * It is NOT the completion stamp at scratch+0x10/+0x14. */
+     read64(command+0x288)!=trace_token ||
+     read32(command+0x298)!=(u32)queue_metadata ||
+     read32(command+0x290)!=0 ||
+     read32(scratch+0x10)!=p->stamp ||
+     read32(scratch+0x14)!=p->stamp) return fail(p,-5);
+ memset(ring+w*AGX21_RUN_RECORD_SIZE,0,AGX21_RUN_RECORD_SIZE);
+ if (agx21_patch_compute_run(ring+w*AGX21_RUN_RECORD_SIZE,
+       AGX21_RUN_RECORD_SIZE,queue_va,w+1,3,1)) return fail(p,-5);
+ write64(queue+w*8,command_va);
+ /* Native channel enqueue (0x842a054): publish command pointer before
+  * advancing the queue producer; its +256 metadata ring receives the
+  * fourth argument, descriptor+256 in WorkCommandCP 0x842c9ec. */
+ write64(queue_gbuf+w*8,queue_metadata);
+ p->io.release(p->io.cookie);write32(pointers+0x40,w+1);
+ p->io.release(p->io.cookie);write32(state+0x20,(w+1)&255);
+ p->io.release(p->io.cookie);p->stamp=expected;p->jobs++;p->phase=AGX21_PROTOCOL_JOB_SENT;
+ if (p->io.send(p->io.cookie,0x21,AGX21_MSG_DOORBELL|2)) return fail(p,-5);
+ return 0;
+}
+int agx21_protocol_wait(struct agx21_protocol *p,u32 timeout_ms)
+{
+ u8 *scratch,*command;u64 start;
+ if (!p || !p->memory || !p->io.send || p->phase!=AGX21_PROTOCOL_JOB_SENT || !timeout_ms || timeout_ms>30000)
+  return -22;
+ scratch=agx21_memory_cpu(p->memory,p->custom_job?p->scratch_object:AGX21_MEM_SCRATCH);
+ command=agx21_memory_cpu(p->memory,p->custom_job?p->command_object:AGX21_MEM_COMMAND);
+ start=p->io.now_ms(p->io.cookie);
+ for (;;) {
+  if (p->io.crashed(p->io.cookie)) return fail(p,-5);
+  p->io.acquire(p->io.cookie);
+  if (read32(command+0x2e0)) return fail(p,-5);
+  if (drain_events(p) || drain_diagnostics(p)) return p->error;
+  if (read32(scratch+0x10)==p->stamp && read32(scratch+0x14)==p->stamp) {
+   p->phase=AGX21_PROTOCOL_COMPLETE;return 0;
+  }
+  if (p->io.now_ms(p->io.cookie)-start>=timeout_ms) return fail(p,-110);
+  p->io.sleep_ms(p->io.cookie,1);
+ }
+}
+
+int agx21_protocol_precheck_output(struct agx21_protocol *p,unsigned int object,
+ u32 words,const u32 *expected)
+{
+ u8 *output;unsigned long a,b;u32 i;
+ if (!p || !p->memory || p->phase!=AGX21_PROTOCOL_READY || !expected ||
+     !words || object<AGX21_MEM_DYNAMIC_BASE || object>=AGX21_MAX_OBJECTS ||
+     words>p->memory->objects[object].size/4) return -22;
+ a=(unsigned long)expected;b=(unsigned long)p->memory->arena;
+ if (a>(~0UL)-(size_t)words*4 ||
+     (a<b+p->memory->size && b<a+(size_t)words*4)) return -22;
+ output=agx21_memory_cpu(p->memory,object);
+ if (!output) return -22;
+ p->io.acquire(p->io.cookie);
+ for (i=0;i<words;i++)
+  if (read32(output+4*i)!=0xa5a5a5a5U || expected[i]==0xa5a5a5a5U)
+   return -74;
+ p->output_object=object;p->output_words=words;p->output_prechecked=1;
+ return 0;
+}
+
+int agx21_protocol_wait_output(struct agx21_protocol *p,unsigned int object,
+ u32 words,const u32 *expected,u32 timeout_ms)
+{
+ u8 *command,*output,*state;u64 start;u32 i,matched;
+ if (!p || !p->memory || p->phase!=AGX21_PROTOCOL_JOB_SENT ||
+     !expected || !words || !timeout_ms || timeout_ms>30000 ||
+     object<AGX21_MEM_DYNAMIC_BASE || object>=AGX21_MAX_OBJECTS ||
+     words>p->memory->objects[object].size/4 ||
+     !p->output_prechecked || object!=p->output_object ||
+     words!=p->output_words) return -22;
+ command=agx21_memory_cpu(p->memory,p->custom_job?p->command_object:AGX21_MEM_COMMAND);
+ output=agx21_memory_cpu(p->memory,object);
+ state=agx21_memory_cpu(p->memory,AGX21_MEM_INPUT_STATE_BASE+2);
+ if (!command || !output || !state) return -22;
+ start=p->io.now_ms(p->io.cookie);
+ for (;;) {
+  if (p->io.crashed(p->io.cookie)) return fail(p,-5);
+  p->io.acquire(p->io.cookie);
+  if (read32(command+0x2e0)) return fail(p,-5);
+  if (drain_events(p) || drain_diagnostics(p)) return p->error;
+  matched=1;
+  for (i=0;i<words;i++) if (read32(output+4*i)!=expected[i]) {matched=0;break;}
+  if (matched) {
+   /* Output is the proof; ring consumption adds useful diagnostic context. */
+   p->phase=AGX21_PROTOCOL_COMPLETE;return 0;
+  }
+  if (p->io.now_ms(p->io.cookie)-start>=timeout_ms) return fail(p,-110);
+  p->io.sleep_ms(p->io.cookie,1);
+ }
+}
+
+int agx21_protocol_check_output(struct agx21_protocol *p,unsigned int object,
+ u32 words,const u32 *expected)
+{
+ u8 *output;unsigned long a,b;u32 i;
+ if (!p || !p->memory || p->phase!=AGX21_PROTOCOL_COMPLETE || !expected ||
+     !words || object<AGX21_MEM_DYNAMIC_BASE || object>=AGX21_MAX_OBJECTS ||
+     words>p->memory->objects[object].size/4) return -22;
+ a=(unsigned long)expected;b=(unsigned long)p->memory->arena;
+ if (a>(~0UL)-(size_t)words*4 ||
+     (a<b+p->memory->size && b<a+(size_t)words*4)) return -22;
+ output=agx21_memory_cpu(p->memory,object);
+ if (!output) return -22;
+ p->io.acquire(p->io.cookie);
+ for (i=0;i<words;i++) if (read32(output+4*i)!=expected[i]) return fail(p,-74);
+ p->phase=AGX21_PROTOCOL_VERIFIED;return 0;
+}
+int agx21_protocol_accept_completion(struct agx21_protocol *p)
+{
+ u8 *scratch;
+ if (!p || !p->generic_mode || !p->memory ||
+     p->phase!=AGX21_PROTOCOL_COMPLETE || !p->jobs ||
+     p->io.crashed(p->io.cookie)) return -22;
+ scratch=agx21_memory_cpu(p->memory,
+  p->custom_job?p->scratch_object:AGX21_MEM_SCRATCH);
+ if (!scratch) return -22;
+ p->io.acquire(p->io.cookie);
+ if (read32(scratch+0x10)!=p->stamp ||
+     read32(scratch+0x14)!=p->stamp) return fail(p,-5);
+ p->phase=AGX21_PROTOCOL_VERIFIED;
+ return 0;
+}
+
+int agx21_protocol_retired(struct agx21_protocol *p)
+{
+ u8 *state,*queue_info,*pointers,*scratch;
+ u32 n;
+ if (!p || !p->memory || p->phase!=AGX21_PROTOCOL_VERIFIED ||
+     !p->jobs || p->jobs>(p->max_jobs ? p->max_jobs : 2) ||
+     p->stamp!=p->jobs*0x100) return -22;
+ n=p->jobs;
+ state=agx21_memory_cpu(p->memory,AGX21_MEM_INPUT_STATE_BASE+2);
+ queue_info=agx21_memory_cpu(p->memory,AGX21_MEM_QUEUE_INFO);
+ pointers=agx21_memory_cpu(p->memory,AGX21_MEM_QUEUE_POINTERS);
+ scratch=agx21_memory_cpu(p->memory,
+  p->custom_job?p->scratch_object:AGX21_MEM_SCRATCH);
+ if (!state || !queue_info || !pointers || !scratch ||
+     p->io.crashed(p->io.cookie)) return fail(p,-5);
+ p->io.acquire(p->io.cookie);
+ if (read32(state)!=n || read32(state+4)!=n || read32(state+0x20)!=n ||
+     read32(queue_info+0x20)!=n || read32(queue_info+0x28)!=n ||
+     read32(pointers)!=n || read32(pointers+0x30)!=n ||
+     read32(pointers+0x40)!=n ||
+     read32(scratch+0x10)!=p->stamp || read32(scratch+0x14)!=p->stamp)
+  return fail(p,-5);
+ return 0;
+}
+int agx21_protocol_rearm_next(struct agx21_protocol *p)
+{
+ if (!p || p->jobs>=(p->max_jobs ? p->max_jobs : 2)) return -22;
+ if (agx21_protocol_retired(p)) return p->error ? p->error : -22;
+ p->output_prechecked=0;p->phase=AGX21_PROTOCOL_READY;
+ return 0;
+}
+
+int agx21_protocol_select_job(struct agx21_protocol *p, unsigned int command,
+ unsigned int microseq, unsigned int event, unsigned int scratch)
+{
+ struct agx21_memory *m;
+ if (!p || !p->memory || p->phase!=AGX21_PROTOCOL_READY ||
+     (!p->generic_mode && p->jobs!=1 &&
+      !(p->max_jobs==3 && p->jobs==2 && p->custom_job)) ||
+     (!p->generic_mode && (command<AGX21_MEM_DYNAMIC_BASE ||
+      microseq<AGX21_MEM_DYNAMIC_BASE || event<AGX21_MEM_DYNAMIC_BASE ||
+      scratch<AGX21_MEM_DYNAMIC_BASE)) ||
+     command>=AGX21_MAX_OBJECTS || microseq>=AGX21_MAX_OBJECTS ||
+     event>=AGX21_MAX_OBJECTS || scratch>=AGX21_MAX_OBJECTS ||
+     command==microseq || command==event || command==scratch ||
+     microseq==event || microseq==scratch || event==scratch)
+  return -22;
+ m=p->memory;
+ if (!p->generic_mode && p->custom_job &&
+     (command==p->command_object || microseq==p->microseq_object ||
+      event==p->event_object || scratch==p->scratch_object)) return -22;
+ if (!m->published || m->objects[command].size<AGX21_PAGE ||
+     m->objects[microseq].size<AGX21_PAGE ||
+     m->objects[event].size<192 || m->objects[scratch].size<0x28)
+  return -22;
+ p->command_object=command;p->microseq_object=microseq;
+ p->event_object=event;p->scratch_object=scratch;p->custom_job=1;
+ return 0;
+}
diff --git a/drivers/gpu/drm/agx/agx_21b91_protocol.h b/drivers/gpu/drm/agx/agx_21b91_protocol.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_protocol.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_PROTOCOL_H
+#define AGX_21B91_PROTOCOL_H
+#include "agx_21b91_memory.h"
+/* One serialized firmware session. A failed send can still have reached the
+ * mailbox, so the owner stays pinned on any publication attempt/failure.
+ * Callbacks may not re-enter this session. No live reset or queue reuse.
+ */
+enum agx21_protocol_phase {
+ AGX21_PROTOCOL_NEW, AGX21_PROTOCOL_INIT_SENT, AGX21_PROTOCOL_READY,
+ AGX21_PROTOCOL_JOB_SENT, AGX21_PROTOCOL_COMPLETE, AGX21_PROTOCOL_VERIFIED,
+ AGX21_PROTOCOL_FAILED
+};
+struct agx21_protocol_io {
+ void *cookie;
+ int (*send)(void *cookie, u8 endpoint, u64 message);
+ u64 (*now_ms)(void *cookie);
+ void (*sleep_ms)(void *cookie, u32 milliseconds);
+ int (*crashed)(void *cookie);
+ void (*release)(void *cookie);
+ void (*acquire)(void *cookie);
+};
+struct agx21_protocol {
+ struct agx21_memory *memory;
+ struct agx21_protocol_io io;
+ enum agx21_protocol_phase phase;
+ int error;
+ u32 stamp, event_records, jobs;
+ u32 max_jobs; /* zero defaults to proven two-job limit; suite opts into three */
+ u32 generic_mode; /* Asahi DRM: serial stamp/retirement, output checked by userspace */
+ u32 context; /* 0 means the proven context-16 default */
+ unsigned int output_object;
+ u32 output_words;
+ u32 output_prechecked;
+ u32 custom_job;
+ unsigned int command_object, microseq_object, event_object, scratch_object;
+};
+/* Select a separately owned, pre-published job after the prior job is
+ * verified and retired. Existing fixed-buffer tests leave this unset. */
+int agx21_protocol_select_job(struct agx21_protocol *p, unsigned int command,
+ unsigned int microseq, unsigned int event, unsigned int scratch);
+/* The standalone protocol is host-testable. A live caller must retain
+ * DMA/module/PM and explicitly choose its InitData policy. A sparse policy
+ * test can diagnose a first job, but cannot claim native HWData equivalence.
+ */
+int agx21_protocol_open(struct agx21_protocol *p, struct agx21_memory *memory,
+ const struct agx21_protocol_io *io);
+/* Suite lock held; do not call from an RTKit callback. */
+int agx21_protocol_drain_idle(struct agx21_protocol *p);
+int agx21_protocol_init(struct agx21_protocol *p, u32 timeout_ms);
+/* The caller must build a native command in AGX21_MEM_COMMAND and its matching
+ * sequence/dispatch addresses before calling. Private compute channel 2,
+ * queue-head 1 only. The expected dispatch VAs come from owned mappings.
+ */
+/* Record +0..7 is padding in the observed 21B91 firmware run handler.
+ * Zero it in our owned ring; do not transplant the XS channel header. */
+/* trace_token is the native command+0x288 qword, separate from the
+ * completion stamp. queue_metadata is native WorkCommandCP descriptor+256;
+ * the enqueue path stores it in the parallel 8-byte queue metadata ring.
+ * The caller must obtain both values from its command producer. */
+int agx21_protocol_submit(struct agx21_protocol *p, u32 expected_stamp,
+ u64 trace_token, u64 queue_metadata, u64 completion_primary_va,
+ u64 completion_retire_va);
+/* Before publishing the job, prove the literal output still contains the
+ * 0xa5 sentinel. A match observed after publication may then be immediate. */
+int agx21_protocol_precheck_output(struct agx21_protocol *p,
+ unsigned int object, u32 words, const u32 *expected);
+int agx21_protocol_wait(struct agx21_protocol *p, u32 timeout_ms);
+/* iPad J171 proof: wait for exact shader output, not unproven XS stamps. */
+int agx21_protocol_wait_output(struct agx21_protocol *p, unsigned int object,
+ u32 words, const u32 *expected, u32 timeout_ms);
+/* Exact u32 shader output check, only after both completion stamps. Expected
+ * values must be outside the mutable DMA arena. Success -> VERIFIED. */
+int agx21_protocol_check_output(struct agx21_protocol *p, unsigned int object,
+ u32 words, const u32 *expected);
+/* Generic DRM jobs have no kernel-known expected output.  Confirm both
+ * firmware stamps, then allow the strict queue-retirement check. */
+int agx21_protocol_accept_completion(struct agx21_protocol *p);
+/* After a verified job, refuse rearm unless firmware consumed both queues and
+ * wrote both stamp words. A failed session is never reusable. */
+int agx21_protocol_rearm_next(struct agx21_protocol *p);
+/* Read-only retirement proof for the most recently verified job. */
+int agx21_protocol_retired(struct agx21_protocol *p);
+#endif
diff --git a/drivers/gpu/drm/agx/agx_21b91_queue.c b/drivers/gpu/drm/agx/agx_21b91_queue.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_queue.c
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "agx_21b91_queue.h"
+#include "agx_21b91_memory.h"
+#ifdef AGX_ABI_HOST_TEST
+#include <string.h>
+#else
+#include <linux/string.h>
+#endif
+static void le32(u8 *p,u32 v)
+{
+ unsigned int i;for(i=0;i<4;i++)p[i]=(u8)(v>>(8*i));
+}
+static void le64(u8 *p,u64 v)
+{
+ le32(p,(u32)v);le32(p+4,(u32)(v>>32));
+}
+static int queue_header_for_ids(struct agx21_memory *m,
+ const unsigned int ids[5])
+{
+ static const u32 minimum[]={0x24c0,0x54,256*8,0x18,0x28};
+ unsigned int i,j;u8 *q,*ptr,*list;
+ if(!m||m->published||!m->arena||m->size!=AGX21_ARENA_BYTES)return -1;
+ for(i=0;i<5;i++){
+  const struct agx21_memory_object *o;
+  if(ids[i]>=AGX21_MAX_OBJECTS)return -1;
+  o=&m->objects[ids[i]];
+  if(o->size<minimum[i]||o->offset>m->size-minimum[i]||
+     o->size>m->size-o->offset||
+     !agx21_memory_firmware_va(m,ids[i]))return -1;
+  for(j=0;j<i;j++){
+   const struct agx21_memory_object *other=&m->objects[ids[j]];
+   if(o->offset<other->offset+other->size&&other->offset<o->offset+o->size)return -1;
+  }
+ }
+ q=agx21_memory_cpu(m,ids[0]);
+ ptr=agx21_memory_cpu(m,ids[1]);
+ list=agx21_memory_cpu(m,ids[3]);
+ memset(q,0,0x24c0);memset(ptr,0,0x54);memset(list,0,0x18);
+ /* 21B91 native base queue constructor 0x8428730. */
+ le64(q,agx21_memory_firmware_va(m,ids[1]));
+ le64(q+8,agx21_memory_firmware_va(m,ids[2]));
+ le64(q+0x10,agx21_memory_firmware_va(m,ids[3]));
+ le64(q+0x18,agx21_memory_firmware_va(m,ids[0])+0xb0);
+ le64(q+0xa8,agx21_memory_firmware_va(m,ids[4]));
+ le32(q+0x2c,0xffffffff);le32(q+0x30,4);
+ le32(q+0x4c,0xffffffff);le32(q+0x54,0xffffffff);
+ le32(q+0x50,0);le32(ptr+0x50,256);
+ le64(list+8,agx21_memory_firmware_va(m,ids[3]));
+ return 0;
+}
+int agx21_queue_initialize(struct agx21_memory *m)
+{
+ static const unsigned int ids[]={AGX21_MEM_QUEUE_INFO,AGX21_MEM_QUEUE_POINTERS,
+  AGX21_MEM_QUEUE_RING,AGX21_MEM_JOB_LIST,AGX21_MEM_QUEUE_CONTEXT};
+ if(!m||m->queue_header_initialized||queue_header_for_ids(m,ids))return -1;
+ m->queue_header_initialized=1;
+ return 0;
+}
+int agx21_queue_initialize_render_staging(struct agx21_memory *m,
+ const struct agx21_render_staging *ids)
+{
+ unsigned int ch,k,j;
+ if(!m||!ids||!m->render_staging_reserved||m->published||
+    m->render_queue_headers_initialized)return -1;
+ if(memcmp(ids,&m->render_ids,sizeof(*ids)))return -1;
+ /* Validate both transactions before any writes. The reservation function
+  * provides 10 disjoint, one-page queue objects plus two command pages. */
+ for(ch=0;ch<2;ch++)for(k=0;k<5;k++){
+  const struct agx21_memory_object *o;
+  if(ids->queue[ch][k]<AGX21_MEM_DYNAMIC_BASE||
+     ids->queue[ch][k]>=m->dynamic_next)return -1;
+  o=&m->objects[ids->queue[ch][k]];
+  if(!o->size||o->reserved!=AGX21_PAGE)return -1;
+  for(j=0;j<ch*5+k;j++){
+   unsigned int other=ids->queue[j/5][j%5];
+   if(ids->queue[ch][k]==other)return -1;
+  }
+ }
+ /* queue_header_for_ids validates the native field-size minima. The first
+  * write cannot partially commit if the second set is malformed. */
+ for(ch=0;ch<2;ch++){
+  static const u32 min[]={0x24c0,0x54,256*8,0x18,0x28};
+  for(k=0;k<5;k++)if(m->objects[ids->queue[ch][k]].size<min[k])return -1;
+ }
+ for(ch=0;ch<2;ch++)if(queue_header_for_ids(m,ids->queue[ch]))return -1;
+ m->render_queue_headers_initialized=1;
+ return 0;
+}
+int agx21_queue_stage_render_policy_candidate(struct agx21_memory *m)
+{
+ static const u32 units[2]={1,0};
+ unsigned int ch;
+ if(!m||m->published||!m->render_queue_headers_initialized||
+    m->render_policy_candidate_ready)return -1;
+ for(ch=0;ch<2;ch++){
+  u8 *q=agx21_memory_cpu(m,m->render_ids.queue[ch][0]);
+  u8 *c=agx21_memory_cpu(m,m->render_ids.queue[ch][4]);
+  if(!q||!c||m->objects[m->render_ids.queue[ch][0]].size<0x58||
+     m->objects[m->render_ids.queue[ch][4]].size<0x28||
+     q[0x30]!=4||q[0x31]||q[0x32]||q[0x33])return -1;
+ }
+ for(ch=0;ch<2;ch++){
+  u8 *q=agx21_memory_cpu(m,m->render_ids.queue[ch][0]);
+  u8 *c=agx21_memory_cpu(m,m->render_ids.queue[ch][4]);
+  memset(c,0,0x28);c[0]=0xff;c[1]=0xff;c[5]=1;
+  c[34]=0xff;c[39]=0; /* explicit unverified client policy */
+  le64(q+0x38,~0xffffULL);
+  le32(q+0x44,0);le32(q+0x48,1);
+  le32(q+0x30,0);le32(q+0x34,0);
+  le32(q+0x40,units[ch]);
+ }
+ m->render_policy_candidate_ready=1;
+ return 0;
+}
+
+int agx21_queue_set_test_priority_zero(struct agx21_memory *m,u32 flags)
+{
+ u8 *q;
+ if(!m||m->published||!m->queue_header_initialized||
+    m->objects[AGX21_MEM_QUEUE_INFO].size<0x58||flags)
+  return -1;
+ q=agx21_memory_cpu(m,AGX21_MEM_QUEUE_INFO);
+ if(!q||q[0x30]!=4||q[0x31]||q[0x32]||q[0x33])return -1;
+ /* 0x845541c priority-0 case: x9=-0x10000, w10=0, w11=1,
+  * w8=1; w3 (the caller's flags) is explicit and zero here. */
+ le64(q+0x38,~0xffffULL);
+ le32(q+0x44,flags);
+ le32(q+0x48,1);
+ le32(q+0x30,0);
+ le32(q+0x34,0);
+ le32(q+0x40,1);
+ return 0;
+}
+
+/* Native parent queue start, 0x842f8e0..0x842f918. The final byte comes
+ * from its client policy object and remains an explicit caller input. */
+int agx21_queue_context_initialize(struct agx21_memory *m,u8 native_policy)
+{
+ u8 *c;
+ if(!m||m->published||!m->queue_header_initialized||m->queue_context_initialized||
+    m->objects[AGX21_MEM_QUEUE_CONTEXT].size<0x28)return -1;
+ c=agx21_memory_cpu(m,AGX21_MEM_QUEUE_CONTEXT);if(!c)return -1;
+ memset(c,0,0x28);c[0]=0xff;c[1]=0xff;c[5]=1;c[34]=0xff;c[39]=native_policy;
+ m->queue_context_initialized=1;return 0;
+}
+
+int agx21_event_control_initialize(struct agx21_memory *m)
+{
+ u8 *control,*scratch;
+ const struct agx21_memory_object *ec,*sc;
+ u64 counter_va;
+ if(!m||m->published||m->event_control_initialized||!m->arena||
+    m->size!=AGX21_ARENA_BYTES)return -1;
+ ec=&m->objects[AGX21_MEM_EVENT_CONTROL];
+ sc=&m->objects[AGX21_MEM_SCRATCH];
+ if(ec->size<192||sc->size<0x24||ec->offset>m->size-ec->size||
+    sc->offset>m->size-sc->size||
+    (ec->offset<sc->offset+sc->size&&sc->offset<ec->offset+ec->size))return -1;
+ counter_va=agx21_memory_firmware_va(m,AGX21_MEM_SCRATCH)+0x20;
+ if(!counter_va)return -1;
+ control=agx21_memory_cpu(m,AGX21_MEM_EVENT_CONTROL);
+ scratch=agx21_memory_cpu(m,AGX21_MEM_SCRATCH);
+ if(!control||!scratch)return -1;
+ /* Native AGXCommandBuffer allocates 36 x 192-byte controls and writes
+  * each control's first qword to the matching separate counter VA.
+  * A single serialized compute test needs the first slot only.
+  */
+ memset(control,0,192);memset(scratch+0x20,0,4);
+ le64(control,counter_va);
+ m->event_control_initialized=1;
+ return 0;
+}
+
+int agx21_event_control_arm(struct agx21_memory *m,u32 sequence,u32 budget)
+{
+ u8 *control,*scratch;
+ u64 counter_va;
+ if(!m||m->published||!m->event_control_initialized||m->event_control_armed||
+    !budget)return -1;
+ control=agx21_memory_cpu(m,AGX21_MEM_EVENT_CONTROL);
+ scratch=agx21_memory_cpu(m,AGX21_MEM_SCRATCH);
+ counter_va=agx21_memory_firmware_va(m,AGX21_MEM_SCRATCH)+0x20;
+ if(!control||!scratch||!counter_va)return -1;
+ /* Native 0x842d814 writes the counter VA again after clearing. Its
+  * event budget comes from the configured client limit, not from the
+  * firmware descriptor or a shared-data guess. */
+ memset(control,0,192);memset(scratch+0x20,0,4);
+ le64(control,counter_va);le32(control+8,sequence);
+ le32(control+16,budget);le64(control+168,~0ULL);
+ m->event_control_armed=1;return 0;
+}
