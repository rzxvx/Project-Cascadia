+++ b/drivers/gpu/drm/agx/agx_fw.c
@@ -0,0 +1,1407 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * AGX G11P firmware: boot, init block, the compute queue and jobs.
+ *
+ * The firmware's structures live in one physically contiguous chunk. The
+ * firmware maps it at AGX_CHUNK_VA through the mem-desc table. Every MMU
+ * context from AGX_FIRST_CTX up gets a page catalogue in the chunk at init
+ * and is loaded by the firmware at every power-up; agx_vm.c fills them in.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-fence.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/unaligned.h>
+#include <drm/asahi_drm.h>
+
+#include "agx.h"
+#include "agx-21b91-layout.h"
+#include "agx_21b91_memory.h"
+
+#define EP_MSGS			0x20
+#define EP_INTS			0x21
+#define MSG_INIT		(0x81ULL << 48)
+#define MSG_DOORBELL		(0x83ULL << 48)
+#define MSG_CHECK		(0x42ULL << 48)
+
+#define NR_SLOTS		4	/* job structures, reused in turn */
+#define RING_SIZE		0x100
+
+#define CH_TA			0
+#define CH_3D			1
+#define CH_CP			2
+#define CH_DEVCTRL		12
+#define CH_EVENT		13
+#define CH_KTRACE		15
+#define NR_CHANNELS		17
+
+#define ASC_CPU_CONTROL		0x44
+#define ASC_CPU_CONTROL_RUN	BIT(4)
+
+#define EV			3
+#define EV_TA			4
+#define EV_3D			7
+#define RGX_MMU_FAULT_STATUS	0x17040
+#define DONE_STAMP		0xcafe0003
+
+/* One entry of the ADT's segment-ranges. */
+struct asc_segment {
+	__le64 phys;
+	__le64 iova;
+	__le64 remap;
+	__le32 size;
+	__le32 flags;
+} __packed;
+
+static u32 agx_alloc(struct agx_device *agx, u32 n, u32 align)
+{
+	u32 o = ALIGN(agx->off, align);
+
+	if (WARN_ON(o + n > AGX_CHUNK_SIZE))
+		return 0;
+	agx->off = o + n;
+	return o;
+}
+
+static u64 fw_va(u32 o)
+{
+	return AGX_CHUNK_VA + o;
+}
+
+static void put32(struct agx_device *agx, u32 o, u32 v)
+{
+	put_unaligned_le32(v, agx->buf + o);
+}
+
+static void put64(struct agx_device *agx, u32 o, u64 v)
+{
+	put_unaligned_le64(v, agx->buf + o);
+}
+
+static u32 get32(struct agx_device *agx, u32 o)
+{
+	return get_unaligned_le32(agx->buf + o);
+}
+
+static u32 fw_off(u64 va)
+{
+	return va - AGX_CHUNK_VA;
+}
+
+/*
+ * Init block per FUN_00025954. Region layout follows m1n1's G13 InitData
+ * where the G11 firmware matches it.
+ */
+static void agx_build(struct agx_device *agx, void *init, void *table, dma_addr_t table_pa)
+{
+	static const u32 rings[NR_CHANNELS] = {
+		[0 ... 11] = 0x30 * 0x100,
+		[12] = 0x30 * 0x100, [13] = 0x38 * 0x100, [14] = 6 * 0xd8 * 0x100,
+		[15] = 0x70 * 0x200, [16] = 0x60 * 0x100,
+	};
+	static const struct { u32 off, size; } bufs[] = {
+		/* TA/3D/CP stats, hwdata A, fault info, TLB generations, ... */
+		{ 0x170, 0x1000 }, { 0x178, 0x1000 }, { 0x180, 0x1000 },
+		{ 0x188, 0x20000 }, { 0x190, 0x80 }, { 0x198, 0xc0 },
+		{ 0x1b0, 0x4000 }, { 0x1b8, 0x1000 }, { 0x1c0, 0x300 },
+		{ 0x1c8, 0x1000 },
+	};
+	static const u16 scratch_maps[] = {
+		0x680, 0x6e0, 0x700, 0x720, 0x740, 0x760, 0x780, 0x7c0, 0x7e0,
+		0x800, 0x820, 0x840, 0x880, 0x8a0, 0x8c0, 0x8e0, 0x900,
+	};
+	/* ADT sgx/perf-states */
+	static const u32 mhz[] = { 0, 316, 456, 612, 740, 900, 1098 };
+	static const u32 mv[] = { 400, 609, 675, 734, 790, 859, 965 };
+	static const u32 mv_sram[] = { 400, 728, 737, 787, 850, 925, 1046 };
+	/* hwdata A power limits, then RegionC ones (offsets above 0x2000) */
+	static const u16 limits[] = {
+		0x6d4, 0x72c, 0x770, 0x820, 0x938, 0x897c, 0x8980, 0x898c,
+	};
+	/* page size, PA shift, index shift, entries, table size, valid, PA mask, index mask */
+	static const struct { u8 esz, pas, pas2, ish; u16 n; u16 valid; u64 pam, im; } lv[] = {
+		{ 4, 4, 12, 30, 0x1000, 1, 0xfffffff0, 0xffc0000000 },
+		{ 8, 10, 10, 21, 0x800, 1, 0xfffffffc00, 0x3fe00000 },
+		{ 8, 12, 12, 14, 0x200, 1, 0xfffffff000, 0x1fc000 },
+	};
+	u32 B, C, st, hb, ha, ttbr;
+	int i, j;
+
+	B = agx->B = agx_alloc(agx, 0x8000, 0x4000);	/* RegionB */
+	C = agx->C = agx_alloc(agx, 0x10000, 0x4000);	/* RegionC */
+	/* Firmware mem-desc ring: {state, 256 entries of 0x14}. */
+	st = agx_alloc(agx, 0x4000, 0x4000);
+	put64(agx, st, fw_va(agx_alloc(agx, 0x100, 0x100)));
+	put64(agx, st + 8, fw_va(agx_alloc(agx, 0x100 * 0x14, 0x4000)));
+	/* 12 run queues, DevCtrl, Event, FWLog, KTrace, Stats */
+	for (i = 0; i < NR_CHANNELS; i++) {
+		agx->chan_state[i] = agx_alloc(agx, 0x100, 0x100);
+		agx->chan_ring[i] = agx_alloc(agx, rings[i], 0x4000);
+		put64(agx, B + i * 0x10, fw_va(agx->chan_state[i]));
+		put64(agx, B + i * 0x10 + 8, fw_va(agx->chan_ring[i]));
+	}
+	hb = agx_alloc(agx, 0x4000, 0x4000);
+	for (i = 0; i < ARRAY_SIZE(bufs); i++)
+		put64(agx, B + bufs[i].off, fw_va(agx_alloc(agx, bufs[i].size, 0x4000)));
+	put64(agx, B + 0x1a0, fw_va(hb));
+	put64(agx, B + 0x1a8, fw_va(hb));
+	ha = fw_off(get_unaligned_le64(agx->buf + B + 0x188));
+	agx->stats_cp = fw_off(get_unaligned_le64(agx->buf + B + 0x180));
+	agx->gen_fw = fw_off(get_unaligned_le64(agx->buf + B + 0x1b0));
+
+	/* hwdata B IO maps, 0x20 each: phys, fw va (firmware fills it), size, rw */
+	put64(agx, hb + 0x640, agx->fender);
+	put64(agx, hb + 0x650, 0x20000);
+	put32(agx, hb + 0x658, 1);
+	put64(agx, hb + 0x6a0, agx->sgx);
+	put64(agx, hb + 0x6b0, 0x20000);
+	put32(agx, hb + 0x6b8, 1);
+	/*
+	 * The firmware maps the others only when the PA is set (FUN_00028ad0)
+	 * but uses them anyway, so point them at scratch RAM.
+	 */
+	for (i = 0; i < ARRAY_SIZE(scratch_maps); i++) {
+		put64(agx, hb + scratch_maps[i], agx->pa + agx_alloc(agx, 0x8000, 0x4000));
+		put64(agx, hb + scratch_maps[i] + 0x10, 0x8000);
+		put32(agx, hb + scratch_maps[i] + 0x18, 1);
+	}
+	/* Real power mode: the firmware asks Fender for a perf state. */
+	put32(agx, hb + 0x958, 1);
+	put32(agx, hb + 0x960, 1);
+	/*
+	 * Sample periods in 24 MHz ticks, 16 ms. At 0 the power thread's
+	 * timers fire back to back and starve agx_background.
+	 */
+	put32(agx, hb + 0x988, 16000 * 24);
+	put32(agx, ha + 4, 16000 * 24);
+	/*
+	 * Power limits in pstate * 100; FUN_00013190 takes the lowest. Below
+	 * 100 the firmware duty-cycles the GPU and at 0 parks every job.
+	 * +0x770 and +0x820 pin the thermal and PPM limits.
+	 */
+	for (i = 0; i < ARRAY_SIZE(limits); i++)
+		put32(agx, (limits[i] > 0x2000 ? C : ha) + limits[i],
+		      (ARRAY_SIZE(mhz) - 1) * 100);
+	/* Highest pstate; the DVFS loop in FUN_00020b44 walks down from it. */
+	put32(agx, hb + 0xa6c, ARRAY_SIZE(mhz) - 1);
+	/* VA bases; power-up loads +0x18 into RGX 0x10000. */
+	put64(agx, hb, 0x1400000000);
+	put64(agx, hb + 8, 0xffc00000);
+	put64(agx, hb + 0x10, AGX_USC_BASE);
+	put64(agx, hb + 0x18, AGX_USC_BASE);
+	put64(agx, hb + 0x20, 0x18ffff8000);
+	/*
+	 * Unit masks for TA, 3D and CP, copied by FUN_000157b4. At 0 the
+	 * scheduler never finds a free unit.
+	 */
+	put32(agx, hb + 0x16d0, 3);
+	put32(agx, hb + 0x16d4, 7);
+	put32(agx, hb + 0x16d8, 1);
+	for (i = 0; i < ARRAY_SIZE(mhz); i++) {
+		put32(agx, hb + 0xa70 + 4 * i, mhz[i]);
+		for (j = 0; j < 8; j++) {
+			put32(agx, hb + 0xab0 + 0x20 * i + 4 * j, mv[i]);
+			put32(agx, hb + 0xcb0 + 0x20 * i + 4 * j, mv_sram[i]);
+		}
+	}
+
+	/*
+	 * Per-context TLB generations, page catalogues, and the contexts
+	 * FUN_00026338 loads at every power-up.
+	 */
+	agx->gen = agx_alloc(agx, 0x100, 0x100);
+	put64(agx, C + 0x9150, fw_va(agx->gen));
+	ttbr = agx_alloc(agx, 0x4000, 0x4000);
+	put64(agx, C + 0x9158, fw_va(ttbr));
+	/*
+	 * Every context gets an empty page catalogue now and is loaded at every
+	 * power-up (32 contexts per mask word), so a new VM only fills one in
+	 * and bumps its TLB generation.
+	 */
+	for (i = 0; i < AGX_NR_CTX; i++) {
+		/* 16K aligned: the firmware maps table pages to walk them */
+		agx->pc[i] = agx_alloc(agx, 0x1000, AGX_PAGE);
+		put64(agx, ttbr + i * 8, agx->pa + agx->pc[i]);
+		if (i >= AGX_FIRST_CTX)
+			put32(agx, C + 0x9160 + i / 32 * 4,
+			      get32(agx, C + 0x9160 + i / 32 * 4) | BIT(i % 32));
+	}
+	/*
+	 * Parameter manager free list descriptors, 16 bytes per buffer manager
+	 * slot. Power-up loads the GPU address into RGX 0x14430 (FUN_0000f72c);
+	 * the firmware fills entries through its own address.
+	 */
+	i = agx_alloc(agx, 0x1000, 0x1000);
+	put64(agx, B + 0x21c, AGX_CHUNK_GVA + i);
+	put64(agx, B + 0x224, fw_va(i));
+	/*
+	 * Trace job events only (bit 0); the main loop's and power thread's
+	 * periodic entries overwrite a hang's trail in seconds. Drained in
+	 * agx_drain().
+	 */
+	put32(agx, C, 0x1);
+	/* The first power-up installs the job handlers only when set. */
+	put32(agx, C + 0xb1cc, 1);
+
+	/* Mem-desc table: va, pa >> 12, 0, 16K pages, flags */
+	put_unaligned_le64(AGX_CHUNK_VA, table);
+	put_unaligned_le32(agx->pa >> 12, table + 8);
+	put_unaligned_le16(AGX_CHUNK_SIZE >> 14, table + 0x10);
+	put_unaligned_le16(1, table + 0x12);
+
+	put_unaligned_le64(fw_va(B), init + 3 * 8);
+	put_unaligned_le64(fw_va(C), init + 4 * 8);
+	put_unaligned_le64(fw_va(st), init + 5 * 8);
+	/* MMU format for the firmware's own walks (FUN_00026744) */
+	put_unaligned_le16(0x4000, init + 0x30);
+	*(u8 *)(init + 0x32) = 14;
+	*(u8 *)(init + 0x33) = ARRAY_SIZE(lv);
+	for (i = 0; i < ARRAY_SIZE(lv); i++) {
+		void *p = init + 0x34 + i * 0x20;
+
+		*(u8 *)p = lv[i].esz;
+		*(u8 *)(p + 1) = lv[i].pas;
+		*(u8 *)(p + 2) = lv[i].pas2;
+		*(u8 *)(p + 3) = lv[i].ish;
+		put_unaligned_le16(lv[i].n, p + 4);
+		put_unaligned_le16(0x4000, p + 6);
+		put_unaligned_le64(lv[i].valid, p + 8);
+		put_unaligned_le64(lv[i].pam, p + 0x10);
+		put_unaligned_le64(lv[i].im, p + 0x18);
+	}
+	put_unaligned_le64(table_pa, init + 0x13 * 8);
+	put_unaligned_le64(1, init + 0x14 * 8);
+}
+
+/* Event and KTrace: mark everything read, so the rings never fill. */
+static void agx_drain(struct agx_device *agx)
+{
+	static const struct { int ch; u32 count; } rings[] = {
+		{ CH_EVENT, 0x100 }, { CH_KTRACE, 0x200 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rings); i++) {
+		u32 st = agx->chan_state[rings[i].ch];
+		u32 w = READ_ONCE(*(u32 *)(agx->buf + st + 0x20));
+
+		if (w < rings[i].count)
+			WRITE_ONCE(*(u32 *)(agx->buf + st), w);
+	}
+}
+
+static void agx_doorbell(struct agx_device *agx, u32 ch)
+{
+	wmb();
+	apple_rtkit_send_message(agx->rtk, EP_INTS, MSG_DOORBELL | ch, NULL, false);
+}
+
+/*
+ * A command queue, CommandQueueInfo as in m1n1 with the context pointer at
+ * +0xa4. units is info+0x40: 1 sends 3D jobs to unit 2 only, which never
+ * finishes them, 0 to units 0 and 1.
+ */
+static void agx_queue(struct agx_device *agx, struct agx_fwq *q, u32 units)
+{
+	u32 ptrs, jl, gbuf, ctx, info;
+
+	ptrs = agx_alloc(agx, 0x100, 0x100);
+	q->ring = agx_alloc(agx, RING_SIZE * 8, 0x100);
+	jl = agx_alloc(agx, 0x100, 0x100);
+	gbuf = agx_alloc(agx, 0x4000, 0x4000);
+	ctx = agx_alloc(agx, 0x100, 0x100);
+	info = q->info = agx_alloc(agx, 0x100, 0x100);
+
+	put32(agx, ptrs + 0x50, RING_SIZE);
+	/* job list, a TAILQ head {first, last = &first} */
+	put64(agx, jl + 8, fw_va(jl));
+	*(u8 *)(agx->buf + ctx) = 0xff;
+	*(u8 *)(agx->buf + ctx + 1) = 0xff;
+	*(u8 *)(agx->buf + ctx + 5) = 1;
+	*(u8 *)(agx->buf + ctx + 0x1e) = 0xff;
+	*(u8 *)(agx->buf + ctx + 0x23) = 2;
+	put64(agx, info, fw_va(ptrs));
+	put64(agx, info + 8, fw_va(q->ring));
+	put64(agx, info + 0x10, fw_va(jl));
+	put64(agx, info + 0x18, fw_va(gbuf));
+	put32(agx, info + 0x2c, -1);
+	put64(agx, info + 0x38, 0xffffffffffff0000);
+	put32(agx, info + 0x40, units);
+	put32(agx, info + 0x48, 1);
+	put32(agx, info + 0x4c, -1);
+	put32(agx, info + 0x50, 0x1001);
+	put32(agx, info + 0x54, -1);
+	put64(agx, info + 0xa4, fw_va(ctx));
+}
+
+static void agx_push(struct agx_device *agx, struct agx_fwq *q, u32 cmd)
+{
+	put64(agx, q->ring + q->n++ % RING_SIZE * 8, fw_va(cmd));
+}
+
+/*
+ * The run message is {type, info, head, event, flush} on the queue's
+ * channel: FUN_000075fc stores head at info+0x28 and FUN_0001fb60 runs the
+ * ring up to it. Both rings hold RING_SIZE entries.
+ */
+static void agx_kick(struct agx_device *agx, struct agx_fwq *q, u32 ch, u32 ev)
+{
+	u32 st = agx->chan_state[ch], w = get32(agx, st + 0x20);
+	u32 msg = agx->chan_ring[ch] + w * 0x30;
+
+	memset(agx->buf + msg, 0, 0x30);
+	put32(agx, msg, ch);
+	put64(agx, msg + 4, fw_va(q->info));
+	put32(agx, msg + 0xc, q->n % RING_SIZE);
+	put32(agx, msg + 0x10, ev);
+	put32(agx, msg + 0x14, 1);
+	put32(agx, st + 0x20, (w + 1) % RING_SIZE);
+	agx_doorbell(agx, ch);
+}
+
+static const char *agx_fence_name(struct dma_fence *f)
+{
+	return "agx";
+}
+
+static const struct dma_fence_ops agx_fence_ops = {
+	.get_driver_name = agx_fence_name,
+	.get_timeline_name = agx_fence_name,
+};
+
+/*
+ * A compute command in MMU context ctx that runs the CDM control stream at
+ * GPU VA stream. args is a zeroed scratch page mapped in that context, for
+ * RGX 0x14020. Microsequence as the kext builds it (FUN_fffffff0084d0f08):
+ * StartCompute, wait for the CDM interrupt, finalize, end, which writes
+ * DONE_STAMP and raises event EV.
+ *
+ * The scheduler runs one job at a time, so this never overtakes a running
+ * one. Returns the job's fence, signalled by agx_complete().
+ */
+struct dma_fence *agx_fw_run(struct agx_device *agx, u32 ctx, u64 args, u64 stream)
+{
+	struct dma_fence *fence;
+	int ret;
+	u32 n = agx->nr_cmds;
+
+	if (agx->ipad_memory) {
+		if (agx->wedged)
+			return ERR_PTR(-EIO);
+		fence = kzalloc(sizeof(*fence), GFP_KERNEL);
+		if (!fence)
+			return ERR_PTR(-ENOMEM);
+		dma_fence_init(fence, &agx_fence_ops, &agx->fence_lock,
+			       agx->fence_ctx, ++agx->fence_seqno);
+		/* The 21B91 backend owns a single, serial command slot.  Run to
+		 * exact stamp and queue retirement before letting the scheduler
+		 * take another job; a 0x42 notification alone is not completion. */
+		ret = agx21_asahi_run(agx->ipad_transport, ctx, args, stream);
+		if (ret) {
+			agx->wedged = true;
+			dma_fence_set_error(fence, ret);
+		}
+		dma_fence_signal(fence);
+		return fence;
+	}
+	u32 cmd = agx->slot[n % NR_SLOTS].cmd, evc = agx->slot[n % NR_SLOTS].evc;
+	u32 useq = agx->slot[n % NR_SLOTS].useq;
+	u32 scratch = agx->slot[n % NR_SLOTS].scratch;
+	u32 fin = useq + 0x64 + 4;
+
+	/* After a timeout the firmware may still own a job slot. */
+	if (agx->wedged)
+		return ERR_PTR(-EIO);
+	fence = kzalloc(sizeof(*fence), GFP_KERNEL);
+	if (!fence)
+		return ERR_PTR(-ENOMEM);
+
+	memset(agx->buf + cmd, 0, 0x300);
+	memset(agx->buf + evc, 0, 0x100);
+	memset(agx->buf + useq, 0, 0x200);
+	memset(agx->buf + scratch, 0, 0x100);
+	put64(agx, scratch + 0x20, 1);			/* kick gate */
+
+	/* StartCompute, 0x64 bytes */
+	put32(agx, useq, 0x29);
+	put64(agx, useq + 4, fw_va(cmd + 0x1c));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x70));
+	put64(agx, useq + 0x14, fw_va(agx->stats_cp));
+	put64(agx, useq + 0x1c, fw_va(agx->cpq.info));
+	put32(agx, useq + 0x24, ctx);
+	put32(agx, useq + 0x2c, ctx);
+	put64(agx, useq + 0x3c, fw_va(cmd + 0x1fc));
+	put64(agx, useq + 0x4c, fw_va(cmd + 0x2d8));
+	put64(agx, useq + 0x5c, fw_va(scratch + 0x20));
+	/* wait for the CDM interrupt */
+	put32(agx, useq + 0x64, 0x41);
+	/* finalize, 0x44 bytes */
+	put32(agx, fin, 0x2a);
+	put64(agx, fin + 4, fw_va(agx->stats_cp));
+	put64(agx, fin + 0xc, fw_va(agx->cpq.info));
+	put32(agx, fin + 0x14, ctx);
+	put64(agx, fin + 0x18, fw_va(cmd + 0x1fc));
+	put64(agx, fin + 0x28, fw_va(scratch + 8));
+	put32(agx, fin + 0x30, 1);
+	put32(agx, fin + 0x38, -(0x64 + 4));
+	put64(agx, fin + 0x3c, fw_va(cmd + 0x2d8));
+	/* end */
+	put32(agx, fin + 0x44, 0x18 | 0x40 << 24);
+
+	put32(agx, cmd, 3);
+	put32(agx, cmd + 0x10, ctx);
+	put64(agx, cmd + 0x14, fw_va(evc));
+	/* event control: +0 points at the counter finalize bumps */
+	put64(agx, evc, fw_va(scratch + 8));
+	put64(agx, cmd + 0x70, args);
+	put64(agx, cmd + 0x78, stream);
+	put64(agx, cmd + 0x1f0, fw_va(useq));
+	put32(agx, cmd + 0x1f8, fin + 0x48 - useq);
+	/* completion stamp {target, ?, value, event} */
+	put64(agx, cmd + 0x278, fw_va(scratch + 0x10));
+	put32(agx, cmd + 0x288, DONE_STAMP);
+	put32(agx, cmd + 0x28c, EV);
+
+	dma_fence_init(fence, &agx_fence_ops, &agx->fence_lock, agx->fence_ctx,
+		       ++agx->fence_seqno);
+	spin_lock_irq(&agx->fence_lock);
+	agx->active = dma_fence_get(fence);
+	agx->active_stamp = scratch + 0x10;
+	spin_unlock_irq(&agx->fence_lock);
+
+	agx->nr_cmds++;
+	agx_push(agx, &agx->cpq, cmd);
+	agx_kick(agx, &agx->cpq, CH_CP, EV);
+	return fence;
+}
+
+/*
+ * Render: a TA (tiling) job on the TA queue, then a 3D (fragment) job on the
+ * 3D queue, kicked by agx_complete() once the TA stamp lands. Both use one
+ * buffer manager (the parameter manager's heap) and one tiling buffer set
+ * sized for the largest target, in the chunk, which every context maps at
+ * AGX_CHUNK_GVA. Layouts: kext FUN_fffffff0084d22c8 (TA registers),
+ * FUN_fffffff0084cd07c (3D registers), firmware FUN_00017018 (microsequence).
+ */
+#define RN_MAX		16384
+/* The tiling buffers fit 16384x4096 worth of macrotiles, in any shape */
+#define RN_BUDGET_W	16384
+#define RN_BUDGET_H	4096
+#define RN_BLOCKS	64		/* parameter heap, 128K blocks */
+#define RN_MAX_BLOCKS	128
+
+static u64 gva(u32 o)
+{
+	return AGX_CHUNK_GVA + o;
+}
+
+struct rn_tiling {
+	u32 tiles_x, tiles_y, tpm_x, tpm_y, tpm, rgn, rgn_pages, tpc_pages;
+};
+
+/*
+ * G11 tiling parameters, kext AGXRenderTargetMemoryG11 (FUN_fffffff0084d1ce0),
+ * 32x32 pixel tiles: rgn is the region headers per layer in dwords (5 per
+ * macrotile utile), rgn_pages and tpc_pages the region array and the TPC
+ * per layer in 4K pages (0x50 and 0x80 bytes per macrotile utile).
+ */
+static void rn_tiling(u32 w, u32 h, u32 uw, u32 uh, struct rn_tiling *t)
+{
+	u32 upt = (32 / uw) * (32 / uh);
+
+	t->tiles_x = DIV_ROUND_UP(w, 32);
+	t->tiles_y = DIV_ROUND_UP(h, 32);
+	t->tpm_x = ALIGN(DIV_ROUND_UP(t->tiles_x, 4), 4);
+	t->tpm_y = ALIGN(DIV_ROUND_UP(t->tiles_y, 4), 4);
+	t->tpm = t->tpm_x * t->tpm_y;
+	t->rgn = 5 * t->tpm * upt / 4;
+	t->rgn_pages = DIV_ROUND_UP(0x50 * t->tpm * upt, SZ_4K);
+	t->tpc_pages = DIV_ROUND_UP(0x80 * t->tpm * upt, SZ_4K);
+}
+
+static int agx_render_init(struct agx_device *agx)
+{
+	struct rn_tiling t;
+	u32 bmd, bms, plist, blist, bctl, i;
+	dma_addr_t pages;
+
+	rn_tiling(RN_BUDGET_W, RN_BUDGET_H, 16, 16, &t);
+	agx->rn.ta = agx_alloc(agx, 0x900, 0x100);	/* cmd, evc +0x600, useq +0x700 */
+	agx->rn.frag = agx_alloc(agx, 0xd00, 0x100);	/* cmd, evc +0xa00, useq +0xb00 */
+	agx->rn.scratch = agx_alloc(agx, 0x100, 0x100);
+	agx->rn.init = agx_alloc(agx, 0x40, 0x40);
+	agx->rn.tilemap = agx_alloc(agx, t.rgn_pages * SZ_4K, AGX_PAGE);
+	agx->rn.tpc = agx_alloc(agx, t.tpc_pages * SZ_4K, AGX_PAGE);
+	agx->rn.heapmeta = agx_alloc(agx, AGX_PAGE, AGX_PAGE);
+	agx->rn.pre = agx_alloc(agx, 3 * AGX_PAGE, AGX_PAGE);
+	bmd = agx->rn.bmd = agx_alloc(agx, 0x100, 0x100);
+	bms = agx->rn.bms = agx_alloc(agx, 0x100, 0x100);
+	plist = agx_alloc(agx, RN_MAX_BLOCKS * 32 * 4, AGX_PAGE);
+	blist = agx_alloc(agx, 0x20 * RN_MAX_BLOCKS, 0x100);
+	bctl = agx_alloc(agx, 0x40, 0x40);
+
+	/* 8M of heap is too much for the chunk; 1M ran out at 3000 draws */
+	if (!dmam_alloc_coherent(agx->dev, RN_BLOCKS * SZ_128K, &pages, GFP_KERNEL))
+		return -ENOMEM;
+
+	/*
+	 * The firmware expands the block list into the page list: each 0x20
+	 * byte entry is eight 16K chunks of a 128K block, PA >> 12.
+	 */
+	for (i = 0; i < RN_BLOCKS * 8; i++)
+		put32(agx, blist + i * 4, pages / SZ_4K + i * 4);
+	put32(agx, bctl, RN_BLOCKS);
+	put32(agx, bctl + 4, RN_BLOCKS);
+
+	/* Buffer manager descriptor: Asahi's BufferManagerInfo without unk_1c. */
+	put32(agx, bmd + 0xc, -1);
+	put64(agx, bmd + 0x1c, gva(plist));
+	put32(agx, bmd + 0x24, RN_MAX_BLOCKS * 32 * 4);
+	/* the block ring wraps at max_blocks, so it must exceed the count */
+	put32(agx, bmd + 0x2c, RN_MAX_BLOCKS);
+	put64(agx, bmd + 0x38, gva(blist));
+	put64(agx, bmd + 0x40, fw_va(bctl));
+	/* G11 kext (FUN_fffffff0084df7dc): +0x48 -1, +0x58 the page size */
+	put32(agx, bmd + 0x48, -1);
+	put32(agx, bmd + 0x58, SZ_16K);
+	put64(agx, bmd + 0x64, fw_va(agx_alloc(agx, 0x40, 0x40)));
+	put32(agx, bmd + 0x7c, 1);
+	put32(agx, bmd + 0x80, RN_MAX_BLOCKS * 32);
+	put32(agx, bmd + 0x84, RN_MAX_BLOCKS * 32);
+
+	/*
+	 * Buffer manager slot 0, which is Asahi's Scene too: PM state buffers
+	 * at +0xa0..+0xb0, stats at +0xbc (zeroed at every 3D retire).
+	 */
+	/* MTileArray, MList and VHeap table (kext "Parameter Scene Allocations") */
+	put64(agx, bms + 0xa0, gva(agx_alloc(agx, SZ_64K, AGX_PAGE)));
+	put64(agx, bms + 0xa8, gva(agx_alloc(agx, SZ_64K, AGX_PAGE)));
+	put64(agx, bms + 0xb0, gva(agx_alloc(agx, SZ_64K, AGX_PAGE)));
+	put64(agx, bms + 0xbc, fw_va(agx_alloc(agx, 0x100, 0x40)));
+	return 0;
+}
+
+/* J171/21B91: one-shot 8 MiB PM capacity experiment. The iPad BMD ABI
+ * remains native; only capacity changes relative to the prior baseline. */
+int agx21_render_init(struct agx_device *agx)
+{
+	struct agx21_memory *m = agx->ipad_memory;
+	const struct agx21_render_resources *r;
+	u32 scene, heap, plist, blist, bctl, bmd, bms, i;
+	u64 heap_pa, aligned_pa;
+	if (!m || !m->render_resources_reserved ||
+	    !m->render_queue_headers_initialized ||
+	    !m->render_policy_candidate_ready)
+		return -EINVAL;
+	r = &m->render_resources;
+	/* The 21B91 3D callback reads scene+0xc0 as a u64 pointer, then
+	 * dereferences control+0x20. Keep the entire zeroed control object
+	 * inside this iPad-owned scene allocation. */
+	if (m->objects[r->scene].size < 0x9040)
+		return -ERANGE;
+	if (get_unaligned_le64(agx21_memory_cpu(m, AGX21_MEM_B) + 0x2c8) !=
+	    AGX21_GPU_SHARED_VA + m->objects[r->pm_slots].offset ||
+	    get_unaligned_le64(agx21_memory_cpu(m, AGX21_MEM_B) + 0x2d0) !=
+	    agx21_memory_firmware_va(m, r->pm_slots))
+		return -EINVAL;
+	scene = m->objects[r->scene].offset;
+	heap = m->objects[r->parameter_heap].offset;
+	heap_pa = m->arena_pa + heap;
+	aligned_pa = ALIGN(heap_pa, SZ_128K);
+	if (aligned_pa < heap_pa ||
+	    aligned_pa + SZ_8M > heap_pa +
+	    m->objects[r->parameter_heap].size)
+		return -ERANGE;
+	heap = (u32)(aligned_pa - m->arena_pa);
+	agx->B = m->objects[AGX21_MEM_B].offset;
+	agx->C = m->objects[AGX21_MEM_C].offset;
+	agx->taq.info = m->objects[m->render_ids.queue[0][0]].offset;
+	agx->taq.ring = m->objects[m->render_ids.queue[0][2]].offset;
+	agx->fragq.info = m->objects[m->render_ids.queue[1][0]].offset;
+	agx->fragq.ring = m->objects[m->render_ids.queue[1][2]].offset;
+	agx->rn.ta = m->objects[m->render_ids.command[0]].offset;
+	agx->rn.frag = m->objects[m->render_ids.command[1]].offset;
+	agx->rn.scratch = agx->rn.ta + 0x1000;
+	agx->rn.init = agx->rn.frag + 0x1000;
+	agx->rn.tilemap = m->objects[r->tilemap].offset;
+	agx->rn.tpc = m->objects[r->tpc].offset;
+	agx->rn.heapmeta = m->objects[r->metadata].offset;
+	agx->rn.pre = m->objects[r->pre].offset;
+	bmd = agx->rn.bmd = scene;
+	bms = agx->rn.bms = scene + 0x100;
+	/* Firmware's InitBuffer cache flush maps a single 16 KiB page at a
+	 * time. Keep the 16 KiB plist wholly inside one aligned page. */
+	plist = scene + 0x4000;
+	blist = scene + 0x8000;
+	bctl = scene + 0x9000;
+	/* 64 physical 128 KiB blocks, 128 descriptor slots. Keep page and
+	 * block tables disjoint from the native scene/control structures. */
+	for (i = 0; i < 64 * 8; i++)
+		put32(agx, blist + i * 4, aligned_pa / SZ_4K + i * 4);
+	put32(agx, bctl, 64);
+	put32(agx, bctl + 4, 64);
+	/* iPad 21B91 AGXG11P writes this layout in
+	 * sub_FFFFFFF00847B4CC.  It is not the XS descriptor ABI. */
+	put32(agx, bmd + 0xc, -1);
+	put64(agx, bmd + 0x18, gva(plist));
+	put32(agx, bmd + 0x20, 128 * 32 * 4);
+	put32(agx, bmd + 0x28, 128);
+	put64(agx, bmd + 0x34, gva(blist));
+	put64(agx, bmd + 0x3c, fw_va(bctl));
+	put32(agx, bmd + 0x44, -1);
+	/* 21B91 InitBuffer divides 128 KiB by this allocation granule,
+	 * then multiplies by granule >> 12 to populate the PM page count.
+	 * The old value 1 made that count zero despite a registered PM slot.
+	 * XS uses 16 KiB at its corresponding BMD +0x58. */
+	put32(agx, bmd + 0x48, SZ_16K);
+	put64(agx, bmd + 0x54, fw_va(scene + 0xa40));
+	put32(agx, bmd + 0x6c, 128 * 32);
+	put32(agx, bmd + 0x70, 128 * 32);
+	/* Native +0x74 has a separate producer; do not alias +0x54. */
+	put64(agx, bms + 0xa0, gva(m->objects[r->mtile].offset));
+	put64(agx, bms + 0xa8, gva(m->objects[r->mlist].offset));
+	put64(agx, bms + 0xb0, gva(m->objects[r->vheap].offset));
+	put64(agx, bms + 0xc0, fw_va(scene + 0xb00));
+	return 0;
+}
+
+int agx_fw_render_check(const struct drm_asahi_cmd_render *r)
+{
+	struct rn_tiling t, b;
+
+	if (r->flags & ~(DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES |
+			 DRM_ASAHI_RENDER_NO_VERTEX_CLUSTERING |
+			 DRM_ASAHI_RENDER_DBIAS_IS_INT))
+		return -EINVAL;
+	if (r->vertex_helper.binary || r->fragment_helper.binary || r->layers != 1 ||
+	    !r->width_px || r->width_px > RN_MAX || !r->height_px ||
+	    r->height_px > RN_MAX || !r->vdm_ctrl_stream_base)
+		return -EINVAL;
+	if ((r->utile_width_px != 16 && r->utile_width_px != 32) ||
+	    (r->utile_height_px != 16 && r->utile_height_px != 32) ||
+	    (r->samples != 1 && r->samples != 2 && r->samples != 4))
+		return -EINVAL;
+	rn_tiling(r->width_px, r->height_px, r->utile_width_px, r->utile_height_px, &t);
+	rn_tiling(RN_BUDGET_W, RN_BUDGET_H, 16, 16, &b);
+	if (t.rgn_pages > b.rgn_pages || t.tpc_pages > b.tpc_pages)
+		return -EINVAL;
+	return 0;
+}
+
+static u32 rn_stats(struct agx_device *agx, u32 off)
+{
+	return fw_off(get_unaligned_le64(agx->buf + agx->B + off));
+}
+
+/* TA command, 0x5e0, and its microsequence: StartTA, wait, FinalizeTA, end. */
+static void rn_ta(struct agx_device *agx, u32 ctx, const struct drm_asahi_cmd_render *r,
+		  const struct rn_tiling *t, u64 utile)
+{
+	u32 cmd = agx->rn.ta, evc = cmd + 0x600, useq = cmd + 0x700;
+	u32 sc = agx->rn.scratch, bmd = agx->rn.bmd, bms = agx->rn.bms;
+	u32 stats = rn_stats(agx, 0x170) + 4, fin = useq + 0x88, i;
+	const u64 r64[] = {
+		0x200, 0x1e3ce5081e3ce508, gva(agx->rn.tilemap), gva(agx->rn.tpc), utile,
+		r->ppp_multisamplectl, gva(agx->rn.heapmeta),
+		gva(agx->rn.pre), gva(agx->rn.pre + AGX_PAGE), 1,
+		gva(agx->rn.pre + 2 * AGX_PAGE), r->vdm_ctrl_stream_base, 0,
+	};
+	const u32 r32[] = {
+		t->rgn_pages | 0x20000, 0x88, r->ppp_ctrl | 2,
+		(r->width_px - 1) | (r->height_px - 1) << 16,
+		(t->tiles_y - 1) << 12 | (t->tiles_x - 1),
+		3 * t->tpm_x | 2 * t->tpm_x << 9 | t->tpm_x << 18,
+		3 * t->tpm_y | 2 * t->tpm_y << 9 | t->tpm_y << 18,
+		t->tpm, t->tpc_pages, 0x100, 0x8000,
+	};
+
+	memset(agx->buf + cmd, 0, 0x900);
+	for (i = 0; i < ARRAY_SIZE(r64); i++)
+		put64(agx, cmd + 0x40 + 8 * i, r64[i]);
+	for (i = 0; i < ARRAY_SIZE(r32); i++)
+		put32(agx, cmd + 0x3c4 + 4 * i, r32[i]);
+
+	put32(agx, cmd, 0);			/* TA */
+	put32(agx, cmd + 0xc, ctx);
+	put64(agx, cmd + 0x14, fw_va(evc));
+	put32(agx, cmd + 0x1c, 0);		/* buffer manager slot */
+	put64(agx, cmd + 0x24, fw_va(bmd));
+	put64(agx, cmd + 0x2c, fw_va(bms));
+	put64(agx, evc, fw_va(sc + 8));
+	/* stamp record {target, ?, value, event}, retired by FUN_0000d704 */
+	put64(agx, cmd + 0x560, fw_va(sc));
+	put64(agx, cmd + 0x568, fw_va(sc));
+	put32(agx, cmd + 0x570, DONE_STAMP);
+	*(u8 *)(agx->buf + cmd + 0x574) = EV_TA;
+	put32(agx, cmd + 0x580, EV_TA);
+
+	/* StartTA, 0x84 bytes */
+	put32(agx, useq, 0x22);
+	put64(agx, useq + 0x4, fw_va(cmd + 0x3c4));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x40));
+	put64(agx, useq + 0x14, fw_va(bmd));
+	put64(agx, useq + 0x1c, fw_va(bms));
+	put64(agx, useq + 0x24, fw_va(stats));
+	put64(agx, useq + 0x2c, fw_va(agx->taq.info));
+	put32(agx, useq + 0x34, ctx);
+	put32(agx, useq + 0x3c, ctx);
+	put64(agx, useq + 0x54, fw_va(cmd + 0x488));
+	put64(agx, useq + 0x5c, fw_va(cmd + 0x58c));
+	put32(agx, useq + 0x6c, 4);
+	put64(agx, useq + 0x78, fw_va(sc + 0x20));	/* kick gate */
+	/* wait for the TA interrupt */
+	put32(agx, useq + 0x84, 0x40001);
+	/* FinalizeTA, 0x54 bytes */
+	put32(agx, fin, 0x23);
+	put64(agx, fin + 0x4, fw_va(bms));
+	put64(agx, fin + 0xc, fw_va(bmd));
+	put64(agx, fin + 0x14, fw_va(stats));
+	put64(agx, fin + 0x1c, fw_va(agx->taq.info));
+	put32(agx, fin + 0x24, ctx);
+	put64(agx, fin + 0x2c, fw_va(cmd + 0x488));
+	put32(agx, fin + 0x38, 4);
+	/*
+	 * The event control counter: FUN_0000d704 unlinks the event control
+	 * from the queue's list once it equals evc+0xc (1 after job start)
+	 * and only then may the structures be reused.
+	 */
+	put64(agx, fin + 0x3c, fw_va(sc + 8));
+	put32(agx, fin + 0x44, 1);
+	put32(agx, fin + 0x4c, -(0x84 + 4));
+	/* end */
+	put32(agx, fin + 0x54, 0x18 | 0x40 << 24);
+	put64(agx, cmd + 0x474, fw_va(useq));
+	put32(agx, cmd + 0x47c, fin + 0x58 - useq);
+}
+
+/* 3D command, 0x940: Start3D, wait, Finalize3D, end. */
+static void rn_frag(struct agx_device *agx, u32 ctx, const struct drm_asahi_cmd_render *r,
+		    const struct rn_tiling *t, u64 utile)
+{
+	u32 cmd = agx->rn.frag, evc = cmd + 0xa00, useq = cmd + 0xb00;
+	u32 sc = agx->rn.scratch, bms = agx->rn.bms;
+	u32 stats = rn_stats(agx, 0x178) + 8, fin = useq + 0xa8, i;
+	u32 tib = DIV_ROUND_UP(r->utile_width_px * r->utile_height_px * r->samples *
+			       r->sample_size_B, 2048);
+	const u64 r64[] = {
+		utile, r->bg.rsrc_spec, r->bg.usc, r->ppp_multisamplectl,
+		r->isp_scissor_base, r->isp_dbias_base, 0,
+		/* G13 AuxFBInfo: isp_ctl, 0, width, height */
+		0xc000 | (r->flags & DRM_ASAHI_RENDER_DBIAS_IS_INT),
+		(u64)r->height_px << 32 | r->width_px, 0,
+		r->isp_zls_pixels, r->isp_oclqry_base & ~0xfULL, r->zls_ctrl,
+		r->depth.base, r->depth.base, r->stencil.base, r->stencil.base,
+		r->depth.stride, r->depth.stride, r->stencil.stride, r->stencil.stride,
+		r->depth.comp_base, r->depth.comp_stride,
+		r->depth.comp_base, r->depth.comp_stride,
+		r->stencil.comp_base, r->stencil.comp_stride,
+		r->stencil.comp_base, r->stencil.comp_stride,
+		gva(agx->rn.tilemap), gva(agx->rn.heapmeta),
+		/* region headers in dwords, region size in pages */
+		t->rgn | (u64)t->rgn_pages << 32,
+		0x280 | (r->flags & DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES ? 0x10000 : 0), 0,
+	};
+	const u32 r32[] = {
+		r->eot.rsrc_spec, r->eot.usc, 0, 0, r->isp_merge_upper_x,
+		r->isp_merge_upper_y, 0, 0,
+		/* BadApple G11: utiles per macrotile (3D register 0x16038). */
+		t->tpm_y * 32 / r->utile_height_px |
+			t->tpm_x * 32 / r->utile_width_px << 16,
+		tib, r->isp_bgobjdepth, r->isp_bgobjvals,
+		/* kext constants 0xfffffff0070cd8a0 */
+		0x1f, 0, 0, 1, 0,
+	};
+
+	memset(agx->buf + cmd, 0, 0xd00);
+	for (i = 0; i < ARRAY_SIZE(r64); i++)
+		put64(agx, cmd + 0x80 + 8 * i, r64[i]);
+	for (i = 0; i < ARRAY_SIZE(r32); i++)
+		put32(agx, cmd + 0x3c8 + 4 * i, r32[i]);
+
+	put32(agx, cmd, 1);			/* 3D */
+	put32(agx, cmd + 0xc, ctx);
+	put64(agx, cmd + 0x20, fw_va(evc));
+	put64(agx, cmd + 0x28, fw_va(agx->rn.bmd));
+	put64(agx, cmd + 0x30, fw_va(bms));	/* scene, read on retire */
+	put64(agx, evc, fw_va(sc + 0x48));
+	put64(agx, cmd + 0x8c4, fw_va(sc + 0x40));
+	put64(agx, cmd + 0x8cc, fw_va(sc + 0x40));
+	put32(agx, cmd + 0x8d4, DONE_STAMP);
+	*(u8 *)(agx->buf + cmd + 0x8d8) = EV_3D;
+	put32(agx, cmd + 0x8e4, EV_3D);
+
+	/* Start3D, 0xa4 bytes */
+	put32(agx, useq, 0x24);
+	put64(agx, useq + 0x4, fw_va(cmd + 0x3c8));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x80));
+	put64(agx, useq + 0x14, fw_va(bms));
+	put64(agx, useq + 0x1c, fw_va(stats));
+	put64(agx, useq + 0x24, fw_va(cmd + 0x888));
+	put64(agx, useq + 0x2c, fw_va(cmd + 0x88c));
+	put64(agx, useq + 0x34, fw_va(cmd + 0x8b8));
+	put64(agx, useq + 0x3c, fw_va(agx->fragq.info));
+	put64(agx, useq + 0x44, fw_va(cmd));
+	put32(agx, useq + 0x4c, ctx);
+	put32(agx, useq + 0x54, ctx);
+	put64(agx, useq + 0x6c, fw_va(cmd + 0x770));
+	put64(agx, useq + 0x74, fw_va(cmd + 0x8f0));
+	put32(agx, useq + 0x90, EV_3D);
+	put64(agx, useq + 0x9c, fw_va(sc + 0x60));	/* kick gate */
+	/* wait for the 3D interrupt */
+	put32(agx, useq + 0xa4, 0x401);
+	/* Finalize3D, 0x7c bytes */
+	put32(agx, fin, 0x25);
+	put32(agx, fin + 0x4, EV_3D);
+	put64(agx, fin + 0xc, fw_va(sc + 0x48));	/* event control counter */
+	put32(agx, fin + 0x14, 1);
+	put64(agx, fin + 0x1c, fw_va(bms));
+	put64(agx, fin + 0x24, fw_va(sc + 0x80));
+	put64(agx, fin + 0x2c, 1);
+	put64(agx, fin + 0x34, fw_va(stats));
+	put64(agx, fin + 0x3c, fw_va(cmd + 0x8b8));
+	put64(agx, fin + 0x44, fw_va(cmd + 0x888));
+	put64(agx, fin + 0x4c, fw_va(agx->fragq.info));
+	put64(agx, fin + 0x54, fw_va(cmd));
+	put32(agx, fin + 0x5c, ctx);
+	put64(agx, fin + 0x64, fw_va(cmd + 0x770));
+	put32(agx, fin + 0x78, -(0xa4 + 4));
+	/* end */
+	put32(agx, fin + 0x7c, 0x18 | 0x40 << 24);
+	put64(agx, cmd + 0x14, fw_va(useq));
+	put32(agx, cmd + 0x1c, fin + 0x80 - useq);
+}
+
+/* The 21B91 GFX kext writes longer microsequence records than XS. Keep the
+ * first experiment separate from the XS writer and refuse any layout that
+ * does not fit the two owned command pages. */
+static int agx21_render_rewrite(struct agx_device *agx, u32 ctx, u32 stamp)
+{
+	u32 ta = agx->rn.ta, d3 = agx->rn.frag, sc = agx->rn.scratch;
+	u32 ts = ta + 0x700, fs = d3 + 0xb00, tf = ts + 0x98;
+	u32 ff = fs + 0xa8;
+	u32 bmd = agx->rn.bmd, bms = agx->rn.bms;
+	u32 ta_stats = rn_stats(agx, 0x170) + 4;
+	u32 d3_stats = rn_stats(agx, 0x178) + 8;
+	u8 *buf = agx->buf;
+
+	if (ta + AGX_PAGE > agx->ipad_memory->size ||
+	    d3 + AGX_PAGE > agx->ipad_memory->size ||
+	    sc + 0x100 > agx->ipad_memory->size)
+		return -ERANGE;
+	/* Type-0 stamp/event are eight bytes later than XS. */
+	put32(agx, ta + 0x570, 0);
+	put32(agx, ta + 0x574, 0);
+	/* The native TA producer carries a translated scratch/status address
+	 * at command +0x570; FinalizeTA copies that address at record +0x44. */
+	put64(agx, ta + 0x570, fw_va(sc + 8));
+	if (agx21_patch_render_completion(buf + ta, AGX_PAGE, 0,
+		stamp, EV_TA) ||
+	    agx21_patch_render_completion(buf + d3, AGX_PAGE, 1,
+		stamp, EV_3D))
+		return -EINVAL;
+	/* 21B91 TA cmd+0x580 is an event-control slot, not the RUN event ID.
+	 * The first bank has slots 0..3: slot 4 would write its pointer into
+	 * evc+0x4c, which the firmware reads as the second-bank pending mask.
+	 * Keep EV_TA=4 for completion/doorbell; use an empty first-bank slot. */
+	put32(agx, ta + 0x580, 0);
+	/* 3D cmd+0x8dc is likewise a slot, in the second bank.  The zeroed
+	 * command already selects slot 0; make that choice explicit. */
+	put32(agx, d3 + 0x8dc, 0);
+	memset(buf + ts, 0, 0x140);
+	memset(buf + fs, 0, 0x140);
+	/* Native StartTA (0x94): the extra 0x7c/0x84/0x8c tail is not
+	 * BadApple padding. The no-auxiliary-record path is selected here. */
+	put32(agx, ts, 0x22);
+	put64(agx, ts + 0x04, fw_va(ta + 0x3c4));
+	put64(agx, ts + 0x0c, fw_va(ta + 0x40));
+	put64(agx, ts + 0x14, fw_va(bmd));
+	put64(agx, ts + 0x1c, fw_va(bms));
+	put64(agx, ts + 0x24, fw_va(ta_stats));
+	put64(agx, ts + 0x2c, fw_va(agx->taq.info));
+	put64(agx, ts + 0x34, fw_va(ta + 0x550));
+	put32(agx, ts + 0x3c, ctx);
+	/* 21B91 StartTA takes the low six bits of +0x44 and the upper
+	 * context field from +0x3c. Native TA +0x44 and 3D +0x54 have the
+	 * same descriptor+0x140->+8 producer; our 3D already uses ctx there.
+	 * Leaving TA +0x44 zero writes ctx<<8 to RGX +0x10208 rather than
+	 * ctx|(ctx<<8), unlike the working XS active-TA path. */
+	put32(agx, ts + 0x44, ctx);
+	/* Native 21B91 +0x50 is the descriptor's auxiliary dword (+0xd30),
+	 * not the completion event ID.  This bounded render has no auxiliary
+	 * descriptor, as in BadApple's corresponding XS +0x48 field. */
+	put32(agx, ts + 0x50, 0);
+	put64(agx, ts + 0x5c, fw_va(ta + 0x488));
+	put64(agx, ts + 0x64, fw_va(ta + 0x594));
+	/* XS native/BadApple both mirror cmd+0x580 at StartTA+0x6c.
+	 * iPad native instead mirrors cmd+0x588 at StartTA+0x74; do not
+	 * transplant XS's literal 4 into the shifted 21B91 record. */
+	put32(agx, ts + 0x74, get_unaligned_le32(buf + ta + 0x588));
+	/* Native J171 StartTA stores the command's +4 qword as a scalar.
+	 * Firmware compares it with *(u64 *)(ts+0x84); publishing its GPU
+	 * address instead always trips the scene+0xbc bypass status. */
+	put64(agx, ts + 0x7c, get_unaligned_le64(buf + ta + 4));
+	put64(agx, ts + 0x84, fw_va(sc + 0x20));
+	put32(agx, ts + 0x94, 0x40001);
+	/* Native FinalizeTA (0x64) and End. */
+	put32(agx, tf, 0x23);
+	put64(agx, tf + 0x04, fw_va(bms));
+	put64(agx, tf + 0x0c, fw_va(bmd));
+	put64(agx, tf + 0x14, fw_va(ta_stats));
+	put64(agx, tf + 0x1c, fw_va(agx->taq.info));
+	/* iPad AGXG11P sub_FFFFFFF00846D7CC: +0x24 is a pointer,
+	 * +0x2c/+0x30 are separate scalars, unlike XS FinalizeTA. */
+	put64(agx, tf + 0x24, fw_va(ta + 0x550));
+	put32(agx, tf + 0x2c, ctx);
+	put32(agx, tf + 0x30, 0);
+	put64(agx, tf + 0x34, fw_va(ta + 0x488));
+	put32(agx, tf + 0x3c, 0);
+	put32(agx, tf + 0x40, 0);
+	put64(agx, tf + 0x44, fw_va(sc + 8));
+	/* EVC completion count, not the GPU stamp: FW 0x1c20c only
+	 * unlinks when this counter equals EVC+0xc (one command). */
+	put32(agx, tf + 0x4c, 1);
+	put64(agx, tf + 0x50, 0);
+	put32(agx, tf + 0x54, -(0x94 + 4));
+	put64(agx, tf + 0x5c, fw_va(ta + 0x5d4));
+	put32(agx, tf + 0x64, 0x18 | 0x40 << 24);
+	/* Native Start3D (0xa4), wait, Finalize3D (0x84), End. */
+	put32(agx, fs, 0x24);
+	put64(agx, fs + 0x04, fw_va(d3 + 0x3c8));
+	put64(agx, fs + 0x0c, fw_va(d3 + 0x80));
+	put64(agx, fs + 0x14, fw_va(bms));
+	put64(agx, fs + 0x1c, fw_va(d3_stats));
+	put64(agx, fs + 0x24, fw_va(d3 + 0x888));
+	put64(agx, fs + 0x2c, fw_va(d3 + 0x88c));
+	put64(agx, fs + 0x34, fw_va(d3 + 0x8b8));
+	put64(agx, fs + 0x3c, fw_va(agx->fragq.info));
+	put64(agx, fs + 0x44, fw_va(d3));
+	put32(agx, fs + 0x4c, ctx);
+	put32(agx, fs + 0x54, ctx);
+	put64(agx, fs + 0x6c, fw_va(d3 + 0x770));
+	put64(agx, fs + 0x74, fw_va(d3 + 0x8f0));
+	put32(agx, fs + 0x90, EV_3D);
+	/* Native 21B91 0x8469660/0x84696e0 copies cmd+4's VALUE.
+	 * FW 0xfdac compares this scalar against *(fs+0x9c); a pointer
+	 * here sets cmd+0x8b8 and skips the hardware 3D kick. */
+	put64(agx, fs + 0x94, get_unaligned_le64(buf + d3 + 4));
+	put64(agx, fs + 0x9c, fw_va(sc + 0x60));
+	put32(agx, fs + 0xa4, 0x401);
+	put32(agx, ff, 0x25);
+	put32(agx, ff + 0x04, EV_3D);
+	put64(agx, ff + 0x0c, fw_va(sc + 0x48));
+	put32(agx, ff + 0x14, 1);
+	put64(agx, ff + 0x1c, fw_va(bms));
+	put64(agx, ff + 0x24, fw_va(sc + 0x80));
+	put64(agx, ff + 0x2c, 1);
+	put64(agx, ff + 0x34, fw_va(d3_stats));
+	put64(agx, ff + 0x3c, fw_va(d3 + 0x8b8));
+	put64(agx, ff + 0x44, fw_va(d3 + 0x888));
+	put64(agx, ff + 0x4c, fw_va(agx->fragq.info));
+	put64(agx, ff + 0x54, fw_va(d3));
+	put32(agx, ff + 0x5c, ctx);
+	put64(agx, ff + 0x64, fw_va(d3 + 0x770));
+	put32(agx, ff + 0x78, -(0xa4 + 4));
+	put64(agx, ff + 0x7c, fw_va(d3 + 0x930));
+	put32(agx, ff + 0x84, 0x18 | 0x40 << 24);
+	if (agx21_patch_render_microseq(buf + ta, AGX_PAGE, 0,
+		fw_va(ts), 0x100) ||
+	    agx21_patch_render_microseq(buf + d3, AGX_PAGE, 1,
+		fw_va(fs), 0x130))
+		return -EINVAL;
+	return 0;
+}
+
+/*
+ * Queue the TA job behind an InitBuffer. The 3D job waits in its ring until
+ * agx_complete() sees the TA stamp.
+ */
+struct dma_fence *agx_fw_render(struct agx_device *agx, u32 ctx,
+				const struct drm_asahi_cmd_render *r)
+{
+	struct dma_fence *fence;
+	struct rn_tiling t;
+	u32 sc = agx->rn.scratch, init = agx->rn.init;
+	u32 render_stamp = DONE_STAMP;
+	u64 utile = (r->utile_width_px / 16) << 12 | (r->utile_height_px / 16) << 14 |
+		    ilog2(r->samples);
+
+	if (agx->wedged)
+		return ERR_PTR(-EIO);
+	if (agx->ipad_memory) {
+		int ret = agx21_render_next_stamp(agx->ipad_transport, &render_stamp);
+
+		if (ret)
+			return ERR_PTR(ret);
+	}
+	fence = kzalloc(sizeof(*fence), GFP_KERNEL);
+	if (!fence)
+		return ERR_PTR(-ENOMEM);
+
+	rn_tiling(r->width_px, r->height_px, r->utile_width_px, r->utile_height_px, &t);
+	if (agx->ipad_memory &&
+	    (!agx->ipad_memory->render_resources_reserved ||
+	     r->width_px > AGX21_RENDER_MAX_WIDTH ||
+	     r->height_px > AGX21_RENDER_MAX_HEIGHT ||
+	     r->layers != 1 || r->samples != 1 ||
+	     t.rgn_pages * SZ_4K > agx->ipad_memory->objects[
+		 agx->ipad_memory->render_resources.tilemap].size ||
+	     t.tpc_pages * SZ_4K > agx->ipad_memory->objects[
+		 agx->ipad_memory->render_resources.tpc].size)) {
+		kfree(fence);
+		return ERR_PTR(-EOPNOTSUPP);
+	}
+	memset(agx->buf + sc, 0, 0x100);
+	put64(agx, sc + 0x20, 1);
+	put64(agx, sc + 0x60, 1);
+	if (agx->ipad_memory)
+		dev_dbg(agx->dev,
+			 "J171 RENDER INPUT flags=%#x empty_tiles=%u bg=%#llx/%#x eot=%#llx/%#x\n",
+			 r->flags,
+			 !!(r->flags & DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES),
+			 (unsigned long long)r->bg.usc, r->bg.rsrc_spec,
+			 (unsigned long long)r->eot.usc, r->eot.rsrc_spec);
+	rn_ta(agx, ctx, r, &t, utile);
+	rn_frag(agx, ctx, r, &t, utile);
+	if (agx->ipad_memory) {
+		int ret;
+		ret = agx21_render_rewrite(agx, ctx, render_stamp);
+		if (!ret)
+			ret = agx21_asahi_render(agx->ipad_transport, ctx,
+				agx->rn.ta, agx->rn.frag, sc);
+		if (ret) {
+			kfree(fence);
+			return ERR_PTR(ret);
+		}
+		dma_fence_init(fence, &agx_fence_ops, &agx->fence_lock,
+			agx->fence_ctx, ++agx->fence_seqno);
+		dma_fence_signal(fence);
+		return fence;
+	}
+
+	dma_fence_init(fence, &agx_fence_ops, &agx->fence_lock, agx->fence_ctx,
+		       ++agx->fence_seqno);
+	spin_lock_irq(&agx->fence_lock);
+	agx->active = dma_fence_get(fence);
+	agx->active_stamp = sc + 0x40;
+	agx->rn.frag_pending = true;
+	spin_unlock_irq(&agx->fence_lock);
+
+	/*
+	 * InitBuffer {6, ctx, slot, start, flag, descriptor, stamp} before every
+	 * TA job.
+	 */
+	memset(agx->buf + init, 0, 0x40);
+	put32(agx, init, 6);
+	put32(agx, init + 4, ctx);
+	put64(agx, init + 0x14, fw_va(agx->rn.bmd));
+	put32(agx, init + 0x1c, DONE_STAMP);
+	agx_push(agx, &agx->taq, init);
+	agx_push(agx, &agx->taq, agx->rn.ta);
+	agx_push(agx, &agx->fragq, agx->rn.frag);
+	agx_kick(agx, &agx->taq, CH_TA, EV_TA);
+	return fence;
+}
+
+/*
+ * Signal the running job's fence if its stamp has landed, or kick a
+ * render's 3D job once its TA job is done.
+ */
+static bool agx_complete(struct agx_device *agx)
+{
+	struct dma_fence *fence = NULL;
+	unsigned long flags;
+	bool kick = false;
+
+	spin_lock_irqsave(&agx->fence_lock, flags);
+	if (agx->rn.frag_pending &&
+	    READ_ONCE(*(u32 *)(agx->buf + agx->rn.scratch)) == DONE_STAMP) {
+		agx->rn.frag_pending = false;
+		kick = true;
+	} else if (agx->active &&
+	    READ_ONCE(*(u32 *)(agx->buf + agx->active_stamp)) == DONE_STAMP) {
+		dma_rmb();
+		fence = agx->active;
+		agx->active = NULL;
+		dma_fence_signal_locked(fence);
+	}
+	spin_unlock_irqrestore(&agx->fence_lock, flags);
+	if (kick)
+		agx_kick(agx, &agx->fragq, CH_3D, EV_3D);
+	if (fence)
+		dma_fence_put(fence);
+	return fence;
+}
+
+/*
+ * The running job timed out. The firmware cannot be reset, so unless the
+ * job finished unnoticed this fails it and every later one.
+ */
+/*
+ * The last firmware trace entries other than the power thread's, which
+ * otherwise overwrite a hang's trail in seconds. Entries are {5, u64 ts,
+ * 4 x u64 args, code | thread << 24, arg}, 0x38 bytes, 0x200 of them.
+ */
+static void agx_dump_trace(struct agx_device *agx)
+{
+	u32 w = get32(agx, agx->chan_state[CH_KTRACE] + 0x20), i, n = 0;
+
+	for (i = 1; i < 0x200 && n < 24; i++) {
+		u32 e = agx->chan_ring[CH_KTRACE] + (w + 0x200 - i) % 0x200 * 0x38;
+		u32 code = get32(agx, e + 0x2c);
+
+		/* skip the power thread and the main loop's idle entries */
+		if (get32(agx, e) != 5 || code >> 24 == 3 ||
+		    (code >> 24 == 1 && ((code & 0xfffffe) == 0x100 ||
+					 (code & 0xfffffe) == 0x104 ||
+					 (code & 0xffffff) == 0x106 ||
+					 (code & 0xffffff) == 0x112 ||
+					 (code & 0xffffff) == 0x11a)))
+			continue;
+		dev_err(agx->dev, "trace %#x thr %u: %llx %llx %llx %llx\n",
+			code & 0xffffff, code >> 24,
+			get_unaligned_le64(agx->buf + e + 0xc),
+			get_unaligned_le64(agx->buf + e + 0x14),
+			get_unaligned_le64(agx->buf + e + 0x1c),
+			get_unaligned_le64(agx->buf + e + 0x24));
+		n++;
+	}
+}
+
+void agx_fw_timeout(struct agx_device *agx)
+{
+	struct dma_fence *fence;
+	u64 st;
+	if (agx->ipad_memory) {
+		agx->wedged = true;
+		dev_err(agx->dev, "J171 firmware job timeout; reboot required\n");
+		return;
+	}
+
+	if (agx_complete(agx)) {
+		dev_warn(agx->dev, "job finished without an event\n");
+		return;
+	}
+	st = readq(agx->rgx + RGX_MMU_FAULT_STATUS);
+	dev_err(agx->dev,
+		"job timed out, GPU wedged; MMU fault %#llx: VA %#llx ctx %llu requester %llu %s type %llu\n",
+		st, (st >> 24) & ~0x3fULL, (st >> 16) & 0x3f, (st >> 8) & 0xff,
+		st & BIT(4) ? "read" : "write", (st >> 1) & 7);
+	if (agx->rn.frag_pending)
+		dev_err(agx->dev, "render stuck in its TA job\n");
+	agx_dump_trace(agx);
+	agx->wedged = true;
+	spin_lock_irq(&agx->fence_lock);
+	agx->rn.frag_pending = false;
+	fence = agx->active;
+	agx->active = NULL;
+	if (fence) {
+		dma_fence_set_error(fence, -ETIMEDOUT);
+		dma_fence_signal_locked(fence);
+	}
+	spin_unlock_irq(&agx->fence_lock);
+	if (fence)
+		dma_fence_put(fence);
+}
+
+static int agx_shmem_setup(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	struct agx_device *agx = cookie;
+	int i;
+
+	/* Address 0 asks the host to pick one. */
+	if (!bfr->iova) {
+		bfr->buffer = dmam_alloc_coherent(agx->dev, bfr->size, &bfr->iova,
+						  GFP_KERNEL);
+		return bfr->buffer ? 0 : -ENOMEM;
+	}
+
+	for (i = 0; i < agx->nsegs; i++) {
+		u64 iova = le64_to_cpu(agx->segs[i].iova);
+		u32 size = le32_to_cpu(agx->segs[i].size);
+
+		if (bfr->iova < iova || bfr->iova + bfr->size > iova + size)
+			continue;
+
+		bfr->buffer = devm_memremap(agx->dev, le64_to_cpu(agx->segs[i].phys) +
+					    bfr->iova - iova, bfr->size, MEMREMAP_WB);
+		return PTR_ERR_OR_ZERO(bfr->buffer);
+	}
+
+	dev_warn(agx->dev, "refusing buffer of %#zx bytes at %pad\n", bfr->size,
+		 &bfr->iova);
+	return -ENOMEM;
+}
+
+/*
+ * devm frees and unmaps the buffers with the device. Without this rtkit
+ * would dma_free_coherent() them itself.
+ */
+static void agx_shmem_destroy(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+}
+
+static void agx_recv(void *cookie, u8 ep, u64 msg)
+{
+	struct agx_device *agx = cookie;
+
+	/* 0x42 only says "check the channels"; a job's end is one reason. */
+	if (msg == MSG_CHECK && READ_ONCE(agx->ready)) {
+		agx_drain(agx);
+		agx_complete(agx);
+	} else if (msg != MSG_CHECK)
+		dev_info(agx->dev, "ep %#x: %#018llx\n", ep, msg);
+}
+
+static void agx_crashed(void *cookie, const void *log, size_t size)
+{
+	struct agx_device *agx = cookie;
+
+	dev_err(agx->dev, "firmware crashed\n");
+}
+
+const struct apple_rtkit_ops agx_rtk_ops = {
+	.crashed = agx_crashed,
+	.recv_message = agx_recv,
+	.shmem_setup = agx_shmem_setup,
+	.shmem_destroy = agx_shmem_destroy,
+};
+
+static int agx_dbg_show(struct seq_file *m, void *v)
+{
+	struct agx_device *agx = m->private;
+	int i;
+
+	seq_printf(m, "pa %pad va %#llx gva %#llx size %#x free %#x\n", &agx->pa,
+		   AGX_CHUNK_VA, AGX_CHUNK_GVA, AGX_CHUNK_SIZE, agx->off);
+	seq_printf(m, "B %#x C %#x info %#x\n", agx->B, agx->C, agx->cpq.info);
+	for (i = 0; i < ARRAY_SIZE(agx->chan_state); i++)
+		seq_printf(m, "chan %d state %#x ring %#x\n", i, agx->chan_state[i],
+			   agx->chan_ring[i]);
+	seq_printf(m, "ctx %*pb\n", AGX_NR_CTX, agx->ctx_used);
+	seq_printf(m, "rn ta %#x frag %#x\n", agx->rn.ta, agx->rn.frag);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(agx_dbg);
+
+static void agx_debugfs(struct agx_device *agx)
+{
+	struct dentry *d = debugfs_create_dir("agx", NULL);
+
+	debugfs_create_file("info", 0400, d, agx, &agx_dbg_fops);
+}
+
+/*
+ * Boot the firmware, hand it the init block and bring the GPU up. The
+ * firmware cannot be restarted, so this runs once per boot.
+ */
+int agx_fw_init(struct agx_device *agx, void __iomem *asc)
+{
+	struct device *dev = agx->dev;
+	dma_addr_t init_pa, table_pa;
+	void *init, *table, *buf;
+	u32 v;
+	int i, ret;
+
+	spin_lock_init(&agx->fence_lock);
+	agx->fence_ctx = dma_fence_context_alloc(1);
+	agx->rtk = devm_apple_rtkit_init(dev, agx, NULL, 0, &agx_rtk_ops);
+	if (IS_ERR(agx->rtk))
+		return dev_err_probe(dev, PTR_ERR(agx->rtk), "RTKit init failed\n");
+
+	writel(ASC_CPU_CONTROL_RUN, asc + ASC_CPU_CONTROL);
+
+	ret = apple_rtkit_boot(agx->rtk);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware did not boot\n");
+	ret = apple_rtkit_start_ep(agx->rtk, EP_MSGS);
+	if (!ret)
+		ret = apple_rtkit_start_ep(agx->rtk, EP_INTS);
+	if (ret)
+		return dev_err_probe(dev, ret, "endpoints did not start\n");
+	msleep(500);
+
+	init = dmam_alloc_coherent(dev, SZ_16K, &init_pa, GFP_KERNEL);
+	table = dmam_alloc_coherent(dev, SZ_16K, &table_pa, GFP_KERNEL);
+	buf = dmam_alloc_coherent(dev, AGX_CHUNK_SIZE, &agx->pa, GFP_KERNEL);
+	if (!init || !table || !buf)
+		return -ENOMEM;
+	agx->buf = buf;
+	agx_build(agx, init, table, table_pa);
+	ret = agx_vm_map_chunk(agx);
+	if (ret)
+		return ret;
+	wmb();
+	WRITE_ONCE(agx->ready, true);
+
+	apple_rtkit_send_message(agx->rtk, EP_MSGS, MSG_INIT | init_pa, NULL, false);
+	ret = readx_poll_timeout(READ_ONCE, *(u32 *)(buf + agx->C + 0xb198), v, v,
+				 10000, 2000000);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware did not take the init block\n");
+
+	/*
+	 * Device control type 0x1b only stores its argument, but it also
+	 * brings the GPU up, which sets up the scheduler state jobs need and
+	 * loads every context's page catalogue.
+	 */
+	put32(agx, agx->chan_ring[CH_DEVCTRL], 0x1b);
+	put64(agx, agx->chan_ring[CH_DEVCTRL] + 4, 0x1122334455667788);
+	put32(agx, agx->chan_state[CH_DEVCTRL] + 0x20, 1);
+	agx_doorbell(agx, 0x11);
+	ret = readx_poll_timeout(READ_ONCE, *(u32 *)(buf + agx->chan_state[CH_DEVCTRL]), v,
+				 v == 1, 10000, 3000000);
+	if (ret)
+		return dev_err_probe(dev, ret, "device control message not taken\n");
+	msleep(1000);
+
+	agx_queue(agx, &agx->cpq, 1);
+	agx_queue(agx, &agx->taq, 1);
+	agx_queue(agx, &agx->fragq, 0);
+	for (i = 0; i < NR_SLOTS; i++) {
+		agx->slot[i].cmd = agx_alloc(agx, 0x300, 0x100);
+		agx->slot[i].evc = agx_alloc(agx, 0x100, 0x100);
+		agx->slot[i].useq = agx_alloc(agx, 0x200, 0x100);
+		agx->slot[i].scratch = agx_alloc(agx, 0x100, 0x100);
+	}
+	ret = agx_render_init(agx);
+	if (ret)
+		return ret;
+	agx_debugfs(agx);
+	dev_info(dev, "firmware up, chunk at %pad\n", &agx->pa);
+	return 0;
+}
+
+/*
+ * After a page table change. FUN_00026514 compares each context's
+ * generation with its own copy (RegionB+0x1b0) before the context's next
+ * job, flushes the TLB if they differ and copies ours over; bits 31:22 ask
+ * for the full flush. Starting from its copy keeps them different however
+ * many changes come before that job.
+ */
+void agx_fw_flush_tlb(struct agx_device *agx, u32 ctx)
+{
+	if (agx->ipad_memory) {
+		u32 old_fw, new_host;
+
+		/* J171's generation buffers are owned by the already-published
+		 * 21B91 InitData.  Never use XS offsets into that arena. */
+		wmb();
+		if (agx21_memory_request_tlb_flush(agx->ipad_memory, ctx,
+					   &old_fw, &new_host)) {
+			agx->wedged = true;
+			dev_err(agx->dev, "J171 TLB generation update failed for context %u\n", ctx);
+		}
+		return;
+	}
+	wmb();
+	WRITE_ONCE(*(u32 *)(agx->buf + agx->gen + ctx * 4),
+		   READ_ONCE(*(u32 *)(agx->buf + agx->gen_fw + ctx * 4)) + BIT(22));
+}
diff --git a/drivers/gpu/drm/agx/agx_vm.c b/drivers/gpu/drm/agx/agx_vm.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_vm.c
@@ -0,0 +1,711 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * GPU VMs. The MMU is a PowerVR Rogue S7 with 16K pages: a page catalogue
+ * of u32 entries (pd >> 12) << 4 | 1 for VA[39:30], page directories of u64
+ * entries pt | 3 for VA[29:21] and page tables of u64 entries page | 1 for
+ * VA[20:14], bit 1 marking a page read-only.
+ *
+ * Each VM owns one MMU context. Its page catalogue sits in the firmware
+ * chunk and is loaded by the firmware at every power-up; page directories
+ * and tables come from DMA pools. After a change the context's TLB
+ * generation is bumped and the firmware flushes before its next job.
+ *
+ * Queues and jobs hold references. Unbinds wait until no job of the VM is
+ * queued or running, so the GPU never sees pages that were given back.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <drm/drm_gem.h>
+#include <drm/asahi_drm.h>
+#include <drm/drm_gem_shmem_helper.h>
+#include <linux/dma-mapping.h>
+#include <linux/dmapool.h>
+#include <linux/kref.h>
+#include <linux/list.h>
+#include <linux/moduleparam.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <linux/wait.h>
+
+#include "agx.h"
+#include "agx_21b91_memory.h"
+
+#define PC_ENTRIES	1024
+#define PD_ENTRIES	512
+#define PT_ENTRIES	128
+#define AGX_PTE_VALID	BIT(0)
+#define AGX_PTE_RO	BIT(1)
+
+struct agx_pt {
+	u64 *cpu;
+	dma_addr_t dma;
+};
+
+struct agx_pd {
+	u64 *cpu;
+	dma_addr_t dma;
+	struct agx_pt pt[PD_ENTRIES];
+};
+
+struct agx_mapping {
+	struct list_head node;
+	u64 addr, range, offset;
+	bool write;
+	struct drm_gem_object *obj;
+};
+
+struct agx_vm {
+	struct agx_device *agx;
+	struct kref ref;
+	atomic_t jobs;
+	wait_queue_head_t idle;
+	u32 ctx;
+	struct mutex lock;
+	struct list_head mappings;
+	u64 kernel_start, kernel_end;
+	void *scratch;		/* for RGX 0x14020, at kernel_start */
+	dma_addr_t scratch_dma;
+	struct agx_pd *pd[PC_ENTRIES];
+};
+
+static u32 *pc_entry(struct agx_vm *vm, u32 i)
+{
+	return vm->agx->buf + vm->agx->pc[vm->ctx] + i * 4;
+}
+
+static int agx_set_pte(struct agx_vm *vm, u64 va, u64 pte)
+{
+	struct agx_device *agx = vm->agx;
+	u32 i0 = (va >> 30) & (PC_ENTRIES - 1);
+	u32 i1 = (va >> 21) & (PD_ENTRIES - 1);
+	u32 i2 = (va >> 14) & (PT_ENTRIES - 1);
+	struct agx_pd *pd = vm->pd[i0];
+	struct agx_pt *pt;
+
+	if (!pd) {
+		if (!pte)
+			return 0;
+		pd = kzalloc(sizeof(*pd), GFP_KERNEL);
+		if (!pd)
+			return -ENOMEM;
+		pd->cpu = dma_pool_zalloc(agx->pd_pool, GFP_KERNEL, &pd->dma);
+		if (!pd->cpu) {
+			kfree(pd);
+			return -ENOMEM;
+		}
+		vm->pd[i0] = pd;
+		WRITE_ONCE(*pc_entry(vm, i0), (pd->dma >> 12) << 4 | 1);
+	}
+	pt = &pd->pt[i1];
+	if (!pt->cpu) {
+		if (!pte)
+			return 0;
+		pt->cpu = dma_pool_zalloc(agx->pt_pool, GFP_KERNEL, &pt->dma);
+		if (!pt->cpu)
+			return -ENOMEM;
+		WRITE_ONCE(pd->cpu[i1], pt->dma | 3);
+	}
+	WRITE_ONCE(pt->cpu[i2], pte);
+	return 0;
+}
+
+/*
+ * The whole chunk at AGX_CHUNK_GVA in every context, for structures the
+ * firmware and the parameter manager both read. User VMs end below it.
+ */
+int agx_vm_map_chunk(struct agx_device *agx)
+{
+	const u64 gva = AGX_CHUNK_GVA;
+	dma_addr_t pd_dma, pt_dma;
+	u64 *pd, *pt;
+	u32 i, j;
+
+	if (agx->ipad_memory) {
+		struct agx21_memory *m = agx->ipad_memory;
+		u32 index = (AGX21_GPU_SHARED_VA >> 30) & (PC_ENTRIES - 1);
+		u32 expected;
+
+		/* J171 owns its shared mapping before InitData publication. Do not
+		 * replace it with an XS-generated page table after publication. */
+		if (!m->published || m->size != AGX21_ARENA_BYTES ||
+		    AGX_CHUNK_GVA != AGX21_GPU_SHARED_VA)
+			return -EINVAL;
+		expected = (agx21_memory_physical(m, AGX21_MEM_SHARED_PD) >> 12) << 4 | 1;
+		for (i = 0; i < AGX_NR_CTX; i++) {
+			u8 *pc = agx21_memory_cpu(m, AGX21_MEM_PC_BASE + i);
+
+			if (!pc || get_unaligned_le32(pc + index * 4) != expected)
+				return -EINVAL;
+		}
+		return 0;
+	}
+
+	pd = dma_pool_zalloc(agx->pd_pool, GFP_KERNEL, &pd_dma);
+	if (!pd)
+		return -ENOMEM;
+	for (i = 0; i < AGX_CHUNK_SIZE / SZ_2M; i++) {
+		pt = dma_pool_zalloc(agx->pt_pool, GFP_KERNEL, &pt_dma);
+		if (!pt)
+			return -ENOMEM;
+		for (j = 0; j < PT_ENTRIES; j++)
+			pt[j] = (agx->pa + i * SZ_2M + j * AGX_PAGE) | AGX_PTE_VALID;
+		pd[(gva >> 21) % PD_ENTRIES + i] = pt_dma | 3;
+	}
+	/* Contexts below AGX_FIRST_CTX too: the parameter manager uses them. */
+	for (i = 0; i < AGX_NR_CTX; i++)
+		put_unaligned_le32((pd_dma >> 12) << 4 | 1,
+				   agx->buf + agx->pc[i] + (gva >> 30) % PC_ENTRIES * 4);
+	return 0;
+}
+
+static void clear_range(struct agx_vm *vm, u64 addr, u64 range)
+{
+	u64 va;
+
+	for (va = addr; va < addr + range; va += AGX_PAGE)
+		agx_set_pte(vm, va, 0);
+}
+
+static bool in_vm(u64 addr, u64 range)
+{
+	return addr >= AGX_VM_START && range <= AGX_VM_END - addr;
+}
+
+struct agx_vm *agx_vm_create(struct agx_device *agx, u64 kernel_start, u64 kernel_end)
+{
+	struct agx_vm *vm;
+	int ctx, ret;
+
+	if (!IS_ALIGNED(kernel_start | kernel_end, AGX_PAGE) || kernel_end < kernel_start + AGX_PAGE ||
+	    !in_vm(kernel_start, kernel_end - kernel_start))
+		return ERR_PTR(-EINVAL);
+
+	vm = kzalloc(sizeof(*vm), GFP_KERNEL);
+	if (!vm)
+		return ERR_PTR(-ENOMEM);
+	vm->agx = agx;
+	kref_init(&vm->ref);
+	init_waitqueue_head(&vm->idle);
+	vm->kernel_start = kernel_start;
+	vm->kernel_end = kernel_end;
+	mutex_init(&vm->lock);
+	INIT_LIST_HEAD(&vm->mappings);
+
+	mutex_lock(&agx->ctx_lock);
+	ctx = find_next_zero_bit(agx->ctx_used, AGX_NR_CTX, AGX_FIRST_CTX);
+	if (ctx < AGX_NR_CTX)
+		set_bit(ctx, agx->ctx_used);
+	mutex_unlock(&agx->ctx_lock);
+	if (ctx >= AGX_NR_CTX) {
+		kfree(vm);
+		return ERR_PTR(-EBUSY);
+	}
+	vm->ctx = ctx;
+
+	vm->scratch = dma_alloc_coherent(agx->dev, AGX_PAGE, &vm->scratch_dma, GFP_KERNEL);
+	ret = vm->scratch ? agx_set_pte(vm, kernel_start, vm->scratch_dma | AGX_PTE_VALID) : -ENOMEM;
+	if (ret) {
+		agx_vm_put(vm);
+		return ERR_PTR(ret);
+	}
+	agx_fw_flush_tlb(agx, ctx);
+	return vm;
+}
+
+static void agx_vm_release(struct kref *ref)
+{
+	struct agx_vm *vm = container_of(ref, struct agx_vm, ref);
+	struct agx_device *agx = vm->agx;
+	struct agx_mapping *m, *tmp;
+	int i, j;
+
+	list_for_each_entry_safe(m, tmp, &vm->mappings, node) {
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	for (i = 0; i < PC_ENTRIES; i++) {
+		struct agx_pd *pd = vm->pd[i];
+
+		if (!pd)
+			continue;
+		WRITE_ONCE(*pc_entry(vm, i), 0);
+		for (j = 0; j < PD_ENTRIES; j++)
+			if (pd->pt[j].cpu)
+				dma_pool_free(agx->pt_pool, pd->pt[j].cpu, pd->pt[j].dma);
+		dma_pool_free(agx->pd_pool, pd->cpu, pd->dma);
+		kfree(pd);
+	}
+	agx_fw_flush_tlb(agx, vm->ctx);
+	if (vm->scratch)
+		dma_free_coherent(agx->dev, AGX_PAGE, vm->scratch, vm->scratch_dma);
+
+	mutex_lock(&agx->ctx_lock);
+	clear_bit(vm->ctx, agx->ctx_used);
+	mutex_unlock(&agx->ctx_lock);
+	kfree(vm);
+}
+
+struct agx_vm *agx_vm_get(struct agx_vm *vm)
+{
+	kref_get(&vm->ref);
+	return vm;
+}
+
+void agx_vm_put(struct agx_vm *vm)
+{
+	kref_put(&vm->ref, agx_vm_release);
+}
+
+/* A job of this VM was queued; unbinds wait for agx_vm_job_end(). */
+struct agx_vm *agx_vm_job_start(struct agx_vm *vm)
+{
+	atomic_inc(&vm->jobs);
+	return agx_vm_get(vm);
+}
+
+void agx_vm_job_end(struct agx_vm *vm)
+{
+	if (atomic_dec_and_test(&vm->jobs))
+		wake_up_all(&vm->idle);
+	agx_vm_put(vm);
+}
+
+static bool overlaps(struct agx_vm *vm, u64 addr, u64 range)
+{
+	struct agx_mapping *m;
+
+	if (addr < vm->kernel_end && vm->kernel_start < addr + range)
+		return true;
+	list_for_each_entry(m, &vm->mappings, node)
+		if (addr < m->addr + m->range && m->addr < addr + range)
+			return true;
+	return false;
+}
+
+static int cut(struct agx_vm *vm, u64 addr, u64 range)
+{
+	struct agx_mapping *m, *tmp, *right;
+	u64 end = addr + range;
+
+	list_for_each_entry_safe(m, tmp, &vm->mappings, node) {
+		u64 m_end = m->addr + m->range;
+
+		if (m_end <= addr || end <= m->addr)
+			continue;
+		clear_range(vm, max(addr, m->addr), min(end, m_end) - max(addr, m->addr));
+		if (m->addr < addr && end < m_end) {
+			right = kzalloc(sizeof(*right), GFP_KERNEL);
+			if (!right)
+				return -ENOMEM;
+			drm_gem_object_get(m->obj);
+			right->obj = m->obj;
+			right->addr = end;
+			right->range = m_end - end;
+			right->offset = m->offset + end - m->addr;
+			right->write = m->write;
+			list_add(&right->node, &vm->mappings);
+			m->range = addr - m->addr;
+		} else if (m->addr < addr) {
+			m->range = addr - m->addr;
+		} else if (end < m_end) {
+			m->offset += end - m->addr;
+			m->addr = end;
+			m->range = m_end - end;
+		} else {
+			list_del(&m->node);
+			drm_gem_object_put(m->obj);
+			kfree(m);
+		}
+	}
+	return 0;
+}
+
+/* Shared VM binding implementation; preserve XS replacement semantics. */
+int agx_vm_bind(struct agx_vm *vm, struct drm_gem_object *obj, u64 offset, u64 range,
+		u64 addr, bool write, bool single)
+{
+	struct sg_table *sgt;
+	struct scatterlist *sg;
+	struct agx_mapping *m;
+	u64 pte_flags = AGX_PTE_VALID | (write ? 0 : AGX_PTE_RO);
+	u64 va = addr, skip = offset;
+	int i, ret;
+
+	if (!range || !IS_ALIGNED(offset | range | addr, AGX_PAGE) || !in_vm(addr, range) ||
+	    offset >= obj->size || (!single && range > obj->size - offset))
+		return -EINVAL;
+
+	/* Imported buffers (display scanout) come with their pages mapped */
+	if (drm_gem_is_imported(obj))
+		sgt = to_drm_gem_shmem_obj(obj)->sgt;
+	else
+		sgt = drm_gem_shmem_get_pages_sgt(to_drm_gem_shmem_obj(obj));
+	if (IS_ERR_OR_NULL(sgt))
+		return sgt ? PTR_ERR(sgt) : -EINVAL;
+
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (!m)
+		return -ENOMEM;
+
+	mutex_lock(&vm->lock);
+	ret = -EBUSY;
+	if (addr < vm->kernel_end && vm->kernel_start < addr + range)
+		goto err;
+	if (overlaps(vm, addr, range)) {
+		ret = wait_event_interruptible(vm->idle, !atomic_read(&vm->jobs));
+		if (ret)
+			goto err;
+		ret = cut(vm, addr, range);
+		if (ret)
+			goto err_clear;
+	}
+
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		dma_addr_t dma = sg_dma_address(sg);
+		u64 len = sg_dma_len(sg);
+
+		if (skip >= len) {
+			skip -= len;
+			continue;
+		}
+		dma += skip;
+		len -= skip;
+		skip = 0;
+		for (; len && va < addr + range; va += AGX_PAGE) {
+			ret = agx_set_pte(vm, va, dma | pte_flags);
+			if (ret)
+				goto err_clear;
+			if (!single) {
+				len -= AGX_PAGE;
+				dma += AGX_PAGE;
+			}
+		}
+		if (va == addr + range)
+			break;
+	}
+	ret = -EINVAL;
+	if (va != addr + range)
+		goto err_clear;
+
+	drm_gem_object_get(obj);
+	m->obj = obj;
+	m->addr = addr;
+	m->range = range;
+	m->offset = offset;
+	m->write = write && !single;
+	list_add(&m->node, &vm->mappings);
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+	mutex_unlock(&vm->lock);
+	return 0;
+
+err_clear:
+	clear_range(vm, addr, va - addr);
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+err:
+	mutex_unlock(&vm->lock);
+	kfree(m);
+	return ret;
+}
+
+/*
+ * Unmap every binding inside [addr, addr + range); partial ones fail. Waits
+ * for the VM's jobs first.
+ *
+ * ponytail: waits for all of them, not only those using the range. Track
+ * per-mapping fences if unbinds under load ever stall.
+ */
+int agx_vm_unbind(struct agx_vm *vm, u64 addr, u64 range)
+{
+	int ret;
+
+	mutex_lock(&vm->lock);
+	ret = wait_event_interruptible(vm->idle, !atomic_read(&vm->jobs));
+	if (!ret)
+		ret = cut(vm, addr, range);
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+	mutex_unlock(&vm->lock);
+	return ret;
+}
+
+/*
+ * Drop every mapping of obj, as when its handle is closed: Mesa frees a
+ * buffer by closing it and reuses the VA. If waiting for the VM's jobs is
+ * interrupted the mappings stay until the VM goes, holding the pages.
+ */
+void agx_vm_unmap_object(struct agx_vm *vm, struct drm_gem_object *obj)
+{
+	struct agx_mapping *m, *tmp;
+	bool mapped = false;
+
+	mutex_lock(&vm->lock);
+	list_for_each_entry(m, &vm->mappings, node)
+		mapped |= m->obj == obj;
+	if (!mapped || wait_event_killable(vm->idle, !atomic_read(&vm->jobs)))
+		goto out;
+	list_for_each_entry_safe(m, tmp, &vm->mappings, node) {
+		if (m->obj != obj)
+			continue;
+		clear_range(vm, m->addr, m->range);
+		list_del(&m->node);
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+out:
+	mutex_unlock(&vm->lock);
+}
+
+/* Diagnostic only: inspect writable GEM bindings on either side of one
+ * render job.  The target colour BO is not named by the render ioctl; Mesa
+ * references it from a GPU-side PBE descriptor.  Surveying every writable
+ * binding avoids guessing a VA from the command's shader/USC fields. */
+#define AGX_CAPTURE_MAX_MAPS 64
+#define AGX_CAPTURE_MAX_BYTES SZ_32M
+#define AGX_CAPTURE_PAGE AGX_PAGE
+static bool render_bo_capture;
+module_param_named(render_bo_capture, render_bo_capture, bool, 0600);
+MODULE_PARM_DESC(render_bo_capture, "Log writable GEM BO page changes across iPad render jobs");
+
+struct agx_capture_page {
+	u64 hash;
+	u32 red_rgba;
+	u8 first[16];
+};
+
+struct agx_capture_map {
+	struct drm_gem_object *obj;
+	u64 addr, range, offset;
+	u32 pages;
+	struct agx_capture_page *before;
+};
+
+struct agx_bo_capture {
+	struct device *dev;
+	struct agx_capture_map map[AGX_CAPTURE_MAX_MAPS];
+	u32 count, skipped;
+};
+
+static void agx_capture_page(const struct iosys_map *map, u64 off, u32 len,
+			     struct agx_capture_page *out)
+{
+	u8 bytes[256];
+	u64 hash = 0xcbf29ce484222325ULL;
+	u32 i, n, done = 0;
+
+	out->red_rgba = 0;
+	iosys_map_memcpy_from(out->first, map, off, sizeof(out->first));
+	while (done < len) {
+		n = min_t(u32, sizeof(bytes), len - done);
+		iosys_map_memcpy_from(bytes, map, off + done, n);
+		for (i = 0; i < n; i++) {
+			hash ^= bytes[i];
+			hash *= 0x100000001b3ULL;
+		}
+		for (i = 0; i + 3 < n; i += 4)
+			if (bytes[i] == 0xff && !bytes[i + 1] &&
+			    !bytes[i + 2] && bytes[i + 3] == 0xff)
+				out->red_rgba++;
+		done += n;
+	}
+	out->hash = hash;
+}
+
+struct agx_bo_capture *agx_vm_capture_begin(struct agx_vm *vm)
+{
+	struct agx_bo_capture *cap;
+	struct agx_mapping *m;
+	u64 total = 0;
+	u32 i, page;
+	int ret;
+
+	if (!render_bo_capture || !vm->agx->ipad_memory)
+		return NULL;
+	cap = kzalloc(sizeof(*cap), GFP_KERNEL);
+	if (!cap)
+		return NULL;
+	cap->dev = vm->agx->dev;
+	mutex_lock(&vm->lock);
+	list_for_each_entry(m, &vm->mappings, node) {
+		struct agx_capture_map *c;
+
+		if (!m->write)
+			continue;
+		if (cap->count == AGX_CAPTURE_MAX_MAPS ||
+		    m->range > AGX_CAPTURE_MAX_BYTES - total) {
+			cap->skipped++;
+			continue;
+		}
+		c = &cap->map[cap->count];
+		c->pages = DIV_ROUND_UP_ULL(m->range, AGX_CAPTURE_PAGE);
+		c->before = kcalloc(c->pages, sizeof(*c->before), GFP_KERNEL);
+		if (!c->before) {
+			cap->skipped++;
+			continue;
+		}
+		c->obj = m->obj;
+		drm_gem_object_get(c->obj);
+		c->addr = m->addr;
+		c->range = m->range;
+		c->offset = m->offset;
+		total += m->range;
+		cap->count++;
+	}
+	mutex_unlock(&vm->lock);
+
+	for (i = 0; i < cap->count; i++) {
+		struct agx_capture_map *c = &cap->map[i];
+		struct iosys_map map = { };
+		struct sg_table *sgt = to_drm_gem_shmem_obj(c->obj)->sgt;
+
+		if (sgt)
+			dma_sync_sgtable_for_cpu(cap->dev, sgt, DMA_BIDIRECTIONAL);
+		ret = drm_gem_vmap(c->obj, &map);
+		if (ret) {
+			dev_warn(vm->agx->dev, "BOCAP before vmap failed va=%#llx err=%d\n",
+				 c->addr, ret);
+			c->pages = 0;
+			if (sgt)
+				dma_sync_sgtable_for_device(cap->dev, sgt, DMA_BIDIRECTIONAL);
+			continue;
+		}
+		for (page = 0; page < c->pages; page++) {
+			u64 pos = (u64)page * AGX_CAPTURE_PAGE;
+			agx_capture_page(&map, c->offset + pos,
+				min_t(u64, AGX_CAPTURE_PAGE, c->range - pos),
+				&c->before[page]);
+		}
+		drm_gem_vunmap(c->obj, &map);
+		if (sgt)
+			dma_sync_sgtable_for_device(cap->dev, sgt, DMA_BIDIRECTIONAL);
+	}
+	dev_info(vm->agx->dev, "BOCAP before ctx=%u maps=%u skipped=%u bytes=%llu\n",
+		 vm->ctx, cap->count, cap->skipped, total);
+	return cap;
+}
+
+void agx_vm_capture_end(struct agx_bo_capture *cap)
+{
+	u32 i, page, changed;
+
+	if (!cap)
+		return;
+	for (i = 0; i < cap->count; i++) {
+		struct agx_capture_map *c = &cap->map[i];
+		struct agx_capture_page after;
+		struct iosys_map map = { };
+		struct sg_table *sgt = to_drm_gem_shmem_obj(c->obj)->sgt;
+		u32 red_before = 0, red_after = 0;
+		int ret;
+
+		changed = 0;
+		if (sgt)
+			dma_sync_sgtable_for_cpu(cap->dev, sgt, DMA_BIDIRECTIONAL);
+		ret = c->pages ? drm_gem_vmap(c->obj, &map) : -EINVAL;
+		if (ret) {
+			pr_warn("BOCAP after vmap unavailable va=%#llx err=%d\n",
+				c->addr, ret);
+			goto next_map;
+		}
+		for (page = 0; page < c->pages; page++) {
+			u64 pos = (u64)page * AGX_CAPTURE_PAGE;
+			agx_capture_page(&map, c->offset + pos,
+				min_t(u64, AGX_CAPTURE_PAGE, c->range - pos), &after);
+			red_before += c->before[page].red_rgba;
+			red_after += after.red_rgba;
+			if (after.hash == c->before[page].hash)
+				continue;
+			if (!changed)
+				pr_info("BOCAP changed va=%#llx size=%llu first_page=%u before=%016llx after=%016llx first16=%16ph -> %16ph\n",
+					c->addr, c->range, page,
+					c->before[page].hash, after.hash,
+					c->before[page].first, after.first);
+			changed++;
+		}
+		drm_gem_vunmap(c->obj, &map);
+		pr_info("BOCAP map va=%#llx size=%llu changed_pages=%u/%u red_rgba=%u->%u\n",
+			c->addr, c->range, changed, c->pages, red_before, red_after);
+	next_map:
+		if (sgt)
+			dma_sync_sgtable_for_device(cap->dev, sgt, DMA_BIDIRECTIONAL);
+		drm_gem_object_put(c->obj);
+		kfree(c->before);
+	}
+	pr_info("BOCAP after maps=%u skipped=%u\n", cap->count, cap->skipped);
+	kfree(cap);
+}
+
+/* Read-only proof that Mesa's VDM stream VA resolves to a bound GEM object.
+ * This is deliberately bounded and runs only for the one-shot iPad test. */
+static void agx_vm_diag_vdm(struct agx_vm *vm, u64 va)
+{
+	struct agx_mapping *m;
+	struct drm_gem_object *obj = NULL;
+	struct iosys_map map = { };
+	struct sg_table *sgt;
+	u64 offset = 0, available = 0;
+	bool writable = false;
+	u8 sample[64];
+	int ret;
+
+	if (!render_bo_capture || !vm->agx->ipad_memory)
+		return;
+	mutex_lock(&vm->lock);
+	list_for_each_entry(m, &vm->mappings, node) {
+		if (va < m->addr || va - m->addr >= m->range)
+			continue;
+		offset = m->offset + va - m->addr;
+		if (offset >= m->obj->size)
+			continue;
+		available = min_t(u64, m->range - (va - m->addr),
+				      m->obj->size - offset);
+		writable = m->write;
+		obj = m->obj;
+		drm_gem_object_get(obj);
+		break;
+	}
+	mutex_unlock(&vm->lock);
+	if (!obj) {
+		dev_err(vm->agx->dev, "GFX RDIAG VDM unmapped ctx=%u va=%#llx\n",
+			vm->ctx, va);
+		return;
+	}
+	if (!available) {
+		dev_err(vm->agx->dev, "GFX RDIAG VDM empty ctx=%u va=%#llx\n",
+			vm->ctx, va);
+		goto out;
+	}
+	sgt = to_drm_gem_shmem_obj(obj)->sgt;
+	if (sgt)
+		dma_sync_sgtable_for_cpu(vm->agx->dev, sgt, DMA_BIDIRECTIONAL);
+	ret = drm_gem_vmap(obj, &map);
+	if (!ret) {
+		u32 n = min_t(u64, sizeof(sample), available);
+
+		iosys_map_memcpy_from(sample, &map, offset, n);
+		dev_info(vm->agx->dev,
+			 "GFX RDIAG VDM ctx=%u va=%#llx bytes=%u writable=%u first=%*ph\n",
+			 vm->ctx, va, n, writable, n, sample);
+		drm_gem_vunmap(obj, &map);
+	} else {
+		dev_warn(vm->agx->dev,
+			 "GFX RDIAG VDM vmap failed ctx=%u va=%#llx err=%d\n",
+			 vm->ctx, va, ret);
+	}
+	if (sgt)
+		dma_sync_sgtable_for_device(vm->agx->dev, sgt, DMA_BIDIRECTIONAL);
+out:
+	drm_gem_object_put(obj);
+}
+
+/* Start a CDM control stream, or a render, in this VM. Returns its fence. */
+struct dma_fence *agx_vm_run(struct agx_vm *vm, u64 stream,
+			     const struct drm_asahi_cmd_render *render)
+{
+	if (render) {
+		agx_vm_diag_vdm(vm, render->vdm_ctrl_stream_base);
+		return agx_fw_render(vm->agx, vm->ctx, render);
+	}
+	return agx_fw_run(vm->agx, vm->ctx, vm->kernel_start, stream);
+}
