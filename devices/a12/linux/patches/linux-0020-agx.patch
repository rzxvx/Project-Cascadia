diff --git a/drivers/gpu/drm/agx/agx-21b91-layout.c b/drivers/gpu/drm/agx/agx-21b91-layout.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx-21b91-layout.c
@@ -0,0 +1,521 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Derived from the documented J171/21B91 firmware consumers, not XS offsets.
+ * These serializers perform no allocation, MMIO, power change or submission.
+ * Firmware identity selection and the remaining ABI are integration work.
+ */
+#include "agx-21b91-layout.h"
+
+static void put_le(u8 *dst, u64 value, unsigned int bytes)
+{
+    unsigned int i;
+    for (i = 0; i < bytes; i++)
+        dst[i] = (u8)(value >> (i * 8));
+}
+
+static u64 get_le(const u8 *src, unsigned int bytes)
+{
+    unsigned int i;
+    u64 value = 0;
+    for (i = 0; i < bytes; i++)
+        value |= (u64)src[i] << (i * 8);
+    return value;
+}
+
+int agx21_write_control_kick(u8 *dst, size_t size, u64 token)
+{
+    unsigned int i;
+    if (!dst || size < AGX21_CONTROL_RECORD_SIZE)
+        return -1;
+    for (i = 0; i < AGX21_CONTROL_RECORD_SIZE; i++)
+        dst[i] = 0;
+    put_le(dst, AGX21_CONTROL_NOOP_TYPE, 4);
+    put_le(dst + 4, token, 8);
+    return 0;
+}
+
+int agx21_write_mmu_format(u8 *dst, size_t size)
+{
+    static const u8 fields[3][4] = {
+        {4, 4, 12, 30}, {8, 10, 10, 21}, {8, 12, 12, 14}
+    };
+    static const u16 entries[3] = {0x1000, 0x800, 0x200};
+    static const u64 pa_mask[3] = {0xfffffff0ULL, 0xfffffffc00ULL, 0xfffffff000ULL};
+    static const u64 index_mask[3] = {0xffc0000000ULL, 0x3fe00000, 0x1fc000};
+    unsigned int i, j;
+    if (!dst || size < AGX21_MMU_SIZE)
+        return -1;
+    put_le(dst, 0x4000, 2);
+    dst[2] = 14;
+    dst[3] = 3;
+    for (i = 0; i < 3; i++) {
+        u8 *record = dst + 4 + 0x20 * i;
+        for (j = 0; j < 4; j++)
+            record[j] = fields[i][j];
+        put_le(record + 4, entries[i], 2);
+        put_le(record + 6, 0x4000, 2);
+        put_le(record + 8, 1, 8);
+        put_le(record + 0x10, pa_mask[i], 8);
+        put_le(record + 0x18, index_mask[i], 8);
+    }
+    return 0;
+}
+
+int agx21_write_init_aux_fields(u8 *dst, size_t size, u64 auxiliary_va,
+                               u64 power_requests_va)
+{
+    if (!dst || size < AGX21_INIT_SIZE || !auxiliary_va || !power_requests_va ||
+        auxiliary_va == power_requests_va || ((auxiliary_va | power_requests_va) & 3))
+        return -1;
+    put_le(dst + 0xac, auxiliary_va, 8);
+    put_le(dst + 0xb4, power_requests_va, 8);
+    return 0;
+}
+
+int agx21_patch_aux_scheduler(u8 *dst, size_t size)
+{
+    if (!dst || size < AGX21_AUX_SIZE)
+        return -1;
+    put_le(dst + 0x45b4, 1, 4);
+    return 0;
+}
+
+int agx21_patch_hwdata_tables(u8 *dst, size_t size, const u32 *frequency_mhz,
+                             const u32 *core, const u32 *sram, u32 count)
+{
+    u32 frequencies[AGX21_MAX_PSTATES] = {0};
+    u32 cv[AGX21_MAX_PSTATES * AGX21_VOLTAGE_COLUMNS] = {0};
+    u32 sv[AGX21_MAX_PSTATES * AGX21_VOLTAGE_COLUMNS] = {0};
+    unsigned int i;
+    if (!dst || size < AGX21_HWDATA_SIZE || !frequency_mhz || !core || !sram ||
+        count < 2 || count > AGX21_MAX_PSTATES || frequency_mhz[0])
+        return -1;
+    /* Copy before writing so callers may supply arrays inside dst. */
+    for (i = 0; i < count; i++) {
+        if (i && frequency_mhz[i] <= frequency_mhz[i - 1])
+            return -1;
+        frequencies[i] = frequency_mhz[i];
+    }
+    for (i = 0; i < count * AGX21_VOLTAGE_COLUMNS; i++) {
+        if (!core[i] || !sram[i])
+            return -1;
+        cv[i] = core[i];
+        sv[i] = sram[i];
+    }
+    /* Native 0x8442bcc..0x8442c00 copies accelerator+2084 (the last
+     * valid pstate index) into HWB+2904 = 0xb58. Firmware 0x1e094
+     * reads this before indexing the frequency table at +0xb5c. A zero
+     * count underflows its first lookup at 0x1e0b8 (captured FAR). */
+    put_le(dst + 0xb58, count - 1, 4);
+    for (i = 0; i < AGX21_MAX_PSTATES; i++)
+        put_le(dst + 0xb5c + 4 * i, frequencies[i], 4);
+    for (i = 0; i < AGX21_MAX_PSTATES * AGX21_VOLTAGE_COLUMNS; i++) {
+        put_le(dst + 0xb9c + 4 * i, cv[i], 4);
+        put_le(dst + 0xd9c + 4 * i, sv[i], 4);
+    }
+    return 0;
+}
+
+int agx21_write_compute_finalize(u8 *dst, size_t size,
+                                 const struct agx21_compute_finalize *args)
+{
+    struct agx21_compute_finalize saved;
+    if (!dst || size < AGX21_FINALIZE_COMPUTE_SIZE || !args)
+        return -1;
+    saved = *args;
+    if (!saved.stats_va || !saved.queue_va || !saved.completion_control_va ||
+        !saved.stamp_target_va || !saved.abort_flag_va || !saved.timing_va ||
+        saved.context >= 256 || (saved.queue_va & 7) ||
+        ((saved.stats_va | saved.completion_control_va | saved.stamp_target_va |
+          saved.abort_flag_va | saved.timing_va) & 3))
+        return -1;
+    put_le(dst, 0x2a, 4);
+    put_le(dst + 4, saved.stats_va, 8);
+    put_le(dst + 0xc, saved.queue_va, 8);
+    put_le(dst + 0x14, saved.context, 4);
+    put_le(dst + 0x18, saved.completion_control_va, 8);
+    put_le(dst + 0x20, 0, 4);
+    put_le(dst + 0x24, saved.command_id, 4);
+    put_le(dst + 0x28, saved.stamp_target_va, 8);
+    put_le(dst + 0x30, saved.stamp_value, 4);
+    put_le(dst + 0x34, 0, 4);
+    put_le(dst + 0x38, saved.restart_offset, 4);
+    put_le(dst + 0x3c, saved.abort_flag_va, 8);
+    put_le(dst + 0x44, saved.timing_va, 8);
+    return 0;
+}
+
+int agx21_write_init_fields(u8 *dst, size_t size, u64 region_b, u64 region_c,
+                           const u8 *mmu, size_t mmu_size, u64 table_pa,
+                           u32 table_count, u64 startup_status)
+{
+    /* Native 21B91 publisher copies 0x68 bytes to InitData+0x2c..+0x93.
+     * The G11P shared-GART initializer zeros source +0x78..+0x7f, then
+     * overwrites +0x74..+0x7b with 0x1fc000. Thus source +0x7c..+0x7f,
+     * copied to InitData+0x90..+0x93, remain explicitly zero.
+     * The separate +0x9c descriptor-count write order is still unresolved.
+     */
+    u8 saved_mmu[AGX21_MMU_SIZE];
+    unsigned int i;
+    /* 0x4000 / 0x18 complete descriptors fit in the firmware-mapped table. */
+    if (!dst || size < AGX21_INIT_SIZE || !mmu || mmu_size != AGX21_MMU_SIZE ||
+        !region_b || !region_c || !startup_status || !table_pa ||
+        (table_pa & 0x3fff) || !table_count || table_count > 0x4000 / 0x18)
+        return -1;
+    /* Permit mmu to refer into dst without destructive overlapping copies. */
+    for (i = 0; i < AGX21_MMU_SIZE; i++)
+        saved_mmu[i] = mmu[i];
+    put_le(dst + 0x18, region_b, 8);
+    put_le(dst + 0x20, region_c, 8);
+    for (i = 0; i < AGX21_MMU_SIZE; i++)
+        dst[0x2c + i] = saved_mmu[i];
+    put_le(dst + 0x90, 0, 4);
+    put_le(dst + 0x94, table_pa, 8);
+    put_le(dst + 0x9c, table_count, 4);
+    put_le(dst + 0xa4, startup_status, 8);
+    return 0;
+}
+
+int agx21_write_memdesc(u8 *dst, size_t size, u64 va, u64 pa,
+                      u16 pages, u16 flags)
+{
+    unsigned int i;
+    if (!dst || size < AGX21_MEMDESC_SIZE || !pages ||
+        ((va | pa) & 0x3fff) || (pa >> 12) > 0xffffffffULL ||
+        va > (~(u64)0) - ((u64)pages << 14) ||
+        pa > (1ULL << 44) - ((u64)pages << 14))
+        return -1;
+    for (i = 0; i < AGX21_MEMDESC_SIZE; i++)
+        dst[i] = 0;
+    put_le(dst, va, 8);
+    put_le(dst + 8, pa >> 12, 4);
+    put_le(dst + 0x10, pages, 2);
+    put_le(dst + 0x12, flags, 2);
+    return 0;
+}
+
+int agx21_write_context_fields(u8 *dst, size_t size, u64 generation_va,
+                              u64 catalogues_va, const u32 masks[8])
+{
+    u32 saved_masks[8];
+    unsigned int i;
+    if (!dst || size < AGX21_CONTEXT_REGION_MIN || !generation_va ||
+        !catalogues_va || !masks)
+        return -1;
+    for (i = 0; i < 8; i++)
+        saved_masks[i] = masks[i];
+    put_le(dst + 0x7dc, generation_va, 8);
+    put_le(dst + 0x7e4, catalogues_va, 8);
+    for (i = 0; i < 8; i++)
+        put_le(dst + 0x7ec + 4 * i, saved_masks[i], 4);
+    return 0;
+}
+
+int agx21_write_channel(u8 *dst, size_t size, u64 consumer_va,
+                       u64 prefetch_cursor_va, u64 producer_va, u64 ring_va)
+{
+    if (!dst || size < AGX21_CHANNEL_SIZE || !consumer_va ||
+        !prefetch_cursor_va || !producer_va || !ring_va ||
+        ((consumer_va | prefetch_cursor_va | producer_va) & 3) ||
+        consumer_va == prefetch_cursor_va || consumer_va == producer_va ||
+        prefetch_cursor_va == producer_va)
+        return -1;
+    put_le(dst, consumer_va, 8);
+    put_le(dst + 8, prefetch_cursor_va, 8);
+    put_le(dst + 0x10, producer_va, 8);
+    put_le(dst + 0x18, ring_va, 8);
+    return 0;
+}
+
+int agx21_write_outbound_channel(u8 *dst, size_t size, u64 state_va, u64 ring_va)
+{
+    if (!dst || size < 0x10 || !state_va || !ring_va || (state_va & 3))
+        return -1;
+    put_le(dst, state_va, 8);
+    put_le(dst + 8, ring_va, 8);
+    return 0;
+}
+
+int agx21_patch_run(u8 *dst, size_t size, u64 queue_va,
+                    u16 head, u8 channel, u8 event, u8 flush)
+{
+    if (!dst || size < AGX21_RUN_RECORD_SIZE || !queue_va || (queue_va & 7) ||
+        head >= 0x100 || channel > 2 || event >= 128 || flush > 1)
+        return -1;
+    put_le(dst + 8, queue_va, 8);
+    put_le(dst + 0x10, channel, 4);
+    put_le(dst + 0x14, head, 2);
+    dst[0x16] = event;
+    dst[0x17] = flush;
+    return 0;
+}
+
+int agx21_patch_compute_run(u8 *dst, size_t size, u64 queue_va,
+                            u16 head, u8 event, u8 flush)
+{
+    return agx21_patch_run(dst, size, queue_va, head, 2, event, flush);
+}
+
+int agx21_patch_render_completion(u8 *cmd, size_t size, u8 type,
+                                  u32 stamp, u8 event)
+{
+    size_t off;
+
+    if (!cmd || event >= 128 || (type != 0 && type != 1))
+        return -1;
+    /* 21B91 GFX dispatch: type 0 reads +0x578/+0x57c, type 1 reads
+     * +0x8d4/+0x8d8.  The type-0 pair is 8 bytes later than BadApple XS. */
+    off = type == 0 ? 0x578 : 0x8d4;
+    if (size < off + 5)
+        return -1;
+    put_le(cmd + off, stamp, 4);
+    cmd[off + 4] = event;
+    return 0;
+}
+
+int agx21_patch_render_microseq(u8 *cmd, size_t size, u8 type,
+                                u64 sequence_va, u32 emitted_size)
+{
+    size_t off;
+    u32 padded;
+
+    if (!cmd || (type != 0 && type != 1) || !sequence_va ||
+        (sequence_va & 63) || !emitted_size || emitted_size > 0xffffffc0U)
+        return -1;
+    off = type == 0 ? 0x474 : 0x14;
+    if (size < off + 12)
+        return -1;
+    padded = (emitted_size + 63U) & ~63U;
+    put_le(cmd + off, sequence_va, 8);
+    put_le(cmd + off + 8, padded, 4);
+    return 0;
+}
+
+int agx21_patch_stamp(u8 *dst, size_t size, u64 target_va, u32 value, u32 event)
+{
+    if (!dst || size < AGX21_STAMP_SIZE || !target_va || (target_va & 3) || event >= 128)
+        return -1;
+    put_le(dst, target_va, 8);
+    put_le(dst + 0x10, value, 4);
+    put_le(dst + 0x14, event, 4);
+    return 0;
+}
+
+int agx21_decode_event(const u8 *src, size_t size, u32 *type, u64 bitmap[2])
+{
+    u32 kind;
+    u64 low, high;
+    if (!src || size < AGX21_EVENT_RECORD_SIZE || !type || !bitmap)
+        return -1;
+    kind = (u32)get_le(src, 4);
+    if (kind != 1) {
+        *type = kind;
+        return 1;
+    }
+    low = get_le(src + 4, 8);
+    high = get_le(src + 0xc, 8);
+    *type = kind;
+    bitmap[0] = low;
+    bitmap[1] = high;
+    return 0;
+}
+
+int agx21_write_region_b_bindings(u8 *dst, size_t size,
+                                 const struct agx21_region_b_bindings *args)
+{
+    struct agx21_region_b_bindings a;
+    u64 pointers[10];
+    static const u32 offsets[10] = {
+        0, 8, 0x10, 0x1f8, 0x234, 0x23c, 0x244, 0x24c, 0x2a8, 0x43d
+    };
+    unsigned int i, j;
+    if (!dst || size < AGX21_REGION_B_SIZE || !args)
+        return -1;
+    a = *args;
+    pointers[0] = a.hardware_b_va;
+    pointers[1] = a.header_08_va;
+    pointers[2] = a.header_10_va;
+    pointers[3] = a.header_1f8_va;
+    pointers[4] = a.ta_stats_va;
+    pointers[5] = a.render_stats_va;
+    pointers[6] = a.compute_stats_va;
+    pointers[7] = a.fault_info_va;
+    pointers[8] = a.firmware_generations_va;
+    pointers[9] = a.hardware_a_va;
+    for (i = 0; i < 10; i++) {
+        /* Native +0xae0 returns zero on both G11P accelerator revisions:
+         * B+8's allocation has size zero. Do not manufacture a replacement
+         * buffer merely to satisfy a host-side non-null restriction.
+         */
+        if (i == 1 && !pointers[i])
+            continue;
+        if (!pointers[i] || (pointers[i] & 3))
+            return -1;
+        for (j = 0; j < i; j++)
+            if (pointers[j] == pointers[i])
+                return -1;
+    }
+    for (i = 0; i < 10; i++)
+        put_le(dst + offsets[i], pointers[i], 8);
+    return 0;
+}
+
+int agx21_write_compute_sequence(u8 *dst, size_t size,
+                                 const struct agx21_compute_start *start,
+                                 const struct agx21_compute_finalize *finalize)
+{
+    struct agx21_compute_start a;
+    struct agx21_compute_finalize f;
+    u8 encoded_finalize[AGX21_FINALIZE_COMPUTE_SIZE];
+    unsigned int i;
+    if (!dst || size < AGX21_COMPUTE_PADDED_SIZE || !start || !finalize)
+        return -1;
+    a = *start;
+    f = *finalize;
+    if (!a.command_va || a.command_va > (~(u64)0) - 0x2e8 ||
+        !a.stats_va || !a.queue_va || !a.gate_counter_va ||
+        ((a.command_va | a.stats_va | a.queue_va | a.gate_counter_va) & 3) ||
+        a.mmu_context >= 64 || f.stats_va != a.stats_va ||
+        f.queue_va != a.queue_va || f.context != a.context ||
+        f.command_id != a.command_id ||
+        f.completion_control_va != a.command_va + 0x1fc ||
+        f.abort_flag_va != a.command_va + 0x2e0 ||
+        f.timing_va != a.command_va + 0x2c8 ||
+        f.restart_offset != (u32)(0U - AGX21_COMPUTE_FINALIZE_OFFSET) ||
+        agx21_write_compute_finalize(encoded_finalize, sizeof(encoded_finalize), &f))
+        return -1;
+    for (i = 0; i < AGX21_COMPUTE_PADDED_SIZE; i++)
+        dst[i] = 0;
+    put_le(dst, 0x29, 4);
+    put_le(dst + 4, a.command_va + 0x1c, 8);
+    put_le(dst + 0xc, a.command_va + 0x70, 8);
+    put_le(dst + 0x14, a.stats_va, 8);
+    put_le(dst + 0x1c, a.queue_va, 8);
+    put_le(dst + 0x24, a.context, 4);
+    put_le(dst + 0x28, a.native_word_28, 4);
+    put_le(dst + 0x2c, a.mmu_context, 4);
+    put_le(dst + 0x30, a.native_word_30, 4);
+    put_le(dst + 0x34, a.native_word_34, 4);
+    put_le(dst + 0x38, a.native_word_38, 4);
+    put_le(dst + 0x3c, a.command_va + 0x1fc, 8);
+    put_le(dst + 0x44, (u64)a.command_id << 32, 8);
+    put_le(dst + 0x4c, a.command_va + 0x2e0, 8);
+    put_le(dst + 0x54, a.gate_expected, 8);
+    put_le(dst + 0x5c, a.gate_counter_va, 8);
+    put_le(dst + AGX21_COMPUTE_WAIT_OFFSET, 0x41, 4);
+    for (i = 0; i < AGX21_FINALIZE_COMPUTE_SIZE; i++)
+        dst[AGX21_COMPUTE_FINALIZE_OFFSET + i] = encoded_finalize[i];
+    put_le(dst + AGX21_COMPUTE_END_OFFSET, 0x40000018, 4);
+    return 0;
+}
+
+int agx21_next_stamp(u32 current_stamp, u32 completed, u32 *next)
+{
+    if (!next || current_stamp != completed || (current_stamp & 0xff) ||
+        current_stamp >= 0x3fffff00U)
+        return -1;
+    *next = current_stamp + 0x100;
+    return 0;
+}
+
+int agx21_write_compute_command_core(u8 *dst, size_t size,
+                                     const struct agx21_compute_command_core *args)
+{
+    struct agx21_compute_command_core a;
+    if (!dst || !args || size < AGX21_COMPUTE_COMMAND_MIN_SIZE)
+        return -1;
+    a = *args;
+    if (a.context >= 64 || a.channel >= 13 || !a.event_control_va ||
+        !a.completion_primary_va || !a.completion_retire_va ||
+        a.completion_primary_va == a.completion_retire_va ||
+        ((a.event_control_va | a.completion_primary_va |
+          a.completion_retire_va) & 3))
+        return -1;
+    /* Do not clear the full buffer: native 0x842c4a4 writes many fields
+     * between +0x1d8 and +0x2e0 which another producer must supply. */
+    put_le(dst, 3, 4);
+    put_le(dst + 4, a.command_id, 8);
+    put_le(dst + 0xc, 0, 4);
+    put_le(dst + 0x10, a.context, 4);
+    put_le(dst + 0x14, a.event_control_va, 8);
+    put_le(dst + 0x278, a.completion_primary_va, 8);
+    put_le(dst + 0x280, a.completion_retire_va, 8);
+    put_le(dst + 0x288, a.completion_value, 8);
+    put_le(dst + 0x290, a.channel, 4);
+    return 0;
+}
+
+int agx21_write_compute_launch_regs(u8 *dst, size_t size,
+                                    const struct agx21_compute_launch_regs *args)
+{
+    struct agx21_compute_launch_regs a;
+    u64 aux;
+
+    if (!dst || !args || size < 0x88)
+        return -1;
+    a = *args;
+    if (!a.descriptor_928_args_va || !a.descriptor_840_cdm_va ||
+        ((a.descriptor_928_args_va | a.descriptor_840_cdm_va) & 3) ||
+        a.descriptor_928_args_va == a.descriptor_840_cdm_va ||
+        a.descriptor_1000_aux_enabled > 1 ||
+        a.descriptor_1004_aux_count > 0x7fffffffU ||
+        (a.descriptor_1000_aux_enabled && !a.descriptor_992_aux_va))
+        return -1;
+    /* Native 0x846c794..7b8: D+928, D+840, and an optional encoded
+     * D+992 auxiliary value. Do not confuse these with late +632/+640. */
+    aux = a.descriptor_1000_aux_enabled ?
+        (a.descriptor_992_aux_va | (2ULL * a.descriptor_1004_aux_count) | 1ULL) : 0;
+    put_le(dst + 0x70, a.descriptor_928_args_va, 8);
+    put_le(dst + 0x78, a.descriptor_840_cdm_va, 8);
+    put_le(dst + 0x80, aux, 8);
+    return 0;
+}
+
+int agx21_copy_compute_descriptor_fields(u8 *dst, size_t size,
+                                         const u8 *descriptor,
+                                         size_t descriptor_size)
+{
+    static const struct { u16 to, from, bytes; } spans[] = {
+        {472, 992, 8}, {480, 1000, 4}, {488, 1004, 4},
+        {516, 848, 8}, {524, 856, 8}, {532, 864, 16},
+        {548, 928, 16}, {564, 880, 8}, {572, 888, 4},
+        {580, 896, 8}, {588, 904, 4}, {596, 912, 8},
+        {604, 920, 4}, {616, 980, 8}, {624, 988, 4},
+        {628, 1144, 2}, {664, 256, 4}, {668, 1148, 4},
+        {696, 1176, 16}, {630, 1192, 1}, {631, 1164, 1}
+    };
+    size_t i, j;
+    unsigned long d = (unsigned long)dst, s = (unsigned long)descriptor;
+    if (!dst || !descriptor || size < 740 || descriptor_size < 1193 ||
+        d > ~0UL - size || s > ~0UL - descriptor_size ||
+        (d < s + descriptor_size && s < d + size))
+        return -1;
+    /* All validation precedes mutation. Native stores at 0x842c7d8..
+     * 0x842c9fc; zero fields are from 0x842c83c/860/864/90c.
+     * Do not fill translated +632/+640/+680/+688 or trace +648 here. */
+    for (i = 0; i < sizeof(spans) / sizeof(spans[0]); i++)
+        for (j = 0; j < spans[i].bytes; j++)
+            dst[spans[i].to + j] = descriptor[spans[i].from + j];
+    put_le(dst + 508, 0, 4);
+    put_le(dst + 612, descriptor[976], 4);
+    put_le(dst + 672, 0, 8);
+    put_le(dst + 712, 0, 8);
+    put_le(dst + 728, 0, 8);
+    put_le(dst + 736, 0, 4);
+    return 0;
+}
+
+int agx21_write_compute_dispatch_vas(u8 *dst, size_t size,
+                                     const struct agx21_compute_dispatch_vas *args)
+{
+    struct agx21_compute_dispatch_vas a;
+    if (!dst || !args || size < 648)
+        return -1;
+    a = *args;
+    if (!a.base_0_va || !a.base_1_va ||
+        a.base_0_va > ~(u64)0 - a.shared_offset ||
+        a.base_1_va > ~(u64)0 - a.shared_offset)
+        return -1;
+    put_le(dst + 632, a.base_0_va + a.shared_offset, 8);
+    put_le(dst + 640, a.base_1_va + a.shared_offset, 8);
+    return 0;
+}
diff --git a/drivers/gpu/drm/agx/agx-21b91-layout.h b/drivers/gpu/drm/agx/agx-21b91-layout.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx-21b91-layout.h
@@ -0,0 +1,216 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Partial, offline-tested G11/21B91 adapter; not a complete init builder. */
+#ifndef AGX_21B91_LAYOUT_H
+#define AGX_21B91_LAYOUT_H
+#ifdef AGX_ABI_HOST_TEST
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#else
+#include <linux/types.h>
+#endif
+
+#define AGX21_INIT_SIZE 0xc0
+#define AGX21_MMU_SIZE 0x64
+#define AGX21_MEMDESC_SIZE 0x18
+#define AGX21_CONTEXT_REGION_MIN 0x80c
+#define AGX21_CHANNEL_SIZE 0x20
+#define AGX21_INPUT_CHANNEL_BASE 0x18
+#define AGX21_RUN_RECORD_SIZE 0x18
+#define AGX21_CONTROL_RECORD_SIZE 0x30
+#define AGX21_CONTROL_NOOP_TYPE 0x1b
+#define AGX21_EVENT_RECORD_SIZE 0x38
+/* BadApple-style control kick, but J171 has its own 0x30-byte record ABI.
+ * This only tests the firmware control ring; it does not submit work. */
+int agx21_write_control_kick(u8 *dst, size_t size, u64 token);
+#define AGX21_STAMP_SIZE 0x20
+#define AGX21_FINALIZE_COMPUTE_SIZE 0x4c
+#define AGX21_REGION_B_SIZE 0x490
+#define AGX21_REGION_C_SIZE 0xe28
+#define AGX21_STARTUP_SIZE 0x20
+#define AGX21_AUX_SIZE 0x65c0
+#define AGX21_POWER_REQUESTS_SIZE 0x1e8
+#define AGX21_HWDATA_SIZE 0x1858
+#define AGX21_MAX_PSTATES 16
+#define AGX21_VOLTAGE_COLUMNS 8
+
+/* Native T8020 16 KiB format only; does not allocate page tables. */
+int agx21_write_mmu_format(u8 *dst, size_t size);
+int agx21_write_init_aux_fields(u8 *dst, size_t size, u64 auxiliary_va,
+                               u64 power_requests_va);
+/* Before first publication only; not a runtime recovery/reset operation. */
+int agx21_patch_aux_scheduler(u8 *dst, size_t size);
+/* Flat, state-major voltage arrays, eight u32s per state. Does not select
+ * performance states, configure controllers or enable Fender/PMGR rails.
+ */
+int agx21_patch_hwdata_tables(u8 *dst, size_t size, const u32 *frequency_mhz,
+                             const u32 *core, const u32 *sram, u32 count);
+
+struct agx21_compute_finalize {
+    u64 stats_va;
+    u64 queue_va;
+    u64 completion_control_va;
+    u64 stamp_target_va;
+    u64 abort_flag_va;
+    u64 timing_va;
+    u32 context;
+    u32 command_id;
+    u32 stamp_value;
+    u32 restart_offset; /* Explicit two's-complement relative offset. */
+};
+/* Serializes 0x4c bytes, not the legacy 0x44. The caller must prove all
+ * pointed-to objects and the relative restart target are valid/live.
+ */
+int agx21_write_compute_finalize(u8 *dst, size_t size,
+                                 const struct agx21_compute_finalize *args);
+
+/* Patch verified fields only: preserve all other caller-owned header bytes. */
+int agx21_write_init_fields(u8 *dst, size_t size, u64 region_b, u64 region_c,
+                           const u8 *mmu, size_t mmu_size, u64 table_pa,
+                           u32 table_count, u64 startup_status);
+int agx21_write_memdesc(u8 *dst, size_t size, u64 va, u64 pa,
+                      u16 pages, u16 flags);
+/* Caller supplies explicit masks; never infer ownership of all 256 contexts. */
+int agx21_write_context_fields(u8 *dst, size_t size, u64 generation_va,
+                              u64 catalogues_va, const u32 masks[8]);
+/* Indices are separate pointers; do not alias the prefetch cursor to consumer. */
+int agx21_write_channel(u8 *dst, size_t size, u64 consumer_va,
+                       u64 prefetch_cursor_va, u64 producer_va, u64 ring_va);
+/* Outbound event descriptor uses state/ring pointers, unlike input channels. */
+int agx21_write_outbound_channel(u8 *dst, size_t size, u64 state_va, u64 ring_va);
+/* Native 21B91 0x18-byte run record.  Channel 0=TA, 1=3D, 2=CP.
+ * This serializes the record only; it does not initialize a queue or submit. */
+int agx21_patch_run(u8 *dst, size_t size, u64 queue_va,
+                    u16 head, u8 channel, u8 event, u8 flush);
+/* Backward-compatible CP wrapper; first eight bytes remain caller-owned. */
+int agx21_patch_compute_run(u8 *dst, size_t size, u64 queue_va,
+                           u16 head, u8 event, u8 flush);
+/* Patch firmware-confirmed type-0 TA or type-1 3D completion fields only.
+ * Does not create a command, event-control object, microsequence or queue.
+ * Not wired into submission until their ownership and layout are verified. */
+int agx21_patch_render_completion(u8 *cmd, size_t size, u8 type,
+                                  u32 stamp, u8 event);
+/* Native channel writer's command offsets and 64-byte padded sequence length.
+ * Caller must allocate/serialize the sequence and own its GPU mapping. */
+int agx21_patch_render_microseq(u8 *cmd, size_t size, u8 type,
+                                u64 sequence_va, u32 emitted_size);
+int agx21_patch_stamp(u8 *dst, size_t size, u64 target_va, u32 value, u32 event);
+/* 0: type-1 bitmap decoded; 1: other event type; -1: invalid/short input.
+ * A bitmap is a notification, not proof of success: also verify the target stamp.
+ */
+int agx21_decode_event(const u8 *src, size_t size, u32 *type, u64 bitmap[2]);
+
+#define AGX21_HWDATA_A_SIZE 0x4358
+#define AGX21_TA_STATS_SIZE 0x670
+#define AGX21_3D_STATS_SIZE 0x730
+#define AGX21_COMPUTE_STATS_SIZE 0x6d0
+#define AGX21_FAULT_INFO_SIZE 0x60
+#define AGX21_COMPUTE_WAIT_OFFSET 0x64
+#define AGX21_COMPUTE_FINALIZE_OFFSET 0x68
+#define AGX21_COMPUTE_END_OFFSET 0xb4
+#define AGX21_COMPUTE_EMITTED_SIZE 0xb8
+#define AGX21_COMPUTE_PADDED_SIZE 0xc0
+#define AGX21_COMPUTE_COMMAND_MIN_SIZE 0x294
+
+/* Fields written directly by native 21B91 command producer 0x842c4a4.
+ * This is a partial command encoder, NOT a publication-ready command: the
+ * native producer also fills the dispatch and statistics ranges in between.
+ * +632/+640 are translated completion-target VAs from two native
+ * allocations. They are not CDM or dispatch input addresses.
+ */
+struct agx21_compute_command_core {
+    u64 command_id;
+    u64 event_control_va;
+    u64 completion_primary_va; /* command+0x278, first translated stamp allocation */
+    u64 completion_retire_va;  /* command+0x280, second translated stamp allocation */
+    u64 completion_value;      /* command+0x288, native descriptor vtable+216 value */
+    u32 context;
+    u32 channel;
+};
+int agx21_write_compute_command_core(u8 *dst, size_t size,
+                                     const struct agx21_compute_command_core *args);
+/* J171 G11 channel vtable +336 (0x846c78c), called by 0x842c4a4.
+ * The early RGX register image is separate from translated completion
+ * targets at command +0x278/+0x280. Firmware StartCompute reads these qwords.
+ */
+struct agx21_compute_launch_regs {
+    u64 descriptor_928_args_va;
+    u64 descriptor_840_cdm_va;
+    u64 descriptor_992_aux_va;
+    u32 descriptor_1000_aux_enabled;
+    u32 descriptor_1004_aux_count;
+};
+int agx21_write_compute_launch_regs(u8 *dst, size_t size,
+                                    const struct agx21_compute_launch_regs *args);
+/* Native WorkCommandCP 0x842c4a4 descriptor-copy portion only. Descriptor
+ * offsets are from its private compute descriptor, not an XS command.
+ * Address translations/microsequence are separate producer steps. */
+int agx21_copy_compute_descriptor_fields(u8 *dst, size_t size,
+                                         const u8 *descriptor,
+                                         size_t descriptor_size);
+
+/* 0x842c6d0/704 and 0x842c910/914: the two translated dispatch VAs
+ * share the offset returned by the context object's vtable+136 method.
+ * base_* are results of the native address translator (vtable+520),
+ * not descriptor addresses. This patches only command +632 and +640.
+ */
+struct agx21_compute_dispatch_vas {
+    u64 base_0_va;
+    u64 base_1_va;
+    u32 shared_offset;
+};
+int agx21_write_compute_dispatch_vas(u8 *dst, size_t size,
+                                     const struct agx21_compute_dispatch_vas *args);
+
+/* Native publisher 0xfffffff0084542f8. Unknown header buffers remain
+ * explicitly named by offset; this API does not invent their semantics.
+ * The caller must allocate/map each pointee with its actual size/lifetime.
+ */
+struct agx21_region_b_bindings {
+    u64 hardware_b_va;
+    u64 header_08_va; /* May be zero: native allocation-size method returns 0. */
+    u64 header_10_va;
+    u64 header_1f8_va;
+    u64 ta_stats_va;
+    u64 render_stats_va;
+    u64 compute_stats_va;
+    u64 fault_info_va;
+    u64 firmware_generations_va;
+    u64 hardware_a_va;
+};
+int agx21_write_region_b_bindings(u8 *dst, size_t size,
+                                 const struct agx21_region_b_bindings *args);
+
+/* Explicit opaque native words: caller obtains their policy, not this encoder.
+ * Register-block offsets +0x1c/+0x70 are verified from native constant data.
+ */
+struct agx21_compute_start {
+    u64 command_va;
+    u64 stats_va;
+    u64 queue_va;
+    u64 gate_counter_va;
+    u64 gate_expected;
+    u32 context;
+    u32 native_word_28;
+    u32 mmu_context;
+    u32 native_word_30;
+    u32 native_word_34;
+    u32 native_word_38;
+    u32 command_id;
+};
+/* Legacy firmware-consumer fixture only, including zeroed alignment padding.
+ * Not the native 21B91 WorkCommandCP producer: 0x846c394 emits 304 bytes
+ * before alignment, including two type-25 records and a type-65 wait.
+ * Never publish this shorter 0xb8-byte sequence in the iPad transport.
+ */
+int agx21_write_compute_sequence(u8 *dst, size_t size,
+                                 const struct agx21_compute_start *start,
+                                 const struct agx21_compute_finalize *finalize);
+/* One private, serialized queue, initially current=completed=0. Refuse reuse
+ * until completion and refuse the native rollover/scrub boundary; no resets.
+ */
+int agx21_next_stamp(u32 current_stamp, u32 completed, u32 *next);
+#endif
diff --git a/drivers/gpu/drm/agx/agx-21b91-microseq.c b/drivers/gpu/drm/agx/agx-21b91-microseq.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx-21b91-microseq.c
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "agx-21b91-microseq.h"
+
+static void put_le(u8 *dst, u64 value, unsigned int bytes)
+{
+    unsigned int i;
+    for (i = 0; i < bytes; i++)
+        dst[i] = (u8)(value >> (8 * i));
+}
+
+static void put_barrier(u8 *dst, u32 opcode,
+                        const struct agx21_cp_microseq_args *a)
+{
+    put_le(dst, opcode, 4);
+    put_le(dst + 4, a->barrier_payload, 4);
+    put_le(dst + 8, a->command_word_664, 4);
+    put_le(dst + 12, a->command_va, 8);
+}
+
+/* Native 0x848901c, command type 3. +56..+59 remain caller-owned. */
+static void put_type25(u8 *dst, const struct agx21_cp_microseq_args *a,
+                       u32 first)
+{
+    u64 p = a->command_va;
+    put_le(dst, first ? 0x80000019U : 25U, 4);
+    put_le(dst + 4, p + 0x2a0, 8);
+    put_le(dst + 12, p + 0x2a8, 8);
+    put_le(dst + 20, p + (first ? 0x2a8 : 0x2b0), 8);
+    put_le(dst + 28, a->token_va, 8);
+    put_le(dst + 36, (a->command_qword_0x2b8 || a->command_qword_0x2c0) ?
+                       p + 0x2b8 : 0, 8);
+    put_le(dst + 44, p + 0x2d0, 8);
+    put_le(dst + 52, a->command_word_664, 4);
+}
+
+int agx21_write_cp_microseq(u8 *dst, size_t size,
+                            const struct agx21_cp_microseq_args *args,
+                            size_t *written)
+{
+    struct agx21_cp_microseq_args a;
+    size_t n, o = 0;
+    u8 *r;
+
+    if (!dst || !args || !written || args->barrier_enabled > 1 ||
+        args->descriptor_has_word_1104 > 1)
+        return -1;
+    a = *args; /* Permit args to alias dst without changing read semantics. */
+    n = a.barrier_enabled ? AGX21_CP_MICROSEQ_BARRIER_SIZE :
+                            AGX21_CP_MICROSEQ_NORMAL_SIZE;
+    if (size < n || a.command_va > ~(u64)0 - 736 ||
+        a.descriptor_aux_va > ~(u64)0 - 168)
+        return -1;
+
+    if (a.barrier_enabled) {
+        put_barrier(dst, 0x9000001fU, &a);
+        o += 20;
+    }
+    r = dst + o;
+    put_le(r, 41, 4);
+    put_le(r + 4, a.command_va + 28, 8);
+    put_le(r + 12, a.command_va + 112, 8);
+    put_le(r + 20, a.state_va, 8);
+    put_le(r + 28, a.token_va, 8);
+    put_le(r + 36, a.command_word_16, 4);
+    put_le(r + 40, a.descriptor_vtable_280_result, 4);
+    put_le(r + 44, a.descriptor_indirect_word_320_8, 4);
+    put_le(r + 48, a.descriptor_word_1148, 4);
+    put_le(r + 52, a.command_word_656, 4);
+    put_le(r + 56, a.descriptor_has_word_1104, 4);
+    put_le(r + 60, a.command_va + 508, 8);
+    put_le(r + 68, (u64)a.command_word_664 << 32, 8);
+    put_le(r + 76, a.command_va + 736, 8);
+    put_le(r + 84, a.command_qword_4, 8);
+    put_le(r + 92, a.descriptor_aux_va + 168, 8);
+    o += 100;
+
+    put_type25(dst + o, &a, 1);
+    o += 60;
+    put_le(dst + o, 65, 4);
+    o += 4;
+    if (a.barrier_enabled) {
+        put_barrier(dst + o, 0x1000001fU, &a);
+        o += 20;
+    }
+    put_type25(dst + o, &a, 0);
+    o += 60;
+
+    r = dst + o;
+    put_le(r, 42, 4);
+    put_le(r + 4, a.state_va, 8);
+    put_le(r + 12, a.token_va, 8);
+    put_le(r + 20, a.command_word_16, 4);
+    put_le(r + 24, a.command_va + 508, 8);
+    put_le(r + 32, 0, 4);
+    put_le(r + 36, a.command_word_664, 4);
+    put_le(r + 40, a.command_qword_640, 8);
+    put_le(r + 48, a.command_word_648, 4);
+    put_le(r + 52, 0, 4);
+    /* Native context+92 + context+40 - cursor_after_76 + 76:
+     * the cursor began at context+40+context+92, so this is the negative
+     * offset of record 42 from the first emitted byte. */
+    put_le(r + 56, (u32)(0U - (a.barrier_enabled ? 264U : 224U)), 4);
+    put_le(r + 60, a.command_va + 736, 8);
+    put_le(r + 68, a.command_va + 712, 8);
+    o += 76;
+    put_le(dst + o, 0x40000018U, 4); /* Native 0x8488ee8. */
+    o += 4;
+    *written = o;
+    return 0;
+}
+
+
+int agx21_stage_cp_microseq(u8 *command, size_t command_size,
+                            u8 *stream, size_t stream_size, u64 stream_va,
+                            const struct agx21_cp_microseq_args *args,
+                            size_t *padded_size)
+{
+    size_t raw, padded;
+    unsigned int i;
+    unsigned long c, s;
+
+    if (!command || !stream || !args || !padded_size ||
+        command_size < 0x200 || !stream_va || (stream_va & 63) ||
+        args->barrier_enabled > 1)
+        return -1;
+    raw = args->barrier_enabled ? AGX21_CP_MICROSEQ_BARRIER_SIZE :
+                                  AGX21_CP_MICROSEQ_NORMAL_SIZE;
+    padded = (raw + 63) & ~(size_t)63;
+    c = (unsigned long)command;
+    s = (unsigned long)stream;
+    if (stream_size < padded || stream_va > ~(u64)0 - padded ||
+        args->descriptor_has_word_1104 > 1 ||
+        args->command_va > ~(u64)0 - 736 ||
+        args->descriptor_aux_va > ~(u64)0 - 168 ||
+        c > ~0UL - command_size || s > ~0UL - stream_size ||
+        (c < s + stream_size && s < c + command_size))
+        return -1;
+    /* Zero the two native caller-owned type-25 slots and round-up padding. */
+    for (i = 0; i < padded; i++) stream[i] = 0;
+    if (agx21_write_cp_microseq(stream, stream_size, args, &raw))
+        return -1;
+    for (i = 0; i < 8; i++) {
+        command[0x1f0 + i] = (u8)(stream_va >> (8 * i));
+        command[0x1f8 + i] = (u8)((u64)padded >> (8 * i));
+    }
+    *padded_size = padded;
+    return 0;
+}
diff --git a/drivers/gpu/drm/agx/agx-21b91-microseq.h b/drivers/gpu/drm/agx/agx-21b91-microseq.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx-21b91-microseq.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_MICROSEQ_H
+#define AGX_21B91_MICROSEQ_H
+
+#ifdef AGX_ABI_HOST_TEST
+#include <stddef.h>
+#include <stdint.h>
+typedef uint8_t u8;
+typedef uint32_t u32;
+typedef uint64_t u64;
+#else
+#include <linux/types.h>
+#endif
+
+#define AGX21_CP_MICROSEQ_NORMAL_SIZE 304
+#define AGX21_CP_MICROSEQ_BARRIER_SIZE 344
+
+/* Byte writer for the type-3 WorkCommandCP path of 21B91 0x846c394.
+ * Every dynamic value must come from the caller's independently verified
+ * native producer. Values named *_va are GPU VAs, not CPU pointers.
+ * This does not translate addresses, compute native context state, align
+ * the microsequence, set command+496/+504, or submit a command.
+ */
+struct agx21_cp_microseq_args {
+    u64 command_va;             /* vtable +520(a4): P */
+    u64 state_va;               /* vtable +520(v10[77]): S */
+    u64 token_va;               /* vtable +520(a1[18]): T */
+    u64 descriptor_aux_va;      /* vtable +520(*(D+312)): U */
+    u64 command_qword_4;       /* *(u64 *)(C+4), unaligned */
+    u64 command_qword_640;     /* *(u64 *)(C+640) */
+    u64 command_qword_0x2b8;   /* controls type-25 conditional pointer */
+    u64 command_qword_0x2c0;   /* controls type-25 conditional pointer */
+    u32 command_word_16;
+    u32 command_word_656;
+    u32 command_word_664;
+    u32 command_word_648;
+    u32 descriptor_word_1148;
+    u32 descriptor_indirect_word_320_8;
+    u32 descriptor_has_word_1104; /* exact Boolean (0 or 1) */
+    u32 descriptor_vtable_280_result;
+    u32 barrier_enabled;       /* exact native predicate result, 0 or 1 */
+    u32 barrier_payload;       /* *(u32 *)(D+980), used iff enabled */
+};
+
+/* Returns 0 and sets *written to 304 or 344; -1 leaves all outputs intact.
+ * Two type-25 trailing u32 slots are deliberately never written. The caller
+ * owns their pre-existing bytes, just as the native helper does.
+ */
+int agx21_write_cp_microseq(u8 *dst, size_t size,
+                            const struct agx21_cp_microseq_args *args,
+                            size_t *written);
+
+/* Stage a complete, 64-byte-rounded stream and bind WorkCommandCP +0x1f0/0x1f8.
+ * The caller must have mapped stream_va into the firmware address space and
+ * populated all dynamic args from native producers. No queue is published.
