+ le32(hwa+4428,0x578);le32(hwa+4432,sample_float);
+ le32(hwa+4436,0x578);le32(hwa+4440,0);
+ le32(hwa+4444,sample*tc0);le32(hwa+4448,sample*tc1);
+ le64(hwa+4452,24000ULL*sample*tc0);
+ le64(hwa+4460,24000ULL*sample*tc1);
+ le32(hwa+4476,0);
+ le32(hwa+4472,0x47800000U);
+ /* The non-zone policy block immediately following SE is emitted by
+  * 0x845ebac (0x846314..0x846384) before the SE structure. Its only
+  * live dynamic input here is the native controller base p-state. */
+ memset(hwa+4296,0,16);le32(hwa+4328,0);
+ le64(hwa+4512,0);le32(hwa+4524,0);le32(hwa+4532,0);
+ le32(hwa+4540,0);le64(hwa+4548,0x4780000000000000ULL);
+ le32(hwa+4556,0);le32(hwa+4564,0);
+ le32(hwa+4568,0x20000);le32(hwa+4572,100*property(p,2,1));
+ le64(hwa+4576,0);le64(hwa+4584,0);
+ le32(hwa+4628,0);le32(hwa+4636,0);
+ memset(hwa+4664,0,40);
+ return 0;
+}
+
+int agx21_write_primary_controller(u8 *hwa, size_t size,
+ const struct agx21_power_tables *p, u64 initial_counter)
+{
+ u32 max, max_power, duty, base, period, ticks, tc, perf_tc[2], limiter;
+ u32 ki, kp, clamp, perf_ki[2], perf_kp[2], perf_clamp, drop, min_util;
+ u32 ratio, inverse, perf_ratio[2], perf_inverse[2], limiter_ratio, limiter_inverse;
+ u32 clamp_float, max_power_float, perf_clamp_float, perf_scale, gain_ratio;
+ unsigned long a=(unsigned long)hwa, b=(unsigned long)p;
+ unsigned int i;
+ if (!hwa || !p || size<0x4358 || a>~0UL-size || b>~0UL-sizeof(*p) ||
+     (a<b+sizeof(*p) && b<a+size) || p->states<2 || p->states>16 ||
+     p->tables<1 || p->tables>8 || p->policy_present>>AGX21_POLICY_WORDS)
+  return -1;
