--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_controller.c
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "agx_21b91_controller.h"
+#ifdef AGX_ABI_HOST_TEST
+#include <string.h>
+#else
+#include <linux/string.h>
+#endif
+
+int agx21_ratio_f32(u32 n, u32 d, u32 *bits)
+{
+ u64 scaled, q, rem;
+ int exponent=0, shift;
+ if (!bits || !d || n>0x1000000 || d>0x1000000) return -1;
+ if (!n) { *bits=0; return 0; }
+ /* Find floor(log2(n/d)) without floating point or overflowing a u32. */
+ if (n>=d) {
+  while ((u64)d << (exponent+1) <= n) exponent++;
+ } else {
+  while ((u64)n << -exponent < d) exponent--;
+ }
+ shift=23-exponent;
+ if (shift>=0) { scaled=(u64)n << shift; q=scaled/d; rem=scaled%d; }
+ else {
+  u64 denominator=(u64)d << -shift;
+  q=n/denominator; rem=n%denominator;
+  if (rem*2>denominator || (rem*2==denominator && (q&1))) q++;
+  goto rounded;
+ }
+ if (rem*2>d || (rem*2==d && (q&1))) q++;
+rounded:
+ if (q==0x1000000) { q>>=1; exponent++; }
+ *bits=((u32)(exponent+127)<<23)|((u32)q&0x7fffff);
+ return 0;
+}
+
+static u32 property(const struct agx21_power_tables *p, unsigned int i, u32 fallback)
+{
+ return p->policy_present & (1ULL<<i) ? p->policy[i] : fallback;
+}
+static void le32(u8 *p, u32 value)
+{
+ unsigned int i;
+ for (i=0;i<4;i++) p[i]=(u8)(value>>(8*i));
+}
+static void le64(u8 *p, u64 value)
+{
+ le32(p,(u32)value); le32(p+4,(u32)(value>>32));
+}
+static int finite_bits(u32 bits) { return (bits&0x7f800000)!=0x7f800000; }
+static int multiply_f32(u32 a,u32 b,u32 *out);
+
+int agx21_write_se_controller_sparse(u8 *hwa, size_t size,
+ const struct agx21_power_tables *p)
+{
+ u32 sample, tc0=9, tc1, ratio0, ratio1, inverse0, inverse1;
+ u32 inactive, engagement, reset, kp0, kp1, max, sample_float;
+ u32 ki0, ki1, sample_ratio, scaled_ki0, scaled_ki1;
+ unsigned long a=(unsigned long)hwa,b=(unsigned long)p;
+ if(!hwa||!p||size<4704||a>~0UL-size||b>~0UL-sizeof(*p)||
+    (a<b+sizeof(*p)&&b<a+size)||p->states<2||p->states>16||
+    p->policy_present>>AGX21_POLICY_WORDS||!(p->policy_present&(1ULL<<12)))return -1;
+ /* Native setup 0x84633b0 gives tc=(9,3). 0x846380c obtains the
+  * millisecond power-sample period; J171 ADT provides it explicitly. */
+ sample=property(p,12,0);tc1=property(p,49,3);
+ inactive=property(p,50,2500);engagement=property(p,48,0xffffffffU);
+ reset=property(p,55,50);kp0=property(p,53,0xc0a00000U);
+ kp1=property(p,54,0xc1200000U);max=100*(p->states-1);
+ ki0=property(p,51,0xc2480000U);ki1=property(p,52,0xc2c80000U);
+ if(!sample||sample>1000||!tc1||tc1>10000||
+    !property(p,2,1)||property(p,2,1)>=p->states||
+    (u64)24000*sample*tc1>0xffffffffU||
+    !finite_bits(kp0)||!finite_bits(kp1)||
+    !finite_bits(ki0)||!finite_bits(ki1)||
+    agx21_ratio_f32(tc0-1,tc0,&ratio0)||
+    agx21_ratio_f32(tc1-1,tc1,&ratio1)||
+    agx21_ratio_f32(1,tc0,&inverse0)||
+    agx21_ratio_f32(1,tc1,&inverse1)||
+    agx21_ratio_f32(1000*sample,1,&sample_float)||
+    agx21_ratio_f32(sample,1000,&sample_ratio)||
+    multiply_f32(ki0&0x7fffffffU,sample_ratio,&scaled_ki0)||
+    multiply_f32(ki1&0x7fffffffU,sample_ratio,&scaled_ki1))return -1;
+ scaled_ki0|=ki0&0x80000000U;scaled_ki1|=ki1&0x80000000U;
+ /* Publisher 0x845ebac, native +0x846380c..0x8463a9c. Leave
+  * all other SE fields that depend on untraced inputs alone. */
+ le32(hwa+4332,(sample/2+33)/sample);
+ le32(hwa+4336,1000*sample);
+ le32(hwa+4340,inactive);
+ le32(hwa+4344,0);
+ le32(hwa+4348,engagement);le32(hwa+4352,reset);
+ le32(hwa+4360,50);
+ /* The exact 21B91 kernelcache contains 0x578,0x578,0,1 at
+  * xmmword_FFFFFFF0070CD790; producer 0x846389c copies that vector
+  * to +5632 before publisher 0x845ebac selects +5644/+5632/+5636. */
+ le32(hwa+4364,1);
+ le32(hwa+4372,ratio0);le32(hwa+4376,ratio1);
+ le32(hwa+4380,inverse0);le32(hwa+4384,inverse1);
+ /* Producer 0x8463860: float32x2(SE ki) * ((float)sample/1000),
+  * publisher 0x845ebac copies the resulting lanes to these offsets. */
+ le32(hwa+4388,scaled_ki0);le32(hwa+4392,scaled_ki1);
+ le32(hwa+4396,0);le32(hwa+4400,0x47800000U);
+ le32(hwa+4404,kp0);le32(hwa+4408,kp1);
+ le32(hwa+4416,100);le32(hwa+4420,max);
+ /* setupConfig 0x8446ed0 stores 100*base_perf_state at a1+2336;
+  * SE producer 0x84638b0 copies it to a1+5696 and publisher
+  * 0x845ebac copies that word to HWA+4424. */
