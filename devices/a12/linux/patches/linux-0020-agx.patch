index 000000000..26962adef
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Apple A12 GPU (AGX G11P). The firmware's structures are described in the
+ * badapple docs/gpu.md; offsets in comments name the firmware functions they
+ * come from.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+#ifndef __AGX_H__
+#define __AGX_H__
+
+#include <drm/drm_device.h>
+#include <drm/gpu_scheduler.h>
+#include <linux/dmapool.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+/* The firmware's view of the chunk, through the mem-desc table. */
+#define AGX_CHUNK_VA		0xffffffffc0000000ULL
+#define AGX_CHUNK_SIZE		SZ_8M
+/* The chunk again in every context's GPU VA space, see agx_vm_map_chunk(). */
+#define AGX_CHUNK_GVA		0x8000000000ULL
+
+/*
+ * GPU VAs. USC (shader) addresses are 32-bit offsets from AGX_USC_BASE,
+ * which the firmware loads into RGX 0x10000 at power-up for every context.
+ * VMs get MMU contexts from AGX_FIRST_CTX; lower ones belong to the
+ * firmware and the parameter manager.
+ */
+#define AGX_USC_BASE		0x1100000000ULL
+#define AGX_FIRST_CTX		16
+#define AGX_NR_CTX		64
+#define AGX_VM_START		SZ_16K
+#define AGX_VM_END		0x8000000000ULL
+#define AGX_PAGE		SZ_16K
+
+struct agx_vm;
+struct apple_rtkit;
+struct drm_asahi_cmd_render;
+struct asc_segment;
+struct drm_gem_object;
+
+struct agx_device {
+	struct drm_device drm;
+	struct device *dev;
+	struct apple_rtkit *rtk;
+	const struct asc_segment *segs;
+	int nsegs;
+	phys_addr_t sgx, fender;
+	void __iomem *rgx;		/* read only, for the MMU fault status */
+
+	/* Firmware structures, see agx_fw.c. */
+	void *buf;
+	dma_addr_t pa;
+	u32 off;
+	bool ready;
+	u32 B, C, stats_cp, gen, gen_fw;
+	u32 pc[AGX_NR_CTX];		/* page catalogue per context */
+	u32 chan_state[17], chan_ring[17];
+	struct agx_fwq { u32 info, ring, n; } cpq, taq, fragq;
+	u32 nr_cmds;
+	struct { u32 cmd, evc, useq, scratch; } slot[4];
+	/* Render: one job's commands and the buffer manager, see agx_fw_render(). */
+	struct {
+		u32 bmd, bms, init, ta, frag, scratch, tilemap, tpc, heapmeta, pre;
+		bool frag_pending;
+	} rn;
+	bool wedged;
+
+	/* One job runs at a time; its fence is signalled from agx_recv(). */
+	struct drm_gpu_scheduler sched;
+	spinlock_t fence_lock;
+	u64 fence_ctx, fence_seqno;
+	struct dma_fence *active;
+	u32 active_stamp;
+
+	struct mutex ctx_lock;
+	unsigned long ctx_used[BITS_TO_LONGS(AGX_NR_CTX)];
+	struct dma_pool *pd_pool, *pt_pool;
+};
+
+#define to_agx(d) container_of(d, struct agx_device, drm)
+
+/* agx_fw.c */
+int agx_fw_init(struct agx_device *agx, void __iomem *asc);
+struct dma_fence *agx_fw_run(struct agx_device *agx, u32 ctx, u64 args, u64 stream);
+int agx_fw_render_check(const struct drm_asahi_cmd_render *r);
+struct dma_fence *agx_fw_render(struct agx_device *agx, u32 ctx,
+				const struct drm_asahi_cmd_render *r);
+void agx_fw_timeout(struct agx_device *agx);
+void agx_fw_flush_tlb(struct agx_device *agx, u32 ctx);
+extern const struct apple_rtkit_ops agx_rtk_ops;
+
+/* agx_vm.c */
+int agx_vm_map_chunk(struct agx_device *agx);
+struct agx_vm *agx_vm_create(struct agx_device *agx, u64 kernel_start, u64 kernel_end);
+struct agx_vm *agx_vm_get(struct agx_vm *vm);
+void agx_vm_put(struct agx_vm *vm);
+int agx_vm_bind(struct agx_vm *vm, struct drm_gem_object *obj, u64 offset, u64 range,
+		u64 addr, bool write);
+int agx_vm_unbind(struct agx_vm *vm, u64 addr, u64 range);
+void agx_vm_unmap_object(struct agx_vm *vm, struct drm_gem_object *obj);
+struct agx_vm *agx_vm_job_start(struct agx_vm *vm);
+void agx_vm_job_end(struct agx_vm *vm);
+struct dma_fence *agx_vm_run(struct agx_vm *vm, u64 stream,
+			     const struct drm_asahi_cmd_render *render);
+
+#endif
diff --git a/drivers/gpu/drm/agx/agx_drv.c b/drivers/gpu/drm/agx/agx_drv.c
new file mode 100644
index 000000000..3c3a930ad
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_drv.c
@@ -0,0 +1,774 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * DRM driver for the Apple A12 GPU (AGX G11P). It speaks the
+ * Asahi uAPI (include/uapi/drm/asahi_drm.h) where the hardware allows:
+ *
+ *  - USC addresses are relative to AGX_USC_BASE, which the firmware loads
+ *    for every context, so queues must use it as usc_exec_base.
+ *  - No helper programs, layered or very large renders, or single-page
+ *    binds yet.
+ *    Sampler heaps and timestamps are accepted and ignored; timestamp
+ *    objects are only kept so that Mesa can bind them.
+ *  - Each compute or render command is one scheduler job. Every queue is an entity
+ *    on the one scheduler, which runs one job at a time, so the commands
+ *    of a submit run in order. In-syncs gate the first, out-syncs get the
+ *    last one's fence.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <drm/asahi_drm.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_file.h>
+#include <drm/drm_gem_shmem_helper.h>
+#include <drm/drm_ioctl.h>
+#include <drm/drm_syncobj.h>
+#include <drm/gpu_scheduler.h>
+#include <linux/dma-fence-chain.h>
+#include <linux/dma-mapping.h>
+#include <linux/dmapool.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/xarray.h>
+
+#include "agx.h"
+
+#define MAX_COMMANDS	64
+#define MAX_SYNCS	64
+#define JOB_TIMEOUT_MS	5000
+
+struct agx_queue {
+	struct agx_vm *vm;
+	struct drm_sched_entity entity;
+};
+
+struct agx_job {
+	struct drm_sched_job base;
+	struct agx_vm *vm;
+	u64 stream;
+	struct drm_asahi_cmd_render *render;	/* or a compute stream */
+};
+
+#define to_job(j) container_of(j, struct agx_job, base)
+
+struct agx_file {
+	struct xarray vms;
+	struct xarray queues;
+	struct xarray objects;	/* GEM objects bound for timestamps */
+	struct mutex lock;	/* VMs against the queues that use them */
+};
+
+/* Waits up to the timeout for the queue's jobs, then drops the rest. */
+static void agx_queue_free(struct agx_queue *q)
+{
+	drm_sched_entity_destroy(&q->entity);
+	agx_vm_put(q->vm);
+	kfree(q);
+}
+
+static int agx_open(struct drm_device *drm, struct drm_file *file)
+{
+	struct agx_file *af = kzalloc(sizeof(*af), GFP_KERNEL);
+
+	if (!af)
+		return -ENOMEM;
+	xa_init_flags(&af->vms, XA_FLAGS_ALLOC1);
+	xa_init_flags(&af->queues, XA_FLAGS_ALLOC1);
+	xa_init_flags(&af->objects, XA_FLAGS_ALLOC1);
+	mutex_init(&af->lock);
+	file->driver_priv = af;
+	return 0;
+}
+
+static void agx_postclose(struct drm_device *drm, struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+	struct drm_gem_object *obj;
+	struct agx_queue *q;
+	struct agx_vm *vm;
+	unsigned long id;
+
+	xa_for_each(&af->objects, id, obj)
+		drm_gem_object_put(obj);
+	xa_for_each(&af->queues, id, q)
+		agx_queue_free(q);
+	xa_for_each(&af->vms, id, vm)
+		agx_vm_put(vm);
+	xa_destroy(&af->objects);
+	xa_destroy(&af->queues);
+	xa_destroy(&af->vms);
+	kfree(af);
+}
+
+static int agx_get_params(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_get_params *args = data;
+	struct drm_asahi_params_global p = {
+		.gpu_generation = 11,
+		.gpu_variant = 'P',
+		.gpu_revision = 0x11,
+		.chip_id = 0x8020,
+		.num_dies = 1,
+		.num_clusters_total = 1,
+		.num_cores_per_cluster = 4,
+		.max_frequency_khz = 1098000,
+		.core_masks = { 0xf },
+		.vm_start = AGX_VM_START,
+		.vm_end = AGX_VM_END,
+		.vm_kernel_min_size = AGX_PAGE,
+		.max_commands_per_submission = MAX_COMMANDS,
+		.command_timestamp_frequency_hz = 24000000,
+	};
+
+	if (args->param_group || args->pad)
+		return -EINVAL;
+	if (copy_to_user(u64_to_user_ptr(args->pointer), &p, min_t(u64, args->size, sizeof(p))))
+		return -EFAULT;
+	return 0;
+}
+
+static int agx_get_time(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_get_time *args = data;
+
+	if (args->flags)
+		return -EINVAL;
+	args->gpu_timestamp = ktime_get_ns();
+	return 0;
+}
+
+static int agx_vm_create_ioctl(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_create *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+	int ret;
+
+	if (args->pad)
+		return -EINVAL;
+	vm = agx_vm_create(to_agx(drm), args->kernel_start, args->kernel_end);
+	if (IS_ERR(vm))
+		return PTR_ERR(vm);
+	ret = xa_alloc(&af->vms, &args->vm_id, vm, xa_limit_32b, GFP_KERNEL);
+	if (ret)
+		agx_vm_put(vm);
+	return ret;
+}
+
+/* Queues and jobs keep their own references. */
+static int agx_vm_destroy_ioctl(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_destroy *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+
+	if (args->pad)
+		return -EINVAL;
+	mutex_lock(&af->lock);
+	vm = xa_erase(&af->vms, args->vm_id);
+	mutex_unlock(&af->lock);
+	if (!vm)
+		return -ENOENT;
+	agx_vm_put(vm);
+	return 0;
+}
+
+static int agx_vm_bind_ioctl(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_bind *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+	u32 i;
+	int ret = 0;
+
+	if (args->pad || args->stride < sizeof(struct drm_asahi_gem_bind_op) ||
+	    args->num_binds > 256)
+		return -EINVAL;
+
+	mutex_lock(&af->lock);
+	vm = xa_load(&af->vms, args->vm_id);
+	if (!vm) {
+		ret = -ENOENT;
+		goto out;
+	}
+	for (i = 0; i < args->num_binds && !ret; i++) {
+		struct drm_asahi_gem_bind_op op;
+		struct drm_gem_object *obj;
+
+		if (copy_from_user(&op, u64_to_user_ptr(args->userptr + (u64)i * args->stride),
+				   sizeof(op))) {
+			ret = -EFAULT;
+			break;
+		}
+		if (op.flags & ~(DRM_ASAHI_BIND_UNBIND | DRM_ASAHI_BIND_READ |
+				 DRM_ASAHI_BIND_WRITE)) {
+			ret = -EINVAL;
+			break;
+		}
+		if (op.flags & DRM_ASAHI_BIND_UNBIND) {
+			ret = agx_vm_unbind(vm, op.addr, op.range);
+			continue;
+		}
+		if (!(op.flags & DRM_ASAHI_BIND_READ)) {
+			ret = -EINVAL;
+			break;
+		}
+		obj = drm_gem_object_lookup(file, op.handle);
+		if (!obj) {
+			ret = -ENOENT;
+			break;
+		}
+		ret = agx_vm_bind(vm, obj, op.offset, op.range, op.addr,
+				  op.flags & DRM_ASAHI_BIND_WRITE);
+		drm_gem_object_put(obj);
+	}
+out:
+	mutex_unlock(&af->lock);
+	return ret;
+}
+
+static int agx_gem_bind_object(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_bind_object *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct drm_gem_object *obj;
+	int ret;
+
+	if (args->vm_id || args->pad)
+		return -EINVAL;
+	switch (args->op) {
+	case DRM_ASAHI_BIND_OBJECT_OP_BIND:
+		if (args->flags != DRM_ASAHI_BIND_OBJECT_USAGE_TIMESTAMPS)
+			return -EINVAL;
+		obj = drm_gem_object_lookup(file, args->handle);
+		if (!obj)
+			return -ENOENT;
+		if (args->offset >= obj->size || args->range > obj->size - args->offset) {
+			drm_gem_object_put(obj);
+			return -EINVAL;
+		}
+		ret = xa_alloc(&af->objects, &args->object_handle, obj, xa_limit_32b, GFP_KERNEL);
+		if (ret)
+			drm_gem_object_put(obj);
+		return ret;
+	case DRM_ASAHI_BIND_OBJECT_OP_UNBIND:
+		obj = xa_erase(&af->objects, args->object_handle);
+		if (!obj)
+			return -ENOENT;
+		drm_gem_object_put(obj);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static void agx_gem_close(struct drm_gem_object *obj, struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+	unsigned long id;
+
+	mutex_lock(&af->lock);
+	xa_for_each(&af->vms, id, vm)
+		agx_vm_unmap_object(vm, obj);
+	mutex_unlock(&af->lock);
+}
+
+static const struct drm_gem_object_funcs agx_gem_funcs = {
+	.free = drm_gem_shmem_object_free,
+	.close = agx_gem_close,
+	.print_info = drm_gem_shmem_object_print_info,
+	.pin = drm_gem_shmem_object_pin,
+	.unpin = drm_gem_shmem_object_unpin,
+	.get_sg_table = drm_gem_shmem_object_get_sg_table,
+	.vmap = drm_gem_shmem_object_vmap,
+	.vunmap = drm_gem_shmem_object_vunmap,
+	.mmap = drm_gem_shmem_object_mmap,
+	.vm_ops = &drm_gem_shmem_vm_ops,
+};
+
+/* The GPU does not snoop, so CPU mappings are always write-combined. */
+static struct drm_gem_object *agx_gem_create_object(struct drm_device *drm, size_t size)
+{
+	struct drm_gem_shmem_object *shmem = kzalloc(sizeof(*shmem), GFP_KERNEL);
+
+	if (!shmem)
+		return ERR_PTR(-ENOMEM);
+	shmem->base.funcs = &agx_gem_funcs;
+	shmem->map_wc = true;
+	return &shmem->base;
+}
+
+static int agx_gem_create(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_create *args = data;
+	struct drm_gem_shmem_object *shmem;
+	int ret;
+
+	if (args->pad || !args->size ||
+	    (args->flags & ~(DRM_ASAHI_GEM_WRITEBACK | DRM_ASAHI_GEM_VM_PRIVATE)))
+		return -EINVAL;
+
+	shmem = drm_gem_shmem_create(drm, round_up(args->size, AGX_PAGE));
+	if (IS_ERR(shmem))
+		return PTR_ERR(shmem);
+	/*
+	 * WRITEBACK is only a performance hint. Pin and map the pages now: that
+	 * cleans the cache lines left by zeroing them, which would otherwise
+	 * land on top of whatever userspace writes before the first bind.
+	 */
+	ret = PTR_ERR_OR_ZERO(drm_gem_shmem_get_pages_sgt(shmem));
+	if (!ret)
+		ret = drm_gem_handle_create(file, &shmem->base, &args->handle);
+	drm_gem_object_put(&shmem->base);
+	return ret;
+}
+
+static int agx_gem_mmap_offset(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_mmap_offset *args = data;
+	struct drm_gem_object *obj;
+	int ret;
+
+	if (args->flags)
+		return -EINVAL;
+	obj = drm_gem_object_lookup(file, args->handle);
+	if (!obj)
+		return -ENOENT;
+	ret = drm_gem_create_mmap_offset(obj);
+	if (!ret)
+		args->offset = drm_vma_node_offset_addr(&obj->vma_node);
+	drm_gem_object_put(obj);
+	return ret;
+}
+
+static int agx_queue_create(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_queue_create *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct drm_gpu_scheduler *sched = &to_agx(drm)->sched;
+	struct agx_queue *q;
+	int ret;
+
+	if (args->flags || args->priority > DRM_ASAHI_PRIORITY_MEDIUM ||
+	    args->usc_exec_base != AGX_USC_BASE)
+		return -EINVAL;
+
+	q = kzalloc(sizeof(*q), GFP_KERNEL);
+	if (!q)
+		return -ENOMEM;
+	ret = drm_sched_entity_init(&q->entity, DRM_SCHED_PRIORITY_NORMAL, &sched, 1, NULL);
+	if (ret) {
+		kfree(q);
+		return ret;
+	}
+	mutex_lock(&af->lock);
+	q->vm = xa_load(&af->vms, args->vm_id);
+	if (q->vm)
+		agx_vm_get(q->vm);
+	ret = q->vm ? xa_alloc(&af->queues, &args->queue_id, q, xa_limit_32b, GFP_KERNEL) : -ENOENT;
+	mutex_unlock(&af->lock);
+	if (ret) {
+		drm_sched_entity_destroy(&q->entity);
+		if (q->vm)
+			agx_vm_put(q->vm);
+		kfree(q);
+	}
+	return ret;
+}
+
+static int agx_queue_destroy(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_queue_destroy *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_queue *q;
+
+	if (args->pad)
+		return -EINVAL;
+	mutex_lock(&af->lock);
+	q = xa_erase(&af->queues, args->queue_id);
+	mutex_unlock(&af->lock);
+	if (!q)
+		return -ENOENT;
+	agx_queue_free(q);
+	return 0;
+}
+
+/*
+ * Check the command buffer and collect its commands: compute streams, or
+ * render commands, which point into cmdbuf. Attachment commands are only
+ * hints and are skipped. Returns the number of commands.
+ */
+static int agx_walk(const u8 *cmdbuf, u32 size, u64 *streams,
+		    const struct drm_asahi_cmd_render **renders)
+{
+	u32 o = 0, n = 0;
+
+	while (o < size) {
+		struct drm_asahi_cmd_header h;
+		struct drm_asahi_cmd_compute c = {};
+
+		if (size - o < sizeof(h))
+			return -EINVAL;
+		memcpy(&h, cmdbuf + o, sizeof(h));
+		o += sizeof(h);
+		if (h.size > size - o)
+			return -EINVAL;
+
+		switch (h.cmd_type) {
+		case DRM_ASAHI_CMD_COMPUTE:
+			memcpy(&c, cmdbuf + o, min_t(u32, h.size, sizeof(c)));
+			if (c.flags || c.helper.binary || !c.cdm_ctrl_stream_base)
+				return -EINVAL;
+			if (n == MAX_COMMANDS)
+				return -EINVAL;
+			streams[n++] = c.cdm_ctrl_stream_base;
+			break;
+		case DRM_ASAHI_CMD_RENDER:
+			if (h.size != sizeof(**renders) || n == MAX_COMMANDS ||
+			    agx_fw_render_check((const void *)(cmdbuf + o)))
+				return -EINVAL;
+			renders[n++] = (const void *)(cmdbuf + o);
+			break;
+		case DRM_ASAHI_SET_VERTEX_ATTACHMENTS:
+		case DRM_ASAHI_SET_FRAGMENT_ATTACHMENTS:
+		case DRM_ASAHI_SET_COMPUTE_ATTACHMENTS:
+			break;
+		default:
+			return -EINVAL;
+		}
+		o += h.size;
+	}
+	return n ?: -EINVAL;
+}
+
+/* An out-sync, looked up before anything is queued so that nothing fails after. */
+struct agx_out {
+	struct drm_syncobj *syncobj;
+	struct dma_fence_chain *chain;
+	u64 point;
+};
+
+static int agx_get_outs(struct drm_file *file, const struct drm_asahi_sync *syncs, u32 n,
+			struct agx_out *outs)
+{
+	u32 i;
+
+	for (i = 0; i < n; i++) {
+		if (syncs[i].sync_type > DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ)
+			return -EINVAL;
+		outs[i].syncobj = drm_syncobj_find(file, syncs[i].handle);
+		if (!outs[i].syncobj)
+			return -ENOENT;
+		if (syncs[i].sync_type == DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ) {
+			outs[i].chain = dma_fence_chain_alloc();
+			if (!outs[i].chain)
+				return -ENOMEM;
+			outs[i].point = syncs[i].timeline_value;
+		}
+	}
+	return 0;
+}
+
+static void agx_put_outs(struct agx_out *outs, u32 n)
+{
+	u32 i;
+
+	for (i = 0; i < n; i++) {
+		dma_fence_chain_free(outs[i].chain);
+		if (outs[i].syncobj)
+			drm_syncobj_put(outs[i].syncobj);
+	}
+}
+
+static void agx_job_free(struct agx_job *job)
+{
+	drm_sched_job_cleanup(&job->base);
+	agx_vm_job_end(job->vm);
+	kfree(job->render);
+	kfree(job);
+}
+
+static int agx_submit(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_submit *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct drm_asahi_sync *syncs = NULL;
+	struct agx_job *jobs[MAX_COMMANDS] = {};
+	struct agx_out *outs = NULL;
+	struct dma_fence *done;
+	const struct drm_asahi_cmd_render **renders = NULL;
+	struct agx_queue *q;
+	u64 *streams;
+	u8 *cmdbuf;
+	int i, n, ret;
+
+	if (args->flags || args->pad || !args->cmdbuf_size || args->cmdbuf_size > SZ_64K ||
+	    args->in_sync_count > MAX_SYNCS || args->out_sync_count > MAX_SYNCS)
+		return -EINVAL;
+
+	cmdbuf = memdup_user(u64_to_user_ptr(args->cmdbuf), args->cmdbuf_size);
+	if (IS_ERR(cmdbuf))
+		return PTR_ERR(cmdbuf);
+	streams = kcalloc(MAX_COMMANDS, sizeof(*streams), GFP_KERNEL);
+	renders = kcalloc(MAX_COMMANDS, sizeof(*renders), GFP_KERNEL);
+	outs = kcalloc(args->out_sync_count, sizeof(*outs), GFP_KERNEL);
+	if (!streams || !renders || (args->out_sync_count && !outs)) {
+		ret = -ENOMEM;
+		goto out_free;
+	}
+	if (args->in_sync_count + args->out_sync_count) {
+		syncs = memdup_array_user(u64_to_user_ptr(args->syncs),
+					  args->in_sync_count + args->out_sync_count, sizeof(*syncs));
+		if (IS_ERR(syncs)) {
+			ret = PTR_ERR(syncs);
+			syncs = NULL;
+			goto out_free;
+		}
+	}
+	n = ret = agx_walk(cmdbuf, args->cmdbuf_size, streams, renders);
+	if (ret < 0)
+		goto out_free;
+	ret = agx_get_outs(file, syncs + args->in_sync_count, args->out_sync_count, outs);
+	if (ret)
+		goto out_outs;
+
+	/* The file lock keeps the queue alive until its jobs are pushed. */
+	mutex_lock(&af->lock);
+	q = xa_load(&af->queues, args->queue_id);
+	if (!q) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	for (i = 0; i < n; i++) {
+		jobs[i] = kzalloc(sizeof(*jobs[i]), GFP_KERNEL);
+		if (!jobs[i]) {
+			ret = -ENOMEM;
+			goto out_jobs;
+		}
+		ret = drm_sched_job_init(&jobs[i]->base, &q->entity, 1, q, file->client_id);
+		if (ret) {
+			kfree(jobs[i]);
+			jobs[i] = NULL;
+			goto out_jobs;
+		}
+		jobs[i]->vm = agx_vm_job_start(q->vm);
+		jobs[i]->stream = streams[i];
+		if (renders[i]) {
+			jobs[i]->render = kmemdup(renders[i], sizeof(*renders[i]), GFP_KERNEL);
+			if (!jobs[i]->render) {
+				ret = -ENOMEM;
+				goto out_jobs;
+			}
+		}
+	}
+	for (i = 0; i < args->in_sync_count; i++) {
+		if (syncs[i].sync_type > DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ) {
+			ret = -EINVAL;
+			goto out_jobs;
+		}
+		ret = drm_sched_job_add_syncobj_dependency(&jobs[0]->base, file, syncs[i].handle,
+							   syncs[i].timeline_value);
+		if (ret)
+			goto out_jobs;
+	}
+
+	/* Nothing fails from here on. */
+	for (i = 0; i < n; i++) {
+		drm_sched_job_arm(&jobs[i]->base);
+		if (i == n - 1)
+			done = dma_fence_get(&jobs[i]->base.s_fence->finished);
+		drm_sched_entity_push_job(&jobs[i]->base);
+	}
+	mutex_unlock(&af->lock);
+
+	for (i = 0; i < args->out_sync_count; i++) {
+		if (outs[i].chain) {
+			drm_syncobj_add_point(outs[i].syncobj, outs[i].chain, done, outs[i].point);
+			outs[i].chain = NULL;
+		} else {
+			drm_syncobj_replace_fence(outs[i].syncobj, done);
+		}
+	}
+	dma_fence_put(done);
+	ret = 0;
+	goto out_outs;
+
+out_jobs:
+	for (i = 0; i < n && jobs[i]; i++)
+		agx_job_free(jobs[i]);
+out_unlock:
+	mutex_unlock(&af->lock);
+out_outs:
+	agx_put_outs(outs, args->out_sync_count);
+out_free:
+	kfree(syncs);
+	kfree(outs);
+	kfree(renders);
+	kfree(streams);
+	kfree(cmdbuf);
+	return ret;
+}
+
+static struct dma_fence *agx_run_job(struct drm_sched_job *sj)
+{
+	struct agx_job *job = to_job(sj);
+
+	return agx_vm_run(job->vm, job->stream, job->render);
+}
+
+/*
+ * The GPU cannot be reset: agx_fw_timeout() either finds the job done or
+ * fails it and wedges the GPU. Either way its fence is signalled, and
+ * NO_HANG puts it back on the pending list to be freed.
+ */
+static enum drm_gpu_sched_stat agx_timedout_job(struct drm_sched_job *sj)
+{
+	agx_fw_timeout(container_of(sj->sched, struct agx_device, sched));
+	return DRM_GPU_SCHED_STAT_NO_HANG;
+}
+
+static void agx_free_job(struct drm_sched_job *sj)
+{
+	agx_job_free(to_job(sj));
+}
+
+static const struct drm_sched_backend_ops agx_sched_ops = {
+	.run_job = agx_run_job,
+	.timedout_job = agx_timedout_job,
+	.free_job = agx_free_job,
+};
+
+static const struct drm_ioctl_desc agx_ioctls[] = {
+	DRM_IOCTL_DEF_DRV(ASAHI_GET_PARAMS, agx_get_params, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GET_TIME, agx_get_time, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_CREATE, agx_vm_create_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_DESTROY, agx_vm_destroy_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_BIND, agx_vm_bind_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_CREATE, agx_gem_create, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_BIND_OBJECT, agx_gem_bind_object, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_MMAP_OFFSET, agx_gem_mmap_offset, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_QUEUE_CREATE, agx_queue_create, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_QUEUE_DESTROY, agx_queue_destroy, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_SUBMIT, agx_submit, DRM_RENDER_ALLOW),
+};
+
+DEFINE_DRM_GEM_FOPS(agx_fops);
+
+static const struct drm_driver agx_drm_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_RENDER | DRIVER_SYNCOBJ |
+			   DRIVER_SYNCOBJ_TIMELINE,
+	.open = agx_open,
+	.postclose = agx_postclose,
+	.ioctls = agx_ioctls,
+	.num_ioctls = ARRAY_SIZE(agx_ioctls),
+	.fops = &agx_fops,
+	.gem_create_object = agx_gem_create_object,
+	DRM_GEM_SHMEM_DRIVER_OPS,
+	/* Mesa picks its driver by this name; this is the Asahi uAPI. */
+	.name = "asahi",
+	.desc = "Apple A12 GPU",
+	.major = 0,
+	.minor = 1,
+};
+
+static void agx_sched_fini(void *sched)
+{
+	drm_sched_fini(sched);
+}
+
+static int agx_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct agx_device *agx;
+	struct resource *res;
+	void __iomem *asc;
+	int len, ret;
+
+	agx = devm_drm_dev_alloc(dev, &agx_drm_driver, struct agx_device, drm);
+	if (IS_ERR(agx))
+		return PTR_ERR(agx);
+	agx->dev = dev;
+	mutex_init(&agx->ctx_lock);
+
+	agx->segs = of_get_property(dev->of_node, "apple,segment-ranges", &len);
+	agx->nsegs = agx->segs ? len / 32 : 0;
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sgx");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no sgx registers\n");
+	agx->sgx = res->start;
+	/* The firmware owns these; only read the fault status after a hang. */
+	agx->rgx = devm_ioremap(dev, res->start, resource_size(res));
+	if (!agx->rgx)
+		return -ENOMEM;
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "fender");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no fender registers\n");
+	agx->fender = res->start;
+
+	/* DRAM starts at 0x800000000, past the default 32 bit mask. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+	asc = devm_platform_ioremap_resource_byname(pdev, "asc");
+	if (IS_ERR(asc))
+		return PTR_ERR(asc);
+
+	/* Page directories hold 512 u64s, page tables 128. */
+	/*
+	 * 16K aligned, as the firmware maps each table page into its own MMU
+	 * when it walks a context (FUN_00026744).
+	 */
+	agx->pd_pool = dmam_pool_create("agx-pd", dev, 0x1000, AGX_PAGE, 0);
+	agx->pt_pool = dmam_pool_create("agx-pt", dev, 0x400, AGX_PAGE, 0);
+	if (!agx->pd_pool || !agx->pt_pool)
+		return -ENOMEM;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	ret = agx_fw_init(agx, asc);
+	if (ret)
+		return ret;
+	ret = drm_sched_init(&agx->sched, &(struct drm_sched_init_args){
+		.ops = &agx_sched_ops,
+		.num_rqs = DRM_SCHED_PRIORITY_COUNT,
+		.credit_limit = 1,
+		.timeout = msecs_to_jiffies(JOB_TIMEOUT_MS),
+		.name = "agx",
+		.dev = dev,
+	});
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, agx_sched_fini, &agx->sched);
+	if (ret)
+		return ret;
+	return drm_dev_register(&agx->drm, 0);
+}
+
+static const struct of_device_id agx_of_match[] = {
+	{ .compatible = "apple,t8020-agx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, agx_of_match);
+
+static struct platform_driver agx_driver = {
+	.driver = {
+		.name = "agx",
+		.of_match_table = agx_of_match,
+		/* The firmware cannot be restarted. */
+		.suppress_bind_attrs = true,
+	},
+	.probe = agx_probe,
+};
+module_platform_driver(agx_driver);
+
+MODULE_AUTHOR("kiki <kieran@lavato.net>");
+MODULE_DESCRIPTION("DRM driver for the Apple A12 GPU (AGX G11P)");
+MODULE_LICENSE("Dual MIT/GPL");
diff --git a/drivers/gpu/drm/agx/agx_fw.c b/drivers/gpu/drm/agx/agx_fw.c
new file mode 100644
index 000000000..27d314f39
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_fw.c
@@ -0,0 +1,1083 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * AGX G11P firmware: boot, init block, the compute queue and jobs.
+ *
+ * The firmware's structures live in one physically contiguous chunk. The
+ * firmware maps it at AGX_CHUNK_VA through the mem-desc table. Every MMU
+ * context from AGX_FIRST_CTX up gets a page catalogue in the chunk at init
+ * and is loaded by the firmware at every power-up; agx_vm.c fills them in.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-fence.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/unaligned.h>
+#include <drm/asahi_drm.h>
+
+#include "agx.h"
+
+#define EP_MSGS			0x20
+#define EP_INTS			0x21
+#define MSG_INIT		(0x81ULL << 48)
+#define MSG_DOORBELL		(0x83ULL << 48)
+#define MSG_CHECK		(0x42ULL << 48)
+
+#define NR_SLOTS		4	/* job structures, reused in turn */
+#define RING_SIZE		0x100
+
+#define CH_TA			0
+#define CH_3D			1
+#define CH_CP			2
+#define CH_DEVCTRL		12
+#define CH_EVENT		13
+#define CH_KTRACE		15
+#define NR_CHANNELS		17
+
+#define ASC_CPU_CONTROL		0x44
+#define ASC_CPU_CONTROL_RUN	BIT(4)
+
+#define EV			3
+#define EV_TA			4
+#define EV_3D			7
+#define RGX_MMU_FAULT_STATUS	0x17040
+#define DONE_STAMP		0xcafe0003
+
+/* One entry of the ADT's segment-ranges. */
+struct asc_segment {
+	__le64 phys;
+	__le64 iova;
+	__le64 remap;
+	__le32 size;
+	__le32 flags;
+} __packed;
+
+static u32 agx_alloc(struct agx_device *agx, u32 n, u32 align)
+{
+	u32 o = ALIGN(agx->off, align);
+
+	if (WARN_ON(o + n > AGX_CHUNK_SIZE))
+		return 0;
+	agx->off = o + n;
+	return o;
+}
+
+static u64 fw_va(u32 o)
+{
+	return AGX_CHUNK_VA + o;
+}
+
+static void put32(struct agx_device *agx, u32 o, u32 v)
+{
+	put_unaligned_le32(v, agx->buf + o);
+}
+
+static void put64(struct agx_device *agx, u32 o, u64 v)
+{
+	put_unaligned_le64(v, agx->buf + o);
+}
+
+static u32 get32(struct agx_device *agx, u32 o)
+{
+	return get_unaligned_le32(agx->buf + o);
+}
+
+static u32 fw_off(u64 va)
+{
+	return va - AGX_CHUNK_VA;
+}
+
+/*
+ * Init block per FUN_00025954. Region layout follows m1n1's G13 InitData
+ * where the G11 firmware matches it.
+ */
+static void agx_build(struct agx_device *agx, void *init, void *table, dma_addr_t table_pa)
+{
+	static const u32 rings[NR_CHANNELS] = {
+		[0 ... 11] = 0x30 * 0x100,
+		[12] = 0x30 * 0x100, [13] = 0x38 * 0x100, [14] = 6 * 0xd8 * 0x100,
+		[15] = 0x70 * 0x200, [16] = 0x60 * 0x100,
+	};
+	static const struct { u32 off, size; } bufs[] = {
+		/* TA/3D/CP stats, hwdata A, fault info, TLB generations, ... */
+		{ 0x170, 0x1000 }, { 0x178, 0x1000 }, { 0x180, 0x1000 },
+		{ 0x188, 0x20000 }, { 0x190, 0x80 }, { 0x198, 0xc0 },
+		{ 0x1b0, 0x4000 }, { 0x1b8, 0x1000 }, { 0x1c0, 0x300 },
+		{ 0x1c8, 0x1000 },
+	};
+	static const u16 scratch_maps[] = {
+		0x680, 0x6e0, 0x700, 0x720, 0x740, 0x760, 0x780, 0x7c0, 0x7e0,
+		0x800, 0x820, 0x840, 0x880, 0x8a0, 0x8c0, 0x8e0, 0x900,
+	};
+	/* ADT sgx/perf-states */
+	static const u32 mhz[] = { 0, 316, 456, 612, 740, 900, 1098 };
+	static const u32 mv[] = { 400, 609, 675, 734, 790, 859, 965 };
+	static const u32 mv_sram[] = { 400, 728, 737, 787, 850, 925, 1046 };
+	/* hwdata A power limits, then RegionC ones (offsets above 0x2000) */
+	static const u16 limits[] = {
+		0x6d4, 0x72c, 0x770, 0x820, 0x938, 0x897c, 0x8980, 0x898c,
+	};
+	/* page size, PA shift, index shift, entries, table size, valid, PA mask, index mask */
+	static const struct { u8 esz, pas, pas2, ish; u16 n; u16 valid; u64 pam, im; } lv[] = {
+		{ 4, 4, 12, 30, 0x1000, 1, 0xfffffff0, 0xffc0000000 },
+		{ 8, 10, 10, 21, 0x800, 1, 0xfffffffc00, 0x3fe00000 },
+		{ 8, 12, 12, 14, 0x200, 1, 0xfffffff000, 0x1fc000 },
+	};
+	u32 B, C, st, hb, ha, ttbr;
+	int i, j;
+
+	B = agx->B = agx_alloc(agx, 0x8000, 0x4000);	/* RegionB */
+	C = agx->C = agx_alloc(agx, 0x10000, 0x4000);	/* RegionC */
+	/* Firmware mem-desc ring: {state, 256 entries of 0x14}. */
+	st = agx_alloc(agx, 0x4000, 0x4000);
+	put64(agx, st, fw_va(agx_alloc(agx, 0x100, 0x100)));
+	put64(agx, st + 8, fw_va(agx_alloc(agx, 0x100 * 0x14, 0x4000)));
+	/* 12 run queues, DevCtrl, Event, FWLog, KTrace, Stats */
+	for (i = 0; i < NR_CHANNELS; i++) {
+		agx->chan_state[i] = agx_alloc(agx, 0x100, 0x100);
+		agx->chan_ring[i] = agx_alloc(agx, rings[i], 0x4000);
+		put64(agx, B + i * 0x10, fw_va(agx->chan_state[i]));
+		put64(agx, B + i * 0x10 + 8, fw_va(agx->chan_ring[i]));
+	}
+	hb = agx_alloc(agx, 0x4000, 0x4000);
+	for (i = 0; i < ARRAY_SIZE(bufs); i++)
+		put64(agx, B + bufs[i].off, fw_va(agx_alloc(agx, bufs[i].size, 0x4000)));
+	put64(agx, B + 0x1a0, fw_va(hb));
+	put64(agx, B + 0x1a8, fw_va(hb));
+	ha = fw_off(get_unaligned_le64(agx->buf + B + 0x188));
+	agx->stats_cp = fw_off(get_unaligned_le64(agx->buf + B + 0x180));
+	agx->gen_fw = fw_off(get_unaligned_le64(agx->buf + B + 0x1b0));
+
+	/* hwdata B IO maps, 0x20 each: phys, fw va (firmware fills it), size, rw */
+	put64(agx, hb + 0x640, agx->fender);
+	put64(agx, hb + 0x650, 0x20000);
+	put32(agx, hb + 0x658, 1);
+	put64(agx, hb + 0x6a0, agx->sgx);
+	put64(agx, hb + 0x6b0, 0x20000);
+	put32(agx, hb + 0x6b8, 1);
+	/*
+	 * The firmware maps the others only when the PA is set (FUN_00028ad0)
+	 * but uses them anyway, so point them at scratch RAM.
+	 */
+	for (i = 0; i < ARRAY_SIZE(scratch_maps); i++) {
+		put64(agx, hb + scratch_maps[i], agx->pa + agx_alloc(agx, 0x8000, 0x4000));
+		put64(agx, hb + scratch_maps[i] + 0x10, 0x8000);
+		put32(agx, hb + scratch_maps[i] + 0x18, 1);
+	}
+	/* Real power mode: the firmware asks Fender for a perf state. */
+	put32(agx, hb + 0x958, 1);
+	put32(agx, hb + 0x960, 1);
+	/*
+	 * Sample periods in 24 MHz ticks, 16 ms. At 0 the power thread's
+	 * timers fire back to back and starve agx_background.
+	 */
+	put32(agx, hb + 0x988, 16000 * 24);
+	put32(agx, ha + 4, 16000 * 24);
+	/*
+	 * Power limits in pstate * 100; FUN_00013190 takes the lowest. Below
+	 * 100 the firmware duty-cycles the GPU and at 0 parks every job.
+	 * +0x770 and +0x820 pin the thermal and PPM limits.
+	 */
+	for (i = 0; i < ARRAY_SIZE(limits); i++)
+		put32(agx, (limits[i] > 0x2000 ? C : ha) + limits[i],
+		      (ARRAY_SIZE(mhz) - 1) * 100);
+	/* Highest pstate; the DVFS loop in FUN_00020b44 walks down from it. */
+	put32(agx, hb + 0xa6c, ARRAY_SIZE(mhz) - 1);
+	/* VA bases; power-up loads +0x18 into RGX 0x10000. */
+	put64(agx, hb, 0x1400000000);
+	put64(agx, hb + 8, 0xffc00000);
+	put64(agx, hb + 0x10, AGX_USC_BASE);
+	put64(agx, hb + 0x18, AGX_USC_BASE);
+	put64(agx, hb + 0x20, 0x18ffff8000);
+	/*
+	 * Unit masks for TA, 3D and CP, copied by FUN_000157b4. At 0 the
+	 * scheduler never finds a free unit.
+	 */
+	put32(agx, hb + 0x16d0, 3);
+	put32(agx, hb + 0x16d4, 7);
+	put32(agx, hb + 0x16d8, 1);
+	for (i = 0; i < ARRAY_SIZE(mhz); i++) {
+		put32(agx, hb + 0xa70 + 4 * i, mhz[i]);
+		for (j = 0; j < 8; j++) {
+			put32(agx, hb + 0xab0 + 0x20 * i + 4 * j, mv[i]);
+			put32(agx, hb + 0xcb0 + 0x20 * i + 4 * j, mv_sram[i]);
+		}
+	}
+
+	/*
+	 * Per-context TLB generations, page catalogues, and the contexts
+	 * FUN_00026338 loads at every power-up.
+	 */
+	agx->gen = agx_alloc(agx, 0x100, 0x100);
+	put64(agx, C + 0x9150, fw_va(agx->gen));
+	ttbr = agx_alloc(agx, 0x4000, 0x4000);
+	put64(agx, C + 0x9158, fw_va(ttbr));
+	/*
+	 * Every context gets an empty page catalogue now and is loaded at every
+	 * power-up (32 contexts per mask word), so a new VM only fills one in
+	 * and bumps its TLB generation.
+	 */
+	for (i = 0; i < AGX_NR_CTX; i++) {
+		/* 16K aligned: the firmware maps table pages to walk them */
+		agx->pc[i] = agx_alloc(agx, 0x1000, AGX_PAGE);
+		put64(agx, ttbr + i * 8, agx->pa + agx->pc[i]);
+		if (i >= AGX_FIRST_CTX)
+			put32(agx, C + 0x9160 + i / 32 * 4,
+			      get32(agx, C + 0x9160 + i / 32 * 4) | BIT(i % 32));
+	}
+	/*
+	 * Parameter manager free list descriptors, 16 bytes per buffer manager
+	 * slot. Power-up loads the GPU address into RGX 0x14430 (FUN_0000f72c);
+	 * the firmware fills entries through its own address.
+	 */
+	i = agx_alloc(agx, 0x1000, 0x1000);
+	put64(agx, B + 0x21c, AGX_CHUNK_GVA + i);
+	put64(agx, B + 0x224, fw_va(i));
+	/*
+	 * Trace job events only (bit 0); the main loop's and power thread's
+	 * periodic entries overwrite a hang's trail in seconds. Drained in
+	 * agx_drain().
+	 */
+	put32(agx, C, 0x1);
+	/* The first power-up installs the job handlers only when set. */
+	put32(agx, C + 0xb1cc, 1);
+
+	/* Mem-desc table: va, pa >> 12, 0, 16K pages, flags */
+	put_unaligned_le64(AGX_CHUNK_VA, table);
+	put_unaligned_le32(agx->pa >> 12, table + 8);
+	put_unaligned_le16(AGX_CHUNK_SIZE >> 14, table + 0x10);
+	put_unaligned_le16(1, table + 0x12);
+
+	put_unaligned_le64(fw_va(B), init + 3 * 8);
+	put_unaligned_le64(fw_va(C), init + 4 * 8);
+	put_unaligned_le64(fw_va(st), init + 5 * 8);
+	/* MMU format for the firmware's own walks (FUN_00026744) */
+	put_unaligned_le16(0x4000, init + 0x30);
+	*(u8 *)(init + 0x32) = 14;
+	*(u8 *)(init + 0x33) = ARRAY_SIZE(lv);
+	for (i = 0; i < ARRAY_SIZE(lv); i++) {
+		void *p = init + 0x34 + i * 0x20;
+
+		*(u8 *)p = lv[i].esz;
+		*(u8 *)(p + 1) = lv[i].pas;
+		*(u8 *)(p + 2) = lv[i].pas2;
+		*(u8 *)(p + 3) = lv[i].ish;
+		put_unaligned_le16(lv[i].n, p + 4);
+		put_unaligned_le16(0x4000, p + 6);
+		put_unaligned_le64(lv[i].valid, p + 8);
+		put_unaligned_le64(lv[i].pam, p + 0x10);
+		put_unaligned_le64(lv[i].im, p + 0x18);
+	}
+	put_unaligned_le64(table_pa, init + 0x13 * 8);
+	put_unaligned_le64(1, init + 0x14 * 8);
+}
+
+/* Event and KTrace: mark everything read, so the rings never fill. */
+static void agx_drain(struct agx_device *agx)
+{
+	static const struct { int ch; u32 count; } rings[] = {
+		{ CH_EVENT, 0x100 }, { CH_KTRACE, 0x200 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rings); i++) {
+		u32 st = agx->chan_state[rings[i].ch];
+		u32 w = READ_ONCE(*(u32 *)(agx->buf + st + 0x20));
+
+		if (w < rings[i].count)
+			WRITE_ONCE(*(u32 *)(agx->buf + st), w);
+	}
+}
+
+static void agx_doorbell(struct agx_device *agx, u32 ch)
+{
+	wmb();
+	apple_rtkit_send_message(agx->rtk, EP_INTS, MSG_DOORBELL | ch, NULL, false);
+}
+
+/*
+ * A command queue, CommandQueueInfo as in m1n1 with the context pointer at
+ * +0xa4. units is info+0x40: 1 sends 3D jobs to unit 2 only, which never
+ * finishes them, 0 to units 0 and 1.
+ */
+static void agx_queue(struct agx_device *agx, struct agx_fwq *q, u32 units)
+{
+	u32 ptrs, jl, gbuf, ctx, info;
+
+	ptrs = agx_alloc(agx, 0x100, 0x100);
+	q->ring = agx_alloc(agx, RING_SIZE * 8, 0x100);
+	jl = agx_alloc(agx, 0x100, 0x100);
+	gbuf = agx_alloc(agx, 0x4000, 0x4000);
+	ctx = agx_alloc(agx, 0x100, 0x100);
+	info = q->info = agx_alloc(agx, 0x100, 0x100);
+
+	put32(agx, ptrs + 0x50, RING_SIZE);
+	/* job list, a TAILQ head {first, last = &first} */
+	put64(agx, jl + 8, fw_va(jl));
+	*(u8 *)(agx->buf + ctx) = 0xff;
+	*(u8 *)(agx->buf + ctx + 1) = 0xff;
+	*(u8 *)(agx->buf + ctx + 5) = 1;
+	*(u8 *)(agx->buf + ctx + 0x1e) = 0xff;
+	*(u8 *)(agx->buf + ctx + 0x23) = 2;
+	put64(agx, info, fw_va(ptrs));
+	put64(agx, info + 8, fw_va(q->ring));
+	put64(agx, info + 0x10, fw_va(jl));
+	put64(agx, info + 0x18, fw_va(gbuf));
+	put32(agx, info + 0x2c, -1);
+	put64(agx, info + 0x38, 0xffffffffffff0000);
+	put32(agx, info + 0x40, units);
+	put32(agx, info + 0x48, 1);
+	put32(agx, info + 0x4c, -1);
+	put32(agx, info + 0x50, 0x1001);
+	put32(agx, info + 0x54, -1);
+	put64(agx, info + 0xa4, fw_va(ctx));
+}
+
+static void agx_push(struct agx_device *agx, struct agx_fwq *q, u32 cmd)
+{
+	put64(agx, q->ring + q->n++ % RING_SIZE * 8, fw_va(cmd));
+}
+
+/*
+ * The run message is {type, info, head, event, flush} on the queue's
+ * channel: FUN_000075fc stores head at info+0x28 and FUN_0001fb60 runs the
+ * ring up to it. Both rings hold RING_SIZE entries.
+ */
+static void agx_kick(struct agx_device *agx, struct agx_fwq *q, u32 ch, u32 ev)
+{
+	u32 st = agx->chan_state[ch], w = get32(agx, st + 0x20);
+	u32 msg = agx->chan_ring[ch] + w * 0x30;
+
+	memset(agx->buf + msg, 0, 0x30);
+	put32(agx, msg, ch);
+	put64(agx, msg + 4, fw_va(q->info));
+	put32(agx, msg + 0xc, q->n % RING_SIZE);
+	put32(agx, msg + 0x10, ev);
+	put32(agx, msg + 0x14, 1);
+	put32(agx, st + 0x20, (w + 1) % RING_SIZE);
+	agx_doorbell(agx, ch);
+}
+
+static const char *agx_fence_name(struct dma_fence *f)
+{
+	return "agx";
+}
+
+static const struct dma_fence_ops agx_fence_ops = {
+	.get_driver_name = agx_fence_name,
+	.get_timeline_name = agx_fence_name,
+};
+
+/*
+ * A compute command in MMU context ctx that runs the CDM control stream at
+ * GPU VA stream. args is a zeroed scratch page mapped in that context, for
+ * RGX 0x14020. Microsequence as the kext builds it (FUN_fffffff0084d0f08):
+ * StartCompute, wait for the CDM interrupt, finalize, end, which writes
+ * DONE_STAMP and raises event EV.
+ *
+ * The scheduler runs one job at a time, so this never overtakes a running
+ * one. Returns the job's fence, signalled by agx_complete().
+ */
+struct dma_fence *agx_fw_run(struct agx_device *agx, u32 ctx, u64 args, u64 stream)
+{
+	struct dma_fence *fence;
+	u32 n = agx->nr_cmds;
+	u32 cmd = agx->slot[n % NR_SLOTS].cmd, evc = agx->slot[n % NR_SLOTS].evc;
+	u32 useq = agx->slot[n % NR_SLOTS].useq;
+	u32 scratch = agx->slot[n % NR_SLOTS].scratch;
+	u32 fin = useq + 0x64 + 4;
+
+	/* After a timeout the firmware may still own a job slot. */
+	if (agx->wedged)
+		return ERR_PTR(-EIO);
+	fence = kzalloc(sizeof(*fence), GFP_KERNEL);
+	if (!fence)
+		return ERR_PTR(-ENOMEM);
+
+	memset(agx->buf + cmd, 0, 0x300);
+	memset(agx->buf + evc, 0, 0x100);
+	memset(agx->buf + useq, 0, 0x200);
+	memset(agx->buf + scratch, 0, 0x100);
+	put64(agx, scratch + 0x20, 1);			/* kick gate */
+
+	/* StartCompute, 0x64 bytes */
+	put32(agx, useq, 0x29);
+	put64(agx, useq + 4, fw_va(cmd + 0x1c));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x70));
+	put64(agx, useq + 0x14, fw_va(agx->stats_cp));
+	put64(agx, useq + 0x1c, fw_va(agx->cpq.info));
+	put32(agx, useq + 0x24, ctx);
+	put32(agx, useq + 0x2c, ctx);
+	put64(agx, useq + 0x3c, fw_va(cmd + 0x1fc));
+	put64(agx, useq + 0x4c, fw_va(cmd + 0x2d8));
+	put64(agx, useq + 0x5c, fw_va(scratch + 0x20));
+	/* wait for the CDM interrupt */
+	put32(agx, useq + 0x64, 0x41);
+	/* finalize, 0x44 bytes */
+	put32(agx, fin, 0x2a);
+	put64(agx, fin + 4, fw_va(agx->stats_cp));
+	put64(agx, fin + 0xc, fw_va(agx->cpq.info));
+	put32(agx, fin + 0x14, ctx);
+	put64(agx, fin + 0x18, fw_va(cmd + 0x1fc));
+	put64(agx, fin + 0x28, fw_va(scratch + 8));
+	put32(agx, fin + 0x30, 1);
+	put32(agx, fin + 0x38, -(0x64 + 4));
+	put64(agx, fin + 0x3c, fw_va(cmd + 0x2d8));
+	/* end */
+	put32(agx, fin + 0x44, 0x18 | 0x40 << 24);
+
+	put32(agx, cmd, 3);
+	put32(agx, cmd + 0x10, ctx);
+	put64(agx, cmd + 0x14, fw_va(evc));
+	/* event control: +0 points at the counter finalize bumps */
+	put64(agx, evc, fw_va(scratch + 8));
+	put64(agx, cmd + 0x70, args);
+	put64(agx, cmd + 0x78, stream);
+	put64(agx, cmd + 0x1f0, fw_va(useq));
+	put32(agx, cmd + 0x1f8, fin + 0x48 - useq);
+	/* completion stamp {target, ?, value, event} */
+	put64(agx, cmd + 0x278, fw_va(scratch + 0x10));
+	put32(agx, cmd + 0x288, DONE_STAMP);
+	put32(agx, cmd + 0x28c, EV);
+
+	dma_fence_init(fence, &agx_fence_ops, &agx->fence_lock, agx->fence_ctx,
+		       ++agx->fence_seqno);
+	spin_lock_irq(&agx->fence_lock);
+	agx->active = dma_fence_get(fence);
+	agx->active_stamp = scratch + 0x10;
+	spin_unlock_irq(&agx->fence_lock);
+
+	agx->nr_cmds++;
+	agx_push(agx, &agx->cpq, cmd);
+	agx_kick(agx, &agx->cpq, CH_CP, EV);
+	return fence;
+}
+
+/*
+ * Render: a TA (tiling) job on the TA queue, then a 3D (fragment) job on the
+ * 3D queue, kicked by agx_complete() once the TA stamp lands. Both use one
+ * buffer manager (the parameter manager's heap) and one tiling buffer set
+ * sized for the largest target, in the chunk, which every context maps at
+ * AGX_CHUNK_GVA. Layouts: kext FUN_fffffff0084d22c8 (TA registers),
+ * FUN_fffffff0084cd07c (3D registers), firmware FUN_00017018 (microsequence).
+ */
+#define RN_MAX_W	2048
+#define RN_MAX_H	4096
+#define RN_PAGES	256		/* 4K heap pages, in 128K blocks */
+#define RN_BLOCKS	(RN_PAGES / 32)
+#define RN_MAX_BLOCKS	64
+
+static u64 gva(u32 o)
+{
+	return AGX_CHUNK_GVA + o;
+}
+
+struct rn_tiling {
+	u32 tiles_x, tiles_y, tpm_x, tpm_y, tpm, rgn, rgn_pages, tpc_pages;
+};
+
+/*
+ * G11 tiling parameters, kext AGXRenderTargetMemoryG11 (FUN_fffffff0084d1ce0),
+ * 32x32 pixel tiles: rgn is the region headers per layer in dwords (5 per
+ * macrotile utile), rgn_pages and tpc_pages the region array and the TPC
+ * per layer in 4K pages (0x50 and 0x80 bytes per macrotile utile).
+ */
+static void rn_tiling(u32 w, u32 h, u32 uw, u32 uh, struct rn_tiling *t)
+{
+	u32 upt = (32 / uw) * (32 / uh);
+
+	t->tiles_x = DIV_ROUND_UP(w, 32);
+	t->tiles_y = DIV_ROUND_UP(h, 32);
+	t->tpm_x = ALIGN(DIV_ROUND_UP(t->tiles_x, 4), 4);
+	t->tpm_y = ALIGN(DIV_ROUND_UP(t->tiles_y, 4), 4);
+	t->tpm = t->tpm_x * t->tpm_y;
+	t->rgn = 5 * t->tpm * upt / 4;
+	t->rgn_pages = DIV_ROUND_UP(0x50 * t->tpm * upt, SZ_4K);
+	t->tpc_pages = DIV_ROUND_UP(0x80 * t->tpm * upt, SZ_4K);
+}
+
+static void agx_render_init(struct agx_device *agx)
+{
+	struct rn_tiling t;
+	u32 bmd, bms, pages, plist, blist, bctl, i;
+
+	rn_tiling(RN_MAX_W, RN_MAX_H, 16, 16, &t);
+	agx->rn.ta = agx_alloc(agx, 0x900, 0x100);	/* cmd, evc +0x600, useq +0x700 */
+	agx->rn.frag = agx_alloc(agx, 0xd00, 0x100);	/* cmd, evc +0xa00, useq +0xb00 */
+	agx->rn.scratch = agx_alloc(agx, 0x100, 0x100);
+	agx->rn.init = agx_alloc(agx, 0x40, 0x40);
+	agx->rn.tilemap = agx_alloc(agx, t.rgn_pages * SZ_4K, AGX_PAGE);
+	agx->rn.tpc = agx_alloc(agx, t.tpc_pages * SZ_4K, AGX_PAGE);
+	agx->rn.heapmeta = agx_alloc(agx, AGX_PAGE, AGX_PAGE);
+	agx->rn.pre = agx_alloc(agx, 3 * AGX_PAGE, AGX_PAGE);
+	bmd = agx->rn.bmd = agx_alloc(agx, 0x100, 0x100);
+	bms = agx->rn.bms = agx_alloc(agx, 0x100, 0x100);
+	plist = agx_alloc(agx, RN_MAX_BLOCKS * 32 * 4, AGX_PAGE);
+	pages = agx_alloc(agx, RN_PAGES * SZ_4K, SZ_128K);
+	blist = agx_alloc(agx, 0x20 * RN_MAX_BLOCKS, 0x100);
+	bctl = agx_alloc(agx, 0x40, 0x40);
+
+	/*
+	 * The firmware expands the block list into the page list: each 0x20
+	 * byte entry is eight 16K chunks of a 128K block, PA >> 12.
+	 */
+	for (i = 0; i < RN_BLOCKS * 8; i++)
+		put32(agx, blist + i * 4, (agx->pa + pages) / SZ_4K + i * 4);
+	put32(agx, bctl, RN_BLOCKS);
+	put32(agx, bctl + 4, RN_BLOCKS);
+
+	/* Buffer manager descriptor: Asahi's BufferManagerInfo without unk_1c. */
+	put32(agx, bmd + 0xc, -1);
+	put64(agx, bmd + 0x1c, gva(plist));
+	put32(agx, bmd + 0x24, RN_MAX_BLOCKS * 32 * 4);
+	/* the block ring wraps at max_blocks, so it must exceed the count */
+	put32(agx, bmd + 0x2c, RN_MAX_BLOCKS);
+	put64(agx, bmd + 0x38, gva(blist));
+	put64(agx, bmd + 0x40, fw_va(bctl));
+	/* G11 kext (FUN_fffffff0084df7dc): +0x48 -1, +0x58 the page size */
+	put32(agx, bmd + 0x48, -1);
+	put32(agx, bmd + 0x58, SZ_16K);
+	put64(agx, bmd + 0x64, fw_va(agx_alloc(agx, 0x40, 0x40)));
+	put32(agx, bmd + 0x7c, 1);
+	put32(agx, bmd + 0x80, RN_MAX_BLOCKS * 32);
+	put32(agx, bmd + 0x84, RN_MAX_BLOCKS * 32);
+
+	/*
+	 * Buffer manager slot 0, which is Asahi's Scene too: PM state buffers
+	 * at +0xa0..+0xb0, stats at +0xbc (zeroed at every 3D retire).
+	 */
+	/* MTileArray, MList and VHeap table (kext "Parameter Scene Allocations") */
+	put64(agx, bms + 0xa0, gva(agx_alloc(agx, SZ_64K, AGX_PAGE)));
+	put64(agx, bms + 0xa8, gva(agx_alloc(agx, SZ_64K, AGX_PAGE)));
+	put64(agx, bms + 0xb0, gva(agx_alloc(agx, SZ_64K, AGX_PAGE)));
+	put64(agx, bms + 0xbc, fw_va(agx_alloc(agx, 0x100, 0x40)));
+}
+
+int agx_fw_render_check(const struct drm_asahi_cmd_render *r)
+{
+	if (r->flags & ~(DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES |
+			 DRM_ASAHI_RENDER_NO_VERTEX_CLUSTERING |
+			 DRM_ASAHI_RENDER_DBIAS_IS_INT))
+		return -EINVAL;
+	if (r->vertex_helper.binary || r->fragment_helper.binary || r->layers != 1 ||
+	    !r->width_px || r->width_px > RN_MAX_W || !r->height_px ||
+	    r->height_px > RN_MAX_H || !r->vdm_ctrl_stream_base)
+		return -EINVAL;
+	if ((r->utile_width_px != 16 && r->utile_width_px != 32) ||
+	    (r->utile_height_px != 16 && r->utile_height_px != 32) ||
+	    (r->samples != 1 && r->samples != 2 && r->samples != 4))
+		return -EINVAL;
+	return 0;
+}
+
+static u32 rn_stats(struct agx_device *agx, u32 off)
+{
+	return fw_off(get_unaligned_le64(agx->buf + agx->B + off));
+}
+
+/* TA command, 0x5e0, and its microsequence: StartTA, wait, FinalizeTA, end. */
+static void rn_ta(struct agx_device *agx, u32 ctx, const struct drm_asahi_cmd_render *r,
+		  const struct rn_tiling *t, u64 utile)
+{
+	u32 cmd = agx->rn.ta, evc = cmd + 0x600, useq = cmd + 0x700;
+	u32 sc = agx->rn.scratch, bmd = agx->rn.bmd, bms = agx->rn.bms;
+	u32 stats = rn_stats(agx, 0x170) + 4, fin = useq + 0x88, i;
+	const u64 r64[] = {
+		0x200, 0x1e3ce5081e3ce508, gva(agx->rn.tilemap), gva(agx->rn.tpc), utile,
+		r->ppp_multisamplectl, gva(agx->rn.heapmeta),
+		gva(agx->rn.pre), gva(agx->rn.pre + AGX_PAGE), 1,
+		gva(agx->rn.pre + 2 * AGX_PAGE), r->vdm_ctrl_stream_base, 0,
+	};
+	const u32 r32[] = {
+		t->rgn_pages | 0x20000, 0x88, r->ppp_ctrl | 2,
+		(r->width_px - 1) | (r->height_px - 1) << 16,
+		(t->tiles_y - 1) << 12 | (t->tiles_x - 1),
+		3 * t->tpm_x | 2 * t->tpm_x << 9 | t->tpm_x << 18,
+		3 * t->tpm_y | 2 * t->tpm_y << 9 | t->tpm_y << 18,
+		t->tpm, t->tpc_pages, 0x100, 0x8000,
+	};
+
+	memset(agx->buf + cmd, 0, 0x900);
+	for (i = 0; i < ARRAY_SIZE(r64); i++)
+		put64(agx, cmd + 0x40 + 8 * i, r64[i]);
+	for (i = 0; i < ARRAY_SIZE(r32); i++)
+		put32(agx, cmd + 0x3c4 + 4 * i, r32[i]);
+
+	put32(agx, cmd, 0);			/* TA */
+	put32(agx, cmd + 0xc, ctx);
+	put64(agx, cmd + 0x14, fw_va(evc));
+	put32(agx, cmd + 0x1c, 0);		/* buffer manager slot */
+	put64(agx, cmd + 0x24, fw_va(bmd));
+	put64(agx, cmd + 0x2c, fw_va(bms));
+	put64(agx, evc, fw_va(sc + 8));
+	/* stamp record {target, ?, value, event}, retired by FUN_0000d704 */
+	put64(agx, cmd + 0x560, fw_va(sc));
+	put64(agx, cmd + 0x568, fw_va(sc));
+	put32(agx, cmd + 0x570, DONE_STAMP);
+	*(u8 *)(agx->buf + cmd + 0x574) = EV_TA;
+	put32(agx, cmd + 0x580, EV_TA);
+
+	/* StartTA, 0x84 bytes */
+	put32(agx, useq, 0x22);
+	put64(agx, useq + 0x4, fw_va(cmd + 0x3c4));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x40));
+	put64(agx, useq + 0x14, fw_va(bmd));
+	put64(agx, useq + 0x1c, fw_va(bms));
+	put64(agx, useq + 0x24, fw_va(stats));
+	put64(agx, useq + 0x2c, fw_va(agx->taq.info));
+	put32(agx, useq + 0x34, ctx);
+	put32(agx, useq + 0x3c, ctx);
+	put64(agx, useq + 0x54, fw_va(cmd + 0x488));
+	put64(agx, useq + 0x5c, fw_va(cmd + 0x58c));
+	put32(agx, useq + 0x6c, 4);
+	put64(agx, useq + 0x78, fw_va(sc + 0x20));	/* kick gate */
+	/* wait for the TA interrupt */
+	put32(agx, useq + 0x84, 0x40001);
+	/* FinalizeTA, 0x54 bytes */
+	put32(agx, fin, 0x23);
+	put64(agx, fin + 0x4, fw_va(bms));
+	put64(agx, fin + 0xc, fw_va(bmd));
+	put64(agx, fin + 0x14, fw_va(stats));
+	put64(agx, fin + 0x1c, fw_va(agx->taq.info));
+	put32(agx, fin + 0x24, ctx);
+	put64(agx, fin + 0x2c, fw_va(cmd + 0x488));
+	put32(agx, fin + 0x38, 4);
+	/*
+	 * The event control counter: FUN_0000d704 unlinks the event control
+	 * from the queue's list once it equals evc+0xc (1 after job start)
+	 * and only then may the structures be reused.
+	 */
+	put64(agx, fin + 0x3c, fw_va(sc + 8));
+	put32(agx, fin + 0x44, 1);
+	put32(agx, fin + 0x4c, -(0x84 + 4));
+	/* end */
+	put32(agx, fin + 0x54, 0x18 | 0x40 << 24);
+	put64(agx, cmd + 0x474, fw_va(useq));
+	put32(agx, cmd + 0x47c, fin + 0x58 - useq);
+}
+
+/* 3D command, 0x940: Start3D, wait, Finalize3D, end. */
+static void rn_frag(struct agx_device *agx, u32 ctx, const struct drm_asahi_cmd_render *r,
+		    const struct rn_tiling *t, u64 utile)
+{
+	u32 cmd = agx->rn.frag, evc = cmd + 0xa00, useq = cmd + 0xb00;
+	u32 sc = agx->rn.scratch, bms = agx->rn.bms;
+	u32 stats = rn_stats(agx, 0x178) + 8, fin = useq + 0xa8, i;
+	u32 tib = DIV_ROUND_UP(r->utile_width_px * r->utile_height_px * r->samples *
+			       r->sample_size_B, 2048);
+	const u64 r64[] = {
+		utile, r->bg.rsrc_spec, r->bg.usc, r->ppp_multisamplectl,
+		r->isp_scissor_base, r->isp_dbias_base, 0,
+		/* G13 AuxFBInfo: isp_ctl, 0, width, height */
+		0xc000 | (r->flags & DRM_ASAHI_RENDER_DBIAS_IS_INT),
+		(u64)r->height_px << 32 | r->width_px, 0,
+		r->isp_zls_pixels, r->isp_oclqry_base & ~0xfULL, r->zls_ctrl,
+		r->depth.base, r->depth.base, r->stencil.base, r->stencil.base,
+		r->depth.stride, r->depth.stride, r->stencil.stride, r->stencil.stride,
+		r->depth.comp_base, r->depth.comp_stride,
+		r->depth.comp_base, r->depth.comp_stride,
+		r->stencil.comp_base, r->stencil.comp_stride,
+		r->stencil.comp_base, r->stencil.comp_stride,
+		gva(agx->rn.tilemap), gva(agx->rn.heapmeta),
+		/* region headers in dwords, region size in pages */
+		t->rgn | (u64)t->rgn_pages << 32,
+		0x280 | (r->flags & DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES ? 0x10000 : 0), 0,
+	};
+	const u32 r32[] = {
+		r->eot.rsrc_spec, r->eot.usc, 0, 0, r->isp_merge_upper_x,
+		r->isp_merge_upper_y, 0, 0, 0, tib, r->isp_bgobjdepth, r->isp_bgobjvals,
+		/* kext constants 0xfffffff0070cd8a0 */
+		0x1f, 0, 0, 1, 0,
+	};
+
+	memset(agx->buf + cmd, 0, 0xd00);
+	for (i = 0; i < ARRAY_SIZE(r64); i++)
+		put64(agx, cmd + 0x80 + 8 * i, r64[i]);
+	for (i = 0; i < ARRAY_SIZE(r32); i++)
+		put32(agx, cmd + 0x3c8 + 4 * i, r32[i]);
+
+	put32(agx, cmd, 1);			/* 3D */
+	put32(agx, cmd + 0xc, ctx);
+	put64(agx, cmd + 0x20, fw_va(evc));
+	put64(agx, cmd + 0x28, fw_va(agx->rn.bmd));
+	put64(agx, cmd + 0x30, fw_va(bms));	/* scene, read on retire */
+	put64(agx, evc, fw_va(sc + 0x48));
+	put64(agx, cmd + 0x8c4, fw_va(sc + 0x40));
+	put64(agx, cmd + 0x8cc, fw_va(sc + 0x40));
+	put32(agx, cmd + 0x8d4, DONE_STAMP);
+	*(u8 *)(agx->buf + cmd + 0x8d8) = EV_3D;
+	put32(agx, cmd + 0x8e4, EV_3D);
+
+	/* Start3D, 0xa4 bytes */
+	put32(agx, useq, 0x24);
+	put64(agx, useq + 0x4, fw_va(cmd + 0x3c8));
+	put64(agx, useq + 0xc, fw_va(cmd + 0x80));
+	put64(agx, useq + 0x14, fw_va(bms));
+	put64(agx, useq + 0x1c, fw_va(stats));
+	put64(agx, useq + 0x24, fw_va(cmd + 0x888));
+	put64(agx, useq + 0x2c, fw_va(cmd + 0x88c));
+	put64(agx, useq + 0x34, fw_va(cmd + 0x8b8));
+	put64(agx, useq + 0x3c, fw_va(agx->fragq.info));
+	put64(agx, useq + 0x44, fw_va(cmd));
+	put32(agx, useq + 0x4c, ctx);
+	put32(agx, useq + 0x54, ctx);
+	put64(agx, useq + 0x6c, fw_va(cmd + 0x770));
+	put64(agx, useq + 0x74, fw_va(cmd + 0x8f0));
+	put32(agx, useq + 0x90, EV_3D);
+	put64(agx, useq + 0x9c, fw_va(sc + 0x60));	/* kick gate */
+	/* wait for the 3D interrupt */
+	put32(agx, useq + 0xa4, 0x401);
+	/* Finalize3D, 0x7c bytes */
+	put32(agx, fin, 0x25);
+	put32(agx, fin + 0x4, EV_3D);
+	put64(agx, fin + 0xc, fw_va(sc + 0x48));	/* event control counter */
+	put32(agx, fin + 0x14, 1);
+	put64(agx, fin + 0x1c, fw_va(bms));
+	put64(agx, fin + 0x24, fw_va(sc + 0x80));
+	put64(agx, fin + 0x2c, 1);
+	put64(agx, fin + 0x34, fw_va(stats));
+	put64(agx, fin + 0x3c, fw_va(cmd + 0x8b8));
+	put64(agx, fin + 0x44, fw_va(cmd + 0x888));
+	put64(agx, fin + 0x4c, fw_va(agx->fragq.info));
+	put64(agx, fin + 0x54, fw_va(cmd));
+	put32(agx, fin + 0x5c, ctx);
+	put64(agx, fin + 0x64, fw_va(cmd + 0x770));
+	put32(agx, fin + 0x78, -(0xa4 + 4));
+	/* end */
+	put32(agx, fin + 0x7c, 0x18 | 0x40 << 24);
+	put64(agx, cmd + 0x14, fw_va(useq));
+	put32(agx, cmd + 0x1c, fin + 0x80 - useq);
+}
+
+/*
+ * Queue the TA job behind an InitBuffer. The 3D job waits in its ring until
+ * agx_complete() sees the TA stamp.
+ */
+struct dma_fence *agx_fw_render(struct agx_device *agx, u32 ctx,
+				const struct drm_asahi_cmd_render *r)
+{
+	struct dma_fence *fence;
+	struct rn_tiling t;
+	u32 sc = agx->rn.scratch, init = agx->rn.init;
+	u64 utile = (r->utile_width_px / 16) << 12 | (r->utile_height_px / 16) << 14 |
+		    ilog2(r->samples);
+
+	if (agx->wedged)
+		return ERR_PTR(-EIO);
+	fence = kzalloc(sizeof(*fence), GFP_KERNEL);
+	if (!fence)
+		return ERR_PTR(-ENOMEM);
+
+	rn_tiling(r->width_px, r->height_px, r->utile_width_px, r->utile_height_px, &t);
+	memset(agx->buf + sc, 0, 0x100);
+	put64(agx, sc + 0x20, 1);
+	put64(agx, sc + 0x60, 1);
+	rn_ta(agx, ctx, r, &t, utile);
+	rn_frag(agx, ctx, r, &t, utile);
+
+	dma_fence_init(fence, &agx_fence_ops, &agx->fence_lock, agx->fence_ctx,
+		       ++agx->fence_seqno);
+	spin_lock_irq(&agx->fence_lock);
+	agx->active = dma_fence_get(fence);
+	agx->active_stamp = sc + 0x40;
+	agx->rn.frag_pending = true;
+	spin_unlock_irq(&agx->fence_lock);
+
+	/*
+	 * InitBuffer {6, ctx, slot, start, flag, descriptor, stamp} before every
+	 * TA job.
+	 */
+	memset(agx->buf + init, 0, 0x40);
+	put32(agx, init, 6);
+	put32(agx, init + 4, ctx);
+	put64(agx, init + 0x14, fw_va(agx->rn.bmd));
+	put32(agx, init + 0x1c, DONE_STAMP);
+	agx_push(agx, &agx->taq, init);
+	agx_push(agx, &agx->taq, agx->rn.ta);
+	agx_push(agx, &agx->fragq, agx->rn.frag);
+	agx_kick(agx, &agx->taq, CH_TA, EV_TA);
+	return fence;
+}
+
+/*
+ * Signal the running job's fence if its stamp has landed, or kick a
+ * render's 3D job once its TA job is done.
+ */
+static bool agx_complete(struct agx_device *agx)
+{
+	struct dma_fence *fence = NULL;
+	unsigned long flags;
+	bool kick = false;
+
+	spin_lock_irqsave(&agx->fence_lock, flags);
+	if (agx->rn.frag_pending &&
+	    READ_ONCE(*(u32 *)(agx->buf + agx->rn.scratch)) == DONE_STAMP) {
+		agx->rn.frag_pending = false;
+		kick = true;
+	} else if (agx->active &&
+	    READ_ONCE(*(u32 *)(agx->buf + agx->active_stamp)) == DONE_STAMP) {
+		dma_rmb();
+		fence = agx->active;
+		agx->active = NULL;
+		dma_fence_signal_locked(fence);
+	}
+	spin_unlock_irqrestore(&agx->fence_lock, flags);
+	if (kick)
+		agx_kick(agx, &agx->fragq, CH_3D, EV_3D);
+	if (fence)
+		dma_fence_put(fence);
+	return fence;
+}
+
+/*
+ * The running job timed out. The firmware cannot be reset, so unless the
+ * job finished unnoticed this fails it and every later one.
+ */
+/*
+ * The last firmware trace entries other than the power thread's, which
+ * otherwise overwrite a hang's trail in seconds. Entries are {5, u64 ts,
+ * 4 x u64 args, code | thread << 24, arg}, 0x38 bytes, 0x200 of them.
+ */
+static void agx_dump_trace(struct agx_device *agx)
+{
+	u32 w = get32(agx, agx->chan_state[CH_KTRACE] + 0x20), i, n = 0;
+
+	for (i = 1; i < 0x200 && n < 24; i++) {
+		u32 e = agx->chan_ring[CH_KTRACE] + (w + 0x200 - i) % 0x200 * 0x38;
+		u32 code = get32(agx, e + 0x2c);
+
+		/* skip the power thread and the main loop's idle entries */
+		if (get32(agx, e) != 5 || code >> 24 == 3 ||
+		    (code >> 24 == 1 && ((code & 0xfffffe) == 0x100 ||
+					 (code & 0xfffffe) == 0x104 ||
+					 (code & 0xffffff) == 0x106 ||
+					 (code & 0xffffff) == 0x112 ||
+					 (code & 0xffffff) == 0x11a)))
+			continue;
+		dev_err(agx->dev, "trace %#x thr %u: %llx %llx %llx %llx\n",
+			code & 0xffffff, code >> 24,
+			get_unaligned_le64(agx->buf + e + 0xc),
+			get_unaligned_le64(agx->buf + e + 0x14),
+			get_unaligned_le64(agx->buf + e + 0x1c),
+			get_unaligned_le64(agx->buf + e + 0x24));
+		n++;
+	}
+}
+
+void agx_fw_timeout(struct agx_device *agx)
+{
+	struct dma_fence *fence;
+	u64 st;
+
+	if (agx_complete(agx)) {
+		dev_warn(agx->dev, "job finished without an event\n");
+		return;
+	}
+	st = readq(agx->rgx + RGX_MMU_FAULT_STATUS);
+	dev_err(agx->dev,
+		"job timed out, GPU wedged; MMU fault %#llx: VA %#llx ctx %llu requester %llu %s type %llu\n",
+		st, (st >> 24) & ~0x3fULL, (st >> 16) & 0x3f, (st >> 8) & 0xff,
+		st & BIT(4) ? "read" : "write", (st >> 1) & 7);
+	if (agx->rn.frag_pending)
+		dev_err(agx->dev, "render stuck in its TA job\n");
+	agx_dump_trace(agx);
+	agx->wedged = true;
+	spin_lock_irq(&agx->fence_lock);
+	agx->rn.frag_pending = false;
+	fence = agx->active;
+	agx->active = NULL;
+	if (fence) {
+		dma_fence_set_error(fence, -ETIMEDOUT);
+		dma_fence_signal_locked(fence);
+	}
+	spin_unlock_irq(&agx->fence_lock);
+	if (fence)
+		dma_fence_put(fence);
+}
+
+static int agx_shmem_setup(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	struct agx_device *agx = cookie;
+	int i;
+
+	/* Address 0 asks the host to pick one. */
+	if (!bfr->iova) {
+		bfr->buffer = dmam_alloc_coherent(agx->dev, bfr->size, &bfr->iova,
+						  GFP_KERNEL);
+		return bfr->buffer ? 0 : -ENOMEM;
+	}
+
+	for (i = 0; i < agx->nsegs; i++) {
+		u64 iova = le64_to_cpu(agx->segs[i].iova);
+		u32 size = le32_to_cpu(agx->segs[i].size);
+
+		if (bfr->iova < iova || bfr->iova + bfr->size > iova + size)
+			continue;
+
+		bfr->buffer = devm_memremap(agx->dev, le64_to_cpu(agx->segs[i].phys) +
+					    bfr->iova - iova, bfr->size, MEMREMAP_WB);
+		return PTR_ERR_OR_ZERO(bfr->buffer);
+	}
+
+	dev_warn(agx->dev, "refusing buffer of %#zx bytes at %pad\n", bfr->size,
+		 &bfr->iova);
+	return -ENOMEM;
+}
+
+/*
+ * devm frees and unmaps the buffers with the device. Without this rtkit
+ * would dma_free_coherent() them itself.
+ */
+static void agx_shmem_destroy(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+}
+
+static void agx_recv(void *cookie, u8 ep, u64 msg)
+{
+	struct agx_device *agx = cookie;
+
+	/* 0x42 only says "check the channels"; a job's end is one reason. */
+	if (msg == MSG_CHECK && READ_ONCE(agx->ready)) {
+		agx_drain(agx);
+		agx_complete(agx);
+	} else if (msg != MSG_CHECK)
+		dev_info(agx->dev, "ep %#x: %#018llx\n", ep, msg);
+}
+
+static void agx_crashed(void *cookie, const void *log, size_t size)
+{
+	struct agx_device *agx = cookie;
+
+	dev_err(agx->dev, "firmware crashed\n");
+}
+
+const struct apple_rtkit_ops agx_rtk_ops = {
+	.crashed = agx_crashed,
+	.recv_message = agx_recv,
+	.shmem_setup = agx_shmem_setup,
+	.shmem_destroy = agx_shmem_destroy,
+};
+
+static int agx_dbg_show(struct seq_file *m, void *v)
+{
+	struct agx_device *agx = m->private;
+	int i;
+
+	seq_printf(m, "pa %pad va %#llx gva %#llx size %#x free %#x\n", &agx->pa,
+		   AGX_CHUNK_VA, AGX_CHUNK_GVA, AGX_CHUNK_SIZE, agx->off);
+	seq_printf(m, "B %#x C %#x info %#x\n", agx->B, agx->C, agx->cpq.info);
+	for (i = 0; i < ARRAY_SIZE(agx->chan_state); i++)
+		seq_printf(m, "chan %d state %#x ring %#x\n", i, agx->chan_state[i],
+			   agx->chan_ring[i]);
+	seq_printf(m, "ctx %*pb\n", AGX_NR_CTX, agx->ctx_used);
+	seq_printf(m, "rn ta %#x frag %#x\n", agx->rn.ta, agx->rn.frag);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(agx_dbg);
