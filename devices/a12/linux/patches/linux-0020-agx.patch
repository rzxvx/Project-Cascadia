+++ b/drivers/gpu/drm/agx/agx_21b91_queue.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef AGX_21B91_QUEUE_H
+#define AGX_21B91_QUEUE_H
+#include "agx-21b91-layout.h"
+struct agx21_memory;
+struct agx21_render_staging;
+/* Native AGXChannel::initializeSharedState 0x8428730. Constructs queue header,
+ * pointer block and empty retirement list using already owned allocations.
+ * +18 references the embedded buffer at queue VA+0xb0, not a separate
+ * allocation. Context contents are initialized separately below.
+ */
+int agx21_queue_initialize(struct agx21_memory *memory);
+/* Construct two unpublished, separately owned TA/3D queue headers from the
+ * same native base layout as CP. Does not select a runtime queue policy,
+ * publish a render channel, or submit work. */
+int agx21_queue_initialize_render_staging(struct agx21_memory *memory,
+ const struct agx21_render_staging *ids);
+/* Host-only BadApple scheduling candidate: priority zero, TA units 1,
+ * 3D units 0. This is NOT native J171 runtime-policy proof. */
+int agx21_queue_stage_render_policy_candidate(struct agx21_memory *memory);
+/* Native AGXArmFirmware::setQueuePriority (0x845541c) is called through
+ * AGXChannel::setPriority (0x842894c) after the initializer's priority-4
+ * sentinel. Only priority 0 is used by the isolated first-job probe.
+ */
+int agx21_queue_set_test_priority_zero(struct agx21_memory *memory,u32 flags);
+/* Native parent context defaults. Caller supplies the client policy byte;
+ * do not copy the older Asahi context defaults at offsets 0x1e/0x23. */
+int agx21_queue_context_initialize(struct agx21_memory *memory,u8 native_policy);
+/* AGXCommandBuffer::init (0x842dd10): first 192-byte event-control slot
+ * points at its separate, zeroed u32 event counter. This constructs an
+ * unpublished object only; it does not assert native event-list readiness.
+ */
+int agx21_event_control_initialize(struct agx21_memory *memory);
+/* AGXCommandBuffer::nextEventControl (0x842d814): clear one 192-byte slot,
+ * reset its counter, then set sequence, explicit native budget and gate=-1.
+ * The caller must obtain budget from the iPad policy; do not infer it from
+ * XS/A13 or a synthetic host test. No firmware publication occurs here.
+ */
+int agx21_event_control_arm(struct agx21_memory *memory,u32 sequence,u32 budget);
+#endif
diff --git a/drivers/gpu/drm/agx/agx_21b91_transport.c b/drivers/gpu/drm/agx/agx_21b91_transport.c
new file mode 100644
index 0000000..29cee5a
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_21b91_transport.c
@@ -0,0 +1,1445 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/* J171/21B91 firmware backend. Shares the DRM uAPI with XS, but owns
+ * its InitData, command layouts, memory and RTKit lifecycle independently.
+ * No probe-time GPU jobs or diagnostic test ioctls. Firmware cannot restart.
+ */
+#include <linux/atomic.h>
+#include <clocksource/arm_arch_timer.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/overflow.h>
+#include <linux/platform_device.h>
+#include <linux/printk.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_file.h>
+#include <drm/drm_ioctl.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_syncobj.h>
+#include <linux/dma-fence.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+#include <linux/uaccess.h>
+#include "agx_21b91_power.h"
+#include "agx_21b91_dma.h"
+#include "agx_21b91_queue.h"
+#include "agx_21b91_controller.h"
+#include "agx_21b91_hwdata.h"
+#include "agx_21b91_init.h"
+#include "agx_21b91_protocol.h"
+#include "agx.h"
+#include "agx-21b91-layout.h"
+#include "agx-21b91-microseq.h"
+
+#define AGX21_ASC_CONTROL 0x44
+#define AGX21_ASC_RUN BIT(4)
+#define AGX21_MAX_SHARED SZ_4M
+#define AGX21_CRASHLOG_MAX SZ_16K
+/* Live J171a ADT /arm-io/sgx meta-sw-interrupt[0], 21B91. The kernel's
+ * configure-device path copies this first qword into its IO-map input.
+ * A DT property may override it for a separately captured board revision. */
+#define AGX21_J171_SW_INTERRUPT_PA 0x23b104028ULL
+
+/* Diagnostics are opt-in; neither switch submits GPU work. */
+static bool agx21_render_diag;
+module_param_named(j171_render_diag, agx21_render_diag, bool, 0600);
+MODULE_PARM_DESC(j171_render_diag, "J171 command/queue/event diagnostics (default off)");
+static bool agx21_fault_probe;
+module_param_named(j171_fault_probe, agx21_fault_probe, bool, 0400);
+MODULE_PARM_DESC(j171_fault_probe, "Optional powered MMIO fault sample; off unless explicitly requested");
+/* Captured J171/21B91 G11 B0 capabilities, never applied to XS. */
+static const unsigned int agx21_g11_revision = 3;
+static const unsigned int agx21_gtp_slots = 2;
+static const unsigned int agx21_frg_slots = 3;
+
+struct agx21_segment {
+	__le64 phys, iova, remap;
+	__le32 size, flags;
+} __packed;
+
+
+struct agx21_transport {
+	struct device *dev;
+	struct agx_device *asahi;
+	struct mutex asahi_lock;
+	struct agx21_protocol asahi_protocol;
+	struct apple_rtkit *rtk;
+	struct agx21_dma_owner *owner;
+	void __iomem *asc;
+	void __iomem *pmgr_diag;
+	void __iomem *volman_diag;
+	void __iomem *fender_diag;
+	void __iomem *rgx_fault_diag;
+	const struct agx21_segment *segments;
+	unsigned int nsegments;
+	atomic_t crashed, messages;
+	atomic_t check_messages;
+	struct delayed_work check_work;
+	bool check_ready;
+	const char *stage;
+	int error;
+	size_t allocated;
+	u32 control_before, control_after;
+	u32 init_status;
+	bool init_attempted;
+	bool control_consumed;
+	bool compute_sent, compute_completed, compute_verified, compute_two_verified;
+	bool render_attempted;
+	bool render_failed;
+	u32 render_completed;
+	atomic_t user_submit_claimed;
+	u8 *crashlog_raw;
+	size_t crashlog_len, crashlog_total;
+};
+
+static ssize_t gpu_status_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+ struct agx21_transport *t = dev_get_drvdata(dev);
+ return sysfs_emit(buf, "firmware=21B91 stage=%s error=%d crashed=%d render_completed=%u events=%u\n",
+  READ_ONCE(t->stage), READ_ONCE(t->error), atomic_read(&t->crashed),
+  READ_ONCE(t->render_completed), READ_ONCE(t->asahi_protocol.event_records));
+}
+static DEVICE_ATTR_RO(gpu_status);
+static struct attribute *agx21_attrs[] = { &dev_attr_gpu_status.attr, NULL };
+static ssize_t crashlog_raw_read(struct file *file, struct kobject *kobj,
+				 const struct bin_attribute *attr, char *buf,
+				 loff_t off, size_t count)
+{
+	struct agx21_transport *t = dev_get_drvdata(kobj_to_dev(kobj));
+	size_t len = smp_load_acquire(&t->crashlog_len);
+
+	if (off < 0 || !t->crashlog_raw || (u64)off >= len)
+		return 0;
+	count = min_t(size_t, count, len - (size_t)off);
+	memcpy(buf, t->crashlog_raw + off, count);
+	return count;
+}
+
+static BIN_ATTR(crashlog_raw, 0400, crashlog_raw_read, NULL, AGX21_CRASHLOG_MAX);
+static const struct bin_attribute *agx21_bin_attrs[] = { &bin_attr_crashlog_raw, NULL };
+static const struct attribute_group agx21_group = { .attrs = agx21_attrs, .bin_attrs = agx21_bin_attrs };
+
+static int agx21_segment_validate(struct device *dev, struct agx21_transport *t)
+{
+	int bytes, regions, i, j;
+	u64 end, other_end;
+	t->segments = of_get_property(dev->of_node, "apple,segment-ranges", &bytes);
+	if (!t->segments || bytes < 32 || bytes % 32 || bytes / 32 > 16)
+		return -EINVAL;
+	t->nsegments = bytes / 32;
+	regions = of_count_phandle_with_args(dev->of_node, "memory-region", NULL);
+	if (regions < t->nsegments)
+		return -EINVAL;
+	for (i = 0; i < t->nsegments; i++) {
+		u64 pa = le64_to_cpu(t->segments[i].phys);
+		u64 va = le64_to_cpu(t->segments[i].iova);
+		u64 size = le32_to_cpu(t->segments[i].size);
+		bool reserved = false;
+		if (!size || size > SZ_16M || !IS_ALIGNED(pa, SZ_16K) ||
+		    check_add_overflow(pa, ALIGN(size, SZ_16K), &end) ||
+		    check_add_overflow(va, size, &other_end))
+			return -EINVAL;
+		for (j = 0; j < i; j++) {
+			u64 other = le64_to_cpu(t->segments[j].phys);
+			u64 other_size = le32_to_cpu(t->segments[j].size);
+			u64 other_va = le64_to_cpu(t->segments[j].iova);
+			if ((pa < other + ALIGN(other_size, SZ_16K) && other < end) ||
+			    (va < other_va + other_size && other_va < va + size))
+				return -EINVAL;
+		}
+		for (j = 0; j < regions; j++) {
+			struct device_node *np = of_parse_phandle(dev->of_node, "memory-region", j);
+			struct resource res;
+			if (np && of_property_read_bool(np, "no-map") &&
+			    !of_address_to_resource(np, 0, &res) &&
+			    pa >= res.start && end - 1 <= res.end)
+				reserved = true;
+			of_node_put(np);
+		}
+		if (!reserved)
+			return -EINVAL;
+		dev_info(dev, "GFX TEST reserved segment %d: PA=%#llx IOVA=%#llx size=%#llx\n",
+			 i, pa, va, size);
+	}
+	return 0;
+}
+
+static int agx21_shmem_setup(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	struct agx21_transport *t = cookie;
+	u64 request_end;
+	unsigned int i;
+	if (!bfr->size || bfr->size > AGX21_MAX_SHARED ||
+	    check_add_overflow((u64)bfr->iova, (u64)bfr->size, &request_end))
+		return -EINVAL;
+	if (!bfr->iova) {
+		if (bfr->size > AGX21_MAX_SHARED - t->allocated)
+			return -ENOMEM;
+		bfr->buffer = dmam_alloc_coherent(t->dev, bfr->size, &bfr->iova,
+						GFP_KERNEL | __GFP_NOWARN);
+		if (!bfr->buffer)
+			return -ENOMEM;
+		t->allocated += bfr->size;
+		dev_info(t->dev, "GFX TEST allocated RTKit buffer %zu at %pad\n", bfr->size, &bfr->iova);
+		return 0;
+	}
+	for (i = 0; i < t->nsegments; i++) {
+		u64 va = le64_to_cpu(t->segments[i].iova);
+		u64 size = le32_to_cpu(t->segments[i].size);
+		if (bfr->iova < va || request_end > va + size)
+			continue;
+		bfr->buffer = devm_memremap(t->dev,
+			le64_to_cpu(t->segments[i].phys) + bfr->iova - va,
+			bfr->size, MEMREMAP_WB);
+		if (IS_ERR(bfr->buffer)) {
+			int ret = PTR_ERR(bfr->buffer);
+			bfr->buffer = NULL;
+			return ret;
+		}
+		dev_info(t->dev, "GFX TEST mapped RTKit buffer %zu IOVA=%pad segment=%u\n",
+			 bfr->size, &bfr->iova, i);
+		return 0;
+	}
+	dev_err(t->dev, "GFX TEST rejected RTKit buffer: IOVA=%pad size=%zu outside reserved firmware\n",
+		&bfr->iova, bfr->size);
+	return -ERANGE;
+}
+
+static void agx21_shmem_destroy(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	/* devm owns these; never free memory while firmware might still use it. */
+}
+
+static void agx21_compute_diag_snapshot(struct agx21_transport *t, const char *phase)
+{
+ if (!t->owner) return;
+ dev_info(t->dev, "GFX J171 %s stage=%s error=%d init=%u compute_jobs=%u render_jobs=%u events=%u\n",
+  phase, t->stage, t->error, t->init_status, t->asahi_protocol.jobs,
+  t->render_completed, t->asahi_protocol.event_records);
+}
+
+static void agx21_crashed(void *cookie, const void *log, size_t size)
+{
+	struct agx21_transport *t = cookie;
+	size_t captured = log && t->crashlog_raw ?
+		min_t(size_t, size, AGX21_CRASHLOG_MAX) : 0;
+
+	if (captured) {
+		memcpy(t->crashlog_raw, log, captured);
+		WRITE_ONCE(t->crashlog_total, size);
+		smp_store_release(&t->crashlog_len, captured);
+	}
+	atomic_set(&t->crashed, 1);
+	WRITE_ONCE(t->error, -EIO);
+	WRITE_ONCE(t->stage, "firmware-crashed");
+	dev_err(t->dev, "GFX TEST FAIL: firmware crash (%zu/%zu raw log bytes captured); reboot required\n",
+		captured, size);
+	agx21_compute_diag_snapshot(t, "firmware-crash");
+}
+
+static void agx21_check_work(struct work_struct *work)
+{
+	struct agx21_transport *t = container_of(to_delayed_work(work),
+		struct agx21_transport, check_work);
+	int ret;
+
+	if (!READ_ONCE(t->check_ready))
+		return;
+	/* Asahi has a separate consumer owner, not the literal-test suite.
+	 * Serialize with synchronous compute/render waits; they also drain
+	 * while holding this lock so the worker cannot deadlock progress. */
+	if (t->asahi) {
+		mutex_lock(&t->asahi_lock);
+		if (!t->render_failed && !atomic_read(&t->crashed)) {
+			ret = agx21_protocol_drain_idle(&t->asahi_protocol);
+			if (ret) {
+				WRITE_ONCE(t->render_failed, true);
+				WRITE_ONCE(t->error, ret);
+				WRITE_ONCE(t->stage, "asahi-channel-drain-failed");
+				dev_err(t->dev, "GFX Asahi channel drain failed: %d\n", ret);
+			}
+		}
+		mutex_unlock(&t->asahi_lock);
+		return;
+	}
+}
+
+static void agx21_recv(void *cookie, u8 ep, u64 message)
+{
+	struct agx21_transport *t = cookie;
+	int n = atomic_inc_return(&t->messages);
+	if (ep == 0x20 && message == (0x42ULL << 48)) {
+		atomic_inc(&t->check_messages);
+		if (READ_ONCE(t->check_ready))
+			schedule_delayed_work(&t->check_work,
+				msecs_to_jiffies(10));
+	}
+	if (n <= 32)
+		dev_info(t->dev, "GFX TEST app RX ep=%#x msg=%#018llx\n", ep, message);
+}
+
+static const struct apple_rtkit_ops agx21_transport_ops = {
+ .crashed = agx21_crashed, .recv_message = agx21_recv,
+ .shmem_setup = agx21_shmem_setup, .shmem_destroy = agx21_shmem_destroy,
+};
+
+static int agx21_power_diag_setup(struct platform_device *pdev,
+				  struct agx21_transport *t)
+{
+	struct device_node *np = NULL;
+	struct resource pmgr, *fender, *sgx;
+	bool found = false;
+
+	for_each_compatible_node(np, NULL, "apple,t8020-pmgr") {
+		if (!of_address_to_resource(np, 0, &pmgr) &&
+		    pmgr.start == 0x23b000000ULL &&
+		    resource_size(&pmgr) >= 0x8c000) {
+			found = true;
+			break;
+		}
+	}
+	of_node_put(np);
+	if (!found)
+		return -ENODEV;
+	fender = platform_get_resource_byname(pdev, IORESOURCE_MEM, "fender");
+	if (!fender || fender->start != 0x204d00000ULL ||
+	    resource_size(fender) < 0x2000)
+		return -EINVAL;
+	/* The Linux PMGR resource ends at +0x8c000, but the captured live
+	 * J171 Apple DT declares reg[0] as a full 1 MiB. Map the candidate
+	 * VOLMAN page separately; never index beyond the PMGR mapping. */
+	t->pmgr_diag = devm_ioremap(&pdev->dev, pmgr.start + 0x80000, 0x4000);
+	if (!t->pmgr_diag)
+		return -ENOMEM;
+	t->volman_diag = devm_ioremap(&pdev->dev, pmgr.start + 0xa0000, 0x1000);
+	if (!t->volman_diag)
+		return -ENOMEM;
+	t->fender_diag = devm_ioremap(&pdev->dev, fender->start, 0x2000);
+	if (!t->fender_diag)
+		return -ENOMEM;
+	if (agx21_fault_probe) {
+		sgx = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sgx");
+		if (!sgx || sgx->start != 0x204000000ULL ||
+		    resource_size(sgx) < 0x18000)
+			return -EINVAL;
+		/* Map only the fault-register page. No SGX read occurs at probe. */
+		t->rgx_fault_diag = devm_ioremap(&pdev->dev,
+					      sgx->start + 0x17000, 0x1000);
+		if (!t->rgx_fault_diag)
+			return -ENOMEM;
+	}
+	return 0;
+}
+
+static int agx21_wait_retired(struct agx21_transport *t,
+				    struct agx21_protocol *p)
+{
+	struct agx21_memory *m = p->memory;
+	u8 *state = agx21_memory_cpu(m, AGX21_MEM_INPUT_STATE_BASE + 2);
+	u8 *info = agx21_memory_cpu(m, AGX21_MEM_QUEUE_INFO);
+	u8 *ptrs = agx21_memory_cpu(m, AGX21_MEM_QUEUE_POINTERS);
+	u8 *scratch = agx21_memory_cpu(m, p->custom_job ?
+		p->scratch_object : AGX21_MEM_SCRATCH);
+	unsigned int attempt, n = p->jobs;
+
+	if (!state || !info || !ptrs || !scratch || !n)
+		return -EINVAL;
+	for (attempt = 0; attempt < 200; attempt++) {
+		if (atomic_read(&t->crashed))
+			return -EIO;
+		dma_rmb();
+		if (get_unaligned_le32(state) == n &&
+		    get_unaligned_le32(state + 4) == n &&
+		    get_unaligned_le32(state + 0x20) == n &&
+		    get_unaligned_le32(info + 0x20) == n &&
+		    get_unaligned_le32(info + 0x28) == n &&
+		    get_unaligned_le32(ptrs) == n &&
+		    get_unaligned_le32(ptrs + 0x30) == n &&
+		    get_unaligned_le32(ptrs + 0x40) == n &&
+		    get_unaligned_le32(scratch + 0x10) == p->stamp &&
+		    get_unaligned_le32(scratch + 0x14) == p->stamp)
+			return agx21_protocol_retired(p);
+		msleep(10);
+	}
+	return -ETIMEDOUT;
+}
+
+static int agx21_stage_asahi_job(struct agx21_transport *t, u32 ctx,
+				u64 args_va, u64 stream_va, u32 stamp)
+{
+	struct agx21_memory *m = &t->owner->memory;
+	u8 *cmd = agx21_memory_cpu(m, AGX21_MEM_COMMAND);
+	u8 *useq = agx21_memory_cpu(m, AGX21_MEM_MICROSEQUENCE);
+	u8 *event = agx21_memory_cpu(m, AGX21_MEM_EVENT_CONTROL);
+	u8 *scratch = agx21_memory_cpu(m, AGX21_MEM_SCRATCH);
+	struct agx21_compute_command_core core = {
+		.context = ctx, .channel = 0,
+		.event_control_va = agx21_memory_firmware_va(m, AGX21_MEM_EVENT_CONTROL),
+		.completion_primary_va = agx21_memory_firmware_va(m, AGX21_MEM_SCRATCH) + 0x14,
+		.completion_retire_va = agx21_memory_firmware_va(m, AGX21_MEM_SCRATCH) + 0x10,
+		.completion_value = (3ULL << 32) | stamp,
+		.command_id = stamp >> 8,
+	};
+	struct agx21_compute_launch_regs launch = {
+		.descriptor_928_args_va = args_va,
+		.descriptor_840_cdm_va = stream_va,
+	};
+	struct agx21_cp_microseq_args seq = {
+		.command_va = agx21_memory_firmware_va(m, AGX21_MEM_COMMAND),
+		.state_va = agx21_memory_firmware_va(m, AGX21_MEM_CP_STATS),
+		.token_va = agx21_memory_firmware_va(m, AGX21_MEM_QUEUE_INFO),
+		.descriptor_aux_va = core.event_control_va,
+		.command_word_16 = ctx, .command_word_664 = stamp,
+		.descriptor_indirect_word_320_8 = stamp >> 8,
+	};
+	size_t padded;
+
+	if (!m->published || !cmd || !useq || !event || !scratch ||
+	    ctx < AGX21_TEST_CONTEXT || ctx >= AGX21_CONTEXTS ||
+	    !(m->graph.context_masks[ctx / 32] & BIT(ctx % 32)) ||
+	    !args_va || !stream_va ||
+	    !IS_ALIGNED(args_va | stream_va, 4) ||
+	    args_va >= AGX21_GPU_SHARED_VA || stream_va >= AGX21_GPU_SHARED_VA ||
+	    !stamp || stamp > 0xff00 || (stamp & 0xff))
+		return -EINVAL;
+	memset(event, 0, 192);
+	put_unaligned_le64(agx21_memory_firmware_va(m, AGX21_MEM_SCRATCH) + 0x20,
+			   event);
+	put_unaligned_le32(stamp >> 8, event + 8);
+	put_unaligned_le32(1, event + 16);
+	put_unaligned_le64(~0ULL, event + 168);
+	put_unaligned_le32(0, scratch + 0x20);
+	put_unaligned_le32(stamp - 0x100, scratch + 0x10);
+	put_unaligned_le32(stamp - 0x100, scratch + 0x14);
+	memset(cmd, 0, m->objects[AGX21_MEM_COMMAND].size);
+	if (agx21_write_compute_command_core(cmd,
+		m->objects[AGX21_MEM_COMMAND].size, &core) ||
+	    agx21_write_compute_launch_regs(cmd,
+		m->objects[AGX21_MEM_COMMAND].size, &launch))
+		return -EINVAL;
+	put_unaligned_le32(stamp, cmd + 0x298);
+	put_unaligned_le32(stamp, cmd + 664);
+	seq.command_qword_4 = get_unaligned_le64(cmd + 4);
+	seq.command_qword_640 = get_unaligned_le64(cmd + 0x280);
+	seq.command_word_648 = get_unaligned_le32(cmd + 0x288);
+	if (agx21_stage_cp_microseq(cmd,
+		m->objects[AGX21_MEM_COMMAND].size, useq,
+		m->objects[AGX21_MEM_MICROSEQUENCE].size,
+		agx21_memory_firmware_va(m, AGX21_MEM_MICROSEQUENCE),
+		&seq, &padded))
+		return -EINVAL;
+	dma_wmb();
+	return 0;
+}
+
+int agx21_asahi_run(void *transport, u32 ctx, u64 args, u64 stream)
+{
+	struct agx21_transport *t = transport;
+	struct agx21_protocol *p;
+	u64 scratch_va;
+	u32 stamp;
+	int ret;
+
+	if (!t || !t->owner)
+		return -ENODEV;
+	mutex_lock(&t->asahi_lock);
+	p = &t->asahi_protocol;
+	if (atomic_read(&t->crashed) || p->phase == AGX21_PROTOCOL_FAILED ||
+	    t->init_status != 1 || p->jobs >= p->max_jobs) {
+		ret = -EIO;
+		goto out;
+	}
+	if (p->jobs) {
+		ret = agx21_protocol_rearm_next(p);
+		if (ret)
+			goto fail;
+	}
+	stamp = (p->jobs + 1) * 0x100;
+	ret = agx21_stage_asahi_job(t, ctx, args, stream, stamp);
+	if (ret)
+		goto fail;
+	p->context = ctx;
+	scratch_va = agx21_memory_firmware_va(p->memory, AGX21_MEM_SCRATCH);
+	ret = agx21_protocol_submit(p, stamp, (3ULL << 32) | stamp,
+		stamp, scratch_va + 0x14, scratch_va + 0x10);
+	if (ret)
+		goto fail;
+	ret = agx21_protocol_wait(p, 5000);
+	if (ret)
+		goto fail;
+	ret = agx21_protocol_accept_completion(p);
+	if (ret)
+		goto fail;
+	ret = agx21_wait_retired(t, p);
+	if (ret)
+		goto fail;
+	if (agx21_render_diag)
+		dev_info(t->dev, "GFX ASAHI compute ctx=%u stamp=%#x retired\n", ctx, stamp);
+	goto out;
+fail:
+	WRITE_ONCE(t->error, ret);
+	WRITE_ONCE(t->stage, "asahi-compute-failed");
+	dev_err(t->dev, "GFX ASAHI compute ctx=%u failed %d; reboot required\n", ctx, ret);
+out:
+	mutex_unlock(&t->asahi_lock);
+	return ret;
+}
+
+/* One bounded 21B91 render transaction. Never use the XS 0x30-byte RUN
+ * record or its channel cursors here. A failed job requires a new boot. */
+static int agx21_render_enqueue(struct agx21_transport *t, unsigned int ch,
+				 u32 command, u32 init, u8 event)
+{
+	struct agx21_protocol *p = &t->asahi_protocol;
+	struct agx21_memory *m = &t->owner->memory;
+	const unsigned int *ids = m->render_ids.queue[ch];
+	u8 *info = agx21_memory_cpu(m, ids[0]);
+	u8 *ptrs = agx21_memory_cpu(m, ids[1]);
+	u8 *queue = agx21_memory_cpu(m, ids[2]);
+	u8 *state = agx21_memory_cpu(m, AGX21_MEM_INPUT_STATE_BASE + ch);
+	u8 *ring = agx21_memory_cpu(m, AGX21_MEM_INPUT_RING_BASE + ch);
+	u32 count = ch ? 1 : 2;
+	u32 previous = (t->render_completed * count) % 256;
+	u32 head = (previous + count) % 256;
+	u32 run_index = t->render_completed % 256;
+	u64 queue_va = agx21_memory_firmware_va(m, ids[0]);
+	u64 command_va = m->firmware_va + command;
+	u64 init_va = m->firmware_va + init;
+
+	if (!info || !ptrs || !queue || !state || !ring ||
+	    m->objects[ids[2]].size < 256 * 8 ||
+	    get_unaligned_le32(ptrs + 0x50) != 256 ||
+	    m->objects[ids[0]].size < 0xb0 + 256 * 8 ||
+	    m->objects[AGX21_MEM_INPUT_RING_BASE + ch].size < 256 * AGX21_RUN_RECORD_SIZE ||
+	    get_unaligned_le32(state) != run_index || get_unaligned_le32(state + 4) != run_index ||
+	    get_unaligned_le32(state + 0x20) != run_index ||
+	    get_unaligned_le32(info + 0x20) != previous || get_unaligned_le32(info + 0x28) != previous ||
+	    get_unaligned_le32(ptrs) != previous ||
+	    get_unaligned_le32(ptrs + 0x30) != previous ||
+	    get_unaligned_le32(ptrs + 0x40) != previous)
+		return -EINVAL;
+	if (!ch)
+		put_unaligned_le64(init_va, queue + previous * 8);
+	put_unaligned_le64(command_va, queue + ((previous + count - 1) % 256) * 8);
+	/* Native queue metadata ring begins at info+0xb0. */
+	memset(info + 0xb0 + previous * 8, 0, count * 8);
+	ring += run_index * AGX21_RUN_RECORD_SIZE;
+	memset(ring, 0, AGX21_RUN_RECORD_SIZE);
+	if (agx21_patch_run(ring, AGX21_RUN_RECORD_SIZE,
+			    queue_va, head, ch, event, 1))
+		return -EINVAL;
+	p->io.release(p->io.cookie);
+	put_unaligned_le32(head, ptrs + 0x40);
+	p->io.release(p->io.cookie);
+	put_unaligned_le32((run_index + 1) % 256, state + 0x20);
+	p->io.release(p->io.cookie);
+	return p->io.send(p->io.cookie, 0x21, (0x83ULL << 48) | ch) ? -EIO : 0;
+}
+
+/* A13 measured a fault only with GFX powered. On J171 this is an explicitly
+ * opt-in, single native-width sample during an outstanding TA, not a timeout
+ * dump. Even with the double Fender check, power can change during MMIO. */
+static bool agx21_render_fault_probe(struct agx21_transport *t, u64 elapsed_ms)
+{
+	u32 gfx, fender_before, fender_after;
+	u64 fault;
+
+	if (!agx21_fault_probe || !t->pmgr_diag || !t->fender_diag ||
+	    !t->rgx_fault_diag)
+		return false;
+	gfx = readl(t->pmgr_diag + 0x388); /* J171 ps_gfx, not A13 +0x390 */
+	if (((gfx >> 4) & 0xf) != 0xf)
+		return false;
+	fender_before = readl(t->fender_diag + 0x1000);
+	if (!(fender_before & 0xf) || (fender_before & 0x10))
+		return false;
+	/* J171 native AGXG11P uses one 64-bit load at SGX+0x17040. */
+	fault = readq(t->rgx_fault_diag + 0x40);
+	fender_after = readl(t->fender_diag + 0x1000);
+	dev_info(t->dev,
+		 "GFX TA MMU probe elapsed=%llums ps_gfx=%#x fender=%#x/%#x raw=%#018llx present=%u ctx=%u requester=%u level=%u read=%u type=%u va=%#llx%s\n",
+		 (unsigned long long)elapsed_ms, gfx, fender_before,
+		 fender_after, (unsigned long long)fault, (unsigned int)(fault & 1),
+		 (unsigned int)((fault >> 16) & 0x3f),
+		 (unsigned int)((fault >> 8) & 0xff),
+		 (unsigned int)((fault >> 5) & 3),
+		 (unsigned int)((fault >> 4) & 1),
+		 (unsigned int)((fault >> 1) & 7),
+		 (unsigned long long)((fault >> 24) & ~0x3fULL),
+		 fender_before == fender_after ? "" : " POWER_CHANGED");
+	return true;
+}
+
+static int agx21_render_wait(struct agx21_transport *t, unsigned int ch,
+			    u8 *scratch, u32 stamp_offset, u32 head,
+			    u32 expected_stamp, u32 expected_run)
+{
+	struct agx21_protocol *p = &t->asahi_protocol;
+	struct agx21_memory *m = &t->owner->memory;
+	const unsigned int *ids = m->render_ids.queue[ch];
+	u8 *info = agx21_memory_cpu(m, ids[0]);
+	u8 *ptrs = agx21_memory_cpu(m, ids[1]);
+	u8 *list = agx21_memory_cpu(m, ids[3]);
+	u8 *evc = m->arena + m->objects[m->render_ids.command[ch]].offset +
+		(ch ? 0xa00 : 0x600);
+	u8 *state = agx21_memory_cpu(m, AGX21_MEM_INPUT_STATE_BASE + ch);
+	u64 start = p->io.now_ms(p->io.cookie);
+	u64 next_fault_probe = start + 1000;
+	bool fault_sampled = false;
+
+	for (;;) {
+		u64 now;
+		int drain_ret;
+
+		if (atomic_read(&t->crashed) || p->io.crashed(p->io.cookie))
+			return -EIO;
+		/* Drain firmware -> host channels during waits, not just stamps.
+		 * The async worker shares asahi_lock and cannot do this for us
+		 * while a synchronous render holds it. */
+		drain_ret = agx21_protocol_drain_idle(p);
+		if (drain_ret)
+			return drain_ret;
+		p->io.acquire(p->io.cookie);
+		if (get_unaligned_le32(scratch + stamp_offset) == expected_stamp &&
+		    get_unaligned_le32(state) == expected_run &&
+		    get_unaligned_le32(state + 4) == expected_run &&
+		    get_unaligned_le32(state + 0x20) == expected_run &&
+		    get_unaligned_le32(info + 0x20) == head &&
+		    get_unaligned_le32(info + 0x28) == head &&
+		    get_unaligned_le32(ptrs) == head &&
+		    get_unaligned_le32(ptrs + 0x30) == head &&
+		    get_unaligned_le32(ptrs + 0x40) == head &&
+		    /* Stamps/cursors alone do not release intrusive EVC links. */
+		    !get_unaligned_le32(evc + 0x94) &&
+		    get_unaligned_le32(scratch + stamp_offset + 8) ==
+			get_unaligned_le32(evc + 0xc) &&
+		    !get_unaligned_le64(list) &&
+		    get_unaligned_le64(list + 8) ==
+			agx21_memory_firmware_va(m, ids[3]))
+			return 0;
+		now = p->io.now_ms(p->io.cookie);
+		if (!ch && agx21_fault_probe && !fault_sampled &&
+		    now >= next_fault_probe && now - start < 5000) {
+			fault_sampled = agx21_render_fault_probe(t, now - start);
+			next_fault_probe = now + 100;
+		}
+		if (now - start >= 5000) {
+			if (!ch && agx21_fault_probe && !fault_sampled) {
+				u32 gfx = readl(t->pmgr_diag + 0x388);
+				u32 fender = ((gfx >> 4) & 0xf) == 0xf ?
+					readl(t->fender_diag + 0x1000) : 0xffffffff;
+
+				dev_info(t->dev,
+					 "GFX TA MMU probe skipped: no verified powered window; ps_gfx=%#x fender=%#x (ffffffff=not-read)\n",
+					 gfx, fender);
+			}
+			dev_err(t->dev, "GFX RENDER ch=%u timeout stamp=%#x input=%u/%u/%u queue=%u/%u ptr=%u/%u/%u event=%u/%u drained=%u\n",
+				ch, get_unaligned_le32(scratch + stamp_offset),
+				get_unaligned_le32(state), get_unaligned_le32(state + 4),
+				get_unaligned_le32(state + 0x20),
+				get_unaligned_le32(info + 0x20), get_unaligned_le32(info + 0x28),
+				get_unaligned_le32(ptrs), get_unaligned_le32(ptrs + 0x30),
+				get_unaligned_le32(ptrs + 0x40),
+				get_unaligned_le32(agx21_memory_cpu(m, AGX21_MEM_EVENT_STATE)),
+				get_unaligned_le32(agx21_memory_cpu(m, AGX21_MEM_EVENT_STATE) + 0x20),
+				p->event_records);
+			return -ETIMEDOUT;
+		}
+		p->io.sleep_ms(p->io.cookie, 1);
+	}
+}
+
+static void agx21_render_dump_ta_event(struct agx21_transport *t, u32 ta_cmd,
+				      const char *phase)
+{
+	struct agx21_memory *m = &t->owner->memory;
+	u8 *evc;
+	char prefix[96];
+
+	/* Normal EVC dumps must honor diag=0; preserve timeout-only evidence. */
+	if (!agx21_render_diag && strcmp(phase, "render-failed"))
+		return;
+	if (!m->arena || ta_cmd > m->size || m->size - ta_cmd < 0x6c0) {
+		dev_err(t->dev, "GFX TA EVC %s: command bounds invalid\n", phase);
+		return;
+	}
+	dma_rmb();
+	evc = m->arena + ta_cmd + 0x600;
+	dev_info(t->dev,
+		 "GFX TA EVC %s: cmd+0x14=%#llx counter=%#llx mask28=%#x mask4c=%#x mask70=%#x slot3=%#llx\n",
+		 phase,
+		 (unsigned long long)get_unaligned_le64(m->arena + ta_cmd + 0x14),
+		 (unsigned long long)get_unaligned_le64(evc),
+		 get_unaligned_le32(evc + 0x28),
+		 get_unaligned_le32(evc + 0x4c),
+		 get_unaligned_le32(evc + 0x70),
+		 (unsigned long long)get_unaligned_le64(evc + 0x68));
+	scnprintf(prefix, sizeof(prefix), "GFX TA EVC %s: ", phase);
+	print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_OFFSET, 16, 1,
+		       evc, 0xc0, false);
+}
+
+/* Capture the *submitted* iPad TA bytes, not just the 3D command.  A TA
+ * timeout happens before Mesa can observe any rendered pixels.  Keep this
+ * bounded and opt-in so the serial log remains useful. */
+static void agx21_render_dump_ta_command(struct agx21_transport *t, u32 ta_cmd,
+					const char *phase)
+{
+	struct agx21_memory *m = &t->owner->memory;
+	u8 *cmd;
+	char prefix[96];
+	u64 useq_va;
+	u64 useq_off;
+
+	if (!agx21_render_diag || !m->arena ||
+	    ta_cmd > m->size || m->size - ta_cmd < 0x900)
+		return;
+	dma_rmb();
+	cmd = m->arena + ta_cmd;
+	useq_va = get_unaligned_le64(cmd + 0x474);
+	dev_info(t->dev,
+		 "GFX TA CMD %s type=%#x ctx=%u pm_slot=%u r32_last=%#x useq_va=%#llx useq_len=%u status=%#x/%#x\n",
+		 phase, get_unaligned_le32(cmd), get_unaligned_le32(cmd + 0xc),
+		 get_unaligned_le32(cmd + 0x1c), get_unaligned_le32(cmd + 0x3f0),
+		 (unsigned long long)useq_va, get_unaligned_le32(cmd + 0x47c),
+		 get_unaligned_le32(cmd + 0x488), get_unaligned_le32(cmd + 0x58c));
+	scnprintf(prefix, sizeof(prefix), "GFX TA CMD %s header: ", phase);
+	print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_OFFSET, 16, 1,
+		       cmd, 0x40, false);
+	scnprintf(prefix, sizeof(prefix), "GFX TA CMD %s regs64: ", phase);
+	print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_OFFSET, 16, 1,
+		       cmd + 0x40, 0x68, false);
+	scnprintf(prefix, sizeof(prefix), "GFX TA CMD %s regs32: ", phase);
+	print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_OFFSET, 16, 1,
+		       cmd + 0x3c4, 0x30, false);
+	if (useq_va < m->firmware_va)
+		return;
+	useq_off = useq_va - m->firmware_va;
+	if (useq_off > m->size || m->size - useq_off < 0x100)
+		return;
+	scnprintf(prefix, sizeof(prefix), "GFX TA CMD %s microseq: ", phase);
+	print_hex_dump(KERN_INFO, prefix, DUMP_PREFIX_OFFSET, 16, 1,
+		       m->arena + useq_off, 0x100, false);
+}
+
+/* One-shot, read-only snapshots. Do not split InitBuffer from TA merely to
+ * observe it: the first safe checkpoint is after their shared queue retires. */
+static void agx21_render_diag_snapshot(struct agx21_transport *t, u32 frag_cmd,
+				       const char *phase, bool before)
+{
+	struct agx21_memory *m = &t->owner->memory;
+	const struct agx21_render_resources *r = &m->render_resources;
+	u32 scene, pm, q, id;
+	u8 *cmd, *bms, *slots, *info;
+	u8 *fault, *event, *power;
+
+	if (!agx21_render_diag || !m->arena ||
+	    frag_cmd > m->size || m->size - frag_cmd < 0xc00)
+		return;
+	id = r->pm_slots;
+	if (id >= AGX21_MAX_OBJECTS ||
+	    m->objects[id].size < AGX21_PAGE ||
+	    r->scene >= AGX21_MAX_OBJECTS ||
+	    m->objects[r->scene].size < AGX21_PAGE ||
+	    m->render_ids.queue[1][0] >= AGX21_MAX_OBJECTS ||
+	    m->objects[m->render_ids.queue[1][0]].size < 0x50 ||
+	    m->objects[AGX21_MEM_B].size < 0x2d8)
+		return;
+	scene = m->objects[r->scene].offset;
+	pm = m->objects[id].offset;
+	q = m->objects[m->render_ids.queue[1][0]].offset;
+	if (scene > m->size || m->size - scene < AGX21_PAGE ||
+	    pm > m->size || m->size - pm < AGX21_PAGE ||
+	    q > m->size || m->size - q < 0x50)
+		return;
+	dma_rmb();
+	cmd = m->arena + frag_cmd;
+	bms = m->arena + scene + 0x100;
+	slots = m->arena + pm;
+	info = m->arena + q;
+	dev_info(t->dev,
+		 "GFX RDIAG %s pm_region_b=%#llx pm0=%16ph scene_gates=%#x/%#x scene_ctl=%#llx ctl=%#x/%#x queue_policy=%#x/%#x/%#x/%#x\n",
+		 phase,
+		 (unsigned long long)get_unaligned_le64(
+			 agx21_memory_cpu(m, AGX21_MEM_B) + 0x2d0),
+		 slots, get_unaligned_le32(bms + 0xb8),
+		 get_unaligned_le32(bms + 0xbc),
+		 (unsigned long long)get_unaligned_le64(bms + 0xc0),
+		 get_unaligned_le32(m->arena + scene + 0xb00),
+		 get_unaligned_le32(m->arena + scene + 0xb04),
+		 get_unaligned_le32(info + 0x30),
+		 get_unaligned_le32(info + 0x38),
+		 get_unaligned_le32(info + 0x40),
+		 get_unaligned_le32(info + 0x48));
+	dev_info(t->dev,
+		 "GFX RDIAG %s bg=%#llx/%#llx eot=%#x/%#x region_size=%#llx empty_ctl=%#llx pm_word=%#x start3d=%#x/%#x/%#x cmd_status=%#x/%#x/%#x\n",
+		 phase,
+		 (unsigned long long)get_unaligned_le64(cmd + 0x88),
+		 (unsigned long long)get_unaligned_le64(cmd + 0x90),
+		 get_unaligned_le32(cmd + 0x3c8),
+		 get_unaligned_le32(cmd + 0x3cc),
+		 (unsigned long long)get_unaligned_le64(cmd + 0x178),
+		 (unsigned long long)get_unaligned_le64(cmd + 0x180),
+		 get_unaligned_le32(cmd + 0x40c),
+		 get_unaligned_le32(cmd + 0xb00 + 0x54),
+		 get_unaligned_le32(cmd + 0xb00 + 0x58),
+		 get_unaligned_le32(cmd + 0xb00 + 0x5c),
+		 get_unaligned_le32(cmd + 0x888),
+		 get_unaligned_le32(cmd + 0x88c),
+		 get_unaligned_le32(cmd + 0x8b8));
+	/* All reads below are from mapped, coherent, owned RAM. In particular,
+	 * do not touch the T8020 SGX/Fender MMIO just to diagnose a timeout. */
+	dev_info(t->dev,
+		 "GFX RDIAG %s PM descriptor count=%u granule=%u blocks=%u/%u heap_pa=%#llx heap_size=%u\n",
+		 phase, get_unaligned_le32(m->arena + scene + 0x28),
+		 get_unaligned_le32(m->arena + scene + 0x48),
+		 get_unaligned_le32(m->arena + scene + 0x9000),
+		 get_unaligned_le32(m->arena + scene + 0x9004),
+		 (unsigned long long)agx21_memory_physical(m, r->parameter_heap),
+		 m->objects[r->parameter_heap].size);
+	print_hex_dump(KERN_INFO, "GFX RDIAG PM blist: ",
+		       DUMP_PREFIX_OFFSET, 16, 4, m->arena + scene + 0x8000,
+		       0x40, false);
+	print_hex_dump(KERN_INFO, "GFX RDIAG PM blist last block: ",
+		       DUMP_PREFIX_OFFSET, 16, 4,
+		       m->arena + scene + 0x8000 + 63 * 0x20,
+		       0x20, false);
+	print_hex_dump(KERN_INFO, "GFX RDIAG PM plist: ",
+		       DUMP_PREFIX_OFFSET, 16, 4, m->arena + scene + 0x4000,
+		       0x40, false);
+	print_hex_dump(KERN_INFO, "GFX RDIAG PM plist last block: ",
+		       DUMP_PREFIX_OFFSET, 16, 4,
+		       m->arena + scene + 0x4000 + 63 * 32 * 4,
+		       0x40, false);
+	fault = agx21_memory_cpu(m, AGX21_MEM_FAULT);
+	if (fault && m->objects[AGX21_MEM_FAULT].size >= 0x40)
+		print_hex_dump(KERN_INFO, "GFX RDIAG FW fault: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, fault, 0x40, false);
+	event = agx21_memory_cpu(m, AGX21_MEM_EVENT_STATE);
+	if (event && m->objects[AGX21_MEM_EVENT_STATE].size >= 0x40)
+		print_hex_dump(KERN_INFO, "GFX RDIAG FW event: ",
+			       DUMP_PREFIX_OFFSET, 16, 4, event, 0x40, false);
+	power = agx21_memory_cpu(m, AGX21_MEM_HWB);
+	if (power && m->objects[AGX21_MEM_HWB].size >= 0xb64)
+		dev_info(t->dev,
+			 "GFX RDIAG %s HWB gate=%u/%u pstate=%u MHz=%u/%u\n",
+			 phase, get_unaligned_le32(power + 0xa38),
+			 get_unaligned_le32(power + 0xa40),
+			 get_unaligned_le32(power + 0xb58),
+			 get_unaligned_le32(power + 0xb5c),
+			 get_unaligned_le32(power + 0xb60));
+	if (before) {
+		print_hex_dump(KERN_INFO, "GFX RDIAG header: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, cmd + 0x40, 0x40, false);
+		print_hex_dump(KERN_INFO, "GFX RDIAG r32: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, cmd + 0x3c8, 0x48, false);
+		print_hex_dump(KERN_INFO, "GFX RDIAG tail: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, cmd + 0x890, 0x20, false);
+	}
+}
+
+/* No lifetime render budget. Rings are reused only after full retirement.
+ * Separate validity from the value: zero is a valid stamp at u32 wrap.
+ * The firmware's event slot is bits14:8, so preserve natural +0x100 wrap
+ * rather than skipping a slot or changing the low stamp bits.
+ */
+int agx21_render_next_stamp(void *transport, u32 *stamp)
+{
+ struct agx21_transport *t = transport;
+ if (!t || !stamp)
+  return -EINVAL;
+ if (READ_ONCE(t->render_failed) || atomic_read(&t->crashed))
+  return -EIO;
+ *stamp = (READ_ONCE(t->render_completed) + 1U) * 0x100U;
+ return 0;
+}
+
+int agx21_asahi_render(void *transport, u32 ctx, u32 ta_cmd, u32 frag_cmd,
+			 u32 scratch_offset)
+{
+	struct agx21_transport *t = transport;
+	struct agx21_memory *m;
+	struct agx21_protocol *p;
+	u8 *scratch, *init;
+	u32 init_offset, job, stamp;
+	int ret;
+
+	if (!t || !t->owner)
+		return -ENODEV;
+	mutex_lock(&t->asahi_lock);
+	m = &t->owner->memory;
+	p = &t->asahi_protocol;
+	ret = agx21_render_next_stamp(t, &stamp);
+	if (ret)
+		goto out;
+	if (t->render_failed || atomic_read(&t->crashed) ||
+	    p->phase != AGX21_PROTOCOL_READY || p->jobs || t->init_status != 1 ||
+	    !m->published || !m->render_resources_reserved ||
+	    !m->render_policy_candidate_ready ||
+	    ctx < AGX21_TEST_CONTEXT || ctx >= AGX21_CONTEXTS ||
+	    !(m->graph.context_masks[ctx / 32] & BIT(ctx % 32)) ||
+	    ta_cmd != m->objects[m->render_ids.command[0]].offset ||
+	    frag_cmd != m->objects[m->render_ids.command[1]].offset ||
+	    scratch_offset != ta_cmd + 0x1000) {
+		ret = -EINVAL;
+		goto out;
+	}
+	job = t->render_completed + 1;
+	if (get_unaligned_le32(m->arena + ta_cmd + 0x578) != stamp ||
+	    get_unaligned_le32(m->arena + frag_cmd + 0x8d4) != stamp) {
+		ret = -EINVAL;
+		goto out;
+	}
+	t->render_attempted = true;
+	if (agx21_render_diag)
+		dev_info(t->dev, "GFX RENDER serial job=%u stamp=%#x TA_head=%u 3D_head=%u\n",
+		 job, stamp, (job * 2) % 256, job % 256);
+	scratch = m->arena + scratch_offset;
+	init_offset = frag_cmd + 0x1000;
+	init = m->arena + init_offset;
+	memset(init, 0, 0x40);
+	put_unaligned_le32(6, init);
+	put_unaligned_le32(ctx, init + 4);
+	put_unaligned_le64(m->firmware_va +
+		m->objects[m->render_resources.scene].offset, init + 0x14);
+	put_unaligned_le32(stamp, init + 0x1c);
+	agx21_render_diag_snapshot(t, frag_cmd, "pre-submit", true);
+	agx21_render_dump_ta_command(t, ta_cmd, "pre-submit");
+	agx21_render_dump_ta_event(t, ta_cmd, "pre-ta-doorbell");
+	WRITE_ONCE(t->stage, "render-ta-sent");
+	ret = agx21_render_enqueue(t, 0, ta_cmd, init_offset, 4);
+	if (ret)
+		goto fail;
+	agx21_render_dump_ta_event(t, ta_cmd, "post-ta-doorbell");
+	ret = agx21_render_wait(t, 0, scratch, 0, (job * 2) % 256, stamp, job % 256);
+	if (ret)
+		goto fail;
+	agx21_render_dump_ta_event(t, ta_cmd, "ta-retired-pre-3d");
+	agx21_render_diag_snapshot(t, frag_cmd, "post-initbuffer-ta", false);
+	if (agx21_render_diag)
+		dev_info(t->dev, "GFX RENDER TA stamp and queue retired\n");
+	/* Observe the firmware-owned scene gates without overriding them. */
+	agx21_render_diag_snapshot(t, frag_cmd, "pre-3d", false);
+	WRITE_ONCE(t->stage, "render-3d-sent");
+	ret = agx21_render_enqueue(t, 1, frag_cmd, 0, 7);
+	if (ret)
+		goto fail;
+	ret = agx21_render_wait(t, 1, scratch, 0x40, job % 256, stamp, job % 256);
+	if (ret)
+		goto fail;
+	WRITE_ONCE(t->render_completed, job);
+	WRITE_ONCE(t->stage, "render-complete");
+	agx21_render_diag_snapshot(t, frag_cmd, "post-3d", false);
+	if (agx21_render_diag)
+		dev_info(t->dev, "GFX RENDER 3D stamp and queue retired\n");
+	goto out;
+fail:
+	WRITE_ONCE(t->render_failed, true);
+	agx21_render_diag_snapshot(t, frag_cmd, "render-failed", false);
+	agx21_render_dump_ta_command(t, ta_cmd, "render-failed");
+	agx21_render_dump_ta_event(t, ta_cmd, "render-failed");
+	WRITE_ONCE(t->error, ret);
+	WRITE_ONCE(t->stage, "render-failed");
+	dev_err(t->dev, "GFX RENDER failed %d; fresh DFU boot required\n", ret);
+out:
+	mutex_unlock(&t->asahi_lock);
+	return ret;
+}
+
+static int agx21_compute_send(void *cookie, u8 ep, u64 message)
+{
+	struct agx21_transport *t = cookie;
+	int ret;
+
+	/* Do not delay the EP21 kick after publishing the queue producer. */
+	ret = apple_rtkit_send_message(t->rtk, ep, message, NULL, false);
+	if (ep == 0x21 && agx21_render_diag) {
+		dev_info(t->dev, "GFX COMPUTE doorbell send returned %d\n", ret);
+		if (ret)
+			agx21_compute_diag_snapshot(t, "send-failed");
+	}
+	return ret;
+}
+
+static u64 agx21_compute_now(void *cookie)
+{
+	return div_u64(ktime_get_boottime_ns(), NSEC_PER_MSEC);
+}
+
+static void agx21_compute_sleep(void *cookie, u32 ms) { msleep(ms); }
+
+static int agx21_compute_crashed(void *cookie)
+{
+	return atomic_read(&((struct agx21_transport *)cookie)->crashed);
+}
+
+static void agx21_compute_release(void *cookie) { dma_wmb(); }
+
+static void agx21_compute_acquire(void *cookie) { dma_rmb(); }
+
+static int agx21_stage_native_iomaps(struct platform_device *pdev,
+				     struct agx21_transport *t)
+{
+	struct resource *sgx_res, *fender_res;
+	u64 sw_pa = AGX21_J171_SW_INTERRUPT_PA;
+	u32 variant_selector, slot_counts;
+	int ret;
+
+	if (!t->owner)
+		return -EINVAL;
+	sgx_res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sgx");
+	fender_res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "fender");
+	if (!sgx_res || !fender_res || resource_size(sgx_res) < 0x401c ||
+	    resource_size(fender_res) < 0x5000)
+		return -EINVAL;
+	ret = of_property_read_u64(pdev->dev.of_node,
+				   "apple,g11-meta-sw-interrupt-pa", &sw_pa);
+	if (ret && ret != -EINVAL && ret != -ENODATA)
+		return ret;
+	if (agx21_g11_revision != AGX21_G11_B0 ||
+	    agx21_gtp_slots != 2 || agx21_frg_slots != 3) {
+		dev_err(&pdev->dev,
+			"GFX TEST needs verified J171 B0/2-GTP/3-FRG capability; refusing pre-ASC SGX MMIO read\n");
+		return -ENODATA;
+	}
+	/* Existing serializers inspect only the G11 family/revision and the two
+	 * slot-count fields. Encode the verified decoded fields for those APIs;
+	 * do not pass these representatives off as raw MMIO register captures. */
+	variant_selector = 0x02000000U | 0x1000U;
+	slot_counts = (agx21_gtp_slots << 16) | (agx21_frg_slots << 20);
+	ret = agx21_write_native_iomaps(
+		agx21_memory_cpu(&t->owner->memory, AGX21_MEM_HWB),
+		t->owner->memory.objects[AGX21_MEM_HWB].size, variant_selector,
+		sgx_res->start, fender_res->start, sw_pa);
+	if (ret)
+		return -EINVAL;
+	ret = agx21_write_native_slot_masks(
+		agx21_memory_cpu(&t->owner->memory, AGX21_MEM_HWB),
+		t->owner->memory.objects[AGX21_MEM_HWB].size, slot_counts);
+	if (ret)
+		return -EINVAL;
+	dev_info(&pdev->dev,
+		 "GFX TEST native IO maps (decoded iOS capability): G11 B0 GTP=%u FRG=%u CDM=1 masks=3/7/1 SGX=%pa Fender=%pa SWI=%#llx\n",
+		 agx21_gtp_slots, agx21_frg_slots,
+		 &sgx_res->start, &fender_res->start, sw_pa);
+	return 0;
+}
+
+int agx21_transport_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct agx21_transport *t;
+	struct agx21_power_tables *power;
+	const char *failed = "rtkit-boot";
+	int ret;
+	t = devm_kzalloc(dev, sizeof(*t), GFP_KERNEL);
+	power = devm_kzalloc(dev, sizeof(*power), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+	if (!power)
+		return -ENOMEM;
+	t->crashlog_raw = devm_kmalloc(dev, AGX21_CRASHLOG_MAX, GFP_KERNEL);
+	if (!t->crashlog_raw)
+		return -ENOMEM;
+	t->dev = dev;
+	mutex_init(&t->asahi_lock);
+	INIT_DELAYED_WORK(&t->check_work, agx21_check_work);
+	atomic_set(&t->check_messages, 0);
+	t->stage = "preflight";
+	ret = agx21_read_power_tables(dev, power);
+	if (ret)
+		return dev_err_probe(dev, ret, "GFX J171 invalid live power handoff\n");
+	/* The experimental DT currently exports the perf arrays but not the
+	 * J171 ADT's policy scalars. Use the two values independently pinned to
+	 * the captured 21B91 J171 ADT only in this opt-in sparse-init run.
+	 * Normal transport and any future native policy path remain unchanged. */
+	{
+		if (!(power->policy_present & (1ULL << 12))) {
+			power->policy[12] = 16; /* gpu-power-sample-period */
+			power->policy_present |= 1ULL << 12;
+			dev_info(dev, "GFX J171 J171 ADT sample period fallback: 16 ms\n");
+		}
+		if (!(power->policy_present & 1)) {
+			power->policy[0] = 5160; /* gpu-device-max-power */
+			power->policy_present |= 1;
+			dev_info(dev, "GFX J171 J171 ADT device max power fallback: 5160\n");
+		}
+	}
+	ret = agx21_segment_validate(dev, t);
+	if (ret)
+		return dev_err_probe(dev, ret, "GFX J171 missing/invalid reserved segments\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+	{
+		struct agx21_memory *m;
+		u8 *hwa, *hwb;
+		u8 *region_c;
+		const char *policy_stage = "bootstrap";
+		t->owner = agx21_dma_owner_create(dev);
+		if (IS_ERR(t->owner)) {
+			ret = PTR_ERR(t->owner);
+			t->owner = NULL;
+			return dev_err_probe(dev, ret, "GFX J171 native DMA ownership failed\n");
+		}
+		m = &t->owner->memory;
+		hwa = agx21_memory_cpu(m, AGX21_MEM_HWA);
+		hwb = agx21_memory_cpu(m, AGX21_MEM_HWB);
+		region_c = agx21_memory_cpu(m, AGX21_MEM_C);
+		/* Native publisher 0x845ebac resets HWA before its policy
+		 * stores, retaining only the qword at +0x4338. This owner has
+		 * not bound any HWA graph pointers yet. Keep this preflight
+		 * unpublished until all native policy fields are proven. */
+		ret = agx21_reset_native_hwa(hwa,
+			m->objects[AGX21_MEM_HWA].size);
+		if (ret)
+			return dev_err_probe(dev, -EINVAL,
+				"GFX J171 native HWA reset failed\n");
+		/* Replay only the iPad-native fields already validated from the
+		 * live power handoff. This is deliberately not full HWData policy,
+		 * and must not set hardware_a_policy_ready or publish InitData. */
+		ret = agx21_write_native_bootstrap_fields(hwb,
+			m->objects[AGX21_MEM_HWB].size, region_c,
+			m->objects[AGX21_MEM_C].size);
+		/* Captured J171 ADT omits both keepalive overrides and all three
+		 * idle-off timing overrides. The handoff can explicitly carry the
+		 * fender delay; use it when present rather than discarding it.
+		 * These are only sparse fields, not a complete C policy. */
+		if (!ret)
+			policy_stage = "region-c-keepalive";
+		if (!ret)
+			ret = agx21_write_region_c_keepalive(region_c,
+				m->objects[AGX21_MEM_C].size, 100, 100);
+		if (!ret)
+			policy_stage = "region-c-timing";
+		if (!ret)
+			ret = agx21_write_region_c_timing(region_c,
+				m->objects[AGX21_MEM_C].size, 0,
+				(power->policy_present & (1ULL << 29)) ?
+				power->policy[29] : 40, 5);
+		if (!ret)
+			policy_stage = "region-c-late-defaults";
+		if (!ret)
+			ret = agx21_write_region_c_late_defaults(region_c,
+				m->objects[AGX21_MEM_C].size);
+		/* J171 G11P identity decode leaves DVMR flag (+1017) zero:
+		 * vtable+3184 only writes neighboring +106, so start copies the
+		 * raw perf table to +12800. The effective count is power->states. */
+		if (!ret)
+			policy_stage = "region-c-perf-range";
+		if (!ret)
+			ret = agx21_write_region_c_perf_range(region_c,
+				m->objects[AGX21_MEM_C].size, power->states);
+		if (!ret)
+			policy_stage = "model-slow";
+		if (!ret)
+			ret = agx21_write_j171_model_slow_policy(hwb,
+				m->objects[AGX21_MEM_HWB].size, region_c,
+				m->objects[AGX21_MEM_C].size, 0);
+		if (!ret)
+			policy_stage = "initial-target";
+		if (!ret)
+			ret = agx21_write_j171_initial_target_policy(region_c,
+				m->objects[AGX21_MEM_C].size, power);
+		if (!ret && (power->policy_present & (1ULL << 12)))
+			policy_stage = "hwb-controls";
+		if (!ret && (power->policy_present & (1ULL << 12)))
+			ret = agx21_write_native_hwb_controls(hwb,
+				m->objects[AGX21_MEM_HWB].size, power->policy[12]);
+		else if (!ret)
+			ret = -EINVAL;
+		if (!ret)
+			policy_stage = "hwb-perf-tables";
+		if (!ret)
+			ret = agx21_patch_hwdata_tables(hwb, m->objects[AGX21_MEM_HWB].size,
+			power->mhz, power->core, power->sram, power->states);
+		if (!ret)
+			policy_stage = "hwb-transfer-tables";
+		if (!ret)
+			ret = agx21_write_transfer_tables(hwb,
+				m->objects[AGX21_MEM_HWB].size, power);
+		if (!ret)
+			policy_stage = "hwa-perf-boost";
+		if (!ret)
+			ret = agx21_write_j171_perf_boost_defaults(hwa,
+				m->objects[AGX21_MEM_HWA].size);
+		if (!ret)
+			policy_stage = "hwa-primary-controller";
+		if (!ret)
+			ret = agx21_write_primary_controller(hwa,
+				m->objects[AGX21_MEM_HWA].size, power,
+				arch_timer_read_counter());
+		if (!ret)
+			policy_stage = "hwa-se-controller";
+		if (!ret)
+			ret = agx21_write_se_controller_sparse(hwa,
+				m->objects[AGX21_MEM_HWA].size, power);
+		if (ret)
+			return dev_err_probe(dev, -EINVAL,
+				"GFX J171 native sparse power-policy staging failed at %s\n",
+				policy_stage);
+		/* Explicit zero policy for a non-published test owner. The native
+		 * client policy byte still requires hardware validation before work.
+		 */
+		ret = agx21_queue_context_initialize(&t->owner->memory, 0);
+		if (ret)
+			return dev_err_probe(dev, -EINVAL, "GFX J171 native queue context failed\n");
+		/* The native initializer leaves queue priority at sentinel 4. Its
+		 * setPriority path must run before the firmware callback sees work.
+		 * Priority 0 selects firmware's bounded per-priority slot 0. */
+        ret = agx21_queue_set_test_priority_zero(&t->owner->memory, 0);
+        if (ret) return ret;
+		ret = agx21_event_control_initialize(&t->owner->memory);
+		if (ret)
+			return dev_err_probe(dev, -EINVAL, "GFX J171 native event control failed\n");
+        {
+            unsigned int ctx;
+            ret = 0;
+            for (ctx = AGX21_TEST_CONTEXT; !ret && ctx < AGX21_CONTEXTS; ctx++)
+                ret = agx21_memory_enable_context(&t->owner->memory, ctx);
+            if (ret) return ret;
+        }
+		{
+			struct agx21_memory *m = &t->owner->memory;
+			struct agx21_render_staging render_staging;
+			unsigned int i;
+
+			ret = agx21_memory_reserve_render_staging(m,
+				&render_staging);
+			if (ret)
+				return dev_err_probe(dev, -ENOSPC,
+					"GFX RENDER preflight: TA/3D workspace reservation failed\n");
+			ret = agx21_queue_initialize_render_staging(m,
+				&render_staging);
+			if (ret)
+				return dev_err_probe(dev, -EINVAL,
+					"GFX RENDER preflight: native queue headers failed\n");
+			{
+				struct agx21_render_resources resources;
+				ret = agx21_memory_reserve_render_resources(m,
+					&resources);
+				if (ret)
+					return dev_err_probe(dev, -ENOSPC,
+						"GFX RENDER: bounded resources unavailable\n");
+				ret = agx21_queue_stage_render_policy_candidate(m);
+				if (ret)
+					return dev_err_probe(dev, -EINVAL,
+						"GFX RENDER: queue policy staging failed\n");
+			}
+			for (i = 0; i < 2; i++) {
+				unsigned int j;
+				for (j = 0; j < 5; j++)
+					if (!agx21_memory_firmware_va(m,
+						render_staging.queue[i][j]))
+						return -EINVAL;
+				if (!agx21_memory_firmware_va(m,
+					render_staging.command[i]))
+					return -EINVAL;
+			}
+			dev_info(dev,
+				 "GFX RENDER preflight: TA/3D queue headers staged; free=%u bytes; no render submission\n",
+				 m->size - m->used);
+		}
+	}
+	t->asc = devm_platform_ioremap_resource_byname(pdev, "asc");
+	if (IS_ERR(t->asc))
+		return PTR_ERR(t->asc);
+	dev_set_drvdata(dev, t);
+	ret = devm_device_add_group(dev, &agx21_group);
+	if (ret)
+		return ret;
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+	if (agx21_fault_probe) {
+		ret = agx21_power_diag_setup(pdev, t);
+		if (ret) {
+			pm_runtime_put_sync(dev);
+			return dev_err_probe(dev, ret,
+				"GFX POWER DIAG invalid J171 MMIO windows\n");
+		}
+	}
+	{
+		ret = agx21_stage_native_iomaps(pdev, t);
+		if (ret) {
+			pm_runtime_put_sync(dev);
+			return dev_err_probe(dev, ret,
+				"GFX J171 native IO-map staging failed before ASC RUN\n");
+		}
+		{
+			ret = agx21_bind_sparse_test_graph(&t->owner->memory.graph);
+			if (ret) {
+				pm_runtime_put_sync(dev);
+				return dev_err_probe(dev, -EINVAL,
+					"GFX J171 sparse structural InitData binding failed\n");
+			}
+			{
+				ret = agx21_render_bind_pm_slots(&t->owner->memory);
+				if (ret) {
+					pm_runtime_put_sync(dev);
+					return dev_err_probe(dev, -EINVAL,
+						"GFX RENDER PM slot table binding failed\n");
+				}
+				dev_info(dev, "GFX PM TABLE pre-publish gpu=%#llx firmware=%#llx\n",
+					(unsigned long long)get_unaligned_le64(
+					 agx21_memory_cpu(&t->owner->memory, AGX21_MEM_B) + 0x2c8),
+					(unsigned long long)get_unaligned_le64(
+					 agx21_memory_cpu(&t->owner->memory, AGX21_MEM_B) + 0x2d0));
+			}
+
+		}
+	}
+	t->control_before = readl(t->asc + AGX21_ASC_CONTROL);
+	if (t->control_before & AGX21_ASC_RUN) {
+		pm_runtime_put_sync(dev);
+		return dev_err_probe(dev, -EALREADY, "GFX J171 refuses to restart running ASC\n");
+	}
+	t->rtk = devm_apple_rtkit_init(dev, t, NULL, 0, &agx21_transport_ops);
+	if (IS_ERR(t->rtk)) {
+		ret = PTR_ERR(t->rtk);
+		pm_runtime_put_sync(dev);
+		return dev_err_probe(dev, ret, "GFX J171 mailbox/RTKit setup failed\n");
+	}
+	/* Pin this module and PM reference before RUN: even a failed test must
+	 * retain all callbacks and shared memory. No unbind attributes exist.
+	 */
+	__module_get(THIS_MODULE);
+	if (t->owner)
+		agx21_dma_owner_retain_live(t->owner);
+	WRITE_ONCE(t->stage, "starting");
+	dev_info(dev, "GFX J171 starting ASC; %u states/%u tables\n", power->states, power->tables);
+	writel(t->control_before | AGX21_ASC_RUN, t->asc + AGX21_ASC_CONTROL);
+	t->control_after = readl(t->asc + AGX21_ASC_CONTROL);
+	/* RTKit library uses a 1-second timeout for each handshake completion. */
+	ret = apple_rtkit_boot(t->rtk);
+	if (ret)
+		goto failed_running;
+	if (!apple_rtkit_is_running(t->rtk) || atomic_read(&t->crashed)) {
+		ret = -EIO;
+		goto failed_running;
+	}
+	WRITE_ONCE(t->stage, "management-ready");
+	dev_info(dev, "GFX J171 management handshake complete\n");
+	failed = "endpoint-20";
+	ret = apple_rtkit_start_ep(t->rtk, 0x20);
+	if (ret)
+		goto failed_running;
+	failed = "endpoint-21";
+	ret = apple_rtkit_start_ep(t->rtk, 0x21);
+	if (ret)
+		goto failed_running;
+	/* API verifies endpoints were advertised, then sends start requests;
+	 * it does NOT provide a separate application-endpoint acknowledgement.
+	 */
+	dev_info(dev, "GFX J171 endpoints 0x20/0x21 advertised; start requests sent\n");
+	msleep(500);
+	if (atomic_read(&t->crashed) || !apple_rtkit_is_running(t->rtk)) {
+		failed = "post-start-health";
+		ret = -EIO;
+		goto failed_running;
+	}
+	{
+		u8 *status = agx21_memory_cpu(&t->owner->memory, AGX21_MEM_STARTUP);
+		u8 *hwb = agx21_memory_cpu(&t->owner->memory, AGX21_MEM_HWB);
+		unsigned int tries;
+
+		failed = "sparse-init-ack";
+		if (!status || t->owner->memory.init_pa >= (1ULL << 48)) {
+			ret = -EINVAL;
+			goto failed_running;
+		}
+		/* BadApple's 1/1 power-mode policy is the fixed experiment baseline.
+		 * The J171 firmware reads these words during InitData handling; keep
+		 * the write before publication and fail closed on invalid HWData. */
+		ret = agx21_write_badapple_power_mode(hwb,
+			t->owner->memory.objects[AGX21_MEM_HWB].size);
+		if (ret) {
+			failed = "badapple-power-mode";
+			goto failed_running;
+		}
+		dev_info(dev,
+			 "GFX J171 J171 power gate 1/1 at HWB+0xa38/+0xa40 (fixed BadApple baseline)\n");
+		dma_wmb();
+		t->owner->memory.published = 1;
+		t->init_attempted = true;
+		WRITE_ONCE(t->stage, "sparse-init-sent");
+		ret = apple_rtkit_send_message(t->rtk, 0x20,
+			(0x81ULL << 48) | t->owner->memory.init_pa, NULL, false);
+		if (ret)
+			goto failed_running;
+		for (tries = 0; tries < 200; tries++) {
+			if (atomic_read(&t->crashed)) {
+				ret = -EIO;
+				goto failed_running;
+			}
+			dma_rmb();
+			t->init_status = READ_ONCE(*(u32 *)(status + 0x14));
+			if (t->init_status)
+				break;
+			msleep(10);
+		}
+		if (t->init_status != 1) {
+			ret = t->init_status ? -EPROTO : -ETIMEDOUT;
+			goto failed_running;
+		}
+		WRITE_ONCE(t->stage, "sparse-init-ack");
+		dev_info(dev, "GFX J171 sparse InitData ACK=1; no compute submitted\n");
+		/* J171 firmware schedules its agx_power thread after the InitData
+		 * handler returns. An immediate ACK snapshot can predate the initial
+		 * state-1 event. Observe it without replaying BadApple's XS-only
+		 * type-27 control record or issuing any Fender/PMGR writes.
+		 */
+		{
+			struct agx21_protocol *p = &t->asahi_protocol;
+
+			failed = "asahi-register";
+			p->memory = &t->owner->memory;
+			p->phase = AGX21_PROTOCOL_READY;
+			p->max_jobs = 255;
+			p->generic_mode = 1;
+			p->custom_job = 1;
+			p->command_object = AGX21_MEM_COMMAND;
+			p->microseq_object = AGX21_MEM_MICROSEQUENCE;
+			p->event_object = AGX21_MEM_EVENT_CONTROL;
+			p->scratch_object = AGX21_MEM_SCRATCH;
+			p->io = (struct agx21_protocol_io) {
+				.cookie = t, .send = agx21_compute_send,
+				.now_ms = agx21_compute_now,
+				.sleep_ms = agx21_compute_sleep,
+				.crashed = agx21_compute_crashed,
+				.release = agx21_compute_release,
+				.acquire = agx21_compute_acquire,
+			};
+			t->asahi = agx21_asahi_register(pdev, t, &t->owner->memory);
+			if (IS_ERR(t->asahi)) {
+				ret = PTR_ERR(t->asahi);
+				t->asahi = NULL;
+				goto failed_running;
+			}
+			WRITE_ONCE(t->check_ready, true);
+			schedule_delayed_work(&t->check_work, msecs_to_jiffies(10));
+			WRITE_ONCE(t->stage, "asahi-ready");
+			dev_info(dev, "GFX ASAHI J171 render node ready\n");
+		}
+		return 0;
+	}
+failed_running:
+	WRITE_ONCE(t->error, ret);
+	if (!atomic_read(&t->crashed))
+		WRITE_ONCE(t->stage, failed);
+	dev_err(dev, "GFX J171 FAIL at %s: %d; preserving live resources, reboot required\n", failed, ret);
+	/* Deliberately bind with recorded failure instead of freeing live DMA. */
+	return 0;
+}
+
diff --git a/drivers/gpu/drm/agx/agx_drv.c b/drivers/gpu/drm/agx/agx_drv.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_drv.c
@@ -0,0 +1,861 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * DRM driver for the Apple A12 GPU (AGX G11P). It speaks the
+ * Asahi uAPI (include/uapi/drm/asahi_drm.h) where the hardware allows:
+ *
+ *  - USC addresses are relative to AGX_USC_BASE, which the firmware loads
+ *    for every context, so queues must use it as usc_exec_base.
+ *  - No helper programs, layered or very large renders, or single-page
+ *    binds yet.
+ *    Sampler heaps and timestamps are accepted and ignored; timestamp
+ *    objects are only kept so that Mesa can bind them.
+ *  - Each compute or render command is one scheduler job. Every queue is an entity
+ *    on the one scheduler, which runs one job at a time, so the commands
+ *    of a submit run in order. In-syncs gate the first, out-syncs get the
+ *    last one's fence.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <drm/asahi_drm.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_file.h>
+#include <drm/drm_gem_shmem_helper.h>
+#include <drm/drm_ioctl.h>
+#include <drm/drm_syncobj.h>
+#include <drm/gpu_scheduler.h>
+#include <linux/dma-fence-chain.h>
+#include <linux/dma-mapping.h>
+#include <linux/dmapool.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/xarray.h>
+
+#include "agx.h"
+#include "agx_21b91_memory.h"
+#include "agx_21b91_power.h"
+
+#define MAX_COMMANDS	64
+#define MAX_SYNCS	64
+#define JOB_TIMEOUT_MS	5000
+
+struct agx_queue {
+	struct agx_vm *vm;
+	struct drm_sched_entity entity;
+};
+
+struct agx_job {
+	struct drm_sched_job base;
+	struct agx_vm *vm;
+	u64 stream;
+	struct drm_asahi_cmd_render *render;	/* or a compute stream */
+	struct agx_bo_capture *bo_capture;
+};
+
+#define to_job(j) container_of(j, struct agx_job, base)
+
+struct agx_file {
+	struct xarray vms;
+	struct xarray queues;
+	struct xarray objects;	/* GEM objects bound for timestamps */
+	struct mutex lock;	/* VMs against the queues that use them */
+};
+
+/* Waits up to the timeout for the queue's jobs, then drops the rest. */
+static void agx_queue_free(struct agx_queue *q)
+{
+	drm_sched_entity_destroy(&q->entity);
+	agx_vm_put(q->vm);
+	kfree(q);
+}
+
+static int agx_open(struct drm_device *drm, struct drm_file *file)
+{
+	struct agx_file *af = kzalloc(sizeof(*af), GFP_KERNEL);
+
+	if (!af)
+		return -ENOMEM;
+	xa_init_flags(&af->vms, XA_FLAGS_ALLOC1);
+	xa_init_flags(&af->queues, XA_FLAGS_ALLOC1);
+	xa_init_flags(&af->objects, XA_FLAGS_ALLOC1);
+	mutex_init(&af->lock);
+	file->driver_priv = af;
+	return 0;
+}
+
+static void agx_postclose(struct drm_device *drm, struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+	struct drm_gem_object *obj;
+	struct agx_queue *q;
+	struct agx_vm *vm;
+	unsigned long id;
+
+	xa_for_each(&af->objects, id, obj)
+		drm_gem_object_put(obj);
+	xa_for_each(&af->queues, id, q)
+		agx_queue_free(q);
+	xa_for_each(&af->vms, id, vm)
+		agx_vm_put(vm);
+	xa_destroy(&af->objects);
+	xa_destroy(&af->queues);
+	xa_destroy(&af->vms);
+	kfree(af);
+}
+
+static int agx_get_params(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_get_params *args = data;
+	struct drm_asahi_params_global p = {
+		.gpu_generation = 11,
+		.gpu_variant = 'P',
+		.gpu_revision = 0x11,
+		.chip_id = 0x8020,
+		.num_dies = 1,
+		.num_clusters_total = 1,
+		.num_cores_per_cluster = 4,
+		.max_frequency_khz = 1098000,
+		.core_masks = { 0xf },
+		.vm_start = AGX_VM_START,
+		.vm_end = AGX_VM_END,
+		.vm_kernel_min_size = AGX_PAGE,
+		.max_commands_per_submission = MAX_COMMANDS,
+		.command_timestamp_frequency_hz = 1000000000,
+	};
+	if (to_agx(drm)->ipad_memory)
+		p.command_timestamp_frequency_hz = 24000000;
+	if (to_agx(drm)->ipad_memory)
+		p.gpu_revision = 0x10; /* J171 G11P_B0, not XS's B1 */
+
+	if (args->param_group || args->pad)
+		return -EINVAL;
+	if (copy_to_user(u64_to_user_ptr(args->pointer), &p, min_t(u64, args->size, sizeof(p))))
+		return -EFAULT;
+	return 0;
+}
+
+static int agx_get_time(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_get_time *args = data;
+
+	if (args->flags)
+		return -EINVAL;
+	args->gpu_timestamp = ktime_get_ns();
+	return 0;
+}
+
+static int agx_vm_create_ioctl(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_create *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+	int ret;
+
+	if (args->pad)
+		return -EINVAL;
+	vm = agx_vm_create(to_agx(drm), args->kernel_start, args->kernel_end);
+	if (IS_ERR(vm))
+		return PTR_ERR(vm);
+	ret = xa_alloc(&af->vms, &args->vm_id, vm, xa_limit_32b, GFP_KERNEL);
+	if (ret)
+		agx_vm_put(vm);
+	return ret;
+}
+
+/* Queues and jobs keep their own references. */
+static int agx_vm_destroy_ioctl(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_destroy *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+
+	if (args->pad)
+		return -EINVAL;
+	mutex_lock(&af->lock);
+	vm = xa_erase(&af->vms, args->vm_id);
+	mutex_unlock(&af->lock);
+	if (!vm)
+		return -ENOENT;
+	agx_vm_put(vm);
+	return 0;
+}
+
+static int agx_vm_bind_ioctl(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_bind *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+	u32 i;
+	int ret = 0;
+
+	if (args->pad || args->stride < sizeof(struct drm_asahi_gem_bind_op) ||
+	    args->num_binds > 256)
+		return -EINVAL;
+
+	mutex_lock(&af->lock);
+	vm = xa_load(&af->vms, args->vm_id);
+	if (!vm) {
+		ret = -ENOENT;
+		goto out;
+	}
+	for (i = 0; i < args->num_binds && !ret; i++) {
+		struct drm_asahi_gem_bind_op op;
+		struct drm_gem_object *obj;
+
+		if (copy_from_user(&op, u64_to_user_ptr(args->userptr + (u64)i * args->stride),
+				   sizeof(op))) {
+			ret = -EFAULT;
+			break;
+		}
+		if (op.flags & ~(DRM_ASAHI_BIND_UNBIND | DRM_ASAHI_BIND_READ |
+				 DRM_ASAHI_BIND_WRITE | DRM_ASAHI_BIND_SINGLE_PAGE)) {
+			ret = -EINVAL;
+			break;
+		}
+		if (op.flags & DRM_ASAHI_BIND_UNBIND) {
+			ret = agx_vm_unbind(vm, op.addr, op.range);
+			continue;
+		}
+		if (!(op.flags & DRM_ASAHI_BIND_READ)) {
+			ret = -EINVAL;
+			break;
+		}
+		obj = drm_gem_object_lookup(file, op.handle);
+		if (!obj) {
+			ret = -ENOENT;
+			break;
+		}
+		ret = agx_vm_bind(vm, obj, op.offset, op.range, op.addr,
+				  op.flags & DRM_ASAHI_BIND_WRITE,
+				  op.flags & DRM_ASAHI_BIND_SINGLE_PAGE);
+		drm_gem_object_put(obj);
+	}
+out:
+	mutex_unlock(&af->lock);
+	return ret;
+}
+
+static int agx_gem_bind_object(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_bind_object *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct drm_gem_object *obj;
+	int ret;
+
+	if (args->vm_id || args->pad)
+		return -EINVAL;
+	switch (args->op) {
+	case DRM_ASAHI_BIND_OBJECT_OP_BIND:
+		if (args->flags != DRM_ASAHI_BIND_OBJECT_USAGE_TIMESTAMPS)
+			return -EINVAL;
+		obj = drm_gem_object_lookup(file, args->handle);
+		if (!obj)
+			return -ENOENT;
+		if (args->offset >= obj->size || args->range > obj->size - args->offset) {
+			drm_gem_object_put(obj);
+			return -EINVAL;
+		}
+		ret = xa_alloc(&af->objects, &args->object_handle, obj, xa_limit_32b, GFP_KERNEL);
+		if (ret)
+			drm_gem_object_put(obj);
+		return ret;
+	case DRM_ASAHI_BIND_OBJECT_OP_UNBIND:
+		obj = xa_erase(&af->objects, args->object_handle);
+		if (!obj)
+			return -ENOENT;
+		drm_gem_object_put(obj);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static void agx_gem_close(struct drm_gem_object *obj, struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+	struct agx_vm *vm;
+	unsigned long id;
+
+	mutex_lock(&af->lock);
+	xa_for_each(&af->vms, id, vm)
+		agx_vm_unmap_object(vm, obj);
+	mutex_unlock(&af->lock);
+}
+
+static const struct drm_gem_object_funcs agx_gem_funcs = {
+	.free = drm_gem_shmem_object_free,
+	.close = agx_gem_close,
+	.print_info = drm_gem_shmem_object_print_info,
+	.pin = drm_gem_shmem_object_pin,
+	.unpin = drm_gem_shmem_object_unpin,
+	.get_sg_table = drm_gem_shmem_object_get_sg_table,
+	.vmap = drm_gem_shmem_object_vmap,
+	.vunmap = drm_gem_shmem_object_vunmap,
+	.mmap = drm_gem_shmem_object_mmap,
+	.vm_ops = &drm_gem_shmem_vm_ops,
+};
+
+/* The GPU does not snoop, so CPU mappings are always write-combined. */
+static struct drm_gem_object *agx_gem_create_object(struct drm_device *drm, size_t size)
+{
+	struct drm_gem_shmem_object *shmem = kzalloc(sizeof(*shmem), GFP_KERNEL);
+
+	if (!shmem)
+		return ERR_PTR(-ENOMEM);
+	shmem->base.funcs = &agx_gem_funcs;
+	shmem->map_wc = true;
+	return &shmem->base;
+}
+
+static int agx_gem_create(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_create *args = data;
+	struct drm_gem_shmem_object *shmem;
+	int ret;
+
+	if (args->pad || !args->size ||
+	    (args->flags & ~(DRM_ASAHI_GEM_WRITEBACK | DRM_ASAHI_GEM_VM_PRIVATE)))
+		return -EINVAL;
+
+	shmem = drm_gem_shmem_create(drm, round_up(args->size, AGX_PAGE));
+	if (IS_ERR(shmem))
+		return PTR_ERR(shmem);
+	/*
+	 * WRITEBACK is only a performance hint. Pin and map the pages now: that
+	 * cleans the cache lines left by zeroing them, which would otherwise
+	 * land on top of whatever userspace writes before the first bind.
+	 */
+	ret = PTR_ERR_OR_ZERO(drm_gem_shmem_get_pages_sgt(shmem));
+	if (!ret)
+		ret = drm_gem_handle_create(file, &shmem->base, &args->handle);
+	drm_gem_object_put(&shmem->base);
+	return ret;
+}
+
+static int agx_gem_mmap_offset(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_mmap_offset *args = data;
+	struct drm_gem_object *obj;
+	int ret;
+
+	if (args->flags)
+		return -EINVAL;
+	obj = drm_gem_object_lookup(file, args->handle);
+	if (!obj)
+		return -ENOENT;
+	ret = drm_gem_create_mmap_offset(obj);
+	if (!ret)
+		args->offset = drm_vma_node_offset_addr(&obj->vma_node);
+	drm_gem_object_put(obj);
+	return ret;
+}
+
+static int agx_queue_create(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_queue_create *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct drm_gpu_scheduler *sched = &to_agx(drm)->sched;
+	struct agx_queue *q;
+	int ret;
+
+	if (args->flags || args->priority > DRM_ASAHI_PRIORITY_MEDIUM ||
+	    args->usc_exec_base != AGX_USC_BASE)
+		return -EINVAL;
+
+	q = kzalloc(sizeof(*q), GFP_KERNEL);
+	if (!q)
+		return -ENOMEM;
+	ret = drm_sched_entity_init(&q->entity, DRM_SCHED_PRIORITY_NORMAL, &sched, 1, NULL);
+	if (ret) {
+		kfree(q);
+		return ret;
+	}
+	mutex_lock(&af->lock);
+	q->vm = xa_load(&af->vms, args->vm_id);
+	if (q->vm)
+		agx_vm_get(q->vm);
+	ret = q->vm ? xa_alloc(&af->queues, &args->queue_id, q, xa_limit_32b, GFP_KERNEL) : -ENOENT;
+	mutex_unlock(&af->lock);
+	if (ret) {
+		drm_sched_entity_destroy(&q->entity);
+		if (q->vm)
+			agx_vm_put(q->vm);
+		kfree(q);
+	}
+	return ret;
+}
+
+static int agx_queue_destroy(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_queue_destroy *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_queue *q;
+
+	if (args->pad)
+		return -EINVAL;
+	mutex_lock(&af->lock);
+	q = xa_erase(&af->queues, args->queue_id);
+	mutex_unlock(&af->lock);
+	if (!q)
+		return -ENOENT;
+	agx_queue_free(q);
+	return 0;
+}
+
+/*
+ * Check the command buffer and collect its commands: compute streams, or
+ * render commands, which point into cmdbuf. Attachment commands are only
+ * hints and are skipped. Returns the number of commands.
+ */
+static int agx_walk(const u8 *cmdbuf, u32 size, u64 *streams,
+		    const struct drm_asahi_cmd_render **renders)
+{
+	u32 o = 0, n = 0;
+
+	while (o < size) {
+		struct drm_asahi_cmd_header h;
+		struct drm_asahi_cmd_compute c = {};
+
+		if (size - o < sizeof(h))
+			return -EINVAL;
+		memcpy(&h, cmdbuf + o, sizeof(h));
+		o += sizeof(h);
+		if (h.size > size - o)
+			return -EINVAL;
+
+		switch (h.cmd_type) {
+		case DRM_ASAHI_CMD_COMPUTE:
+			memcpy(&c, cmdbuf + o, min_t(u32, h.size, sizeof(c)));
+			if (c.flags || c.helper.binary || !c.cdm_ctrl_stream_base)
+				return -EINVAL;
+			if (n == MAX_COMMANDS)
+				return -EINVAL;
+			streams[n++] = c.cdm_ctrl_stream_base;
+			break;
+		case DRM_ASAHI_CMD_RENDER:
+			/* J171 currently has a proven compute command only.  The
+			 * XS render producer must never reach 21B91 firmware. */
+			if (h.size != sizeof(**renders) || n == MAX_COMMANDS ||
+			    agx_fw_render_check((const void *)(cmdbuf + o)))
+				return -EINVAL;
+			renders[n++] = (const void *)(cmdbuf + o);
+			break;
+		case DRM_ASAHI_SET_VERTEX_ATTACHMENTS:
+		case DRM_ASAHI_SET_FRAGMENT_ATTACHMENTS:
+		case DRM_ASAHI_SET_COMPUTE_ATTACHMENTS:
+			break;
+		default:
+			return -EINVAL;
+		}
+		o += h.size;
+	}
+	return n ?: -EINVAL;
+}
+
+/* An out-sync, looked up before anything is queued so that nothing fails after. */
+struct agx_out {
+	struct drm_syncobj *syncobj;
+	struct dma_fence_chain *chain;
+	u64 point;
+};
+
+static int agx_get_outs(struct drm_file *file, const struct drm_asahi_sync *syncs, u32 n,
+			struct agx_out *outs)
+{
+	u32 i;
+
+	for (i = 0; i < n; i++) {
+		if (syncs[i].sync_type > DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ)
+			return -EINVAL;
+		outs[i].syncobj = drm_syncobj_find(file, syncs[i].handle);
+		if (!outs[i].syncobj)
+			return -ENOENT;
+		if (syncs[i].sync_type == DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ) {
+			outs[i].chain = dma_fence_chain_alloc();
+			if (!outs[i].chain)
+				return -ENOMEM;
+			outs[i].point = syncs[i].timeline_value;
+		}
+	}
+	return 0;
+}
+
+static void agx_put_outs(struct agx_out *outs, u32 n)
+{
+	u32 i;
+
+	for (i = 0; i < n; i++) {
+		dma_fence_chain_free(outs[i].chain);
+		if (outs[i].syncobj)
+			drm_syncobj_put(outs[i].syncobj);
+	}
+}
+
+static void agx_job_free(struct agx_job *job)
+{
+	agx_vm_capture_end(job->bo_capture);
+	drm_sched_job_cleanup(&job->base);
+	agx_vm_job_end(job->vm);
+	kfree(job->render);
+	kfree(job);
+}
+
+static int agx_submit(struct drm_device *drm, void *data, struct drm_file *file)
+{
+	struct drm_asahi_submit *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct drm_asahi_sync *syncs = NULL;
+	struct agx_job *jobs[MAX_COMMANDS] = {};
+	struct agx_out *outs = NULL;
+	struct dma_fence *done;
+	const struct drm_asahi_cmd_render **renders = NULL;
+	struct agx_queue *q;
+	u64 *streams;
+	u8 *cmdbuf;
+	int i, n, ret;
+
+	if (args->flags || args->pad || !args->cmdbuf_size || args->cmdbuf_size > SZ_64K ||
+	    args->in_sync_count > MAX_SYNCS || args->out_sync_count > MAX_SYNCS)
+		return -EINVAL;
+
+	cmdbuf = memdup_user(u64_to_user_ptr(args->cmdbuf), args->cmdbuf_size);
+	if (IS_ERR(cmdbuf))
+		return PTR_ERR(cmdbuf);
+	streams = kcalloc(MAX_COMMANDS, sizeof(*streams), GFP_KERNEL);
+	renders = kcalloc(MAX_COMMANDS, sizeof(*renders), GFP_KERNEL);
+	outs = kcalloc(args->out_sync_count, sizeof(*outs), GFP_KERNEL);
+	if (!streams || !renders || (args->out_sync_count && !outs)) {
+		ret = -ENOMEM;
+		goto out_free;
+	}
+	if (args->in_sync_count + args->out_sync_count) {
+		syncs = memdup_array_user(u64_to_user_ptr(args->syncs),
+					  args->in_sync_count + args->out_sync_count, sizeof(*syncs));
+		if (IS_ERR(syncs)) {
+			ret = PTR_ERR(syncs);
+			syncs = NULL;
+			goto out_free;
+		}
+	}
+	n = ret = agx_walk(cmdbuf, args->cmdbuf_size, streams, renders);
+	if (ret < 0)
+		goto out_free;
+	if (to_agx(drm)->ipad_memory &&
+	    !to_agx(drm)->ipad_memory->render_resources_reserved) {
+		for (i = 0; i < n; i++)
+			if (renders[i]) {
+				ret = -EOPNOTSUPP;
+				goto out_free;
+			}
+	}
+	ret = agx_get_outs(file, syncs + args->in_sync_count, args->out_sync_count, outs);
+	if (ret)
+		goto out_outs;
+
+	/* The file lock keeps the queue alive until its jobs are pushed. */
+	mutex_lock(&af->lock);
+	q = xa_load(&af->queues, args->queue_id);
+	if (!q) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	for (i = 0; i < n; i++) {
+		jobs[i] = kzalloc(sizeof(*jobs[i]), GFP_KERNEL);
+		if (!jobs[i]) {
+			ret = -ENOMEM;
+			goto out_jobs;
+		}
+		ret = drm_sched_job_init(&jobs[i]->base, &q->entity, 1, q, file->client_id);
+		if (ret) {
+			kfree(jobs[i]);
+			jobs[i] = NULL;
+			goto out_jobs;
+		}
+		jobs[i]->vm = agx_vm_job_start(q->vm);
+		jobs[i]->stream = streams[i];
+		if (renders[i]) {
+			jobs[i]->render = kmemdup(renders[i], sizeof(*renders[i]), GFP_KERNEL);
+			if (!jobs[i]->render) {
+				ret = -ENOMEM;
+				goto out_jobs;
+			}
+		}
+	}
+	for (i = 0; i < args->in_sync_count; i++) {
+		if (syncs[i].sync_type > DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ) {
+			ret = -EINVAL;
+			goto out_jobs;
+		}
+		ret = drm_sched_job_add_syncobj_dependency(&jobs[0]->base, file, syncs[i].handle,
+							   syncs[i].timeline_value);
+		if (ret)
+			goto out_jobs;
+	}
+
+	/* Nothing fails from here on. */
+	for (i = 0; i < n; i++) {
+		drm_sched_job_arm(&jobs[i]->base);
+		if (i == n - 1)
+			done = dma_fence_get(&jobs[i]->base.s_fence->finished);
+		drm_sched_entity_push_job(&jobs[i]->base);
+	}
+	mutex_unlock(&af->lock);
+
+	for (i = 0; i < args->out_sync_count; i++) {
+		if (outs[i].chain) {
+			drm_syncobj_add_point(outs[i].syncobj, outs[i].chain, done, outs[i].point);
+			outs[i].chain = NULL;
+		} else {
+			drm_syncobj_replace_fence(outs[i].syncobj, done);
+		}
+	}
+	dma_fence_put(done);
+	ret = 0;
+	goto out_outs;
+
+out_jobs:
+	for (i = 0; i < n && jobs[i]; i++)
+		agx_job_free(jobs[i]);
+out_unlock:
+	mutex_unlock(&af->lock);
+out_outs:
+	agx_put_outs(outs, args->out_sync_count);
+out_free:
+	kfree(syncs);
+	kfree(outs);
+	kfree(renders);
+	kfree(streams);
+	kfree(cmdbuf);
+	return ret;
+}
+
+static struct dma_fence *agx_run_job(struct drm_sched_job *sj)
+{
+	struct agx_job *job = to_job(sj);
+
+	if (job->render)
+		job->bo_capture = agx_vm_capture_begin(job->vm);
+	return agx_vm_run(job->vm, job->stream, job->render);
+}
+
+/*
+ * The GPU cannot be reset: agx_fw_timeout() either finds the job done or
+ * fails it and wedges the GPU. Either way its fence is signalled, and
+ * NO_HANG puts it back on the pending list to be freed.
+ */
+static enum drm_gpu_sched_stat agx_timedout_job(struct drm_sched_job *sj)
+{
+	agx_fw_timeout(container_of(sj->sched, struct agx_device, sched));
+	return DRM_GPU_SCHED_STAT_NO_HANG;
+}
+
+static void agx_free_job(struct drm_sched_job *sj)
+{
+	agx_job_free(to_job(sj));
+}
+
+static const struct drm_sched_backend_ops agx_sched_ops = {
+	.run_job = agx_run_job,
+	.timedout_job = agx_timedout_job,
+	.free_job = agx_free_job,
+};
+
+static const struct drm_ioctl_desc agx_ioctls[] = {
+	DRM_IOCTL_DEF_DRV(ASAHI_GET_PARAMS, agx_get_params, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GET_TIME, agx_get_time, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_CREATE, agx_vm_create_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_DESTROY, agx_vm_destroy_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_BIND, agx_vm_bind_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_CREATE, agx_gem_create, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_BIND_OBJECT, agx_gem_bind_object, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_MMAP_OFFSET, agx_gem_mmap_offset, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_QUEUE_CREATE, agx_queue_create, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_QUEUE_DESTROY, agx_queue_destroy, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_SUBMIT, agx_submit, DRM_RENDER_ALLOW),
+};
+
+DEFINE_DRM_GEM_FOPS(agx_fops);
+
+static const struct drm_driver agx_drm_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_RENDER | DRIVER_SYNCOBJ |
+			   DRIVER_SYNCOBJ_TIMELINE,
+	.open = agx_open,
+	.postclose = agx_postclose,
+	.ioctls = agx_ioctls,
+	.num_ioctls = ARRAY_SIZE(agx_ioctls),
+	.fops = &agx_fops,
+	.gem_create_object = agx_gem_create_object,
+	/* GPU binds require an already DMA-mapped imported SG table. */
+	.gem_prime_import_sg_table = drm_gem_shmem_prime_import_sg_table,
+	.dumb_create = drm_gem_shmem_dumb_create,
+	/* Mesa picks its driver by this name; this is the Asahi uAPI. */
+	.name = "asahi",
+	.desc = "Apple A12 GPU",
+	.major = 0,
+	.minor = 1,
+};
+
+static void agx_sched_fini(void *sched)
+{
+	drm_sched_fini(sched);
+}
+
+/* Register BadApple's Asahi uAPI only after the J171 transport has started
+ * its own 21B91 firmware and published its iPad-specific InitData.  None of
+ * the XS InitData, queue or power startup code is called on this path. */
+struct agx_device *agx21_asahi_register(struct platform_device *pdev,
+	void *transport, struct agx21_memory *m)
+{
+	struct device *dev = &pdev->dev;
+	struct agx_device *agx;
+	unsigned int i;
+	int ret;
+
+	if (!transport || !m || !m->published || m->size != AGX21_ARENA_BYTES)
+		return ERR_PTR(-EINVAL);
+	agx = devm_drm_dev_alloc(dev, &agx_drm_driver, struct agx_device, drm);
+	if (IS_ERR(agx))
+		return agx;
+	agx->dev = dev;
+	agx->ipad_memory = m;
+	agx->ipad_transport = transport;
+	agx->buf = m->arena;
+	agx->pa = m->arena_pa;
+	if (m->render_resources_reserved) {
+		ret = agx21_render_init(agx);
+		if (ret)
+			return ERR_PTR(ret);
+	}
+	mutex_init(&agx->ctx_lock);
+	spin_lock_init(&agx->fence_lock);
+	agx->fence_ctx = dma_fence_context_alloc(1);
+	for (i = 0; i < AGX_NR_CTX; i++)
+		agx->pc[i] = m->objects[AGX21_MEM_PC_BASE + i].offset;
+	agx->pd_pool = dmam_pool_create("j171-agx-pd", dev, 0x1000, AGX_PAGE, 0);
+	agx->pt_pool = dmam_pool_create("j171-agx-pt", dev, 0x400, AGX_PAGE, 0);
+	if (!agx->pd_pool || !agx->pt_pool)
+		return ERR_PTR(-ENOMEM);
+	ret = agx_vm_map_chunk(agx); /* verify, never replace, J171 shared map */
+	if (ret)
+		return ERR_PTR(ret);
+	ret = drm_sched_init(&agx->sched, &(struct drm_sched_init_args){
+		.ops = &agx_sched_ops,
+		.num_rqs = DRM_SCHED_PRIORITY_COUNT,
+		.credit_limit = 1,
+		.timeout = msecs_to_jiffies(JOB_TIMEOUT_MS),
+		.name = "j171-agx",
+		.dev = dev,
+	});
+	if (ret)
+		return ERR_PTR(ret);
+	ret = devm_add_action_or_reset(dev, agx_sched_fini, &agx->sched);
+	if (ret)
+		return ERR_PTR(ret);
+	ret = drm_dev_register(&agx->drm, 0);
+	if (ret)
+		return ERR_PTR(ret);
+	return agx;
+}
+
+static int agx_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct agx_device *agx;
+	struct resource *res;
+	void __iomem *asc;
+	int len, ret;
+
+	/* J171 has a different firmware ABI. The explicit test entry never
+	 * reaches the XS InitData, queues or render/compute methods below.
+	 */
+	if (of_machine_is_compatible("apple,j171a"))
+		return agx21_transport_probe(pdev);
+
+	agx = devm_drm_dev_alloc(dev, &agx_drm_driver, struct agx_device, drm);
+	if (IS_ERR(agx))
+		return PTR_ERR(agx);
+	agx->dev = dev;
+	mutex_init(&agx->ctx_lock);
+
+	agx->segs = of_get_property(dev->of_node, "apple,segment-ranges", &len);
+	agx->nsegs = agx->segs ? len / 32 : 0;
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "sgx");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no sgx registers\n");
+	agx->sgx = res->start;
+	/* The firmware owns these; only read the fault status after a hang. */
+	agx->rgx = devm_ioremap(dev, res->start, resource_size(res));
+	if (!agx->rgx)
+		return -ENOMEM;
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "fender");
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no fender registers\n");
+	agx->fender = res->start;
+
+	/* DRAM starts at 0x800000000, past the default 32 bit mask. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(64));
+	if (ret)
+		return ret;
+	asc = devm_platform_ioremap_resource_byname(pdev, "asc");
+	if (IS_ERR(asc))
+		return PTR_ERR(asc);
+
+	/* Page directories hold 512 u64s, page tables 128. */
+	/*
+	 * 16K aligned, as the firmware maps each table page into its own MMU
+	 * when it walks a context (FUN_00026744).
+	 */
+	agx->pd_pool = dmam_pool_create("agx-pd", dev, 0x1000, AGX_PAGE, 0);
+	agx->pt_pool = dmam_pool_create("agx-pt", dev, 0x400, AGX_PAGE, 0);
+	if (!agx->pd_pool || !agx->pt_pool)
+		return -ENOMEM;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	ret = agx_fw_init(agx, asc);
+	if (ret)
+		return ret;
+	ret = drm_sched_init(&agx->sched, &(struct drm_sched_init_args){
+		.ops = &agx_sched_ops,
+		.num_rqs = DRM_SCHED_PRIORITY_COUNT,
+		.credit_limit = 1,
+		.timeout = msecs_to_jiffies(JOB_TIMEOUT_MS),
+		.name = "agx",
+		.dev = dev,
+	});
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, agx_sched_fini, &agx->sched);
+	if (ret)
+		return ret;
+	return drm_dev_register(&agx->drm, 0);
+}
+
+static const struct of_device_id agx_of_match[] = {
+	{ .compatible = "cascadia,j171a-agx-21b91" },
+	{ .compatible = "apple,t8020-agx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, agx_of_match);
+
+static struct platform_driver agx_driver = {
+	.driver = {
+		.name = "agx",
+		.of_match_table = agx_of_match,
+		/* The firmware cannot be restarted. */
+		.suppress_bind_attrs = true,
+	},
+	.probe = agx_probe,
+};
+module_platform_driver(agx_driver);
+
+MODULE_AUTHOR("kiki <kieran@lavato.net>");
+MODULE_DESCRIPTION("DRM driver for the Apple A12 GPU (AGX G11P)");
+MODULE_LICENSE("Dual MIT/GPL");
