+/*
+ * Boot the firmware, hand it the init block and bring the GPU up. The
+ * firmware cannot be restarted, so this runs once per boot.
+ */
+int agx_fw_init(struct agx_device *agx, void __iomem *asc)
+{
+	struct device *dev = agx->dev;
+	dma_addr_t init_pa, table_pa;
+	void *init, *table, *buf;
+	u32 v;
+	int i, ret;
+
+	spin_lock_init(&agx->fence_lock);
+	agx->fence_ctx = dma_fence_context_alloc(1);
+	agx->rtk = devm_apple_rtkit_init(dev, agx, NULL, 0, &agx_rtk_ops);
+	if (IS_ERR(agx->rtk))
+		return dev_err_probe(dev, PTR_ERR(agx->rtk), "RTKit init failed\n");
+
+	writel(ASC_CPU_CONTROL_RUN, asc + ASC_CPU_CONTROL);
+
+	ret = apple_rtkit_boot(agx->rtk);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware did not boot\n");
+	ret = apple_rtkit_start_ep(agx->rtk, EP_MSGS);
+	if (!ret)
+		ret = apple_rtkit_start_ep(agx->rtk, EP_INTS);
+	if (ret)
+		return dev_err_probe(dev, ret, "endpoints did not start\n");
+	msleep(500);
+
+	init = dmam_alloc_coherent(dev, SZ_16K, &init_pa, GFP_KERNEL);
+	table = dmam_alloc_coherent(dev, SZ_16K, &table_pa, GFP_KERNEL);
+	buf = dmam_alloc_coherent(dev, AGX_CHUNK_SIZE, &agx->pa, GFP_KERNEL);
+	if (!init || !table || !buf)
+		return -ENOMEM;
+	agx->buf = buf;
+	agx_build(agx, init, table, table_pa);
+	ret = agx_vm_map_chunk(agx);
+	if (ret)
+		return ret;
+	wmb();
+	WRITE_ONCE(agx->ready, true);
+
+	apple_rtkit_send_message(agx->rtk, EP_MSGS, MSG_INIT | init_pa, NULL, false);
+	ret = readx_poll_timeout(READ_ONCE, *(u32 *)(buf + agx->C + 0xb198), v, v,
+				 10000, 2000000);
+	if (ret)
+		return dev_err_probe(dev, ret, "firmware did not take the init block\n");
+
+	/*
+	 * Device control type 0x1b only stores its argument, but it also
+	 * brings the GPU up, which sets up the scheduler state jobs need and
+	 * loads every context's page catalogue.
+	 */
+	put32(agx, agx->chan_ring[CH_DEVCTRL], 0x1b);
+	put64(agx, agx->chan_ring[CH_DEVCTRL] + 4, 0x1122334455667788);
+	put32(agx, agx->chan_state[CH_DEVCTRL] + 0x20, 1);
+	agx_doorbell(agx, 0x11);
+	ret = readx_poll_timeout(READ_ONCE, *(u32 *)(buf + agx->chan_state[CH_DEVCTRL]), v,
+				 v == 1, 10000, 3000000);
+	if (ret)
+		return dev_err_probe(dev, ret, "device control message not taken\n");
+	msleep(1000);
+
+	agx_queue(agx, &agx->cpq, 1);
+	agx_queue(agx, &agx->taq, 1);
+	agx_queue(agx, &agx->fragq, 0);
+	for (i = 0; i < NR_SLOTS; i++) {
+		agx->slot[i].cmd = agx_alloc(agx, 0x300, 0x100);
+		agx->slot[i].evc = agx_alloc(agx, 0x100, 0x100);
+		agx->slot[i].useq = agx_alloc(agx, 0x200, 0x100);
+		agx->slot[i].scratch = agx_alloc(agx, 0x100, 0x100);
+	}
+	agx_render_init(agx);
+	agx_debugfs(agx);
+	dev_info(dev, "firmware up, chunk at %pad\n", &agx->pa);
+	return 0;
+}
+
+/*
+ * After a page table change. FUN_00026514 compares each context's
+ * generation with its own copy (RegionB+0x1b0) before the context's next
+ * job, flushes the TLB if they differ and copies ours over; bits 31:22 ask
+ * for the full flush. Starting from its copy keeps them different however
+ * many changes come before that job.
+ */
+void agx_fw_flush_tlb(struct agx_device *agx, u32 ctx)
+{
+	wmb();
+	WRITE_ONCE(*(u32 *)(agx->buf + agx->gen + ctx * 4),
+		   READ_ONCE(*(u32 *)(agx->buf + agx->gen_fw + ctx * 4)) + BIT(22));
+}
diff --git a/drivers/gpu/drm/agx/agx_vm.c b/drivers/gpu/drm/agx/agx_vm.c
new file mode 100644
index 000000000..4dc96afc9
--- /dev/null
+++ b/drivers/gpu/drm/agx/agx_vm.c
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * GPU VMs. The MMU is a PowerVR Rogue S7 with 16K pages: a page catalogue
+ * of u32 entries (pd >> 12) << 4 | 1 for VA[39:30], page directories of u64
+ * entries pt | 3 for VA[29:21] and page tables of u64 entries page | 1 for
+ * VA[20:14], bit 1 marking a page read-only.
+ *
+ * Each VM owns one MMU context. Its page catalogue sits in the firmware
+ * chunk and is loaded by the firmware at every power-up; page directories
+ * and tables come from DMA pools. After a change the context's TLB
+ * generation is bumped and the firmware flushes before its next job.
+ *
+ * Queues and jobs hold references. Unbinds wait until no job of the VM is
+ * queued or running, so the GPU never sees pages that were given back.
+ *
+ * Copyright (c) 2026 kiki <kieran@lavato.net>
+ */
+
+#include <drm/drm_gem.h>
+#include <drm/drm_gem_shmem_helper.h>
+#include <linux/dma-mapping.h>
+#include <linux/dmapool.h>
+#include <linux/kref.h>
+#include <linux/list.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+#include <linux/wait.h>
+
+#include "agx.h"
+
+#define PC_ENTRIES	1024
+#define PD_ENTRIES	512
+#define PT_ENTRIES	128
+#define AGX_PTE_VALID	BIT(0)
+#define AGX_PTE_RO	BIT(1)
+
+struct agx_pt {
+	u64 *cpu;
+	dma_addr_t dma;
+};
+
+struct agx_pd {
+	u64 *cpu;
+	dma_addr_t dma;
+	struct agx_pt pt[PD_ENTRIES];
+};
+
+struct agx_mapping {
+	struct list_head node;
+	u64 addr, range;
+	struct drm_gem_object *obj;
+};
+
+struct agx_vm {
+	struct agx_device *agx;
+	struct kref ref;
+	atomic_t jobs;
+	wait_queue_head_t idle;
+	u32 ctx;
+	struct mutex lock;
+	struct list_head mappings;
+	u64 kernel_start, kernel_end;
+	void *scratch;		/* for RGX 0x14020, at kernel_start */
+	dma_addr_t scratch_dma;
+	struct agx_pd *pd[PC_ENTRIES];
+};
+
+static u32 *pc_entry(struct agx_vm *vm, u32 i)
+{
+	return vm->agx->buf + vm->agx->pc[vm->ctx] + i * 4;
+}
+
+static int agx_set_pte(struct agx_vm *vm, u64 va, u64 pte)
+{
+	struct agx_device *agx = vm->agx;
+	u32 i0 = (va >> 30) & (PC_ENTRIES - 1);
+	u32 i1 = (va >> 21) & (PD_ENTRIES - 1);
+	u32 i2 = (va >> 14) & (PT_ENTRIES - 1);
+	struct agx_pd *pd = vm->pd[i0];
+	struct agx_pt *pt;
+
+	if (!pd) {
+		if (!pte)
+			return 0;
+		pd = kzalloc(sizeof(*pd), GFP_KERNEL);
+		if (!pd)
+			return -ENOMEM;
+		pd->cpu = dma_pool_zalloc(agx->pd_pool, GFP_KERNEL, &pd->dma);
+		if (!pd->cpu) {
+			kfree(pd);
+			return -ENOMEM;
+		}
+		vm->pd[i0] = pd;
+		WRITE_ONCE(*pc_entry(vm, i0), (pd->dma >> 12) << 4 | 1);
+	}
+	pt = &pd->pt[i1];
+	if (!pt->cpu) {
+		if (!pte)
+			return 0;
+		pt->cpu = dma_pool_zalloc(agx->pt_pool, GFP_KERNEL, &pt->dma);
+		if (!pt->cpu)
+			return -ENOMEM;
+		WRITE_ONCE(pd->cpu[i1], pt->dma | 3);
+	}
+	WRITE_ONCE(pt->cpu[i2], pte);
+	return 0;
+}
+
+/*
+ * The whole chunk at AGX_CHUNK_GVA in every context, for structures the
+ * firmware and the parameter manager both read. User VMs end below it.
+ */
+int agx_vm_map_chunk(struct agx_device *agx)
+{
+	const u64 gva = AGX_CHUNK_GVA;
+	dma_addr_t pd_dma, pt_dma;
+	u64 *pd, *pt;
+	u32 i, j;
+
+	pd = dma_pool_zalloc(agx->pd_pool, GFP_KERNEL, &pd_dma);
+	if (!pd)
+		return -ENOMEM;
+	for (i = 0; i < AGX_CHUNK_SIZE / SZ_2M; i++) {
+		pt = dma_pool_zalloc(agx->pt_pool, GFP_KERNEL, &pt_dma);
+		if (!pt)
+			return -ENOMEM;
+		for (j = 0; j < PT_ENTRIES; j++)
+			pt[j] = (agx->pa + i * SZ_2M + j * AGX_PAGE) | AGX_PTE_VALID;
+		pd[(gva >> 21) % PD_ENTRIES + i] = pt_dma | 3;
+	}
+	/* Contexts below AGX_FIRST_CTX too: the parameter manager uses them. */
+	for (i = 0; i < AGX_NR_CTX; i++)
+		put_unaligned_le32((pd_dma >> 12) << 4 | 1,
+				   agx->buf + agx->pc[i] + (gva >> 30) % PC_ENTRIES * 4);
+	return 0;
+}
+
+static void clear_range(struct agx_vm *vm, u64 addr, u64 range)
+{
+	u64 va;
+
+	for (va = addr; va < addr + range; va += AGX_PAGE)
+		agx_set_pte(vm, va, 0);
+}
+
+static bool in_vm(u64 addr, u64 range)
+{
+	return addr >= AGX_VM_START && range <= AGX_VM_END - addr;
+}
+
+struct agx_vm *agx_vm_create(struct agx_device *agx, u64 kernel_start, u64 kernel_end)
+{
+	struct agx_vm *vm;
+	int ctx, ret;
+
+	if (!IS_ALIGNED(kernel_start | kernel_end, AGX_PAGE) || kernel_end < kernel_start + AGX_PAGE ||
+	    !in_vm(kernel_start, kernel_end - kernel_start))
+		return ERR_PTR(-EINVAL);
+
+	vm = kzalloc(sizeof(*vm), GFP_KERNEL);
+	if (!vm)
+		return ERR_PTR(-ENOMEM);
+	vm->agx = agx;
+	kref_init(&vm->ref);
+	init_waitqueue_head(&vm->idle);
+	vm->kernel_start = kernel_start;
+	vm->kernel_end = kernel_end;
+	mutex_init(&vm->lock);
+	INIT_LIST_HEAD(&vm->mappings);
+
+	mutex_lock(&agx->ctx_lock);
+	ctx = find_next_zero_bit(agx->ctx_used, AGX_NR_CTX, AGX_FIRST_CTX);
+	if (ctx < AGX_NR_CTX)
+		set_bit(ctx, agx->ctx_used);
+	mutex_unlock(&agx->ctx_lock);
+	if (ctx >= AGX_NR_CTX) {
+		kfree(vm);
+		return ERR_PTR(-EBUSY);
+	}
+	vm->ctx = ctx;
+
+	vm->scratch = dma_alloc_coherent(agx->dev, AGX_PAGE, &vm->scratch_dma, GFP_KERNEL);
+	ret = vm->scratch ? agx_set_pte(vm, kernel_start, vm->scratch_dma | AGX_PTE_VALID) : -ENOMEM;
+	if (ret) {
+		agx_vm_put(vm);
+		return ERR_PTR(ret);
+	}
+	agx_fw_flush_tlb(agx, ctx);
+	return vm;
+}
+
+static void agx_vm_release(struct kref *ref)
+{
+	struct agx_vm *vm = container_of(ref, struct agx_vm, ref);
+	struct agx_device *agx = vm->agx;
+	struct agx_mapping *m, *tmp;
+	int i, j;
+
+	list_for_each_entry_safe(m, tmp, &vm->mappings, node) {
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	for (i = 0; i < PC_ENTRIES; i++) {
+		struct agx_pd *pd = vm->pd[i];
+
+		if (!pd)
+			continue;
+		WRITE_ONCE(*pc_entry(vm, i), 0);
+		for (j = 0; j < PD_ENTRIES; j++)
+			if (pd->pt[j].cpu)
+				dma_pool_free(agx->pt_pool, pd->pt[j].cpu, pd->pt[j].dma);
+		dma_pool_free(agx->pd_pool, pd->cpu, pd->dma);
+		kfree(pd);
+	}
+	agx_fw_flush_tlb(agx, vm->ctx);
+	if (vm->scratch)
+		dma_free_coherent(agx->dev, AGX_PAGE, vm->scratch, vm->scratch_dma);
+
+	mutex_lock(&agx->ctx_lock);
+	clear_bit(vm->ctx, agx->ctx_used);
+	mutex_unlock(&agx->ctx_lock);
+	kfree(vm);
+}
+
+struct agx_vm *agx_vm_get(struct agx_vm *vm)
+{
+	kref_get(&vm->ref);
+	return vm;
+}
+
+void agx_vm_put(struct agx_vm *vm)
+{
+	kref_put(&vm->ref, agx_vm_release);
+}
+
+/* A job of this VM was queued; unbinds wait for agx_vm_job_end(). */
+struct agx_vm *agx_vm_job_start(struct agx_vm *vm)
+{
+	atomic_inc(&vm->jobs);
+	return agx_vm_get(vm);
+}
+
+void agx_vm_job_end(struct agx_vm *vm)
+{
+	if (atomic_dec_and_test(&vm->jobs))
+		wake_up_all(&vm->idle);
+	agx_vm_put(vm);
+}
+
+static bool overlaps(struct agx_vm *vm, u64 addr, u64 range)
+{
+	struct agx_mapping *m;
+
+	if (addr < vm->kernel_end && vm->kernel_start < addr + range)
+		return true;
+	list_for_each_entry(m, &vm->mappings, node)
+		if (addr < m->addr + m->range && m->addr < addr + range)
+			return true;
+	return false;
+}
+
+/* Map range bytes of obj from offset at addr. Binds may not overlap. */
+int agx_vm_bind(struct agx_vm *vm, struct drm_gem_object *obj, u64 offset, u64 range,
+		u64 addr, bool write)
+{
+	struct sg_table *sgt;
+	struct scatterlist *sg;
+	struct agx_mapping *m;
+	u64 pte_flags = AGX_PTE_VALID | (write ? 0 : AGX_PTE_RO);
+	u64 va = addr, skip = offset;
+	int i, ret;
+
+	if (!range || !IS_ALIGNED(offset | range | addr, AGX_PAGE) || !in_vm(addr, range) ||
+	    offset >= obj->size || range > obj->size - offset)
+		return -EINVAL;
+
+	sgt = drm_gem_shmem_get_pages_sgt(to_drm_gem_shmem_obj(obj));
+	if (IS_ERR(sgt))
+		return PTR_ERR(sgt);
+
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (!m)
+		return -ENOMEM;
+
+	mutex_lock(&vm->lock);
+	ret = -EBUSY;
+	if (overlaps(vm, addr, range))
+		goto err;
+
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		dma_addr_t dma = sg_dma_address(sg);
+		u64 len = sg_dma_len(sg);
+
+		if (skip >= len) {
+			skip -= len;
+			continue;
+		}
+		dma += skip;
+		len -= skip;
+		skip = 0;
+		for (; len && va < addr + range; len -= AGX_PAGE, dma += AGX_PAGE, va += AGX_PAGE) {
+			ret = agx_set_pte(vm, va, dma | pte_flags);
+			if (ret)
+				goto err_clear;
+		}
+		if (va == addr + range)
+			break;
+	}
+	ret = -EINVAL;
+	if (va != addr + range)
+		goto err_clear;
+
+	drm_gem_object_get(obj);
+	m->obj = obj;
+	m->addr = addr;
+	m->range = range;
+	list_add(&m->node, &vm->mappings);
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+	mutex_unlock(&vm->lock);
+	return 0;
+
+err_clear:
+	clear_range(vm, addr, va - addr);
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+err:
+	mutex_unlock(&vm->lock);
+	kfree(m);
+	return ret;
+}
+
+/*
+ * Unmap every binding inside [addr, addr + range); partial ones fail. Waits
+ * for the VM's jobs first.
+ *
+ * ponytail: waits for all of them, not only those using the range. Track
+ * per-mapping fences if unbinds under load ever stall.
+ */
+int agx_vm_unbind(struct agx_vm *vm, u64 addr, u64 range)
+{
+	struct agx_mapping *m, *tmp;
+	int ret;
+
+	mutex_lock(&vm->lock);
+	ret = wait_event_interruptible(vm->idle, !atomic_read(&vm->jobs));
+	if (ret)
+		goto out;
+	list_for_each_entry(m, &vm->mappings, node) {
+		if (m->addr < addr + range && addr < m->addr + m->range &&
+		    (m->addr < addr || m->addr + m->range > addr + range)) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	list_for_each_entry_safe(m, tmp, &vm->mappings, node) {
+		if (m->addr < addr || m->addr + m->range > addr + range)
+			continue;
+		clear_range(vm, m->addr, m->range);
+		list_del(&m->node);
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+out:
+	mutex_unlock(&vm->lock);
+	return ret;
+}
+
+/*
+ * Drop every mapping of obj, as when its handle is closed: Mesa frees a
+ * buffer by closing it and reuses the VA. If waiting for the VM's jobs is
+ * interrupted the mappings stay until the VM goes, holding the pages.
+ */
+void agx_vm_unmap_object(struct agx_vm *vm, struct drm_gem_object *obj)
+{
+	struct agx_mapping *m, *tmp;
+	bool mapped = false;
+
+	mutex_lock(&vm->lock);
+	list_for_each_entry(m, &vm->mappings, node)
+		mapped |= m->obj == obj;
+	if (!mapped || wait_event_killable(vm->idle, !atomic_read(&vm->jobs)))
+		goto out;
+	list_for_each_entry_safe(m, tmp, &vm->mappings, node) {
+		if (m->obj != obj)
+			continue;
+		clear_range(vm, m->addr, m->range);
+		list_del(&m->node);
+		drm_gem_object_put(m->obj);
+		kfree(m);
+	}
+	agx_fw_flush_tlb(vm->agx, vm->ctx);
+out:
+	mutex_unlock(&vm->lock);
+}
+
+/* Start a CDM control stream, or a render, in this VM. Returns its fence. */
+struct dma_fence *agx_vm_run(struct agx_vm *vm, u64 stream,
+			     const struct drm_asahi_cmd_render *render)
+{
+	if (render)
+		return agx_fw_render(vm->agx, vm->ctx, render);
+	return agx_fw_run(vm->agx, vm->ctx, vm->kernel_start, stream);
+}
