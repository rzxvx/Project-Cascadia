+ max_power=property(p,0,property(p,1,4070));
+ duty=property(p,18,40); base=property(p,2,1);
+ period=property(p,12,0);
+ ticks=property(p,20,0);
+ if (p->policy_present&(1ULL<<20)) period=ticks/24000;
+ else {
+  /* Do not invent configureDevice's period default if DT supplies neither. */
+  if (!(p->policy_present&(1ULL<<12)) || period>0xffffffffU/24000) return -1;
+  ticks=period*24000;
+ }
+ tc=property(p,56,313);
+ ki=property(p,16,1017484678); kp=property(p,19,1084821467);
+ clamp=property(p,17,0);
+ perf_tc[0]=property(p,4,5); perf_tc[1]=property(p,5,50);
+ perf_ki[0]=property(p,6,0x40fca970); perf_ki[1]=property(p,7,0x3e4a2121);
+ perf_kp[0]=property(p,10,0x416b53d1); perf_kp[1]=property(p,11,0x40db53d0);
+ perf_clamp=property(p,8,0); drop=property(p,3,0);
+ limiter=property(p,9,5); min_util=property(p,57,95);
+ /* This bounded first-test implementation rejects unsupported ranges rather
+  * than silently changing native integer->float rounding or dividing by zero. */
+ if (!max_power || max_power>0x1000000 || duty>100 || !base ||
+     base>=p->states || !ticks || !period || clamp>0x1000000 ||
+     perf_clamp>0x1000000 || min_util>100 || !finite_bits(ki) || !finite_bits(kp)) return -1;
+ for (i=0;i<2;i++) {
+  if (!perf_tc[i] || !finite_bits(perf_ki[i]) || !finite_bits(perf_kp[i]) ||
+      agx21_ratio_f32(perf_tc[i]-1,perf_tc[i],&perf_ratio[i]) ||
+      agx21_ratio_f32(1,perf_tc[i],&perf_inverse[i])) return -1;
+ }
+ if (!limiter || agx21_ratio_f32(tc-1,tc,&ratio) ||
+     agx21_ratio_f32(1,tc,&inverse) ||
+     agx21_ratio_f32(limiter-1,limiter,&limiter_ratio) ||
+     agx21_ratio_f32(1,limiter,&limiter_inverse) ||
+     agx21_ratio_f32(clamp,1,&clamp_float) ||
+     agx21_ratio_f32(max_power,1,&max_power_float) ||
+     agx21_ratio_f32(perf_clamp,1,&perf_clamp_float) ||
+     agx21_ratio_f32(100*(p->states-1-base),95,&perf_scale) ||
+     agx21_ratio_f32(max,max_power,&gain_ratio)) return -1;
