+
+/* Most vertices in one piece of a split draw, a multiple of 6 for any list */
+static inline uint32_t
+agx_g11_split_max(unsigned instances, unsigned outputs)
+{
+   uint64_t per = agx_g11_heap_cost(MAX2(instances, 1), outputs);
+   return MAX2((AGX_G11_HEAP_BUDGET / 2) / per / 6 * 6, 6);
