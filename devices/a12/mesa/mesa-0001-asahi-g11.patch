+/*
+ * G11 has no partial renders (the kernel does not set them up), so a render
+ * whose geometry fills the 8 MB tiler heap hangs the TA. Drivers end the
+ * render, and split draws, before that. Measured: 14 B per point and 32 B
+ * per tiny triangle, plus about 0.6 B per 32x32 tile a primitive covers.
+ *
+ * ponytail: a CPU estimate against a fixed budget, with indirect draws at a
+ * flat cost; firmware partial renders are the real fix
+ */
+#define AGX_G11_HEAP_BUDGET   (6u << 20)
+#define AGX_G11_HEAP_INDIRECT (AGX_G11_HEAP_BUDGET / 64)
+
+static inline uint64_t
+agx_g11_heap_cost(uint64_t vertices, unsigned outputs)
+{
+   return vertices * (4 * outputs + 8);
