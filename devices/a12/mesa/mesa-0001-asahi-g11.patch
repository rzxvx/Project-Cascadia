+      unsigned reg = g11_low_range(rctx, n, pinned, &copies, n);
+      if (reg == ~0)
+         continue;
+
+      insert_copy(rctx, &copies, reg, var);
+      BITSET_CLEAR_COUNT(rctx->used_regs[RA_GPR], old, n);
+      BITSET_SET_COUNT(rctx->used_regs[RA_GPR], reg, n);
+      BITSET_SET_COUNT(pinned, reg, n);
+      set_ssa_to_reg(rctx, var, reg);
+   }
