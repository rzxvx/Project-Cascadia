+   if (face_dirty) {
+      bool stencil = hk_stencil_test_enabled(cmd);
+
+      uint32_t control;
+      agx_pack(&control, FRAGMENT_CONTROL, cfg) {
+         cfg.visibility_mode = gfx->occlusion.mode;
+         cfg.stencil_test_enable = stencil;
+         cfg.two_sided_stencil = stencil;
+         cfg.depth_bias_enable = dyn->rs.depth_bias.enable &&
