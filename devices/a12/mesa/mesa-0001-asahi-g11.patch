+/* See agx_g11_ppp_emit */
+static void
+hk_g11_ppp(struct hk_cmd_buffer *cmd, uint8_t **out, const uint32_t *words,
+           unsigned count)
+{
+   struct agx_ptr T = hk_pool_alloc(cmd, count * 4, 4);
+   if (T.cpu)
+      agx_g11_ppp_emit(out, T, words, count);
+}
