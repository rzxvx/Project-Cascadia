+/*
+ * G11 samples, image writes and tile accesses encode their data and
+ * coordinate registers in six bits (16-bit halves), so those must sit in
+ * r0-r31. Whether source s
+ * (-1 for the destination) is such an operand.
+ */
+#define G11_LOW_REGS 64
+
+static bool
+g11_low_operand(const agx_instr *I, int s)
+{
+   if (!AGX_G11)
+      return false;
+
+   switch (I->op) {
+   case AGX_OPCODE_TEXTURE_SAMPLE:
+   case AGX_OPCODE_TEXTURE_LOAD:
+   case AGX_OPCODE_IMAGE_LOAD:
+      return s == -1 || s == 0;
+   case AGX_OPCODE_LD_TILE:
+      return s == -1;
+   case AGX_OPCODE_IMAGE_WRITE:
+   case AGX_OPCODE_ST_TILE:
+      return s == 0;
+   default:
+      return false;
+   }
