+static uint32_t
+hk_g11_stencil(struct vk_stencil_test_face_state s, bool enabled)
+{
+   uint32_t w;
+   agx_pack(&w, FRAGMENT_STENCIL, cfg) {
+      cfg.compare = enabled ? translate_compare_op(s.op.compare)
+                            : AGX_ZS_FUNC_ALWAYS;
+      cfg.write_mask = enabled ? s.write_mask : 0xFF;
+      cfg.read_mask = enabled ? s.compare_mask : 0xFF;
+      cfg.depth_pass =
+         enabled ? translate_stencil_op(s.op.pass) : AGX_STENCIL_OP_KEEP;
+      cfg.depth_fail =
+         enabled ? translate_stencil_op(s.op.depth_fail) : AGX_STENCIL_OP_KEEP;
+      cfg.stencil_fail =
+         enabled ? translate_stencil_op(s.op.fail) : AGX_STENCIL_OP_KEEP;
+   }
+   return w;
+}
