+                    BITFIELD_MASK(5),
+                    control,
+                    face | dyn->ds.stencil.front.reference,
+                    hk_g11_stencil(dyn->ds.stencil.front, stencil),
+                    face | dyn->ds.stencil.back.reference,
+                    hk_g11_stencil(dyn->ds.stencil.back, stencil),
