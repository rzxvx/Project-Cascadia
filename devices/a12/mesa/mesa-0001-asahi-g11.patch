+/*
+ * G11 draw state in AGXMetalA12's blocks and order: the fragment shader,
+ * output select, fragment state, viewport, W clamp with cull, and depth
+ * bias/scissor (the GL driver's agx_g11_encode_ppp).
+ */
+static void
+hk_g11_flush_ppp_state(struct hk_cmd_buffer *cmd, struct hk_cs *cs,
