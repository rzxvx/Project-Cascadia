+      bool has_z = render->depth_att.vk_format != VK_FORMAT_UNDEFINED;
+      bool z_test = has_z && dyn->ds.depth.test_enable;
+      enum agx_zs_func zf =
+         (z_test && !gfx->descriptors.root.draw.force_never_in_shader)
+            ? translate_compare_op(dyn->ds.depth.compare_op)
+            : AGX_ZS_FUNC_ALWAYS;
+
+      unsigned type = gfx->object_type;
+      if (type == AGX_OBJECT_TYPE_TRIANGLE &&
+          dyn->rs.polygon_mode != VK_POLYGON_MODE_FILL)
