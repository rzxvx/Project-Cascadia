+             * "device descriptor read/64, error -110".
+             *
+             * PongoOS does not infer it either, it writes 0x1408 flat, and
+             * Linux reads 0x1408 back on this board. Both say 16 bit UTMI+.
+             */
+            gusbcfg = DWC2_GUSBCFG_PHYIF16 | FIELD_PREP(GUSBCFG_USBTRDTIM_MASK, 5);
+            break;
         case 0b10: /* ULPI */
             gusbcfg = FIELD_PREP(GUSBCFG_USBTRDTIM_MASK, 9);
             break;
