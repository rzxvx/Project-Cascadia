index 9220d62..e8a67ad 100644
--- a/src/usb_dwc2.c
+++ b/src/usb_dwc2.c
@@ -890,9 +890,56 @@ static void usb_dwc2_ep0_handle_setup(dwc2_dev_t *dev)
     }
