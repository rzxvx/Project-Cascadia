     else if (adt_is_compatible(adt, usbComplex_offset, "usb-complex,t8011")) {
         type = USBCOMPLEX_T8011;
     } else {
diff --git a/src/usb_complex.h b/src/usb_complex.h
index 58f33ca..ebc57ba 100644
--- a/src/usb_complex.h
+++ b/src/usb_complex.h
@@ -51,6 +51,23 @@
 #define USBX_EHCI1_REMAP_CTL_T8015  0x38
 #define USBX_USBDEV_REMAP_CTL_T8015 0x48
 
+/*
+ * T8020 has no registers of its own: it takes the T8015 offsets above, and the
+ * ADT agrees. /arm-io/usb-complex usb_widget_with_mask is three (offset, value,
+ * mask) triplets at 0x28, 0x38 and 0x48, value 0x88, mask 0x030000ff, which is
+ * the T8011 bit layout at the T8015 offsets. 0x48 is the device controller.
+ *
+ * What the ADT does not explain is that the two bits the mask covers above the
+ * splice value are not part of it. They are the DMA enables. Clearing them on
+ * a live gadget, from the proxy, leaves the device enumerated and kills every
+ * transfer, so they have to be set whatever address the controller emits.
+ *
+ * The splice value itself is left at zero here, unlike T8011 and T8015, since
+ * on this SoC the DART behind the widget is what puts the address in DRAM.
+ */
+#define USBX_REMAP_DMA_EN_ONLY_T8020                                                               \
+    (USBX_REMAP_DMA_TO_DEVICE_EN_T8011 | USBX_REMAP_DMA_FROM_DEVICE_EN_T8011)
+
 /* USB PHY registers */
 
 #define USBX_OTG_CTL       0x00
@@ -95,6 +112,7 @@ enum usb_complex_type {
     USBCOMPLEX_S5L8960X,
     USBCOMPLEX_T8011,
     USBCOMPLEX_T8015,
+    USBCOMPLEX_T8020,
 };
 
