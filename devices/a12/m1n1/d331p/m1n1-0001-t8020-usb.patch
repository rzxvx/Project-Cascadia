+/*
+ * Power cycle the USB domains before bringing the controller up.
+ *
+ * PongoOS does this on every SoC and m1n1 does not do it anywhere, because on
+ * a Mac m1n1 is the first thing to touch USB. Here it is not: iBoot and then
+ * PongoOS have both had the controller running, PongoOS still being mid
+ * session when bootm jumps to us, and nothing hands it back in a clean state.
+ *
+ * These two addresses are the T8020 power state registers, from PongoOS's
+ * t8020_usb_regs, as absolute addresses rather than offsets from gIOBase. The
+ * low nibble is the requested state and the next nibble is the actual one, so
+ * drive the request and wait for the two to agree, exactly as clock_gate does.
+ */
+#define T8020_USB_PS0 0x23b0802a8
+#define T8020_USB_PS1 0x23b0802b0
+/*
+ * The device controller has a domain of its own, and without it the dwc2 core
+ * does not answer and reading GSNPSID data aborts. Linux names all three when
+ * it comes up: "always-on domain usb", "usbctlreg", then "usb2dev", which is
+ * this one.
+ */
+#define T8020_USB_PS2 0x23b0802c0
+
+static void usb_t8020_ps_set(u64 addr, bool on)
+{
+    mask32(addr, 0xf, on ? 0xf : 0);
+
+    while (1) {
+        u32 value = read32(addr);
+        if ((value & 0xf) == ((value >> 4) & 0xf))
+            break;
+    }
+}
+
+static void usb_t8020_power_cycle(void)
+{
+    usb_t8020_ps_set(T8020_USB_PS2, false);
+    usb_t8020_ps_set(T8020_USB_PS1, false);
+    usb_t8020_ps_set(T8020_USB_PS0, false);
+    udelay(1000);
+    usb_t8020_ps_set(T8020_USB_PS0, true);
+    usb_t8020_ps_set(T8020_USB_PS1, true);
+    usb_t8020_ps_set(T8020_USB_PS2, true);
+}
+
+/*
+ * The device controller sits behind a DART, which the ADT says outright:
+ * /arm-io/usb-complex/usb-device has an iommu-parent property pointing at
+ * /arm-io/dart-usb/mapper-usbdev, stream 0. iBSS leaves that DART in bypass,
+ * so the 32 bit address the controller emits reaches the fabric unchanged,
+ * and with DRAM starting at 0x800000000 there is nothing at 0x11fd8000 to
+ * answer it. That is the AHBErr on every SETUP packet.
+ *
+ * PongoOS gets away with this because it programs the DART for its own gadget
+ * and only puts it back in bypass on the way out, which is why the gadget used
+ * to work and stopped working when PongoOS left the boot chain.
+ *
+ * Rather than teach the dwc2 driver about IOVAs, give stream 0 a flat map of
+ * DRAM at the low 32 bits of each page's own address, which is exactly what
+ * the driver writes into DOEPDMA and DIEPDMA.
+ *
+ * That only lines up because the complex remap widget is told to splice zero
+ * into the top bits rather than 8. The widget sits in front of the DART, not
+ * behind it: with the 8 in place the DART sees 0x8_11fd8000 and needs a
+ * second window up there, and a Linux DMA address can never reach that, since
+ * dwc2 is a 32 bit master. The two bits above the splice value are not part of
+ * it. They are the DMA enables, and clearing them stops the controller
+ * reaching memory at all, whatever the address.
+ */
+static void usb_t8020_dart_setup(void)
+{
+    if (pmgr_adt_power_enable("/arm-io/dart-usb") < 0)
+        printf("usb: could not power /arm-io/dart-usb, trying it anyway\n");
+
+    dart_dev_t *dart = dart_init_adt("/arm-io/dart-usb", 0, 0, false);
+    if (!dart) {
+        printf("usb: no dart-usb, leaving translation as iBoot left it\n");
+        return;
+    }
+
+    if (dart_map(dart, ram_base & 0xffffffff, (void *)ram_base, mem_size_actual) < 0)
+        printf("usb: dart-usb flat map at 0x%lx failed\n", ram_base & 0xffffffff);
+}
+
