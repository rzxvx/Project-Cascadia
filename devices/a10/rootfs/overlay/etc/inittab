# /etc/inittab - BusyBox init for the iPad 7. The initramfs has done the boot
# (USB gadget, usb0, the root); a10-init starts the services.
::sysinit:/sbin/a10-init

# shell on the USB serial (no login: a cable you plugged in yourself)
ttyGS0::respawn:/sbin/getty -n -l /bin/sh -L 115200 ttyGS0 vt100
# and on the screen, where the on-screen keyboard (fbkeyboard) types
tty1::respawn:/sbin/getty -n -l /bin/sh 38400 tty1 linux

::ctrlaltdel:/sbin/reboot
::shutdown:/bin/umount -a -r
