#!/bin/sh
# desktop -- the Wayland desktop (labwc, drawn by the CPU through pixman) on
# the iPad's screen, started in the background from the screen's shell or
# ssh. Log: /tmp/labwc.log. After devices/a5's desktop-labwc.
#
#   desktop               start it
#   desktop stop          end it (the text console and fbkeyboard come back)
#   desktop auto on|off   start it at boot, or the text console only
#   desktop auto          whether it starts at boot
#   desktop --boot        what a10-init runs: the desktop, unless auto off
OFF=/etc/cascadia/desktop-boot-off
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

case "${1:-}" in
    auto)
        case "${2:-}" in
            on)  rm -f "$OFF"; echo "The desktop starts at boot." ;;
            off) mkdir -p "${OFF%/*}" && : > "$OFF" && echo "No desktop at boot: the text console." ;;
            "")  if [ -e "$OFF" ]; then echo off; else echo on; fi ;;
            *)   echo "usage: desktop auto on|off" >&2; exit 2 ;;
        esac
        exit 0 ;;
    stop)
        killall labwc 2>/dev/null && echo "labwc stopped" || echo "labwc is not running"
        exit 0 ;;
    --boot)
        [ -e "$OFF" ] && exit 0 ;;
    "") ;;
    *)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

command -v labwc >/dev/null ||
    { echo "no labwc here (Alpine in RAM?) -- the desktop needs: ./cascadia a10 rootfs sync" >&2; exit 1; }
if pidof labwc >/dev/null; then echo "labwc is already running"; exit 1; fi
# the console's on-screen keyboard, for when the session ends: its
# touchscreen, found by name
ts=
for n in /sys/class/input/event*; do
    case "$(cat "$n/device/name" 2>/dev/null)" in
        iPad7,1[12]" Touchscreen") ts=/dev/input/${n##*/}; break ;;
    esac
done
# fbkeyboard draws straight onto the framebuffer and would paint over it
killall fbkeyboard 2>/dev/null   # (busybox pkill -x compares the whole argv[0])
mountpoint -q /dev/shm || { mkdir -p /dev/shm; mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm; }
export XDG_RUNTIME_DIR=/tmp/xdg-$(id -u)
mkdir -p -m 700 "$XDG_RUNTIME_DIR"
# the system bus, for the programs that want it
if [ ! -S /run/dbus/system_bus_socket ]; then
    mkdir -p /run/dbus && dbus-uuidgen --ensure && dbus-daemon --system
fi
# seatd hands labwc the screen and the input devices
if ! pidof seatd >/dev/null; then
    rm -f /run/seatd.sock
    seatd -g video >/tmp/seatd.log 2>&1 &
    n=0; while [ ! -S /run/seatd.sock ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
fi
export LIBSEAT_BACKEND=seatd WLR_RENDERER=pixman
# the way out from the glass: Home three times (a10-init starts it; a root
# from before it did not)
if [ -x /usr/local/bin/task-killer ] && ! pidof task-killer >/dev/null; then
    setsid /usr/local/bin/task-killer >/tmp/task-killer.log 2>&1 </dev/null &
fi
# setsid: the session outlives the ssh it was started from; when it ends,
# fbkeyboard is back on the text console
TS=$ts setsid sh -c '
    dbus-run-session labwc >/tmp/labwc.log 2>&1 </dev/null
    if [ -n "$TS" ] && ! pidof fbkeyboard >/dev/null; then
        exec fbkeyboard -d "$TS" -f /usr/share/fonts/dejavu/DejaVuSans.ttf >/tmp/fbkeyboard.log 2>&1 </dev/null
    fi
' </dev/null >/dev/null 2>&1 &
echo "labwc is starting -- a few seconds (log: /tmp/labwc.log)"
