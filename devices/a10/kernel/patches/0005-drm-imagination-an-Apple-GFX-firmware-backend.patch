@@ -91,6 +93,16 @@
 }
 
 /**
+ * pvr_vm_get_page_table_root_ptr() - Get the CPU mapping of the root of the
+ * page table structure behind a VM context.
+ * @vm_ctx: Target VM context.
+ */
+void *pvr_vm_get_page_table_root_ptr(struct pvr_vm_context *vm_ctx)
