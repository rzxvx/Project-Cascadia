  * @vm_ctx: Target VM context.
  *
@@ -576,7 +588,8 @@
 	if (err)
 		goto err_free;
 
-	if (is_userspace_context) {
+	/* Apple's firmware has no memory-context object: pvr_apple.c maps contexts */
+	if (is_userspace_context && !pvr_dev->apple) {
 		err = pvr_fw_object_create(pvr_dev, sizeof(struct rogue_fwif_fwmemcontext),
 					   PVR_BO_FW_FLAGS_DEVICE_UNCACHED,
 					   fw_mem_context_init, vm_ctx, &vm_ctx->fw_mem_ctx_obj);
@@ -594,6 +607,15 @@
 	mutex_init(&vm_ctx->lock);
 	kref_init(&vm_ctx->ref_count);
 
+	/* Apple backend: every VM maps the page the firmware's flush writes to */
+	if (is_userspace_context && pvr_dev->apple) {
+		err = pvr_apple_vm_map_fence(pvr_dev->apple, vm_ctx);
+		if (err) {
+			pvr_vm_context_put(vm_ctx);
+			return ERR_PTR(err);
+		}
+	}
+
 	return vm_ctx;
 
 err_page_table_destroy:
@@ -621,6 +643,9 @@
 	if (vm_ctx->fw_mem_ctx_obj)
 		pvr_fw_object_destroy(vm_ctx->fw_mem_ctx_obj);
 
+	if (vm_ctx->pvr_dev->apple)
+		pvr_apple_vm_release(vm_ctx->pvr_dev->apple, vm_ctx);
+
 	pvr_vm_unmap_all(vm_ctx);
 
 	pvr_mmu_context_destroy(vm_ctx->mmu_ctx);
@@ -1057,6 +1082,10 @@
 		if (i == DRM_PVR_HEAP_RGNHDR && !PVR_HAS_QUIRK(pvr_dev, 63142))
 			heap.size = 0;
 
+		/* Apple backend: the general heap's last page is the fence page */
+		if (i == DRM_PVR_HEAP_GENERAL && pvr_dev->apple)
+			heap.size -= PVR_APPLE_RESERVED_SIZE;
+
 		err = PVR_UOBJ_SET(dest, query.heaps.stride, heap);
 		if (err < 0)
 			return err;
