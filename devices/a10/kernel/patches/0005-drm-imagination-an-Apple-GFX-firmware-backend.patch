 	if (!drm_dev_enter(drm_dev, &idx))
 		return -EIO;
 
@@ -719,6 +725,9 @@
 
 	if (args->_padding_4)
 		return -EINVAL;
+
+	if (to_pvr_device(drm_dev)->apple)
+		return pvr_apple_ioctl_destroy_context(pvr_file, args->handle);
 
 	return pvr_context_destroy(pvr_file, args->handle);
 }
@@ -746,6 +755,10 @@
 	int idx;
 	int err;
 
+	/* Apple backend: not yet (G7 step 5) */
+	if (to_pvr_device(drm_dev)->apple)
+		return -EOPNOTSUPP;
+
 	if (!drm_dev_enter(drm_dev, &idx))
 		return -EIO;
 
@@ -832,6 +845,10 @@
 	int idx;
 	int err;
 
+	/* Apple backend: not yet (G7 step 5) */
+	if (to_pvr_device(drm_dev)->apple)
+		return -EOPNOTSUPP;
+
 	if (!drm_dev_enter(drm_dev, &idx))
 		return -EIO;
 
@@ -1024,6 +1041,11 @@
 	u64 offset_plus_size;
 	int idx;
 	int err;
+
+	/* Apple backend: the fence page at the general heap's end is the kernel's */
+	if (to_pvr_device(drm_dev)->apple &&
+	    pvr_apple_va_reserved(args->device_addr, args->size))
+		return -EINVAL;
 
 	if (!drm_dev_enter(drm_dev, &idx))
 		return -EIO;
@@ -1113,6 +1135,11 @@
 	struct pvr_vm_context *vm_ctx;
 	int err;
 
+	/* Apple backend: the fence page at the general heap's end is the kernel's */
+	if (to_pvr_device(drm_dev)->apple &&
+	    pvr_apple_va_reserved(args->device_addr, args->size))
+		return -EINVAL;
+
 	/* Initial validation of args. */
 	if (args->_padding_4)
 		return -EINVAL;
@@ -1151,6 +1178,10 @@
 	int idx;
 	int err;
 
+	/* Apple backend: jobs on Apple's firmware (pvr_apple_uapi.c) */
+	if (pvr_dev->apple)
+		return pvr_apple_ioctl_submit_jobs(pvr_dev, file, args);
+
 	trace_pvr_job_submit_ioctl(pvr_dev, args->jobs.count);
 
 	if (!drm_dev_enter(drm_dev, &idx))
@@ -1314,6 +1345,14 @@
 {
 	struct pvr_device *pvr_dev = to_pvr_device(drm_dev);
 	struct pvr_file *pvr_file;
+
+	/* Apple backend: the firmware comes up with the first open */
+	if (pvr_dev->apple) {
+		int err = pvr_apple_start(pvr_dev->apple);
+
+		if (err)
+			return err;
+	}
 
 	pvr_file = kzalloc_obj(*pvr_file);
 	if (!pvr_file)
@@ -1337,6 +1376,7 @@
 	xa_init_flags(&pvr_file->free_list_handles, XA_FLAGS_ALLOC1);
 	xa_init_flags(&pvr_file->hwrt_handles, XA_FLAGS_ALLOC1);
 	xa_init_flags(&pvr_file->vm_ctx_handles, XA_FLAGS_ALLOC1);
+	xa_init_flags(&pvr_file->apple_ctx_handles, XA_FLAGS_ALLOC1);
 
 	/*
 	 * Store reference to powervr-specific file private data in DRM file
@@ -1363,6 +1403,10 @@
 {
 	struct pvr_file *pvr_file = to_pvr_file(file);
 
+	/* Apple backend: its contexts first (their jobs keep their VMs) */
+	if (to_pvr_device(drm_dev)->apple)
+		pvr_apple_file_close(pvr_file);
+
 	/* Kill remaining contexts. */
 	pvr_destroy_contexts_for_file(pvr_file);
 
@@ -1415,6 +1459,10 @@
 
 	platform_set_drvdata(plat_dev, drm_dev);
 
+	/* Apple's firmware: a backend of its own (pvr_apple.c) */
+	if (pvr_apple_match(&plat_dev->dev))
+		return pvr_apple_probe(pvr_dev);
+
 	err = pvr_power_domains_init(pvr_dev);
 	if (err)
 		return err;
@@ -1468,6 +1516,11 @@
 	struct drm_device *drm_dev = platform_get_drvdata(plat_dev);
 	struct pvr_device *pvr_dev = to_pvr_device(drm_dev);
 
+	if (pvr_dev->apple) {
+		pvr_apple_remove(pvr_dev);
+		return;
+	}
+
 	WARN_ON(!xa_empty(&pvr_dev->job_ids));
 	WARN_ON(!xa_empty(&pvr_dev->free_list_ids));
 
@@ -1492,7 +1545,13 @@
 };
 
 static const struct of_device_id dt_match[] = {
+#if IS_ENABLED(CONFIG_DRM_POWERVR_APPLE)
 	{
+		/* no power sequence ops: pvr_apple.c powers the GPU itself */
+		.compatible = "apple,t8010-gpu",
+	},
+#endif
+	{
 		.compatible = "thead,th1520-gpu",
 		.data = &pvr_device_data_pwrseq,
 	},
--- a/drivers/gpu/drm/imagination/pvr_mmu.c
+++ b/drivers/gpu/drm/imagination/pvr_mmu.c
@@ -5,6 +5,7 @@
 
 #include "pvr_ccb.h"
 #include "pvr_device.h"
+#include "pvr_apple.h"
 #include "pvr_fw.h"
 #include "pvr_gem.h"
 #include "pvr_power.h"
@@ -129,6 +130,12 @@
 	int err = 0;
 	u32 slot;
 	int idx;
+
+	/* Apple's firmware: the backend moves the contexts' MMU generations */
+	if (pvr_dev->apple) {
+		atomic_xchg(&pvr_dev->mmu_flush_cache_flags, 0);
+		return pvr_apple_mmu_flush(pvr_dev->apple);
+	}
 
 	if (!drm_dev_enter(from_pvr_device(pvr_dev), &idx))
 		return -EIO;
@@ -1864,6 +1871,16 @@
 }
 
 /**
+ * pvr_mmu_get_root_table_ptr() - Get the CPU mapping of the root of the page
+ * table structure behind a VM context (the Apple backend mirrors it).
+ * @ctx: Target MMU context.
+ */
+void *pvr_mmu_get_root_table_ptr(struct pvr_mmu_context *ctx)
+{
+	return ctx->page_table_l2.backing_page.host_ptr;
+}
+
+/**
  * pvr_page_table_l1_alloc() - Allocate a l1 page_table object.
  * @ctx: MMU context of owning VM context.
  *
