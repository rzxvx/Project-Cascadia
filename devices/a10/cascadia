#!/usr/bin/env bash
#
# Project Cascadia — A10 / iPad 7 (iPad7,11 J171 Wi-Fi, iPad7,12 J172
# Cellular), through ./cascadia a10 at the repository's top.
#
#   ./cascadia a10 doctor          check that this machine has what the build needs
#   ./cascadia a10 build           tools + m1n1 + kernel (all)
#   ./cascadia a10 build tools     gaster (checkm8) + hBootPatcher, host side
#   ./cascadia a10 build m1n1      just m1n1
#   ./cascadia a10 build kernel    just the kernel + DTBs
#   ./cascadia a10 build initramfs the USB-gadget initramfs (shell, ssh, network)
#   ./cascadia a10 build fbkeyboard the on-screen keyboard (Alpine's fbkeyboard)
#   ./cascadia a10 build rootfs    the Alpine root, run from RAM (pack sends it as a ramdisk)
#   ./cascadia a10 inputs          iPad in DFU: pwn it, fetch iBSS + DeviceTree
#                                  from Apple, decrypt and patch them (once per board)
#   ./cascadia a10 syscfg          with Linux up: this iPad's SysCfg (calibration), read-only
#   ./cascadia a10 firmware        Apple's firmware for the drivers (SmartIO; touch with the
#                                  SysCfg), from the CDN
#   ./cascadia a10 pack            wrap m1n1 and m1n1 + Linux into bootable IMG4s
#   ./cascadia a10 boot            DFU → checkm8 → patched iBSS → m1n1 → Linux
#                                  (USB: ssh root@172.16.43.1, serial /dev/cu.usbmodem*)
#   ./cascadia a10 boot proxy      the same, into m1n1's proxy instead of Linux
#                                  (driven from the Mac: m1n1 proxyclient)
#   ./cascadia a10 net on|off|status  share this Mac's internet with the iPad
#                                  over USB (NAT through pf; asks for sudo)
#   ./cascadia a10 storage inspect the GPT and APFS, read-only
#   ./cascadia a10 storage linux [GB]  shrink iPadOS's APFS and add a Linux
#                                  partition (Enter = 10 GB, at most 14
#                                  recommended; asks for a backup and RESIZE).
#                                  Required from you: the iPad in a jailbroken
#                                  iPadOS (palera1n, Dopamine) with OpenSSH
#   ./cascadia a10 nvme setup      with Linux up: note the Linux partition, so
#                                  pack opens the kernel's write gate for it
#   ./cascadia a10 nvme format     after setup + pack + boot: ext4 + the Alpine
#                                  root on it (asks FORMAT); boots from it then
#   ./cascadia a10 nvme status     the gate and the NVMe as the iPad sees them
#
# The boot chain is open source end to end: gaster (checkm8), hBootPatcher,
# m1n1 -- no checkra1n, no PongoOS. Pinned sources: sources.env.
set -euo pipefail

A10="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$A10"
. "$A10/sources.env"

say()  { printf '==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

B="$A10/build"
GASTER="$B/bin/gaster"
HBP="$B/bin/hBootPatcher"
REPAIR="$A10/../a13/boot/repair_lzss_img4.py"   # ipsw 3.1.714's bad LZSS record
OVERLAY="$A10/../a13/boot/overlay_cpio.py"      # a second cpio on top of the initramfs

sha_check() {   # sha file
    if have sha256sum; then echo "$1  $2" | sha256sum -c - >/dev/null
    else echo "$1  $2" | shasum -a 256 -c - >/dev/null; fi
}

# ---------- device -----------------------------------------------------------

# irecovery -q -> CPID MODEL PRODUCT MODE in globals; only the iPad 7
query() {
    local q
    q=$(irecovery -q 2>/dev/null) || return 1
    CPID=$(printf '%s\n' "$q" | awk '$1=="CPID:"{print $2}')
    MODEL=$(printf '%s\n' "$q" | awk '$1=="MODEL:"{print $2}')
    PRODUCT=$(printf '%s\n' "$q" | awk '$1=="PRODUCT:"{print $2}')
    MODE=$(printf '%s\n' "$q" | awk '$1=="MODE:"{print $2}')
    PWND=$(printf '%s\n' "$q" | grep -o 'PWND:[^]]*' || true)
}

need_ipad7() {
    query || fail "no device -- put the iPad 7 in DFU and connect it"
    [ "$CPID" = 0x8010 ] || fail "CPID $CPID is not the A10 (0x8010)"
    case "$MODEL" in
        j171ap) BOARD=j171 ;;
        j172ap) BOARD=j172 ;;
        *) fail "$MODEL / $PRODUCT is an A10, but not an iPad 7 (j171ap / j172ap)" ;;
    esac
    IN="$B/inputs/$BOARD"
}

wait_mode() {   # mode seconds
    local i=0
    while [ "$i" -lt "$2" ]; do
        if query && [ "$MODE" = "$1" ]; then return 0; fi
        sleep 1; i=$((i + 1))
    done
    return 1
}

pwn() {
    [ -x "$GASTER" ] || fail "no gaster -- run: ./cascadia a10 build tools"
    query || true
    if [ -n "${PWND:-}" ]; then note "already pwned ($PWND)"; return; fi
    say "checkm8 (gaster)"
    "$GASTER" pwn
    # gaster leaves the AES engine usable after one throwaway decryption
    "$GASTER" decrypt_kbag "$(printf '0%.0s' $(seq 96))" >/dev/null 2>&1 || true
}

# ---------- doctor -----------------------------------------------------------

cmd_doctor() {
    rc=0
    say "host: $(uname -srm)"
    for t in git python3 curl irecovery ipsw docker; do
        if have "$t"; then note "ok:      $t"; else note "MISSING: $t"; rc=1; fi
    done
    if [ "$(uname -s)" = Darwin ]; then
        if have rustup && rustup target list --installed 2>/dev/null | grep -qx aarch64-unknown-none-softfloat; then
            note "ok:      Rust target aarch64-unknown-none-softfloat"
        else note "MISSING: rustup target add aarch64-unknown-none-softfloat (m1n1)"; rc=1; fi
        if have brew && [ -x "$(brew --prefix llvm 2>/dev/null)/bin/clang" ]; then note "ok:      Homebrew llvm"
        else note "MISSING: brew install llvm lld (m1n1)"; rc=1; fi
    fi
    have ipsw && note "ipsw $(ipsw version 2>/dev/null | head -1)"
    [ -f "$REPAIR" ] && note "ok:      LZSS repair (devices/a13/boot)" || { note "MISSING: $REPAIR"; rc=1; }
    for f in "$GASTER" "$HBP" "$B/payload/m1n1-idevice.macho" "$B/payload/Image.gz"; do
        if [ -e "$f" ]; then note "built:   ${f#$A10/}"; else note "not yet: ${f#$A10/}"; fi
    done
    return $rc
}

# ---------- build ------------------------------------------------------------

cmd_build() {
    case "${1:-all}" in
        tools)  bash tools/build-tools.sh ;;
        m1n1)   bash m1n1/build-m1n1.sh ;;
        kernel) bash kernel/build-kernel.sh ;;
        initramfs) bash initramfs/make-initramfs.sh ;;
        fbkeyboard) bash tools/fbkeyboard.sh ;;
        rootfs) bash rootfs/build-alpine-rootfs.sh ;;
        all)    bash tools/build-tools.sh; bash m1n1/build-m1n1.sh; bash kernel/build-kernel.sh
                bash initramfs/make-initramfs.sh; bash tools/fbkeyboard.sh
                bash rootfs/build-alpine-rootfs.sh ;;
        *) fail "build what? tools, m1n1, kernel, initramfs, fbkeyboard, rootfs (or nothing for all)" ;;
    esac
}

# ---------- inputs -----------------------------------------------------------

cmd_inputs() {
    [ -x "$HBP" ] || fail "no hBootPatcher -- run: ./cascadia a10 build tools"
    need_ipad7
    [ "$MODE" = DFU ] || fail "the iPad is in $MODE mode; inputs needs DFU (gaster decrypts with its AES engine)"
    mkdir -p "$IN"
    pwn

    say "IM4M"
    curl -fsSL "$A10_IM4M_URL" -o "$IN/IM4M"
    sha_check "$A10_IM4M_SHA256" "$IN/IM4M" || fail "IM4M checksum mismatch"

    say "iBSS + DeviceTree from iPadOS $A10_BOOT_IOS ($PRODUCT, $MODEL)"
    local w; w=$(mktemp -d)
    ( cd "$w"
      ipsw download ipsw --version "$A10_BOOT_IOS" -d "$PRODUCT" -y \
          --pattern '^BuildManifest.plist$' >/dev/null )
    local manifest ibss dtre
    manifest=$(find "$w" -name BuildManifest.plist -type f | head -1)
    [ -n "$manifest" ] || fail "no BuildManifest.plist from ipsw"
    ibss=$(awk "/$MODEL/{x=1}x&&/iBSS[.]/{print;exit}" "$manifest" | sed -E 's/.*<string>(.*)<\/string>.*/\1/')
    dtre=$(awk "/$MODEL/{x=1}x&&/DeviceTree[.]/{print;exit}" "$manifest" | sed -E 's/.*<string>(.*)<\/string>.*/\1/')
    [ -n "$ibss" ] && [ -n "$dtre" ] || fail "no iBSS / DeviceTree for $MODEL in the manifest"
    note "$ibss"; note "$dtre"
    ( cd "$w"
      ipsw download ipsw --version "$A10_BOOT_IOS" -d "$PRODUCT" -y --pattern "^${ibss}\$" >/dev/null
      ipsw download ipsw --version "$A10_BOOT_IOS" -d "$PRODUCT" -y --pattern "^${dtre}\$" >/dev/null )
    local ibss_f dtre_f
    ibss_f=$(find "$w" -name "$(basename "$ibss")" -type f | head -1)
    dtre_f=$(find "$w" -name "$(basename "$dtre")" -type f | head -1)

    say "decrypt + patch iBSS"
    "$GASTER" decrypt "$ibss_f" "$IN/iBSS.raw"
    "$HBP" -airs "$IN/iBSS.raw" "$IN/iBSS.patched.raw"
    ipsw img4 im4p extract -o "$IN/DeviceTree.raw" "$dtre_f" >/dev/null

    ipsw img4 create --input "$IN/iBSS.patched.raw" --type ibss --im4m "$IN/IM4M" \
        --output "$IN/iBSS.img4" >/dev/null
    ipsw img4 create --input "$IN/DeviceTree.raw" --type rdtr --im4m "$IN/IM4M" \
        --output "$IN/DeviceTree.rdtr.img4" >/dev/null
    # an empty trust cache (version 1, a UUID, no entries)
    printf '\001\000\000\000\103\141\163\143\141\144\151\141\101\061\060\000\000\000\000\001\000\000\000\000' \
        > "$IN/empty.trustcache"
    ipsw img4 create --input "$IN/empty.trustcache" --type rtsc --im4m "$IN/IM4M" \
        --output "$IN/empty.rtsc.img4" >/dev/null
    rm -rf "$w"
    say "inputs OK: ${IN#$A10/}"
    note "the iPad stays in pwned DFU: ./cascadia a10 boot proxy"
}

# ---------- syscfg -----------------------------------------------------------

# this iPad's SysCfg (calibrations, MAC addresses, serials) from the running
# Linux, read-only: NVMe namespace 3, 128 KiB. It stays in build/private.
cmd_syscfg() {
    local out="$B/private/syscfg.bin" host=root@172.16.43.1
    mkdir -p "$B/private"; chmod 700 "$B/private"
    say "SysCfg from $host (/dev/nvme0n3, read-only)"
    ssh -o ConnectTimeout=8 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR "$host" \
        'test "$(cat /sys/block/nvme0n3/ro)" = 1 &&
         test "$(blockdev --getsize64 /dev/nvme0n3)" = 131072 &&
         dd if=/dev/nvme0n3 bs=131072 count=1 2>/dev/null' > "$out.tmp" \
        || { rm -f "$out.tmp"; fail "could not read SysCfg -- is Linux up on the iPad?"; }
    [ "$(wc -c < "$out.tmp" | tr -d ' ')" = 131072 ] && [ "$(head -c 4 "$out.tmp")" = gfCS ] \
        || { rm -f "$out.tmp"; fail "that is not a SysCfg (size / magic)"; }
    mv "$out.tmp" "$out"; chmod 600 "$out"
    say "wrote ${out#$A10/} -- private: never commit or share it"
    note "next: ./cascadia a10 firmware && ./cascadia a10 pack"
}

# build/private/nvme-linux -> n_nsid n_first n_count n_part n_guid (checked
# first: bash 3.2 on macOS cannot source a process substitution)
nvme_note() {
    grep -Eqx 'nsid=[0-9]+ first=[0-9]+ count=[0-9]+ part=nvme0n1p[0-9]+ guid=[0-9A-F-]+' "$1" \
        || fail "$1 is not what nvme setup writes"
    eval "$(tr ' ' '\n' < "$1" | sed 's/^/n_/')"
}

# ---------- pack -------------------------------------------------------------

cmd_pack() {
    local P="$B/payload" out="$B/out" tmp i board f mode
    local m="$P/m1n1-idevice.macho"
    [ -f "$m" ] || fail "no m1n1 -- run: ./cascadia a10 build m1n1"
    for i in "$B"/inputs/*/IM4M; do [ -f "$i" ] && break; done
    [ -f "${i:-}" ] || fail "no IM4M -- run: ./cascadia a10 inputs"
    mkdir -p "$out"; tmp=$(mktemp -d)
    # m1n1 alone: with nothing appended it stays in its proxy (USB)
    { cat "$m"; printf '\000\000\000\000'; } > "$tmp/m1n1-proxy.macho"
    ipsw img4 create --input "$tmp/m1n1-proxy.macho" --type rkrn --compress lzss \
        --im4m "$i" --output "$tmp/proxy.img4" >/dev/null
    python3 "$REPAIR" "$tmp/proxy.img4" "$out/m1n1-proxy.rkrn.img4" >/dev/null
    say "wrote ${out#$A10/}/m1n1-proxy.rkrn.img4"

    # Linux: m1n1 + bootargs + DTB + initramfs + kernel, which m1n1 finds by
    # their magic (as devices/a13/boot/package.sh). One image per board that
    # has inputs.
    if [ ! -f "$P/Image.gz" ] || [ ! -f "$P/initramfs.cpio.gz" ]; then
        note "no kernel / initramfs yet -- proxy only (./cascadia a10 build kernel, build initramfs)"
        rm -rf "$tmp"; return
    fi
    # the user's SSH keys and the persistent dropbear host key, in a second cpio
    SSH_KEYS=${SSH_KEYS:-$(ls ~/.ssh/*.pub 2>/dev/null || true)}
    if [ -n "$SSH_KEYS" ]; then cat $SSH_KEYS > "$tmp/authorized_keys"; else : > "$tmp/authorized_keys"; fi
    set -- "root/.ssh/authorized_keys=$tmp/authorized_keys:600"
    [ -f "$B/ssh/dropbear_ed25519_host_key" ] && \
        set -- "$@" "etc/dropbear/dropbear_ed25519_host_key=$B/ssh/dropbear_ed25519_host_key:600"
    # the on-screen keyboard (./cascadia a10 build fbkeyboard); /init starts it
    if [ -d "$B/fbkeyboard" ]; then
        for f in $(cd "$B/fbkeyboard" && find . -type f | sed 's|^\./||'); do
            case "$f" in usr/bin/*|lib/ld-*) mode=755 ;; *) mode=644 ;; esac
            set -- "$@" "$f=$B/fbkeyboard/$f:$mode"
        done
    else
        note "no build/fbkeyboard -- no on-screen keyboard (./cascadia a10 build fbkeyboard)"
    fi
    # Apple's firmware from ./cascadia a10 firmware, where the drivers look for it
    if [ -d "$B/firmware" ]; then
        for f in $(cd "$B/firmware" && find . -type f | sed 's|^\./||'); do
            set -- "$@" "lib/firmware/$f=$B/firmware/$f:644"
        done
    else
        note "no build/firmware -- no SmartIO, no touch (run: ./cascadia a10 firmware)"
    fi
    python3 "$OVERLAY" "$tmp/overlay.cpio" "$@"
    { gzip -dc "$P/initramfs.cpio.gz"; cat "$tmp/overlay.cpio"; } | gzip -9 > "$tmp/initramfs.cpio.gz"
    note "ssh keys: $(grep -c . "$tmp/authorized_keys")"
    cp "$tmp/initramfs.cpio.gz" "$out/initramfs.cpio.gz"   # also for m1n1's linux.py
    for i in "$B"/inputs/*/IM4M; do
        board=$(basename "$(dirname "$i")")
        [ -f "$P/t8010-$board.dtb" ] || { note "no t8010-$board.dtb -- skipped"; continue; }
        cp "$P/t8010-$board.dtb" "$tmp/dtb"
        # the Linux partition (./cascadia a10 nvme setup): the kernel's NVMe
        # write gate opens for that range only; without it, no writes at all
        if [ -f "$B/private/nvme-linux" ]; then
            ( nvme_note "$B/private/nvme-linux"
              fdtput -t u "$tmp/dtb" /soc/pcie@610000000 apple,write-ranges \
                  "$n_nsid" 0 "$n_first" 0 "$n_count"
              note "NVMe write gate: namespace $n_nsid, LBA $n_first +$n_count ($n_part) writable" )
        fi
        cat "$m" boot/bootargs.txt "$tmp/dtb" "$tmp/initramfs.cpio.gz" \
            "$P/Image.gz" > "$tmp/linux.macho"
        printf '\000\000\000\000' >> "$tmp/linux.macho"
        ipsw img4 create --input "$tmp/linux.macho" --type rkrn --compress lzss \
            --im4m "$i" --output "$tmp/linux.img4" >/dev/null
        python3 "$REPAIR" "$tmp/linux.img4" "$out/m1n1-linux-$board.rkrn.img4" >/dev/null
        say "wrote ${out#$A10/}/m1n1-linux-$board.rkrn.img4 ($(($(wc -c < "$out/m1n1-linux-$board.rkrn.img4") / 1024)) KiB)"
    done
    # Alpine in RAM: the root travels as an iBoot ramdisk (rdsk) -- iBoot
    # refuses a large rkrn -- which m1n1 (patch 0011) appends to the
    # initramfs; /init unpacks it into a tmpfs
    rm -f "$out/alpine.rdsk.img4"
    if [ -f "$B/alpine-a10.tar.gz" ]; then
        python3 "$OVERLAY" "$tmp/alpine.cpio" "alpine.tar.gz=$B/alpine-a10.tar.gz:644"
        gzip -1 < "$tmp/alpine.cpio" > "$tmp/alpine.cpio.gz"
        ipsw img4 create --input "$tmp/alpine.cpio.gz" --type rdsk --im4m "$i" \
            --output "$out/alpine.rdsk.img4" >/dev/null
        say "wrote ${out#$A10/}/alpine.rdsk.img4 ($(($(wc -c < "$out/alpine.rdsk.img4") / 1024)) KiB, Alpine in RAM)"
    else
        note "no build/alpine-a10.tar.gz -- the iPad stays in the initramfs (./cascadia a10 build rootfs)"
    fi
    rm -rf "$tmp"
}

# ---------- boot -------------------------------------------------------------

cmd_boot() {
    need_ipad7
    local img="$B/out/m1n1-linux-$BOARD.rkrn.img4"
    [ "${1:-}" = proxy ] && img="$B/out/m1n1-proxy.rkrn.img4"
    [ -f "$img" ] || fail "no ${img#$A10/} -- run: ./cascadia a10 pack"
    [ -f "$IN/iBSS.img4" ] || fail "no inputs for $BOARD -- run: ./cascadia a10 inputs"
    if [ "$MODE" = DFU ]; then
        pwn
        "$GASTER" reset
        sleep 1
        say "patched iBSS"
        irecovery -f "$IN/iBSS.img4" >/dev/null
        note "a cable replug may be needed on some setups"
        wait_mode Recovery 20 || fail "no Recovery within 20 s after iBSS"
    fi
    [ "$MODE" = Recovery ] || fail "the iPad is in $MODE mode -- DFU, please"
    say "DeviceTree, trust cache, m1n1"
    irecovery -f "$IN/DeviceTree.rdtr.img4" >/dev/null; irecovery -c devicetree
    irecovery -f "$IN/empty.rtsc.img4" >/dev/null;      irecovery -c firmware
    if [ "${1:-}" != proxy ] && [ -f "$B/out/alpine.rdsk.img4" ]; then
        irecovery -f "$B/out/alpine.rdsk.img4" >/dev/null; irecovery -c ramdisk
    fi
    irecovery -f "$img" >/dev/null;                     irecovery -c bootx
    if [ "${1:-}" = proxy ]; then
        say "bootx submitted: m1n1 proxy. On the Mac: ls /dev/cu.usbmodem*"
    else
        say "bootx submitted: Linux. ~30 s later: ssh root@172.16.43.1 (or screen /dev/cu.usbmodem*)"
    fi
}

# ---------- main -------------------------------------------------------------

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
    doctor) cmd_doctor ;;
    build)  cmd_build "$@" ;;
    inputs) cmd_inputs ;;
    firmware) bash tools/firmware.sh ;;
    syscfg) cmd_syscfg ;;
    net)    exec bash host/mac-share-internet.sh "$@" ;;
    storage) exec bash storage/host.sh "$@" ;;
    nvme)   exec bash tools/nvme.sh "$@" ;;
    pack)   cmd_pack ;;
    boot)   cmd_boot "$@" ;;
    ''|-h|--help|help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$A10/cascadia" ;;
    *) fail "unknown command '$cmd' -- ./cascadia a10 help" ;;
esac
