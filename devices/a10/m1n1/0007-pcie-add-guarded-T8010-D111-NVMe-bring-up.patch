+        ADT_GETPROP(adt, gpio_node, "AAPL,phandle", &gpio_phandle) < 0 ||
+        ADT_GETPROP(adt, dart_node, "AAPL,phandle", &dart_phandle) < 0 ||
+        ADT_GETPROP(adt, nvmmu_node, "AAPL,phandle", &nvmmu_phandle) < 0 ||
+        adt_get_reg(adt, gpio_path, "reg", 0, &state->gpio_base, &size) ||
+        state->gpio_base != 0x20f100000 || size != 0x100000 ||
+        adt_get_reg(adt, dart_path, "reg", 0, &dart_base, &size) || dart_base != T8010_DART_BASE ||
