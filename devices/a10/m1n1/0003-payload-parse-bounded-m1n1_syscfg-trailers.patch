From daac9cdb75a776858d0951673a22fdc52a31b1bb Mon Sep 17 00:00:00 2001
From: Paul Praschl <praschlpaul@g-p.at>
Date: Sun, 26 Jul 2026 17:28:18 +0200
Subject: [PATCH 3/9] payload: parse bounded m1n1_syscfg trailers

Recognize an m1n1_syscfg trailer containing a little-endian length and
pass its raw blob to kboot before continuing payload parsing. Reject
empty, truncated and oversized records before exposing any data.

Define _payload_end as a 64 MiB upper bound for size-less concatenated
payload parsing and cap SysCfg input at 1 MiB. These bounds keep pointer
arithmetic and trailer validation inside the payload window while
leaving regular size-delimited payloads unchanged.

Signed-off-by: Paul Praschl <praschlpaul@g-p.at>
---
 m1n1-raw.ld   |  2 ++
 src/payload.c | 45 +++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/m1n1-raw.ld b/m1n1-raw.ld
index 961ed3a..965d422 100644
--- a/m1n1-raw.ld
+++ b/m1n1-raw.ld
@@ -2,6 +2,7 @@ ENTRY(_start)
 
 _stack_size = 0x20000;
 _stack_size_el3 = 0x8000;
+_max_payload_size = 64*1024*1024;
 
 /* We are actually relocatable */
 . = 0;
@@ -88,6 +89,7 @@ SECTIONS {
     _data_size = . - _data_start;
     _end = .;
     _payload_start = .;
+    _payload_end = . + _max_payload_size;
 
     .symtab 0 : { *(.symtab) }
     .strtab 0 : { *(.strtab) }
diff --git a/src/payload.c b/src/payload.c
index 5b1547f..d0ac7bf 100644
--- a/src/payload.c
+++ b/src/payload.c
@@ -32,8 +32,12 @@ static const u8 sig_magic[] = {'m', '1', 'n', '1', '_', 's', 'i', 'g'};
 static const u8 initramfs_magic[] = {
     'm', '1', 'n', '1', '_', 'i', 'n',
     'i', 't', 'r', 'a', 'm', 'f', 's'}; // followed by size as little endian uint32_t
+static const u8 syscfg_magic[] = {
+    'm', '1', 'n', '1', '_', 's', 'y', 's', 'c', 'f', 'g'}; // followed by size as little endian uint32_t
 static const u8 empty[] = {0, 0, 0, 0};
 
+#define SYSCFG_MAX_SIZE SZ_1M
+
 // custom logo is RGBA with 256x256 retina logo followed by half resolution
 static const u8 custom_logo_magic[] = {'m', '1', 'n', '1', '_', 'l', 'o', 'g',
                                        'o', '_', '2', '5', '6', '1', '2', '8'};
@@ -46,6 +50,20 @@ static char *chainload_spec = NULL;
 
 static void *load_one_payload(void *start, size_t size);
 
+static size_t payload_bytes_available(const u8 *p, size_t size)
+{
+    u64 addr = (u64)p;
+    u64 payload_start = (u64)_payload_start;
+    u64 payload_end = (u64)_payload_end;
+
+    if (size)
+        return size;
+    if (addr < payload_start || addr >= payload_end)
+        return 0;
+
+    return payload_end - addr;
+}
+
 static void finalize_uncompression(void *dest, size_t dest_len)
 {
     // Actually reserve the space. malloc is safe after this, but...
@@ -246,6 +264,33 @@ static void *load_one_payload(void *start, size_t size)
         printf("Found a m1n1 initramfs payload at %p, 0x%x bytes\n", p, size);
         p += sizeof(initramfs_magic) + 4;
         return load_cpio(p, size);
+    } else if (payload_bytes_available(p, size) >= sizeof(syscfg_magic) &&
+               !memcmp(p, syscfg_magic, sizeof(syscfg_magic))) {
+        const size_t header_size = sizeof(syscfg_magic) + sizeof(u32);
+        size_t available = payload_bytes_available(p, size);
+        u32 payload_size;
+
+        /*
+         * SysCfg payload format:
+         *   "m1n1_syscfg" + little-endian u32 byte length + raw blob.
+         */
+        if (available < header_size) {
+            printf("Truncated m1n1 SysCfg payload header at %p\n", p);
+            return NULL;
+        }
+
+        memcpy(&payload_size, p + sizeof(syscfg_magic), sizeof(payload_size));
+        if (!payload_size || payload_size > SYSCFG_MAX_SIZE ||
+            payload_size > available - header_size) {
+            printf("Invalid m1n1 SysCfg payload size 0x%x at %p (0x%lx available)\n",
+                   payload_size, p, available - header_size);
+            return NULL;
+        }
+
+        printf("Found a m1n1 SysCfg payload at %p, 0x%x bytes\n", p, payload_size);
+        p += header_size;
+        kboot_set_syscfg(p, payload_size);
+        return p + payload_size;
     } else if (!memcmp(p, custom_logo_magic, sizeof(custom_logo_magic))) {
         printf("Found a m1n1 custom logo payload at %p, skipping 0x%lx bytes\n", p,
                sizeof(custom_logo_magic) + CUSTOM_LOGO_SIZE);
-- 
