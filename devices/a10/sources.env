# Pinned sources for the A10 track (iPad 7, T8010). Sourced by the scripts in
# devices/a10; every network fetch in this tree goes to one of these commits.
#
# Kernel: Paul Praschl's (Pauli1Go) HoolockLinux fork, the one tree with the
# J172 iPad 7 drivers (ANS NVMe, H9P PCIe Wi-Fi, SmartIO + SPI + Z2 touch,
# HDQ battery, SN2400/D2365 charging, BCM4355C1 Bluetooth). GPL-2.0.
A10_KERNEL_REPO=https://github.com/Pauli1Go/HoolockLinux.git
A10_KERNEL_COMMIT=7b3e4e8b0156e190d9175c6fcf396ae384419f14   # branch hoolock, 2026-10-24

# Kernel config base: HoolockLinux's known-good 16K config (A13 lesson: a
# 4K/PAC defconfig kernel hangs early on these SoCs).
A10_CONFIG_URL=https://raw.githubusercontent.com/HoolockLinux/docs/23ebe1fbc375599221553a7e1815e5de182a6b42/config_16k
A10_CONFIG_SHA256=a5cbcb0d3fe655888106672e6fe03477b63d51bd36bbcfc4f5145627d906b208

# m1n1: HoolockLinux idevice branch, the same commit the A13 track builds. MIT.
A10_M1N1_REPO=https://github.com/HoolockLinux/m1n1.git
A10_M1N1_COMMIT=d5a10ac52a6468484854419a6c5130f1d62073eb

# Boot chain, all open source (no checkra1n):
#   gaster      checkm8 (pwned DFU) + AES-engine decryption. Apache-2.0.
#   hBootPatcher patches iBSS so it boots our images. MIT.
A10_GASTER_REPO=https://github.com/HoolockLinux/gaster.git
A10_GASTER_COMMIT=2b9d747f2367f8c0860def02ec4fd299e531c52a
A10_HBOOTPATCHER_REPO=https://github.com/HoolockLinux/hBootPatcher.git
A10_HBOOTPATCHER_COMMIT=231a23202b305f9434c69b397a858d44cfd79064

# The IM4M iBoot still parses (a T8010 one; the patched iBSS does not check
# whose it is). From HoolockLinux/remote_boot, which notes signature files are
# not copyrightable.
A10_IM4M_URL=https://raw.githubusercontent.com/HoolockLinux/remote_boot/e254a58b7d7c68c9e34a407a0beb0aab4861a6b6/im4m/0x8010.im4m
A10_IM4M_SHA256=ba24320ab1bd9428a9243a7beac2502e8d8f6753b0afb9e195a0d9d5b1ee596c

# iBSS + DeviceTree come from this iPadOS (what remote_boot uses for devices
# whose latest major is >= 16).
A10_BOOT_IOS=16.4

# Touch firmware converter: Paul Praschl's makez2fw (Apple MTFW HBPP sequence
# + this iPad's SysCfg calibration -> the Z2 container apple_z2 loads).
# GPL-2.0-or-later.
A10_MAKEZ2FW_REPO=https://github.com/Pauli1Go/HoolockLinux-linux-firmware.git
A10_MAKEZ2FW_COMMIT=944541e67b4c603df328c77d30093551de802c17

# Bluetooth firmware extractor: Corellium's Project Sandcastle hcdpack (cuts
# the BCM4355C1 Patchram image out of iPadOS's BlueTool), the revision
# Pauli1Go's guide pins. GPL-2.0. Fetched as its one source file, checked.
A10_HCDPACK_URL=https://raw.githubusercontent.com/corellium/projectsandcastle/03db9c6ae04141eb940f3b9f56d446f50d57fadf/hcdpack/hcdpack.c
A10_HCDPACK_SHA256=ad2f5f370501ac59cd822468c064b56a7b332dcdbbf68a67e01c1ed02e75d4ef

# The iPadOS 18.7.9 (22H355) root filesystem, for the Wi-Fi and Bluetooth
# firmware in it: the IPSW member and its AEA key (public, per build).
A10_IPSW_URL=https://updates.cdn-apple.com/2026WinterFCS/fullrestores/122-57592/FBDFE8FD-7949-4258-B392-F56D6CD4B8FA/iPad_10.2_18.7.9_22H355_Restore.ipsw
A10_OSDMG=094-32804-023.dmg.aea
A10_OSDMG_KEY=7KOdNK5Zt/nFXc8jtMCMOJIDBnSdOGkvI6s3MEghYD8=
