#!/usr/bin/env bash
#
# Project Cascadia -- iPad mini 1 / A5 (p105ap), through ./cascadia a5 at the
# repository's top (this file is devices/a5/cascadia).
#
#   ./cascadia a5 install     everything, from nothing to Linux on the iPad, step by
#                             step (run it again to carry on after a stop)
#   ./cascadia a5 setup       put on this computer what the build needs (asks first)
#   ./cascadia a5 ssh         a shell on the iPad
#
#   ./cascadia a5 doctor      check that this machine has what the build needs
#   ./cascadia a5 kernel      fetch the pinned Linux source into build/linux
#   ./cascadia a5 rootfs      build the Alpine armhf rootfs for the initramfs
#   ./cascadia a5 build       dtb + kernel + staging bundle, with the safety checks
#   ./cascadia a5 firmware    patch iBSS/iBEC out of a stock IPSW
#   ./cascadia a5 mtcal       this iPad's own touch calibration, from its iOS (optional)
#   ./cascadia a5 flash       boot the device over USB (Pi Pico, or --kdfu from iOS)
#   ./cascadia a5 link        give this host 10.55.0.1 on the device's link (flash does it)
#   ./cascadia a5 net on|off  share this host's internet with it  (macOS or Linux)
#   ./cascadia a5 nfs on|off  export a root filesystem to it      (macOS or Linux)
#   ./cascadia a5 desktop-root  a root with XFCE, the GPU's Mesa and pack, SuperTux,
#                             screenpad, autorotate, built here; nfs on seeds
#                             a new root from it
#
# For working on the port (desktop-root runs these itself):
#   ./cascadia a5 dev gpu     the GPU's pack (the template frame Mesa takes, sgx2d's
#                             demos): build, and install onto the iPad (or --install
#                             HOST, --root DIR)
#   ./cascadia a5 dev mesa    Mesa with the GPU's driver (OpenGL ES 1.1/2.0, desktop
#                             2.1, GLX, tux-gpudemo): build, and install the same way
#                             (release; a debug build: MESA_BUILD=debug)
#   ./cascadia a5 image       rebuild the build image if the Dockerfile changed
#
# Everything is relative to this file, so the repository works wherever it is
# cloned.  There is no ~/iBSSloader and no ~/Desktop anything.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$ROOT/../.." && pwd)"     # the repository; this file is devices/a5/cascadia
IMAGE="${IMAGE:-cascadia-build}"
cd "$ROOT"

say()  { printf '==> %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# stat's flags are the classic portability trap here: BSD wants -f%z and GNU
# wants -c%s, and the wrong one prints an error that looks like a missing file.
filesize() {
    stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null \
        || fail "cannot stat $1"
}

# Having the docker BINARY says nothing about being able to use it: on a fresh
# Arch install the daemon is not started and the user is not in the docker
# group, and every call then fails with "dial unix /var/run/docker.sock: no
# such file or directory" -- which doctor used to report as "ok: docker".
docker_reachable() { have docker && docker info >/dev/null 2>&1; }

require_docker() {
    have docker || fail "docker is not installed or not on PATH"
    docker_reachable && return 0
    {
        echo "error: docker is installed but its daemon is not reachable."
        echo "       (dial unix /var/run/docker.sock -- nothing listening there)"
        echo
        case "$(uname -s)" in
            Linux)
                echo "  Start it and allow your user to talk to it:"
                echo "    sudo systemctl enable --now docker"
                echo "    sudo usermod -aG docker \"$USER\" && newgrp docker"
                echo
                echo "  Rootless docker or podman also work; point IMAGE= and"
                echo "  DOCKER= at them if you use those." ;;
            Darwin)
                echo "  Start Docker Desktop (or colima) and wait for it to settle." ;;
        esac
    } >&2
    exit 1
}

# The image is rebuilt whenever the Dockerfile changes, not only when it is
# missing.  The first clean install on Arch found the gap: its image predated
# the iBoot32Patcher step, so ./cascadia a5 firmware failed on a tool the
# Dockerfile plainly installs, and the only way out was knowing to `docker rmi`
# it.  The image carries a label with a hash of the Dockerfile it came from.
# Unchanged layers come from docker's cache, so a rebuild for an old image
# that merely lacks the label takes seconds.
dockerfile_hash() {
    python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest()[:16])' \
        "$ROOT/Dockerfile"
}

ensure_image() {
    require_docker
    want=$(dockerfile_hash)
    have=$(docker image inspect -f '{{ index .Config.Labels "cascadia.dockerfile" }}' "$IMAGE" 2>/dev/null || true)
    if [ "$have" = "$want" ]; then return 0; fi
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        say "$IMAGE does not match the current Dockerfile -- rebuilding it"
    else
        say "building the $IMAGE image (first run only)"
    fi
    docker build --label "cascadia.dockerfile=$want" -t "$IMAGE" "$ROOT"
}

in_docker() {
    ensure_image
    # Run as the calling user on Linux.  Docker Desktop on macOS maps ownership
    # for you; a plain Linux daemon does not, so everything the build writes
    # into the bind mount lands owned by root and the next `rm -rf build` or
    # plain rebuild needs sudo.  Observed on the first clean-clone build: the
    # bundle came out root:root while the loader, copied by the host shell
    # afterwards, came out as the user.
    duser=()
    [ "$(uname -s)" = "Linux" ] && duser=(--user "$(id -u):$(id -g)")
    # ${arr[@]+"${arr[@]}"} and not plain "${arr[@]}": macOS ships bash 3.2,
    # where expanding an EMPTY array under `set -u` is an unbound-variable
    # error.  bash 4.4 and later made it fine, so this only ever breaks on the
    # Mac -- and it broke on the Mac, after passing on Arch.
    docker run --rm ${duser[@]+"${duser[@]}"} ${DOCKER_EXTRA[@]+"${DOCKER_EXTRA[@]}"} \
        -v "$ROOT":/cascadia -w /cascadia "$IMAGE" bash -c "$1"
}

DOCKER_EXTRA=()

# The one stock file the boot chain is derived from.  Apple still serves it;
# the URL is Apple's own, nothing here redistributes the firmware.
IPSW_NAME="iPad2,5_8.4.1_12H321_Restore.ipsw"
IPSW_URL="https://secure-appldnld.apple.com/ios8.4.1/031-31249-20150812-75235CC6-3C8F-11E5-848D-BE1A3A53DB92/$IPSW_NAME"

# IPSW= wins, and a wrong IPSW= is an error rather than a quiet fallback.
# Otherwise devices/a5 and the repository's top are searched under both
# names: the one Apple serves, so `curl -LO` followed by ./cascadia a5
# firmware just works from either, and the short one this tree has always
# used.
find_ipsw() {
    if [ -n "${IPSW:-}" ]; then
        if [ -f "$IPSW" ]; then echo "$IPSW"; return 0; fi
        return 1
    fi
    for c in "$ROOT/$IPSW_NAME" "$ROOT/ipad25.ipsw" "$REPO/$IPSW_NAME" "$REPO/ipad25.ipsw"; do
        if [ -f "$c" ]; then echo "$c"; return 0; fi
    done
    return 1
}

# Into the repository's top, through a .part so a broken download is never
# taken for the IPSW, and resumed (-C -) when run again after one.
download_ipsw() {
    have curl || fail "no curl to download with"
    say "downloading $IPSW_NAME"
    curl -fL -C - --retry 3 -o "$REPO/$IPSW_NAME.part" "$IPSW_URL" \
        || fail "the download stopped; run ./cascadia a5 firmware again to resume it"
    python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).testzip()' "$REPO/$IPSW_NAME.part" 2>/dev/null \
        || fail "$REPO/$IPSW_NAME.part is not a whole IPSW (a zip); delete it and try again"
    mv "$REPO/$IPSW_NAME.part" "$REPO/$IPSW_NAME"
}

cmd_firmware() {
    # The image builds iBoot32Patcher from source and the img3 decrypt/encrypt
    # steps are pure Python, so the whole boot chain is derived from the user's
    # own IPSW and nothing else.
    if ! IPSW_PATH=$(find_ipsw); then
        [ -z "${IPSW:-}" ] || fail "no IPSW at $IPSW"
        echo "No IPSW here yet.  This port is pinned to iPad2,5 on iOS 8.4.1 (12H321):"
        echo "the auto-go hook patches an address inside that exact iBEC, and the keys"
        echo "are that build's.  Apple still serves it (about 1.4 GB):"
        echo "    $IPSW_URL"
        ans=n
        if [ -t 0 ]; then
            read -r -p "Download it now into $REPO? [Y/n] " ans || ans=n
            ans=${ans:-y}
        fi
        case "$ans" in
            y|Y|yes) download_ipsw ;;
            *) fail "no IPSW.  Download it into the repository's top (or pass IPSW=/path/to/it):
    curl -LO '$IPSW_URL'" ;;
        esac
        IPSW_PATH=$(find_ipsw) || fail "the download did not leave $IPSW_NAME in $REPO"
    fi

    say "IPSW: $IPSW_PATH"
    DOCKER_EXTRA=(-v "$IPSW_PATH":/ipsw.ipsw:ro)
    in_docker "IPSW=/ipsw.ipsw bash scripts/build-firmware.sh"
    DOCKER_EXTRA=()
}

cmd_doctor() {
    rc=0
    say "host"
    note "uname: $(uname -srm)"
    for t in git python3 rsync; do
        if have "$t"; then note "ok:      $t"; else note "MISSING: $t"; rc=1; fi
    done
    # Reachability, not presence.  doctor exists to fail here rather than in the
    # middle of a build, and reporting the binary was exactly the wrong check.
    if ! have docker; then
        note "MISSING: docker"; rc=1
    elif docker_reachable; then
        note "ok:      docker (daemon reachable)"
    else
        note "BROKEN:  docker is installed but its daemon is not reachable"; rc=1
    fi
    case "$(uname -s)" in
        Darwin) note "ok:      macOS -- build, flash and the host-side helpers all run here" ;;
        Linux)  note "ok:      Linux -- build, flash, link, net and nfs all run here"
                for t in exportfs rpcinfo; do
                    if have "$t"; then note "ok:      $t"
                    else note "missing: $t -- ./cascadia a5 nfs needs nfs-utils (Arch: pacman -S nfs-utils)"; fi
                done
                if have iptables || have nft; then note "ok:      $(have iptables && echo iptables || echo nft) (./cascadia a5 net)"
                else note "missing: iptables or nft -- ./cascadia a5 net needs one (Arch: pacman -S iptables-nft)"; fi ;;
        *)      note "note:    $(uname -s) -- untested; build may work, the rest will not" ;;
    esac
    say "boot chain (not needed to build a kernel)"
    if p=$(find_ipsw); then note "ok:      IPSW ${p#$REPO/} (./cascadia a5 firmware)"
    else note "missing: $IPSW_NAME for ./cascadia a5 firmware"
         note "         curl -LO '$IPSW_URL'"; fi
    # flash talks USB through lib/appleusb.py: pyusb (the system's or
    # build/pylib's), and libusb under it -- `mode` needs both to answer
    if python3 "$REPO/lib/appleusb.py" mode >/dev/null 2>&1; then
        note "ok:      pyusb + libusb (./cascadia a5 flash)"
    else
        note "MISSING: pyusb or libusb -- ./cascadia a5 flash needs them: ./cascadia a5 setup"
        rc=1
    fi
    note "         into pwned DFU: a Pi Pico with checkm8-a5, or --kdfu from a jailbroken iOS"
    if [ "$(uname -s)" = Linux ]; then
        if have usbmuxd; then note "ok:      usbmuxd (flash --kdfu, mtcal: ssh to iOS over USB)"
        else note "missing: usbmuxd -- flash --kdfu and mtcal reach iOS through it (package usbmuxd;"
             note "         or over Wi-Fi with IOS_HOST=<the iPad's IP>)"; fi
        [ -e /etc/udev/rules.d/39-cascadia-apple.rules ] || ls /etc/udev/rules.d/*libirecovery* /usr/lib/udev/rules.d/*libirecovery* >/dev/null 2>&1 \
            && note "ok:      a udev rule gives you Apple's USB devices" \
            || note "note:    no udev rule for Apple's USB devices yet -- flash says which one to add"
    fi

    say "tree"
    for p in build/linux/Makefile build/initramfs-root/init dtb/p105ap.dtb; do
        # The hint is picked outside $(...): macOS's /bin/bash 3.2 cannot parse
        # a case statement inside a command substitution.
        if [ -e "$p" ]; then note "ok:      $p"
        else
            case $p in
                build/linux*) hint='./cascadia a5 kernel' ;;
                build/initramfs*) hint='./cascadia a5 rootfs' ;;
                *) hint='./cascadia a5 build' ;;
            esac
            note "missing: $p    ($hint)"
        fi
    done
    [ "$rc" -eq 0 ] || fail "install what is missing above and re-run"
    say "ready"
}

cmd_kernel() { bash "$ROOT/scripts/fetch-kernel.sh"; }

# ---------- setup: this computer ---------------------------------------------
# What the rest needs, installed after asking (lib/host.sh knows brew, apt,
# pacman and dnf); then doctor says what is still missing, if anything.
cmd_setup() {
    . "$REPO/lib/host.sh"
    say "packages"
    if [ "$HOST_OS" = Darwin ]; then
        have git && have python3 || { note "the Command Line Tools first:"; run xcode-select --install || true
                                       fail "run this again once they are installed"; }
        [ "$(host_pm)" = brew ] || note "no Homebrew (https://brew.sh): libusb and Docker Desktop then by hand"
        pm_install libusb || true
    else
        pm_install base libusb nfs firewall usbmuxd || true
    fi
    say "docker"
    ensure_docker
    ensure_binfmt linux/arm/v6
    say "USB"
    pylib_pyusb
    ensure_udev
    say "ssh"
    ensure_sshkey
    echo
    cmd_doctor
}

# ---------- install: from nothing to Linux on the iPad -----------------------
# Every step in order, each skipped when its result is already there, so
# running it again after a stop carries on where it stopped.  The answers
# (desktop or not, Pico or kDFU) are kept in build/install.conf.
INSTALL_CONF="$ROOT/build/install.conf"

istep() {   # N TITLE [HOW-LONG]
    ISTEP=$1
    echo
    if [ -t 1 ]; then printf '\033[1m[%s/%s] %s\033[0m%s\n' "$1" "$ITOTAL" "$2" "${3:+  ($3)}"
    else printf '[%s/%s] %s%s\n' "$1" "$ITOTAL" "$2" "${3:+  ($3)}"; fi
}
iskip() { note "done already -- $*"; }
inone() { note "not needed -- $*"; }
isub() { bash "$ROOT/cascadia" "$@" || fail "step $ISTEP stopped (above).  Fix what it says and run ./cascadia a5 install again: it carries on from here."; }

install_conf() {   # KEY QUESTION -> y|n, asked once
    local v
    v=$(sed -n "s/^$1=//p" "$INSTALL_CONF" 2>/dev/null | tail -1)
    if [ -z "$v" ]; then
        if ask "$2"; then v=y; else v=n; fi
        # kept only when someone answered (or YES=1 did): a run without a
        # terminal takes the default for now and asks again next time
        if [ -t 0 ] || [ "${YES:-0}" = 1 ]; then mkdir -p "$ROOT/build"; echo "$1=$v" >> "$INSTALL_CONF"; fi
    fi
    echo "$v"
}

nfs_dst() { [ "$(uname -s)" = Darwin ] && echo "$HOME/cascadia-root" || echo /srv/cascadia-root; }

cmd_install() {
    . "$REPO/lib/host.sh"
    local FW="$ROOT/build/firmware" desktop route
    ITOTAL=8
    echo "Linux on the iPad mini 1 (iPad2,5), from the start.  Each step says what it"
    echo "does; one that is done already is skipped, so this can be run again any time."

    istep 1 "this computer: what the build needs"
    isub setup

    istep 2 "Linux's source, pinned to 6.12" "a few hundred MB"
    if [ -f "$ROOT/build/linux/Makefile" ]; then iskip "build/linux"; else isub kernel; fi

    istep 3 "the Alpine system the iPad boots into" "a few minutes"
    if [ -x "$ROOT/build/initramfs-root/sbin/p105-stage2" ] && [ -x "$ROOT/build/initramfs-root/usr/sbin/dropbear" ]; then
        iskip "build/initramfs-root"
    else isub rootfs; fi

    istep 4 "Apple's files, from the iPad's own iOS 8.4.1 IPSW" "1.4 GB download the first time"
    if [ -f "$FW/iBEC.patched.autogo.plain.dfu" ] && [ -f "$FW/P105.mtprops" ] && [ -f "$FW/sgx543.fw" ]; then
        iskip "build/firmware"
    else isub firmware; fi

    echo
    echo "    The desktop (XFCE on the GPU, SuperTux, an on-screen keyboard and game"
    echo "    controls) lives on this computer, which the iPad uses as its disk over the"
    echo "    cable (NFS, ~1.5 GB).  Without it the iPad runs a small system in its RAM."
    desktop=$(install_conf desktop "the desktop?")

    istep 5 "the kernel and the boot image" "~15 min the first time, a few on an M-series Mac"
    # fresh: the bundle is newer than the tree it embeds and than the
    # sources a build lays over it (an edit to initramfs/init reaches the
    # tree only when the build runs)
    if [ -f "$ROOT/output/staging-bundle.bin" ] && [ -z "$(find "$ROOT/build/initramfs-root" \
            "$ROOT/initramfs" "$ROOT/rootfs/alpine" "$ROOT/dts" "$ROOT/patches" "$ROOT/config" \
            "$ROOT/build/keep" -newer "$ROOT/output/staging-bundle.bin" -type f -print -quit 2>/dev/null)" ]; then
        iskip "output/staging-bundle.bin is newer than everything in it"
    else isub build; fi

    istep 6 "the desktop's root" "minutes; up to two hours the very first time"
    if [ "$desktop" != y ]; then inone "no desktop: the iPad runs from RAM"
    elif [ -f "$ROOT/build/desktop-root.tar" ]; then iskip "build/desktop-root.tar"
    else isub desktop-root; fi

    istep 7 "the iPad's disk on this computer (NFS)"
    if [ "$desktop" != y ]; then inone "no desktop"
    elif [ -s "$ROOT/build/initramfs-root/etc/nfsroot" ] && [ -e "$(nfs_dst)/sbin/p105-stage2" ]; then
        iskip "$(nfs_dst), exported"
    else
        isub nfs on
        # the image has to carry the export's address: build again (only
        # the initramfs changed, so it is quick)
        isub build
    fi

    istep 8 "boot the iPad"
    route=$(sed -n 's/^route=//p' "$INSTALL_CONF" 2>/dev/null | tail -1)
    if [ -z "$route" ]; then
        echo "    How does the iPad get into pwned DFU?"
        echo "      1) a Raspberry Pi Pico with checkm8-a5 (docs/QUICKSTART.md, \"Into pwned DFU\")"
        echo "      2) its own jailbroken iOS (EverPwnage, OpenSSH from Cydia): nothing else needed"
        route=2
        if [ -t 0 ] && [ "${YES:-0}" != 1 ]; then read -r -p "    1 or 2 [2]: " route || route=2; fi
        case "${route:-2}" in 1) route=pico ;; *) route=kdfu ;; esac
        if [ -t 0 ]; then echo "route=$route" >> "$INSTALL_CONF"; fi
    fi
    if [ "$route" = pico ]; then
        echo "    Put the iPad into DFU (hold Power + Home 10 s, then let go of Power and keep"
        echo "    Home 10 s more: the screen stays black), plug it into the Pico, wait for the"
        echo "    Pico's LED to say done, then plug the iPad into this computer."
        ask "ready?" || fail "run ./cascadia a5 install again when it is"
        isub flash
    else
        echo "    Boot the iPad into its jailbroken iOS, unlock it, and plug it into this computer."
        ask "ready?" || fail "run ./cascadia a5 install again when it is"
        isub flash --kdfu
    fi

    echo
    say "done: Linux is booting on the iPad (about 30 s)"
    echo "    a shell:      ./cascadia a5 ssh       (or on the glass, with its keyboard)"
    [ "$desktop" = y ] && echo "    the desktop:  desktop                 (on the iPad: on the glass, or over ssh)"
    echo "    internet for it through this computer:  ./cascadia a5 net on   (or Wi-Fi: wifi, on the iPad)"
    echo "    every later boot: ./cascadia a5 flash$([ "$route" = kdfu ] && echo ' --kdfu')"
}

# ---------- ssh: a shell on the iPad -----------------------------------------
# With ~/.ssh/cascadia when there is one, and a known_hosts of its own in
# build/, so a rebuilt image's new host key meets no warning about anyone's
# ~/.ssh/known_hosts.  IPAD= another address (its Wi-Fi one).
cmd_ssh() {
    local key=() rc=0
    [ -f "$HOME/.ssh/cascadia" ] && key=(-i "$HOME/.ssh/cascadia")
    mkdir -p "$ROOT/build"
    ssh ${key[@]+"${key[@]}"} -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR \
        -o UserKnownHostsFile="$ROOT/build/known_hosts" "root@${IPAD:-10.55.0.2}" "$@" || rc=$?
    if [ $rc = 255 ]; then
        echo "no ssh to ${IPAD:-10.55.0.2}.  Booted and on the cable?  ./cascadia a5 link gives this" >&2
        echo "computer its address on the iPad's link (flash does it at every boot)." >&2
    fi
    return $rc
}

cmd_rootfs() {
    [ -x "$ROOT/scripts/build-alpine-rootfs.sh" ] || fail "scripts/build-alpine-rootfs.sh is missing"
    bash "$ROOT/scripts/build-alpine-rootfs.sh"
}

cmd_build() {
    [ -f "$ROOT/build/linux/Makefile" ] || fail "no kernel source -- run: ./cascadia a5 kernel"
    [ -d "$ROOT/build/initramfs-root" ] || fail "no rootfs -- run: ./cascadia a5 rootfs"
    mkdir -p "$ROOT/build/out" "$ROOT/output"

    # KERNEL_SRC= makes build/linux a symlink to a tree somewhere else, which is
    # right for the host -- a kernel checkout is ~2.5 GB and nobody wants two --
    # and useless inside the container, where that absolute path does not exist.
    # Bind the target over the symlink so the path the build expects is a real
    # directory on both sides.  realpath via python3 because BSD readlink has no
    # -f and python3 is already a checked prerequisite.
    if [ -L "$ROOT/build/linux" ]; then
        KTREE=$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$ROOT/build/linux")
        [ -f "$KTREE/Makefile" ] || fail "build/linux points at $KTREE, which is not a kernel tree"
        note "kernel tree: $KTREE (mounted over the symlink)"
        DOCKER_EXTRA=(-v "$KTREE":/cascadia/build/linux)
    fi

    say "1/6 device tree"
    # rm first: dtc is not a make target here, so a stale .dtb would just be
    # reused and an edit to the .dts would silently never reach the device.
    rm -f "$ROOT/dtb/p105ap.dtb"; mkdir -p "$ROOT/dtb"
    # Capture rather than pipe: a pipeline hands back the last command's status,
    # so a docker failure here used to surface as the far less useful "dtc
    # produced no dtb" with the real error scrolled past.
    if ! out=$(in_docker "dtc -I dts -O dtb -f dts/p105ap.dts -o dtb/p105ap.dtb" 2>&1); then
        printf '%s\n' "$out" >&2
        fail "dtc failed -- see above"
    fi
    printf '%s\n' "$out" | grep -v '^$' | tail -5 || true
    [ -s "$ROOT/dtb/p105ap.dtb" ] || fail "dtc ran but produced no dtb"
    for s in g_cdc.host_addr g_cdc.dev_addr; do
        LC_ALL=C grep -aFq "$s" "$ROOT/dtb/p105ap.dtb" || fail "$s missing from the dtb bootargs"
    done
    LC_ALL=C grep -aFq initcall_debug "$ROOT/dtb/p105ap.dtb" && fail "dtb has initcall_debug; drop it from bootargs"
    note "ok: fresh dtb, gadget MACs pinned"

    say "2/6 initramfs extras"
    # initramfs/ is the source of truth for the boot scripts, but only
    # ./cascadia a5 rootfs used to copy it in -- an edit to initramfs/init followed
    # by ./cascadia a5 build shipped the old init.  Overlay it on every build.
    # rootfs/alpine/ the same way, and first, as ./cascadia a5 rootfs lays them:
    # it was applied only there, so the login banner's list of what works
    # (etc/motd) stayed whatever the last rootfs build had seen.
    cp -a "$ROOT/rootfs/alpine/." "$ROOT/build/initramfs-root/"
    cp -a "$ROOT/initramfs/." "$ROOT/build/initramfs-root/"
    note "ok: rootfs/alpine/ and boot scripts from initramfs/"
    # The digitizer's firmware is Apple's, so it comes out of the user's IPSW
    # with the boot chain rather than out of the repository.  Before build/keep
    # is laid over the tree, so a copy there still wins.
    if [ -s "$ROOT/build/firmware/P105.mtprops" ]; then
        mkdir -p "$ROOT/build/initramfs-root/lib/firmware"
        cp "$ROOT/build/firmware/P105.mtprops" "$ROOT/build/initramfs-root/lib/firmware/"
        note "ok: touch firmware from the IPSW (build/firmware/P105.mtprops)"
    fi
    # The same for Wi-Fi: brcmfmac is built in and asks for brcm/<name> as soon
    # as the chip enumerates, which is long before any NFS root is mounted --
    # so it has to be in the image itself.
    if [ -s "$ROOT/build/firmware/brcmfmac4334.bin" ]; then
        mkdir -p "$ROOT/build/initramfs-root/lib/firmware/brcm"
        cp "$ROOT/build/firmware/brcmfmac4334.bin" "$ROOT/build/initramfs-root/lib/firmware/brcm/"
        note "ok: Wi-Fi firmware from the IPSW (build/firmware/brcmfmac4334.bin)"
    else
        note "note: no Wi-Fi firmware -- ./cascadia a5 firmware extracts it from the IPSW"
    fi
    # Bluetooth's patchram, from BlueTool in the same IPSW.  btbcm asks for it
    # by the chip's subversion as soon as hci_bcm attaches, at boot.
    if [ -s "$ROOT/build/firmware/BCM4334B0.hcd" ]; then
        mkdir -p "$ROOT/build/initramfs-root/lib/firmware/brcm"
        cp "$ROOT/build/firmware/BCM4334B0.hcd" "$ROOT/build/initramfs-root/lib/firmware/brcm/"
        note "ok: Bluetooth firmware from the IPSW (build/firmware/BCM4334B0.hcd)"
    else
        note "note: no Bluetooth firmware -- ./cascadia a5 firmware extracts it from the IPSW"
    fi
    # The GPU's microkernel, for drivers/gpu/drm/apple-sgx.  Apple's, so it
    # comes out of the kernelcache like the rest (scripts/extract-sgx-firmware.py).
    if [ -s "$ROOT/build/firmware/sgx543.fw" ]; then
        mkdir -p "$ROOT/build/initramfs-root/lib/firmware/apple"
        cp "$ROOT/build/firmware/sgx543.fw" "$ROOT/build/initramfs-root/lib/firmware/apple/"
        note "ok: GPU microkernel from the IPSW (build/firmware/sgx543.fw)"
    else
        note "note: no GPU microkernel -- ./cascadia a5 firmware extracts it from the IPSW"
    fi
    # No RTC on this board: without a stamp it boots at the epoch and every TLS
    # handshake fails on notBefore.  Written before the kernel build so it lands
    # inside the embedded initramfs.
    date -u "+%Y-%m-%d %H:%M:%S" > "$ROOT/build/initramfs-root/etc/build-date"
    note "ok: build date $(cat "$ROOT/build/initramfs-root/etc/build-date") UTC"
    # /bin/peek is the MMIO tool every lab note in docs/ uses, and this busybox
    # has no devmem applet.  Built here rather than committed: the source is
    # ours, and the cross-compiler is already in the image.
    in_docker "arm-linux-gnueabihf-gcc -static -Os -o build/initramfs-root/bin/peek tools/p105-peek.c"
    [ -s "$ROOT/build/initramfs-root/bin/peek" ] || fail "peek did not build"
    note "ok: /bin/peek ($(filesize "$ROOT/build/initramfs-root/bin/peek") bytes, static ARM)"
    # /sbin/z2-boot brings the digitizer up the way iOS does -- firmware, the
    # N1 calibration sequence, EXECUTE, operating mode -- where hx-touchd stops
    # after the firmware.  docs/research/p105-z2-boot.md.
    in_docker "arm-linux-gnueabihf-gcc -static -Os -o build/initramfs-root/sbin/z2-boot tools/z2-boot.c"
    [ -s "$ROOT/build/initramfs-root/sbin/z2-boot" ] || fail "z2-boot did not build"
    note "ok: /sbin/z2-boot ($(filesize "$ROOT/build/initramfs-root/sbin/z2-boot") bytes, static ARM)"
    # /sbin/p105-keys: the buttons -- volume sets the speakers' volume or the
    # backlight (the side switch picks), Hold puts the screen out and back,
    # Home held is the rotation lock.  Started by stage 2.
    in_docker "arm-linux-gnueabihf-gcc -static -Os -Wall -o build/initramfs-root/sbin/p105-keys tools/p105-keys.c"
    [ -s "$ROOT/build/initramfs-root/sbin/p105-keys" ] || fail "p105-keys did not build"
    note "ok: /sbin/p105-keys (static ARM)"
    # The NAND, read-only: nandctl pokes the PPN chips, iosnand serves iOS's
    # partitions as block devices (`ios mount`).  docs/research/p105-nand.md.
    in_docker "arm-linux-gnueabihf-gcc -static -Os -D_FILE_OFFSET_BITS=64 -o build/initramfs-root/sbin/nandctl tools/nand/nandctl.c tools/nand/ppn.c && arm-linux-gnueabihf-gcc -static -O2 -D_FILE_OFFSET_BITS=64 -o build/initramfs-root/sbin/iosnand tools/nand/iosnand.c tools/nand/ppn.c"
    [ -s "$ROOT/build/initramfs-root/sbin/iosnand" ] || fail "iosnand did not build"
    note "ok: /sbin/nandctl, /sbin/iosnand (static ARM)"
    # Wi-Fi's tools and the on-screen keyboard ride in the image (a RAM boot
    # has no network to apk add them with).  A tree made by an older
    # ./cascadia a5 rootfs lacks them; add them rather than make it start over.
    if [ ! -x "$ROOT/build/initramfs-root/sbin/wpa_supplicant" ] \
        || [ ! -x "$ROOT/build/initramfs-root/usr/sbin/iw" ] \
        || [ ! -x "$ROOT/build/initramfs-root/usr/bin/fbkeyboard" ] \
        || [ ! -x "$ROOT/build/initramfs-root/usr/lib/bluetooth/bluetoothd" ] \
        || [ ! -s "$ROOT/build/initramfs-root/etc/netconfig" ] \
        || [ ! -x "$ROOT/build/initramfs-root/usr/bin/aplay" ]; then
        bash "$ROOT/scripts/add-base-packages.sh" >/dev/null \
            || fail "could not add the base packages (scripts/add-base-packages.sh)"
    fi
    note "ok: iw, wpa_supplicant, fbkeyboard, bluez, dbus, alsa-utils, NFS RPC configuration"
    # dropbear's host key, made once and kept in build/keep so it outlives a
    # rootfs rebuild.  Without it dropbear -R made a new one at every boot of the
    # RAM root, and every boot met ssh with REMOTE HOST IDENTIFICATION HAS
    # CHANGED.  The fingerprint printed here is the one ssh shows the first time.
    if [ -x "$ROOT/build/initramfs-root/usr/sbin/dropbear" ]; then
        if command -v ssh-keygen >/dev/null 2>&1; then
            HOSTKEY=etc/dropbear/dropbear_ed25519_host_key
            hk=$(python3 "$ROOT/scripts/dropbear-hostkey.py" "$ROOT/build/keep/$HOSTKEY") \
                || fail "could not make the ssh host key"
            note "ok: ssh host key, ${hk%% *} ed25519 ${hk#* }"
        else
            note "note: no ssh-keygen here, so the device makes its host key at boot -- a new one every boot"
        fi
    fi
    # build/keep holds what the repository cannot reproduce -- the touch
    # daemon, the digitizer firmware, the ssh host key made just above -- and
    # only ./cascadia a5 rootfs used to copy it in, so a firmware added later
    # never reached the image.  Every build now.
    if [ -d "$ROOT/build/keep" ]; then
        cp -a "$ROOT/build/keep/." "$ROOT/build/initramfs-root/"
        note "ok: build/keep/ -> image ($(cd "$ROOT/build/keep" && find . -type f | wc -l | tr -d ' ') files)"
    fi
    # Not fatal: without it the image boots as before, just without touch.
    if [ ! -s "$ROOT/build/initramfs-root/lib/firmware/P105.mtprops" ]; then
        note "note: no touch firmware -- touch stays off; ./cascadia a5 firmware extracts it from the IPSW"
    fi
    if [ -f "$ROOT/build/keep/lib/firmware/mtcal.bin" ]; then
        note "ok: touch calibration: this iPad's own (build/keep, ./cascadia a5 mtcal)"
    else
        note "ok: touch calibration: the default (initramfs/lib/firmware/mtcal.bin)"
    fi
    if [ -x "$ROOT/build/initramfs-root/usr/sbin/dropbear" ]; then
        # The image always lets in the machine that builds it.  add-dropbear.sh
        # bakes a key once, at rootfs time, so a key made after that -- another
        # ssh-keygen, another laptop -- left an image that met every login with
        # a password prompt for a password that does not exist.  This machine's
        # key is added if the image does not carry it yet; nothing is removed.
        # So is every ~/.ssh/cascadia*.pub: keys made for this device alone
        # (cascadia_claude, the passphrase-less one the assistant logs in
        # with).  Stage 1 copies the image's list over the NFS root's at every
        # boot, so a key appended on the device by hand is gone after a reboot.
        AK="$ROOT/build/initramfs-root/root/.ssh/authorized_keys"
        PUB="${PUBKEY:-}"
        if [ -z "$PUB" ]; then
            for c in ~/.ssh/id_ed25519.pub ~/.ssh/id_rsa.pub ~/.ssh/id_ecdsa.pub; do
                if [ -f "$c" ]; then PUB="$c"; break; fi
            done
        fi
        [ -n "$PUB" ] || note "note: no ssh public key on this machine -- the image keeps whatever keys it had"
        for PUB in $PUB ~/.ssh/cascadia*.pub; do
            [ -f "$PUB" ] || continue
            blob=$(awk 'NR == 1 { print $2 }' "$PUB")
            case "$(head -c 12 "$PUB" 2>/dev/null)" in
                ssh-*|ecdsa-*|sk-*) : ;;
                *) blob= ;;
            esac
            if [ -z "$blob" ]; then
                note "note: $PUB is not an OpenSSH public key -- skipped"
            elif [ -f "$AK" ] && grep -qF "$blob" "$AK"; then
                note "ok: ssh lets in $PUB"
            else
                mkdir -p "$(dirname "$AK")"
                chmod 700 "$(dirname "$AK")"
                { [ -s "$AK" ] && echo; cat "$PUB"; } >> "$AK"
                chmod 600 "$AK"
                note "ok: ssh lets in $PUB -- added to the image"
            fi
        done
    fi

    say "3/6 kernel"
    # set -o pipefail INSIDE the container shell: without it a failed build
    # returns the status of whatever the output was piped into, and the stale
    # artifacts from last time get shipped as if they were fresh.
    in_docker "set -o pipefail; bash scripts/build-kernel.sh 2>&1 | tail -25"

    say "4/6 freshness"
    CPIO="$ROOT/build/linux/usr/initramfs_data.cpio"
    [ -f "$CPIO" ] || fail "no $CPIO -- the kernel build did not embed an initramfs"
    STALE=$(find "$ROOT/build/initramfs-root" -type f -newer "$CPIO" -print -quit 2>/dev/null || true)
    [ -z "$STALE" ] || fail "the archive predates ${STALE#$ROOT/build/initramfs-root/} -- the build missed your change"
    note "ok: the initramfs archive is newer than every input"

    say "5/6 initramfs contents"
    # The kernel build embeds whatever it is pointed at without an opinion, so
    # check that what went in is the boot these docs describe.  This is the
    # check that was missing while ./cascadia a5 rootfs still installed a pre-USB
    # /init: the build was green, the kernel was fine, and the device came up
    # on the glass with no console over the cable, no 10.55.0.2 and no ssh.
    # LC_ALL=C because BSD grep in a UTF-8 locale silently skips regions of a
    # binary it cannot decode.
    for s in "P105: stage1 start" p105-stage2 ttyGS0 10.55.0.2; do
        LC_ALL=C grep -aFq "$s" "$CPIO" \
            || fail "the archive has no '$s' -- build/initramfs-root is not what ./cascadia a5 rootfs builds"
    done
    note "ok: stage 1, stage 2, the ACM console and the pinned address are in the archive"
    # Ownership, read out of the archive's own headers.  Every entry must be
    # root's: the first build on a Linux host came out owned by uid 1000
    # throughout, booted fine, and then dropbear refused root's key because
    # /root/.ssh was not root's -- which surfaces as a password prompt for a
    # password that does not exist.  A group other than 0 is only noted.
    owners=$(python3 "$ROOT/scripts/cpio-owners.py" "$CPIO") \
        || fail "could not read owners out of $CPIO"
    bad_uid=$(printf '%s\n' "$owners" | sed -n 1p)
    bad_gid=$(printf '%s\n' "$owners" | sed -n 2p)
    [ "$bad_uid" = "-" ] || fail "files in the archive are not owned by root ($bad_uid).
The kernel config maps the builder's uid to 0 (CONFIG_INITRAMFS_ROOT_UID=-1),
so this is a file in build/initramfs-root owned by some third uid."
    note "ok: every entry is owned by root"
    [ "$bad_gid" = "-" ] || note "note: some entries keep a non-root group ($bad_gid) -- harmless; rootfs and build ran under different groups"

    # Not fatal: a tree without these still boots and still gives both consoles.
    for s in bin/peek usr/sbin/dropbear etc/dropbear/dropbear_ed25519_host_key sbin/mount.nfs etc/netconfig \
             usr/sbin/iw sbin/wpa_supplicant usr/bin/fbkeyboard usr/lib/bluetooth/bluetoothd \
             usr/bin/aplay etc/asound.conf; do
        if LC_ALL=C grep -aFq "$s" "$CPIO"; then note "ok:      $s"
        else note "missing: $s  -- ./cascadia a5 rootfs installs it when docker is up"; fi
    done

    say "6/6 bundle"
    cat "$ROOT/build/linux/arch/arm/boot/zImage" "$ROOT/dtb/p105ap.dtb" > "$ROOT/output/zImage-dtb"
    want=$(( $(filesize "$ROOT/build/linux/arch/arm/boot/zImage") + $(filesize "$ROOT/dtb/p105ap.dtb") ))
    got=$(filesize "$ROOT/output/zImage-dtb")
    [ "$want" = "$got" ] || fail "zImage-dtb is $got bytes, expected $want"
    in_docker "bash build-bundle.sh 2>&1 | tail -5"
    cp "$ROOT/output/linux-boot.bin" "$ROOT/output/staging-loader.bin"
    bs=$(filesize "$ROOT/output/staging-bundle.bin")
    [ "$bs" = "$(( got + 32768 ))" ] || fail "staging-bundle.bin is $bs bytes, expected $(( got + 32768 ))"
    note "ok: bundle = 32K loader + this exact zImage-dtb"

    DOCKER_EXTRA=()
    say "done"
    ls -l "$ROOT/output/staging-bundle.bin" "$ROOT/output/staging-loader.bin"
}

# The GPU's pack (docs/GPU.md), in one command: the template frame Mesa
# takes, and sgx2d's demos.  It needs the IPSW's kernelcache and the GL
# driver's event template from ./cascadia a5 firmware (run here if it has not
# been), nothing from the device.  Built in the build image -- unicorn for
# the kext's emulated code, the ARM cross compiler for the device's
# binaries -- and installed from the host: into the running device's NFS
# root over ssh, or else into the root this host exports.
cmd_gpu() {
    if [ ! -f "$ROOT/build/firmware/kernelcache.12H321.macho" ] || [ ! -f "$ROOT/build/firmware/gl-event.pds" ]; then
        say "the GPU pack is made from the IPSW: ./cascadia a5 firmware"
        cmd_firmware
    fi
    in_docker "python3 tools/sgx/mkpack.py"
    if [ $# -gt 0 ]; then
        python3 "$ROOT/tools/sgx/mkpack.py" "$@"
    else
        python3 "$ROOT/tools/sgx/mkpack.py" --auto
    fi
}

# Mesa for the device is built in an Alpine armv7 image of its own
# (mesa/Dockerfile), under the host's ARM emulation: a native musl build
# against the libraries the device's root has.  The source is fetched here
# first, natively (mesa/fetch.sh): the first try cloned it inside the image
# and sat there for over an hour.  mesa/build.sh does the build;
# mesa/install.py puts it where ./cascadia a5 dev gpu puts the GPU's pack.
cmd_mesa() {
    require_docker
    bash "$ROOT/mesa/fetch.sh"
    say "the cascadia-mesa image (Alpine armv7)"
    docker build -q --platform linux/arm/v7 -t cascadia-mesa "$ROOT/mesa" >/dev/null \
        || fail "could not build the cascadia-mesa image -- does docker run linux/arm/v7 here?"
    duser=()
    [ "$(uname -s)" = "Linux" ] && duser=(--user "$(id -u):$(id -g)")
    # The system's OpenGL is a release build (no assertions: a debug build
    # stops a program on Mesa's own, M36); install.py takes the same one
    export MESA_BUILD="${MESA_BUILD:-release}"
    # --init: without it the build is PID 1, which ignores ^C
    docker run --rm --init --platform linux/arm/v7 ${duser[@]+"${duser[@]}"} \
        -e MESA_BUILD -v "$ROOT":/cascadia -w /cascadia cascadia-mesa sh mesa/build.sh
    if [ $# -gt 0 ]; then
        python3 "$ROOT/mesa/install.py" "$@"
    else
        python3 "$ROOT/mesa/install.py" --auto
    fi
}

# net and nfs have one script per host OS: they share the interface and not
# much else (pf and nfsd on the Mac, iptables/nftables and nfs-utils on Linux).
host_tool() {
    case "$(uname -s)" in
        Darwin) echo "$ROOT/tools/mac-$1.sh" ;;
        Linux)  echo "$ROOT/tools/linux-$1.sh" ;;
        *)      fail "no host-side '$1' for $(uname -s) -- macOS and Linux only" ;;
    esac
}

case "${1:-}" in
    doctor) cmd_doctor ;;
    kernel) cmd_kernel ;;
    rootfs) cmd_rootfs ;;
    build)  cmd_build ;;
    firmware) cmd_firmware ;;
    mtcal)  bash "$ROOT/tools/mtcal.sh" ;;
    flash)  shift; bash "$ROOT/tools/flash.sh" "$@" ;;
    link)   bash "$ROOT/tools/host-link.sh" ;;
    image)  ensure_image; say "$IMAGE is current" ;;
    net)    t=$(host_tool share-internet); shift; bash "$t" "$@" ;;
    nfs)    t=$(host_tool nfs-export);     shift; bash "$t" "$@" ;;
    dev)    shift
            case "${1:-}" in
                gpu)  shift; cmd_gpu "$@" ;;
                mesa) shift; cmd_mesa "$@" ;;
                *)    fail "./cascadia a5 dev gpu | mesa  (./cascadia a5 lists them)" ;;
            esac ;;
    desktop-root) bash "$ROOT/tools/desktop/make-root.sh" ;;
    setup)  cmd_setup ;;
    install) cmd_install ;;
    ssh)    shift; cmd_ssh "$@" ;;
    mesa|gpu) fail "./cascadia a5 $1 is ./cascadia a5 dev $1 now (desktop-root puts both into the root for you)" ;;
    *)      sed -n '2,35p' "$ROOT/cascadia" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
