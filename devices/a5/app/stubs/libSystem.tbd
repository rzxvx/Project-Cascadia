--- !tapi-tbd
tbd-version:     4
targets:         [ armv7-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
exports:
  - targets:         [ armv7-ios ]
    symbols:         [ _open, _close, _read, _ioctl, _fopen, _fclose, _fileno, _fstat, _fgets, _sscanf, _snprintf, _printf, _fflush, ___stdoutp, _strcmp, _setgid, _setuid, _getuid, _sysctlbyname, _sync, _execl, _CC_SHA1_Init, _CC_SHA1_Update, _CC_SHA1_Final, _popen, _pclose, _fread, _asprintf, _strdup, _free, _strcspn, _dispatch_async, _dispatch_get_global_queue, __dispatch_main_q, __NSConcreteStackBlock, __NSConcreteGlobalBlock, __Block_object_assign, __Block_object_dispose, _dyld_stub_binder, _puts, _putchar, _memset, _memcmp, _memcpy, ___memcpy_chk, ___snprintf_chk, ___sprintf_chk, ___stack_chk_guard, ___stack_chk_fail, _strlen ]
...
