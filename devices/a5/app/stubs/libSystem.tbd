--- !tapi-tbd
tbd-version:     4
targets:         [ armv7-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
exports:
  - targets:         [ armv7-ios ]
    symbols:         [ _open, _close, _read, _ioctl, _fopen, _fclose, _fileno, _fstat, _fgets, _sscanf, _snprintf, _printf, _fflush, ___stdoutp, _strcmp, _setgid, _setuid, _getuid, _sysctlbyname, _sync, _execl, _CC_SHA1_Init, _CC_SHA1_Update, _CC_SHA1_Final, _popen, _pclose, _fread, _asprintf, _strdup, _free, _strcspn, _dispatch_async, _dispatch_get_global_queue, __dispatch_main_q, __NSConcreteStackBlock, __NSConcreteGlobalBlock, __Block_object_assign, __Block_object_dispose, _dyld_stub_binder, _puts, _putchar, ___divsi3, ___modsi3, ___udivsi3, ___umodsi3, _memset, _memcmp, _memcpy, _memmove, _socket, _connect, _getaddrinfo, _freeaddrinfo, _write, ___error, _alarm, _malloc, _strstr, _strchr, _strncmp, _strcpy, ___strcpy_chk, ___memmove_chk, ___memset_chk, _time, _gettimeofday, _abort, ___memcpy_chk, ___snprintf_chk, ___sprintf_chk, ___stack_chk_guard, ___stack_chk_fail, _strlen, _CC_SHA256_Final, _CC_SHA256_Init, _CC_SHA256_Update, __exit, _calloc, _dup2, _fchmod, _fchown, _fork, _fprintf, _fsync, _mkdir, _pipe, _rename, _stat, _statfs, _strnlen, _strtoull, _unlink, _waitpid, ___stderrp, _fwrite, _strncasecmp, _strtoul ]
...
