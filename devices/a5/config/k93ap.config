#
# iPad 2 Wi-Fi (iPad2,1 / K93AP, S5L8940X): what it adds to the A5 kernel.
#
# Merged after config/p105ap.config (scripts/build-kernel.sh CONFIG_EXTRA,
# ./cascadia k93 build sets it).  Everything the iPad mini's fragment enables
# stays: the two boards share the AIC, PMU, GPIO, I2C, SPI, USB and GPU
# drivers, and a driver whose node is not in dts/k93ap.dts simply never
# binds -- the mini's PPN NAND driver (mtd-apple-h2fmi) above all, which must
# never touch this board's raw NAND.
#

# Wi-Fi: a BCM4329 on the SoC's SDIO controller (arm-io/sdio, an SDHC at
# 0x30000000; iOS drives it through the IOP, Linux directly).  The mini's
# fragment turns MMC off; this turns it back on with only the SDHCI core --
# multi_v7 would otherwise bring back every SoC vendor's glue driver.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_APPLE_S5L=y
CONFIG_PWRSEQ_SIMPLE=y
# CONFIG_MMC_ARMMMCI is not set
# CONFIG_MMC_SDHCI_OF_ARASAN is not set
# CONFIG_MMC_SDHCI_OF_AT91 is not set
# CONFIG_MMC_SDHCI_OF_ESDHC is not set
# CONFIG_MMC_SDHCI_ESDHC_IMX is not set
# CONFIG_MMC_SDHCI_DOVE is not set
# CONFIG_MMC_SDHCI_TEGRA is not set
# CONFIG_MMC_SDHCI_S3C is not set
# CONFIG_MMC_SDHCI_PXAV3 is not set
# CONFIG_MMC_SDHCI_PXAV2 is not set
# CONFIG_MMC_SDHCI_SPEAR is not set
# CONFIG_MMC_SDHCI_BCM_KONA is not set
# CONFIG_MMC_MESON_MX_SDHC is not set
# CONFIG_MMC_MESON_MX_SDIO is not set
# CONFIG_MMC_SDHCI_ST is not set
# CONFIG_MMC_OMAP is not set
# CONFIG_MMC_OMAP_HS is not set
# CONFIG_MMC_MVSDIO is not set
# CONFIG_MMC_SDHI is not set
# CONFIG_MMC_DW is not set
# CONFIG_MMC_SH_MMCIF is not set
# CONFIG_MMC_SUNXI is not set
# CONFIG_MMC_BCM2835 is not set
# CONFIG_MMC_SDHCI_IPROC is not set
# CONFIG_MMC_STM32_SDMMC is not set
# CONFIG_MMC_SDHCI_MSM is not set
# CONFIG_MMC_SDHCI_OMAP is not set
CONFIG_BRCMFMAC_SDIO=y

# Sensors (arm-io/i2c1, i2c2): the AK8975 compass, the TSL2581 light sensor
# and the L3G4200D gyro (built in: the image loads no modules).  The
# LIS331DLH accelerometer is st_accel, already in.
CONFIG_AK8975=y
CONFIG_TSL2583=y
CONFIG_IIO_ST_GYRO_3AXIS=y
CONFIG_IIO_ST_GYRO_I2C_3AXIS=y

# The root bigger than RAM: a squashfs image on iOS's System partition, read
# through tools/nand/k93iosnand over NBD (docs/k93-bringup.md).  zstd
# decompresses several times faster than xz on the A9, and a decompressor per
# CPU lets both cores work at once.
CONFIG_SQUASHFS_ZSTD=y
# CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE is not set
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y

# The speaker: ALSA card "iPad2" -- I2S0 + CDMA (sound/soc/apple/
# s5l8940-audio.c) and the CS42L63 codec run with iOS's own sequences
# (sound/soc/codecs/cs42l63.c).  docs/research/k93-audio.md.
CONFIG_SND_SOC_APPLE_S5L8940_AUDIO=y
CONFIG_SND_SOC_CS42L63=y

# The cameras: the A5's H4 ISP, a CPU of its own running iOS's firmware
# behind its IOMMU, as two V4L2 devices (drivers/media/platform/apple/
# apple-h4isp.c, docs/research/k93-camera.md).  V4L2 built in, as everything
# here: the image loads no modules.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_APPLE_H4ISP=y
