# Added to the running kernel's config by tools/nand/build-nand-rw.sh.
# Writable NAND root: controller and FTL built in, with program/erase and the
# FTL write path; the runtime gates (apple_ftl.enable_write, write_volume,
# apple_ppn.allow_write) come from the command line.
# CONFIG_MTD_APPLE_H2FMI is not set
CONFIG_APPLE_PPN=y
CONFIG_APPLE_SFTL=y
CONFIG_APPLE_SFTL_WRITE=y
CONFIG_EXT4_FS=y
CONFIG_LOCALVERSION="-nand-rw"
# CONFIG_LOCALVERSION_AUTO is not set
