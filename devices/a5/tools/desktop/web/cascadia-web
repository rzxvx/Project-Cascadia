def to_uri(text):
    """what was typed: an address, or words for the search engine"""
    t = text.strip()
    if not t:
        return None
    if re.match(r"^[a-z][a-z0-9+.-]*:", t, re.I) and not re.match(r"^[\w.-]+:\d+(/|$)", t):
        return t
    if " " not in t and ("." in t.strip(".") or t.startswith("localhost") or re.match(r"^[\w.-]+:\d+", t)):
        return ("http://" if t.startswith("localhost") else "https://") + t
    return SEARCH + urllib.parse.quote_plus(t)


def shown_uri(uri):
    return "" if not uri or uri.startswith("cascadia:") or uri == "about:blank" else uri


def proc_children(pid):
    """(pid, name) of the processes whose parent is pid"""
    out = []
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % p) as f:
                st = f.read()
        except OSError:
            continue
        r = st.rfind(")")
        if int(st[r + 2:].split()[1]) == pid:
            out.append((int(p), st[st.find("(") + 1:r]))
    return out


def web_pids():
    """WebKit's page processes: ours, or under bubblewrap when sandboxed"""
    pids = []
    for pid, name in proc_children(os.getpid()):
        if name.startswith("WebKitWebProces"):
            pids.append(pid)
        elif name == "bwrap":
            pids += [p for p, n in proc_children(pid) if n.startswith("WebKitWebProces")]
    return pids


def keyboard_up():
    for p in os.listdir("/proc"):
        if p.isdigit():
            try:
                with open("/proc/%s/cmdline" % p, "rb") as f:
                    if os.path.basename(f.read().split(b"\0", 1)[0]) == b"svkbd-mobile-intl":
                        return True
            except OSError:
                pass
    return False


class Toast(Gtk.Box):
    """a message at the bottom of the window, with buttons"""

    def __init__(self):
        super().__init__(spacing=12, halign=Gtk.Align.CENTER, valign=Gtk.Align.END, margin_bottom=28,
                         margin_start=16, margin_end=16, no_show_all=True)
        self.get_style_context().add_class("cascadia-toast")
        self.label = Gtk.Label(wrap=True, max_width_chars=56, xalign=0)
        self.buttons = Gtk.Box(spacing=8)
        self.pack_start(self.label, True, True, 0)
        self.pack_end(self.buttons, False, False, 0)
        self.timer = None

    def say(self, text, buttons=(), timeout=0):
        # no spinner: its animation kept X busy at a third of a core while
        # mpv and yt-dlp started
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self.label.set_text(text)
        for b in self.buttons.get_children():
            self.buttons.remove(b)
        for name, cb in buttons:
            b = Gtk.Button(label=name)
            b.connect("clicked", lambda _b, cb=cb: (self.clear(), cb()))
            self.buttons.pack_start(b, False, False, 0)
        for w in (self.label, self.buttons, *self.buttons.get_children()):
            w.show()
        self.show()
        if timeout:
            self.timer = GLib.timeout_add_seconds(timeout, self.clear)

    def clear(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        self.hide()
        return False


class Tab:
    """what the browser keeps of one page: its tab label, the media playlists
    it fetched, what its last tapped video said"""

    def __init__(self, view, on_close):
        self.view = view
        self.media = []
        self.last_play = None
        self.committed = None
        self.label = Gtk.Label(label="New tab", ellipsize=Pango.EllipsizeMode.END, width_chars=6,
                               max_width_chars=18)
        close = Gtk.Button(relief=Gtk.ReliefStyle.NONE, focus_on_click=False)
        if Gtk.IconTheme.get_default().has_icon("window-close-symbolic"):
            close.set_image(Gtk.Image.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON))
        else:
            close.set_label("✕")
        close.connect("clicked", lambda _b: on_close(view))
        self.box = Gtk.Box(spacing=4)
        self.box.pack_start(self.label, True, True, 0)
        self.box.pack_start(close, False, False, 0)
        self.box.show_all()

    def note(self, uri):
        if uri and uri not in self.media:
            self.media.append(uri)
            del self.media[:-8]


class Browser(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Web")
        self.conf = dict(DEFAULTS)
        try:
            with open(SETTINGS) as f:
                self.conf.update(json.load(f))
        except (OSError, ValueError):
            pass
        self.tabs = {}
        self.player = None
        self.player_buf = b""
        self.player_failed = None
        self.player_view = None
        self.last_input = 0.0
        self.kbd_timer = None
        self.ytdl = None
        self.setup_webkit()
        self.build()
        self.set_default_size(1024, 700)
        self.maximize()
        self.show_all()
        self.notebook.set_show_tabs(False)
        # yt-dlp kept warm (cascadia-ytdl): started once the first page has
        # had the CPU, at a low priority
        GLib.timeout_add_seconds(8, self.start_ytdl)

    def start_ytdl(self):
        if os.access(YTDL, os.X_OK):
            try:
                self.ytdl = subprocess.Popen([YTDL, "--serve"], stdin=subprocess.DEVNULL,
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                self.ytdl = None
        return False

    # -- WebKit ---------------------------------------------------------------

    def setup_webkit(self):
        for d in (CONF, DATA, CACHE):
            os.makedirs(d, exist_ok=True)
        self.data = WebKit2.WebsiteDataManager(base_data_directory=DATA, base_cache_directory=CACHE)
        self.data.get_cookie_manager().set_persistent_storage(COOKIES, WebKit2.CookiePersistentStorage.TEXT)
        # WebKit's processes give memory back sooner: by default they take
        # all of the iPad's 468 MB as their budget and start releasing caches
        # at a third of it, collecting harder at half -- with the desktop,
        # yt-dlp and mpv beside them, that was swap.  Budget 320 MB: from
        # 106 MB, and hard from 160, looked at every 10 s.  Caches sized for a
        # document viewer (nothing kept for going back): a page is fetched
        # again rather than held
        mp = WebKit2.MemoryPressureSettings.new()
        mp.set_memory_limit(320)
        mp.set_conservative_threshold(0.33)
        mp.set_strict_threshold(0.5)
        mp.set_poll_interval(10)
        WebKit2.WebsiteDataManager.set_memory_pressure_settings(mp)
        ctx = WebKit2.WebContext(website_data_manager=self.data, memory_pressure_settings=mp)
        ctx.set_cache_model(WebKit2.CacheModel.DOCUMENT_BROWSER)
        ctx.register_uri_scheme("cascadia", self.on_scheme)
        ctx.get_security_manager().register_uri_scheme_as_local("cascadia")
        ctx.connect("download-started", self.on_download)
        self.ctx = ctx

        s = WebKit2.Settings()
        s.set_enable_smooth_scrolling(False)
        s.set_enable_page_cache(False)
        s.set_enable_webgl(False)
        s.set_enable_encrypted_media(False)
        s.set_enable_media_stream(False)
        s.set_enable_developer_extras(False)
        s.set_javascript_can_open_windows_automatically(False)
        s.set_media_playback_requires_user_gesture(False)
        if DEBUG:
            s.set_enable_write_console_messages_to_stdout(True)
        # pages drawn on the CPU: as fast here (a scripted scroll at 18.6-18.9
        # frames a second against 17.3-18.2 through the GPU), steadier (no
        # frame over 82 ms, where the GPU's path stalled up to 427 ms) and
        # ~50 MB of RAM lighter.  CASCADIA_WEB_GPU=1: through the GPU anyway
        if os.environ.get("CASCADIA_WEB_GPU") != "1":
            s.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.NEVER)
        self.settings = s
        self.apply_site_mode()

        ucm = WebKit2.UserContentManager()
        with open(HOOK) as f:
            ucm.add_script(WebKit2.UserScript.new(f.read(), WebKit2.UserContentInjectedFrames.ALL_FRAMES,
                                                  WebKit2.UserScriptInjectionTime.START, None, None))
        ucm.connect("script-message-received::cascadia", self.on_message)
        ucm.register_script_message_handler("cascadia")
        self.ucm = ucm
        # every video is stopped by hook.js anyway: letting them start is
        # what lets a tap that reaches play() late still hand one over
        self.policies = WebKit2.WebsitePolicies(autoplay=WebKit2.AutoplayPolicy.ALLOW)
        self.filters = WebKit2.UserContentFilterStore.new(os.path.join(DATA, "filters"))
        self.ad_filter = None
        if self.conf["block_ads"]:
            self.load_ad_filter()

    def apply_site_mode(self):
        self.settings.set_user_agent(UA_DESKTOP if self.conf["desktop"] else UA_MOBILE)

    def load_ad_filter(self):
        if self.ad_filter:
            self.ucm.add_filter(self.ad_filter)
            return
        try:
            st = os.stat(BLOCKLIST)
        except OSError:
            return      # no list: web-setup.sh could not fetch one
        ident = "ads-%d-%d" % (st.st_size, int(st.st_mtime))

        def saved(store, res):
            try:
                self.set_ad_filter(store.save_finish(res))
                self.toast.clear()
            except GLib.Error as e:
                print("cascadia-web: the ad server list did not compile:", e.message, file=sys.stderr)
            store.fetch_identifiers(None, lambda st_, r: [
                st_.remove(i, None, None, None) for i in st_.fetch_identifiers_finish(r) if i != ident])

        def loaded(store, res):
            try:
                self.set_ad_filter(store.load_finish(res))
            except GLib.Error:
                with open(BLOCKLIST, "rb") as f:
                    rules = GLib.Bytes.new(f.read())
                self.toast.say("Preparing the ad blocker (once)…", timeout=30)
                store.save(ident, rules, None, saved)
        self.filters.load(ident, None, loaded)

    def set_ad_filter(self, f):
        self.ad_filter = f
        if self.conf["block_ads"]:
            self.ucm.add_filter(f)

    # -- the window -----------------------------------------------------------

    def button(self, icon, text, tip, cb):
        b = Gtk.Button(tooltip_text=tip, focus_on_click=False)
        if Gtk.IconTheme.get_default().has_icon(icon):
