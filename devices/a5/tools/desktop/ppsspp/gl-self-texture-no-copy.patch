+// Cascadia: Mesa's SGX driver (the iPad 2's tile-based GPU: renderer "PowerVR SGX543MP2",
+// "Mesa" in the version) ends the render a draw that samples its own target would join, so
+// the draw reads what was drawn before it, and the GPU stores each tile's pixels only when
+// that tile is done -- so a draw that reads none of the pixels it draws needs no copy of its
+// target: it samples the target itself.  God of War's bloom: six such copies of its
+// 864 x 272 target a frame, each a render of its own.  Through mode, in the target's pixels:
+// the pixels drawn are those whose centres the vertices' box covers (a quarter pixel either
+// way for the rasterizer); the texels read, the two around each texture coordinate in the
+// box (bilinear) -- kept in the texture's rectangle when PPSSPP's shader clamps them there
+// (with its offset in the target: God of War's bloom samples right beside where it draws),
+// the rectangle and a texel around it when the shader wraps, and inside the target
+// otherwise (the sampler's own wrap is not looked at).  PPSSPP_SELF_TEXTURE_COPY=1 / 0: a
+// copy always / none needed whatever the driver.
+static bool SelfTextureNeedsNoCopy(Draw::DrawContext *draw, const VirtualFramebuffer *fb, int flags) {
+	static int enabled = -1;
+	if (enabled < 0) {
+		const char *env = getenv("PPSSPP_SELF_TEXTURE_COPY");
+		std::string renderer = draw->GetInfoString(Draw::InfoField::DRIVER);
+		std::string version = draw->GetInfoString(Draw::InfoField::APIVERSION);
+		bool sgxMesa = renderer.find("SGX") != std::string::npos && version.find("Mesa") != std::string::npos;
+		enabled = env ? atoi(env) == 0 : sgxMesa;
+		INFO_LOG(Log::G3D, "Self-texturing copies: %s", enabled ? "only where the draw reads what it draws" : "always");
+	}
+	const CascadiaDrawVerts &dv = g_cascadiaDrawVerts;
+	if (!enabled || (flags & BINDFBCOLOR_MAY_COPY_WITH_UV) != BINDFBCOLOR_MAY_COPY_WITH_UV ||
+		!dv.verts || dv.count <= 0 || dv.uvOff < 0 || !gstate.isModeThrough())
+		return false;
+	float x0 = 1e9f, y0 = 1e9f, x1 = -1e9f, y1 = -1e9f;
+	float u0 = 1e9f, v0 = 1e9f, u1 = -1e9f, v1 = -1e9f;
+	for (int i = 0; i < dv.count; i++) {
+		const float *pos = (const float *)(dv.verts + i * dv.stride + dv.posOff);
+		const float *uv = (const float *)(dv.verts + i * dv.stride + dv.uvOff);
+		x0 = std::min(x0, pos[0]);
+		x1 = std::max(x1, pos[0]);
+		y0 = std::min(y0, pos[1]);
+		y1 = std::max(y1, pos[1]);
+		u0 = std::min(u0, uv[0]);
+		u1 = std::max(u1, uv[0]);
+		v0 = std::min(v0, uv[1]);
+		v1 = std::max(v1, uv[1]);
+	}
+	if (!(x1 - x0 < 8192.0f && y1 - y0 < 8192.0f && u1 - u0 < 8192.0f && v1 - v0 < 8192.0f))
+		return false;
+	// drawn: [dx0, dx1) x [dy0, dy1); read: [sx0, sx1) x [sy0, sy1)
+	int dx0 = (int)ceilf(x0 - 0.75f) + gstate_c.curRTOffsetX, dx1 = (int)ceilf(x1 - 0.25f) + gstate_c.curRTOffsetX;
+	int dy0 = (int)ceilf(y0 - 0.75f) + gstate_c.curRTOffsetY, dy1 = (int)ceilf(y1 - 0.25f) + gstate_c.curRTOffsetY;
+	int sx0 = (int)floorf(u0 - 0.5f), sx1 = (int)floorf(u1 - 0.5f) + 2;
+	int sy0 = (int)floorf(v0 - 0.5f), sy1 = (int)floorf(v1 - 0.5f) + 2;
+	if (gstate_c.needShaderTexClamp && !(gl_extensions.bugs & BUG_PVR_SHADER_PRECISION_TERRIBLE)) {
+		int w = gstate.getTextureWidth(0), h = gstate.getTextureHeight(0);
+		if (gstate.isTexCoordClampedS()) {
+			sx0 = std::max(sx0, 0);
+			sx1 = std::min(sx1, w);
+		} else {
+			sx0 = -1;
+			sx1 = w + 1;
+		}
+		if (gstate.isTexCoordClampedT()) {
+			sy0 = std::max(sy0, 0);
+			sy1 = std::min(sy1, h);
+		} else {
+			sy0 = -1;
+			sy1 = h + 1;
+		}
+	} else if (sx0 < 0 || sy0 < 0 || sx1 > fb->bufferWidth || sy1 > fb->bufferHeight) {
+		return false;
+	}
+	if (flags & BINDFBCOLOR_APPLY_TEX_OFFSET) {
+		sx0 += gstate_c.curTextureXOffset;
+		sx1 += gstate_c.curTextureXOffset;
+		sy0 += gstate_c.curTextureYOffset;
+		sy1 += gstate_c.curTextureYOffset;
+	}
+	return dx1 <= sx0 || sx1 <= dx0 || dy1 <= sy0 || sy1 <= dy0;
+}
