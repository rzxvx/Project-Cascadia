+// Cascadia: the blocks a streamed game's cache keeps.  Upstream's 256 MB ran God of War
+// (over HTTP: the disk cache turns itself off without the space) out of memory on the iPad 2
+// -- ~470 MB of RAM, no swap, the cache filling as the cutscenes stream -- so a sixteenth of
+// the RAM at most (~29 MB there; 256 MB as before from 4 GB on); PPSSPP_DISC_CACHE_MB: so
+// many MB.  Never under 32 blocks: a read's 16 and a read-ahead's 4 fit.
+static size_t CascadiaMaxBlocksCached(size_t blockSize) {
+	const size_t upstream = 4096, least = 32;
+	const char *env = getenv("PPSSPP_DISC_CACHE_MB");
+
+	if (env && atoi(env) > 0)
+		return std::max<size_t>((size_t)atoi(env) * 1048576 / blockSize, least);
+#if !defined(_WIN32)
+	const long pages = sysconf(_SC_PHYS_PAGES), pageSize = sysconf(_SC_PAGESIZE);
+	if (pages > 0 && pageSize > 0)
+		return std::min(upstream, std::max<size_t>((size_t)((unsigned long long)pages * pageSize / 16 / blockSize), least));
+#endif
+	return upstream;
+}
