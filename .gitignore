# ---- Large binaries / stock firmware (never belongs in git) ----
*.ipsw
*.dmg
*.raw
ibootfiles/
ich_ramdisk/
a13_boot/
ghidra_kc/
ghidra_project*/

# ---- Build products ----
# output/ is fully reproducible from patches/ + config/ + scripts/.
output/
# build/ is where the kernel clone, the Alpine rootfs and the intermediate
# objects land.  All of it is fetched or generated by scripts/.
build/
*.img3
*.complzss
*.macho
zImage
zImage-dtb
System.map
build.log
# regenerated by scripts/build-staging-bundle.sh from the zImage it is
# bundling, so a committed copy is always about to be wrong
pongo/staging-generated.h
pongo/staging-generated.inc

# ---- Raw capture logs from lab runs ----
uart_*.txt

# ---- Junk ----
.DS_Store
**/.DS_Store
__pycache__/
*.bak-*
*.backup
attic/_to_delete/
