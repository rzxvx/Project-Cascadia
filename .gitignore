# ---- Large binaries / stock firmware (never belongs in git) ----
# irecovery's history: per-device
.irecovery
*.ipsw
*.dmg
*.raw
ibootfiles/
ich_ramdisk/
a13_boot/
ghidra_kc/
ghidra_project*/

# ---- Build products ----
# output/ is fully reproducible from patches/ + config/ + scripts/.
output/
# build/ is where the kernel clone, the Alpine rootfs and the intermediate
# objects land.  All of it is fetched or generated by scripts/.
build/
*.img3
*.complzss
*.macho
zImage
zImage-dtb
System.map
build.log
# build-kernel.sh writes its config and build logs here
logs/
# regenerated by scripts/build-staging-bundle.sh from the zImage it is
# bundling, so a committed copy is always about to be wrong
devices/a5/pongo/staging-generated.h
devices/a5/pongo/staging-generated.inc

# ---- Raw capture logs from lab runs ----
uart_*.txt
uart.txt

# ---- Junk ----
.DS_Store
**/.DS_Store
__pycache__/
*.bak-*
*.backup
devices/a5/attic/_to_delete/
# built by ./cascadia a5 build from dts/p105ap.dts
dtb/
ipad25.ipsw

# sgx2d demo binary (built in docker, armv7)
devices/a5/tools/sgx/lib/sprites
devices/a5/tools/sgx/lib/demo2
devices/a5/tools/sgx/lib/sgxinfo
devices/a5/tools/sgx/lib/replay
devices/a5/tools/sgx/lib/cnttest
devices/a5/tools/sgx/lib/pbtest

# the device ./cascadia remembers (./cascadia device ...)
/.cascadia-device
