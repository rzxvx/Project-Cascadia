# Kconfig fragment merged on top of multi_v7_defconfig for iPad2,5 (P105AP).
#
# Merge with:
#   scripts/kconfig/merge_config.sh -m .config config/p105ap.config
#
# Rationale for the non-obvious entries is in DECISIONS.md.

# ---- platform -------------------------------------------------------------
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_APPLE_S5L=y
CONFIG_APPLE_AIC1=y

# Avoid interactive olddefconfig prompt during build-kernel.sh
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set
# CONFIG_KERNEL_ZSTD is not set

# L2 left enabled by iBoot; Linux outer_cache ops hang with L1 D-cache off.
# CONFIG_CACHE_L2X0 is not set

# VMAP stacks use __vmalloc during fork; with CPSR.I still set that hangs
# at rest_init / user_mode_thread. Use page-backed stacks until IRQs work.
# CONFIG_VMAP_STACK is not set

# SW DOMAIN PAN + unaligned __get_user kills init: dabt entry sets
# DOMAIN_USER=NOACCESS, then do_alignment_ldrstr privileged ldrb domain-faults
# (DAC 0x51).  alignment.c is patched for addr<TASK_SIZE, but keep PAN off
# until userspace is stable on P105.
# CONFIG_ARM_PAN is not set

# Dual-core A5 (S5L8942X). cpu1 needs PMGR Core(2) + AIC IPI (docs/p105-smp-bringup.md).
CONFIG_SMP=y
CONFIG_NR_CPUS=2
# Keep PMCCNTR clocksource; A9 TWD needs a safe CBAR map (still risky).
# CONFIG_ARM_GLOBAL_TIMER is not set

# ---- console --------------------------------------------------------------
# apple,s5l-uart is a real upstream binding (added for Apple silicon Macs);
# the A5 UART is the same Samsung-derived block, so the stock driver applies.
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_OF_PLATFORM=y

# ---- framebuffer ----------------------------------------------------------
# simplefb only.  No CLCD or MIPI-DSI driver exists for S5L8940X and writing
# one is not needed when iBoot leaves the panel scanning out.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_DEVICE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# ---- ramdisk root ---------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=262144
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

# ---- input ----------------------------------------------------------------
# The touch panel is driven from userspace over spidev and injected via uinput,
# so the kernel only needs the plumbing, not a multitouch driver.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=y

# ---- boot handoff ---------------------------------------------------------
# Appended DTB lets us hand pongoOS a single blob and not care whether r2
# survived the jump.  A separate DTB in r2 still works and takes priority.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
# Keep iBEC boot-args (cs_enforcement_disable=1 debug=0x14) from replacing
# the DTB /chosen/bootargs that carry earlycon and console=.
# CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER is not set

# ---- debugging ------------------------------------------------------------
# This is a bring-up kernel; noisy is correct.
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y

# ---- explicitly off -------------------------------------------------------
# Nothing may touch the NAND.  There is no driver for Apple's flash-controller
# upstream, but disabling MTD as well removes any chance of a stray probe.
# CONFIG_MTD is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set

# ---- Sandcastle-port (touch stack) ----
CONFIG_S5L8940X_PMGR_CLK=y
CONFIG_PINCTRL_S5L8940X_GPIO=y
CONFIG_SPI_S5L8940X=y
CONFIG_I2C_S5L8940X=y
CONFIG_MFD_APPLE_PMU_I2C=y
CONFIG_REGULATOR_APPLE_PMU_PWRSW=y
CONFIG_TOUCHSCREEN_APPLE_Z2=y
# INPUT_MT + REGMAP_I2C selected by driver Kconfigs; make explicit for safety:
CONFIG_INPUT_MT=y
CONFIG_REGMAP_I2C=y
CONFIG_REGULATOR=y
# hx-touch uses misc device for firmware upload path
CONFIG_MISC_ALTERA_PTS=n
CONFIG_I2C_S3C2410=y

# ---- USB stack (device / peripheral mode via DWC2) ----
CONFIG_GENERIC_PHY=y
CONFIG_PHY_APPLE_S5L_USB=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_DWC2=y
# Force peripheral-only mode; dual-role's OTG state machine gets stuck
# waiting for a session-valid signal that never arrives on this SoC.
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB_DWC2_DUAL_ROLE is not set
# dwc2 debug is OFF as of 2026-09-15.  It prints ~10 lines per USB transfer,
# printk to a UART console is synchronous, and the DCSD line is 115200 baud
# (~11 KB/s) -- so every keystroke on the ACM console dragged ~70 ms of serial
# output behind it.  73% of the previous boot log was dwc2 chatter.  Turn these
# back on only while actually debugging the gadget.
# CONFIG_USB_DWC2_DEBUG is not set
# CONFIG_USB_DWC2_DEBUG_PERIODIC is not set
# CONFIG_USB_DWC2_VERBOSE is not set
CONFIG_DEBUG_FS=y
CONFIG_USB_GADGET=y
# Simple test gadget — g_ether (RNDIS/CDC ECM); enumerates over Lightning
# g_ether proved the gadget path on 2026-09-14 (full enumeration + SET_CONFIGURATION
# + CDC ECM packet filter from macOS).  Swapped out for g_serial: only one legacy
# gadget can bind the UDC, and CDC ACM gives a real interactive tty with no IP
# config, no daemon and no extra binaries in the initramfs.
# CONFIG_USB_ETH is not set
# CONFIG_USB_ETH_RNDIS is not set
#
# 2026-09-16: g_serial -> g_cdc (USB_CDC_COMPOSITE).  One legacy gadget that
# exposes BOTH a CDC ECM link (usb0) and a CDC ACM port (/dev/ttyGS0), so the
# shell and the network share the single peripheral port instead of competing
# for it.  Only one legacy gadget can bind the UDC, which is why this is a swap
# and not an addition.
#
# Why a LEGACY gadget and not configfs, which would be more flexible:
# the system tick is the dwc2 SOF interrupt, and SOFs only reach us once the
# host has enumerated the device -- which only happens once something pulls up
# D+, which only happens once a gadget driver BINDS.  A legacy gadget binds
# from its own initcall, i.e. before apple_sof_clkevt registers at
# late_initcall.  A configfs gadget is bound by userspace writing to
# $GADGET/UDC, which happens in /init, long AFTER late_initcall -- the tick
# would look for SOFs, find none, and decline to register.  No jiffies, no
# sleep, dead box.  Do not "modernise" this to configfs without first making
# apple_sof_clkevt registration deferrable.
#
# Endpoint budget (g_cdc needs 4 bulk + 2 interrupt): ADT says num-of-eps=14
# and the DTS declares 8 dedicated TX FIFOs, 512+128+8*128 = 1664 words of the
# 2080 (fifo-depth 0x820) available.  Fits.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_CDC_COMPOSITE=y
# CONFIG_USB_G_SERIAL is not set

# ---- NFS client, for a root filesystem on the Mac over the ECM link -------
# The initramfs lives in RAM, which means it is also the disk: `apk add`
# evaporates on reboot and 512 MB is the ceiling for both.  An NFS root fixes
# both at once, over the link that already exists.
#
# v3 only, and v4 explicitly off: macOS's built-in nfsd serves v2/v3 -- neither
# exports(5) nor nfsd(8) on macOS mentions v4 at all -- so the v4 code would be
# dead weight.  v3 needs a userspace RPC handshake to get the root file handle,
# which is why mount.nfs from nfs-utils has to be baked into the initramfs; see
# scripts/add-apk-packages.sh.
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
# CONFIG_NFS_V4 is not set
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
# ROOT_NFS is the kernel mounting nfsroot itself, which needs the gadget bound
# and the host configured before do_initcalls has even finished.  We mount from
# /init instead, where the link is already up and a failure can fall back to
# the RAM rootfs instead of a panic.
# CONFIG_ROOT_NFS is not set

# ---- trim (2026-09-15) ----------------------------------------------------
# multi_v7_defconfig drags in drivers for every ARM SoC under the sun.  Each one
# costs an initcall and a printk at boot, and on this board the printk is the
# expensive part: the console is a 115200 UART and printk to it is synchronous.
# None of the below exists on P105AP.
#
# USB host-side network drivers -- this board is a peripheral, it will never
# have a USB NIC plugged into it:
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_USB_USBNET is not set
# CONFIG_USB_PEGASUS is not set
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
# CONFIG_USB_NET_CDCETHER is not set
# CONFIG_USB_NET_CDC_NCM is not set
# CONFIG_USB_NET_SMSC75XX is not set
# CONFIG_USB_NET_SMSC95XX is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_CDC_SUBSET_ENABLE is not set
# CONFIG_USB_NET_ZAURUS is not set
#
# DWC3 is a completely different controller from our DWC2, and its nine
# platform glue drivers each probe and print on the way past:
# CONFIG_USB_DWC3 is not set
#
# No SD/MMC, no SATA/SCSI, no optical, no NFS root:
# CONFIG_MMC is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_CDROM is not set
# CONFIG_NFS_FS is not set
