# Kconfig fragment merged on top of multi_v7_defconfig for iPad2,5 (P105AP).
#
# Merge with:
#   scripts/kconfig/merge_config.sh -m .config config/p105ap.config
#
# Rationale for the non-obvious entries is in DECISIONS.md.

# ---- platform -------------------------------------------------------------
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_APPLE_S5L=y
CONFIG_APPLE_AIC1=y

# Avoid interactive olddefconfig prompt during build-kernel.sh
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set
# CONFIG_KERNEL_ZSTD is not set

# L2 left enabled by iBoot; Linux outer_cache ops hang with L1 D-cache off.
# CONFIG_CACHE_L2X0 is not set

# VMAP stacks use __vmalloc during fork; with CPSR.I still set that hangs
# at rest_init / user_mode_thread. Use page-backed stacks until IRQs work.
# CONFIG_VMAP_STACK is not set

# SW DOMAIN PAN + unaligned __get_user kills init: dabt entry sets
# DOMAIN_USER=NOACCESS, then do_alignment_ldrstr privileged ldrb domain-faults
# (DAC 0x51).  alignment.c is patched for addr<TASK_SIZE, but keep PAN off
# until userspace is stable on P105.
# CONFIG_ARM_PAN is not set

# Dual-core A5 (S5L8942X). cpu1 needs PMGR Core(2) + AIC IPI (docs/p105-smp-bringup.md).
CONFIG_SMP=y
CONFIG_NR_CPUS=2
# Keep PMCCNTR clocksource; A9 TWD needs a safe CBAR map (still risky).
# CONFIG_ARM_GLOBAL_TIMER is not set

# ---- console --------------------------------------------------------------
# apple,s5l-uart is a real upstream binding (added for Apple silicon Macs);
# the A5 UART is the same Samsung-derived block, so the stock driver applies.
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_OF_PLATFORM=y

# ---- framebuffer ----------------------------------------------------------
# simplefb only.  No CLCD or MIPI-DSI driver exists for S5L8940X and writing
# one is not needed when iBoot leaves the panel scanning out.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_DEVICE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# ---- ramdisk root ---------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=1
CONFIG_BLK_DEV_RAM_SIZE=262144
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

# ---- input ----------------------------------------------------------------
# The touch panel is driven from userspace over spidev and injected via uinput,
# so the kernel only needs the plumbing, not a multitouch driver.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=y

# ---- boot handoff ---------------------------------------------------------
# Appended DTB lets us hand pongoOS a single blob and not care whether r2
# survived the jump.  A separate DTB in r2 still works and takes priority.
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
# Keep iBEC boot-args (cs_enforcement_disable=1 debug=0x14) from replacing
# the DTB /chosen/bootargs that carry earlycon and console=.
# CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER is not set

# ---- debugging ------------------------------------------------------------
# This is a bring-up kernel; noisy is correct.
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_MAGIC_SYSRQ=y

# ---- explicitly off -------------------------------------------------------
# Nothing may touch the NAND.  There is no driver for Apple's flash-controller
# upstream, but disabling MTD as well removes any chance of a stray probe.
# CONFIG_MTD is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
