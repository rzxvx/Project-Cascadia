--- !tapi-tbd
tbd-version:     4
targets:         [ armv7-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
exports:
  - targets:         [ armv7-ios ]
    symbols:         [ dyld_stub_binder, ___stack_chk_fail, ___stack_chk_guard, ___stdoutp, _fclose, _fopen, _fwrite, _memset, _printf, _putchar, _puts, _setvbuf, _snprintf, _strlen, _strstr, _strcpy, _memcpy, ___floatundidf, ___udivdi3, _atoi, _mach_absolute_time, _mach_task_self_, _mach_timebase_info, _usleep, _write ]
...
